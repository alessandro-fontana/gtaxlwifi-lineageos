From b78616f44c4b080d6888d25af08b8f650177754e Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 15:51:39 +0200
Subject: [PATCH] media: i2c: dw9807-vcm: skip the ramp down when the bus is
 dead

On the Galaxy Tab A 2016 the lens driver shares the module's I2C bus
with the sensor, whose I/O rail carries the pull-ups. The lens subdev
is closed after the sensor has stopped, so the ramp down in the runtime
suspend writes some forty positions to a bus that does not answer,
each one waiting for the 300 ms controller timeout: twelve seconds in
which the camera cannot be opened again.

Probe the bus once before the ramp and power off without it if it
does not answer, and stop the ramp at the first failure.

---
 drivers/media/i2c/dw9807-vcm.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 3166ff8395..eb589a46a6 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -296,11 +296,26 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 	if (!dw9807_dev->online)
 		return regulator_disable(dw9807_dev->vdd);
 
+	/*
+	 * The lens is usually closed after the sensor has stopped, and with
+	 * the sensor off the bus of the module does not answer: every write
+	 * would wait for the controller timeout, 300 ms, and the ramp takes
+	 * some forty of them. Probe once, and give up on the first failure:
+	 * the lens falls back to rest when the power goes anyway.
+	 */
+	if (dw9807_i2c_check(client) < 0) {
+		dev_dbg(dev, "bus down, powering off without the ramp\n");
+		dw9807_dev->online = false;
+		return regulator_disable(dw9807_dev->vdd);
+	}
+
 	for (val = dw9807_dev->current_val & ~(DW9807_CTRL_STEPS - 1);
 	     val >= 0; val -= DW9807_CTRL_STEPS) {
 		ret = dw9807_set_dac(client, val);
-		if (ret)
+		if (ret) {
 			dev_err_once(dev, "%s I2C failure: %d", __func__, ret);
+			return regulator_disable(dw9807_dev->vdd);
+		}
 		usleep_range(DW9807_CTRL_DELAY_US, DW9807_CTRL_DELAY_US + 10);
 	}
 
-- 
