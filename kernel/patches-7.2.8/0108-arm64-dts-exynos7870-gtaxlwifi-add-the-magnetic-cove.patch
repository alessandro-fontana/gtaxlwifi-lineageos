From 4dff23ab268e833d3dc8bed580c0c5a6ec5a55eb Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 21 Sep 2026 13:17:08 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: add the magnetic cover hall
 sensor

The book cover holds a magnet and the board has a hall sensor for it, but no
source we have says which pin it is: the downstream device tree is not here
and the mainline one never described it.

So it was measured. Reading the DAT registers of the alive GPIO banks while
the cover was opened and closed three times (tools/hall-caccia.sh) shows six
clean transitions on gpa1 bit 3 and on no other bit: closed 0xce -> 0xc6,
open 0xc6 -> 0xce. Active low with the magnet near, on a bank that stays
powered and can wake the SoC - which is where such a sensor belongs.

Declared as a switch and not a key: SW_LID is 1 with the lid CLOSED, which
with GPIO_ACTIVE_LOW is exactly the magnet being near, and wakeup-source
because opening the cover has to be able to wake the tablet.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 36 ++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 811578de89..813a1d7a29 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -516,7 +516,7 @@ gpio-keys {
 		label = "GPIO Keys";
 
 		pinctrl-names = "default";
-		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home>;
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home &hall_cover>;
 
 		key-power {
 			label = "Power Key";
@@ -543,6 +543,21 @@ key-home {
 			linux,code = <KEY_HOMEPAGE>;		/* 172 */
 			wakeup-source;
 		};
+
+		/*
+		 * La cover magnetica: non e' un tasto ma un interruttore, e
+		 * Android lo tratta come tale. SW_LID vale 1 a coperchio
+		 * CHIUSO, che con GPIO_ACTIVE_LOW e' esattamente il magnete
+		 * vicino. wakeup-source perche' l'apertura deve poter
+		 * svegliare il tablet.
+		 */
+		hall-cover {
+			label = "Hall Sensor";
+			gpios = <&gpa1 3 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;			/* 0 */
+			wakeup-source;
+		};
 	};
 };
 
@@ -1899,6 +1914,25 @@ key_home: key-home-pins {
 		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
 	};
 
+	/*
+	 * Sensore di Hall della cover magnetica, su gpa1-3 (§49).
+	 *
+	 * Il pin non e' documentato da nessuna parte che abbiamo: e' stato
+	 * MISURATO leggendo i registri DAT dei banchi alive mentre la cover si
+	 * apriva e si chiudeva (tools/hall-caccia.sh). Sei transizioni pulite,
+	 * tre aperture e tre chiusure, su gpa1 bit 3 e su nessun altro bit:
+	 * cover chiusa 0xce -> 0xc6, cover aperta 0xc6 -> 0xce. Quindi attivo
+	 * basso con il magnete vicino.
+	 *
+	 * Come i tasti: funzione EINT, cosi' il pin puo' svegliare il SoC.
+	 */
+	hall_cover: hall-cover-pins {
+		samsung,pins = "gpa1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
 	/* IRQ del PMIC S2MPU05, come nel J6 (righe 570-574). */
 	pmic_irq: pmic-irq-pins {
 		samsung,pins = "gpa0-2";
-- 
2.47.3

