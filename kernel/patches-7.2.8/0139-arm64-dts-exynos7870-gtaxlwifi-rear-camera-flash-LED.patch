From a74cccc2822addaff749d66984dace56d36d7f59 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 19:35:50 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: rear camera flash LED

On the SM5703: 150 mA torch, 1200 mA flash, as the vendor tree.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 2679386e33..9dbe6ad7da 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -27,6 +27,7 @@
 #include "exynos7870.dtsi"
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
 / {
@@ -2323,6 +2324,25 @@ charger {
 			 */
 			input-current-limit-microamp = <1650000>;
 		};
+
+		/*
+		 * Flash LED della fotocamera posteriore (§57). Il downstream
+		 * (sm5703_fled): flash 1200 mA, torcia e video 150 mA, e i
+		 * pin gpd3-5/gpd3-7 come comandi esterni. Qui il LED si
+		 * comanda via I2C e quei pin non si toccano: gpd3-7 e' anche
+		 * la linea d'interrupt del codec audio nel downstream.
+		 */
+		flash {
+			compatible = "siliconmitus,sm5703-flash";
+
+			led {
+				function = LED_FUNCTION_FLASH;
+				color = <LED_COLOR_ID_WHITE>;
+				led-max-microamp = <150000>;
+				flash-max-microamp = <1200000>;
+				flash-max-timeout-us = <1600000>;
+			};
+		};
 	};
 };
 
-- 
2.47.3

