From 94fe68f45a65f10e8b05bdee42ec3012e03a6f62 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 16:48:27 +0200
Subject: [PATCH] media: samsung: exynos7870-csis: rotate buffers on the DMA
 interrupts

Under memory load (a software ISP debayering on six cores) the DMA
drains the last lines of frame N after the CSI-2 link has started frame
N+1. Rotating the buffers on the link frame start then returned as
broken buffers the DMA was about to complete, and the preview stalled
after a while. Use the DMA frame start and end, which are ordered for
the engine itself; keep the link frame start for the sequence number.

With no DMA frame start while the DMA is off for lack of buffers, a
buffer queued in that state is programmed at once.

Allocate the buffers non-coherent: the frames are read by the CPU, and
the readers synchronise with DMA_BUF_IOCTL_SYNC.

Measured on the Galaxy Tab A 10.1 (2016) front camera: 2719 frames on
the link in 90 s, 2662 captured, 3 broken, no stall.

---
 .../samsung/exynos7870-csis/exynos7870-csis.c | 53 ++++++++++++++++---
 1 file changed, 45 insertions(+), 8 deletions(-)

diff --git a/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c b/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
index c0d9808705..42483673da 100644
--- a/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
+++ b/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
@@ -13,10 +13,16 @@
  *
  * Buffer handling: the DMA address registers are shadowed and latched at
  * frame start. An address written during frame N is used for frame N+1,
- * so at every frame start the buffer programmed before it becomes the
+ * so at every DMA frame start the buffer programmed before it becomes the
  * active one and the next queued buffer is programmed; at DMA frame end
  * the active buffer is complete. With no buffer to program, the DMA of
- * the next frame is disabled and that frame is dropped.
+ * the next frame is disabled and that frame is dropped; a buffer queued
+ * while the DMA is off re-enables it at once.
+ *
+ * The DMA start and end interrupts are used, not the CSI-2 frame start:
+ * under memory load the DMA drains the last lines of frame N after the
+ * link has started frame N+1, and rotating on the link frame start then
+ * gave back, as broken, buffers the DMA was about to complete.
  */
 
 #include <linux/bitfield.h>
@@ -85,6 +91,7 @@
 #define CSIS_INT1_ENABLE		0x00003ff0
 #define CSIS_INT1_DMA_ERROR		BIT(12)
 #define CSIS_INT1_DMA_FRM_END_CH0	BIT(8)
+#define CSIS_INT1_DMA_FRM_START_CH0	BIT(4)
 
 #define CSIS_DT_RAW8			0x2a
 #define CSIS_DT_RAW10			0x2b
@@ -155,6 +162,9 @@ struct csis {
 	u32 sequence;
 	unsigned int reported;
 	unsigned int errors;
+	unsigned int done;
+	unsigned int dropped;
+	bool running;
 };
 
 static inline u32 csis_read(struct csis *csis, u32 reg)
@@ -257,7 +267,11 @@ static irqreturn_t csis_irq(int irq, void *data)
 				    csis_read(csis, CSIS_DMA_ERR_CODE));
 	}
 
-	/* The end of frame N comes before the start of frame N+1. */
+	/* Frames seen on the link, captured or not. */
+	if (src0 & CSIS_INT0_FRAMESTART_CH0)
+		csis->sequence++;
+
+	/* For the DMA engine, the end of frame N precedes the start of N+1. */
 	if (src1 & CSIS_INT1_DMA_FRM_END_CH0) {
 		if (csis->reported < 3) {
 			csis->reported++;
@@ -270,14 +284,15 @@ static irqreturn_t csis_irq(int irq, void *data)
 		if (csis->active) {
 			csis_buffer_done(csis, csis->active, VB2_BUF_STATE_DONE);
 			csis->active = NULL;
+			csis->done++;
 		}
 	}
 
-	if (src0 & CSIS_INT0_FRAMESTART_CH0) {
-		csis->sequence++;
+	if (src1 & CSIS_INT1_DMA_FRM_START_CH0) {
 		if (csis->active) {
 			/* Its end never came: give it back as broken. */
 			csis_buffer_done(csis, csis->active, VB2_BUF_STATE_ERROR);
+			csis->dropped++;
 		}
 		csis->active = csis->next;
 		csis->next = csis_pop_pending(csis);
@@ -343,6 +358,7 @@ static int csis_hw_start(struct csis *csis)
 	spin_lock_irq(&csis->slock);
 	csis->next = csis_pop_pending(csis);
 	csis_dma_program(csis, csis->next);
+	csis->running = true;
 	spin_unlock_irq(&csis->slock);
 
 	csis_update(csis, CSIS_CMN_CTRL, CSIS_CMN_CTRL_UPDATE_SHADOW,
@@ -360,6 +376,10 @@ static int csis_hw_start(struct csis *csis)
 
 static void csis_hw_stop(struct csis *csis)
 {
+	spin_lock_irq(&csis->slock);
+	csis->running = false;
+	spin_unlock_irq(&csis->slock);
+
 	csis_write(csis, CSIS_INT_MSK0, 0);
 	csis_write(csis, CSIS_INT_MSK1, 0);
 	csis_update(csis, CSIS_DMA0_CTRL, CSIS_DMA_CTRL_DISABLE |
@@ -403,6 +423,15 @@ static void csis_buf_queue(struct vb2_buffer *vb)
 
 	spin_lock_irqsave(&csis->slock, flags);
 	list_add_tail(&buf->list, &csis->pending);
+	/*
+	 * The DMA was switched off for lack of buffers: no DMA frame start
+	 * will come to switch it on again, so program this one now. It is
+	 * latched at the next frame start.
+	 */
+	if (csis->running && !csis->next) {
+		csis->next = csis_pop_pending(csis);
+		csis_dma_program(csis, csis->next);
+	}
 	spin_unlock_irqrestore(&csis->slock, flags);
 }
 
@@ -479,6 +508,8 @@ static int csis_start_streaming(struct vb2_queue *q, unsigned int count)
 	csis->sequence = 0;
 	csis->reported = 0;
 	csis->errors = 0;
+	csis->done = 0;
+	csis->dropped = 0;
 
 	ret = csis_hw_start(csis);
 	if (ret)
@@ -514,9 +545,9 @@ static void csis_stop_streaming(struct vb2_queue *q)
 	pm_runtime_put(csis->dev);
 	video_device_pipeline_stop(&csis->vdev);
 
-	if (csis->errors)
-		dev_info(csis->dev, "%u frames, %u error interrupts\n",
-			 csis->sequence, csis->errors);
+	dev_info(csis->dev,
+		 "%u frames on the link, %u captured, %u broken, %u error interrupts\n",
+		 csis->sequence, csis->done, csis->dropped, csis->errors);
 
 	csis_return_all(csis, VB2_BUF_STATE_ERROR);
 }
@@ -747,6 +778,12 @@ static int csis_register(struct csis *csis)
 	q->mem_ops = &vb2_dma_contig_memops;
 	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
 	q->min_queued_buffers = 1;
+	/*
+	 * The frames are read by the CPU (software ISP): cached buffers,
+	 * synchronised by vb2 and by DMA_BUF_IOCTL_SYNC, instead of an
+	 * uncached mapping that makes every read crawl.
+	 */
+	q->non_coherent_mem = 1;
 	q->lock = &csis->lock;
 	q->dev = csis->dev;
 	ret = vb2_queue_init(q);
-- 
2.47.3

