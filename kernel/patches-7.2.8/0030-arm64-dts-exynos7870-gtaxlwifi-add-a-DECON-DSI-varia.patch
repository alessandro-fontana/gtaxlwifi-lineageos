From 305d14bb9b2a1843dda2927077f172c881280eb6 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 14:42:12 +0000
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: add a DECON/DSI variant

---
 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../dts/exynos/exynos7870-gtaxlwifi-decon.dts | 150 ++++++++++++++++++
 2 files changed, 151 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index b2dd1ec1ca..d853df07ca 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -23,3 +23,4 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynosautov9-sadk.dtb		\
 	exynosautov920-sadk.dtb
 dtb-$(CONFIG_ARCH_EXYNOS) += exynos7870-gtaxlwifi.dtb
+dtb-$(CONFIG_ARCH_EXYNOS) += exynos7870-gtaxlwifi-decon.dtb
diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts
new file mode 100644
index 0000000000..f20ebb48de
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab A 10.1 (2016) - SM-T580 - "gtaxlwifi"
+ * Variante con il display nativo: DECON + DSI + pannello HX8279D.
+ *
+ * Questo file include il DTS base e ne cambia solo la parte display.
+ * Tutto il resto (memoria, PMIC, eMMC, touch, batteria, pinctrl) resta
+ * definito in un posto solo: se cambi il base, cambia anche questo.
+ *
+ * Il DTB base resta quello da usare finche' il pannello non funziona:
+ * simpledrm e DECON attivi insieme sullo stesso buffer sono un
+ * conflitto, non un ripiego. Due DTB, due voci in extlinux.conf.
+ *
+ * ATTENZIONE: U-Boot compila il DTS base (CONFIG_OF_LIST). Questo file
+ * serve solo al kernel; non aggiungerlo alla lista di U-Boot, che non
+ * ha i binding del pannello.
+ */
+
+#include "exynos7870-gtaxlwifi.dts"
+
+/*
+ * Via il framebuffer di S-BOOT esposto a simpledrm. Il DECON prende in
+ * carico la stessa memoria attraverso memory-region, qui sotto.
+ */
+/delete-node/ &framebuffer0;
+
+/ {
+	model = "Samsung Galaxy Tab A 10.1 (2016) (DECON)";
+
+	/*
+	 * Alimentazione del pannello, lato "alto". Il downstream
+	 * (decon_board, gpio_buck_en) accende un DC-DC esterno con
+	 * gpd3-4 e aspetta 15 ms; non e' un LDO del PMIC.
+	 *
+	 * DA CONFERMARE: la tensione reale. Il valore qui serve solo a
+	 * soddisfare regulator_is_supported_voltage() nel driver, che
+	 * pretende vdd fra 3,0 e 5,0 V; non viene programmato nulla,
+	 * il regolatore e' un semplice interruttore su GPIO.
+	 */
+	lcd_buck: regulator-lcd-buck {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_lcd_buck";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpd3 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-enable-ramp-delay = <15000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_buck_en>;
+	};
+};
+
+/*
+ * Handoff dal framebuffer del bootloader, meccanismo preso da
+ * exynos7870-j6lte.dts: la regione riservata resta no-map e in piu'
+ * dichiara l'identity mapping nell'IOMMU del DECON, cosi' il blocco non
+ * fa page fault fra il probe e il primo modeset.
+ *
+ * fb_mem e' gia' definito nel DTS base a 0x67000000 con la dimensione
+ * giusta: qui basta aggiungere la proprieta'.
+ *
+ * Dopo la compilazione ricontrolla il risultato, che la sintassi di
+ * iommu-addresses e' facile da sbagliare in silenzio:
+ *   dtc -I dtb -O dts exynos7870-gtaxlwifi-decon.dtb | grep -A3 iommu-add
+ */
+&fb_mem {
+	iommu-addresses = <&decon 0x67000000 (1200 * 1920 * 4)>;
+};
+
+&decon {
+	memory-region = <&fb_mem>;
+
+	status = "okay";
+};
+
+/*
+ * samsung-dsim ricava PMS da burst-clock-frequency. Il downstream
+ * dichiara pms = <3 226 1> con riferimento a 26 MHz, che da'
+ * 26 x 226 / (3 x 2^1) = 979,3 MHz: coerente con i 980 Mbps/lane del
+ * nodo hx8279d_wuxga (timing,dsi-hs-clk = 980).
+ *
+ * 980 Mbps x 4 lane = 3,92 Gbps contro i 3,83 richiesti a 24 bpp.
+ */
+&dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,burst-clock-frequency = <980000000>;
+	samsung,esc-clock-frequency = <16000000>;
+	samsung,pll-clock-frequency = <26000000>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "boe,hx8279d-gtaxl";
+		reg = <0>;
+
+		/*
+		 * vdd  = DC-DC esterno su gpd3-4  (buck_en downstream)
+		 * iovcc = LDO35 del PMIC, "LCD_1P8" a 1,8 V
+		 */
+		vdd-supply = <&lcd_buck>;
+		iovcc-supply = <&vdd_ldo35>;
+
+		/*
+		 * Il driver porta reset_gpio a 1 e SUBITO DOPO parla in
+		 * DSI: in questo driver il valore logico 1 significa
+		 * "reset rilasciato". Il downstream rilascia portando il
+		 * pin alto, quindi ACTIVE_HIGH.
+		 */
+		reset-gpios = <&gpd4 1 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_rst>;
+	};
+};
+
+/*
+ * Ora il pannello ha un consumatore vero: il regolatore non deve piu'
+ * restare acceso per forza, altrimenti unprepare() non spegne niente e
+ * i ~230 mA a schermo spento restano.
+ */
+&vdd_ldo35 {
+	/delete-property/ regulator-always-on;
+};
+
+/*
+ * gpd3 e gpd4 stanno sotto pinctrl_top, come bt_enable ("gpd4-0") e
+ * wlan_enable ("gpd3-6") nel J6.
+ *
+ * Nessun samsung,pin-val: i pin arrivano gia' configurati da S-BOOT col
+ * pannello acceso, e il driver li prende con GPIOD_ASIS proprio per non
+ * interrompere l'immagine del bootloader prima del primo modeset.
+ */
+&pinctrl_top {
+	lcd_rst: lcd-rst-pins {
+		samsung,pins = "gpd4-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	lcd_buck_en: lcd-buck-en-pins {
+		samsung,pins = "gpd3-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
-- 
