From 10976ad40016bfc24d431f77d6c525a2cb8ebf64 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 10 Sep 2026 08:40:38 +0000
Subject: [PATCH] drm/panel: himax-hx8279: add two probes for the wake-up
 stripes

One wake-up in about ten comes back with single-line horizontal stripes
over the whole panel, in a different place each time and flickering near
the top, while the DSI sequence in dmesg and all 256 DSIM and DECON
registers are identical to a good wake-up, every write is accepted and
the reset line is really toggled. The difference is inside the DriverIC,
and it cannot be read back: DCS reads time out on this link (-110), the
same reason the module id read is off by default.

So offer two things that can be tried while the bad image is on screen,
as write-only module parameters: redo_display_on sends display off, a
pause and display on again; redo_init sends the whole init table again.
Both take the page lock and do nothing unless the panel is prepared.

If the stripes clear on the first, the DriverIC holds the right
configuration and locked onto the video stream at a bad phase - the
vendor driver turns the display on only after the controller has been
started, which mainline cannot do from panel enable(). If only the
second clears them, part of the init table did not take. Nothing runs
unless something is written to the parameters.
---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 76 ++++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index d680d5ced6..f113054339 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -961,6 +961,81 @@ static int hx8279_enable(struct drm_panel *panel)
 	return 0;
 }
 
+/*
+ * Diagnostics for the wake-up stripes. The panel cannot be read back
+ * (DCS reads time out on this link), so instead offer two things that
+ * can be tried while the bad image is on screen:
+ *
+ *   echo 1 > /sys/module/panel_himax_hx8279/parameters/redo_display_on
+ *   echo 1 > /sys/module/panel_himax_hx8279/parameters/redo_init
+ *
+ * If the stripes clear on the first, the DriverIC is configured
+ * correctly and locked onto the video stream at a bad phase; if only
+ * the second clears them, part of the init table did not take.
+ */
+static struct hx8279 *hx8279_live;
+
+static int hx8279_redo_display_on_set(const char *val,
+				      const struct kernel_param *kp)
+{
+	struct hx8279 *hx = hx8279_live;
+
+	if (!hx)
+		return -ENODEV;
+
+	guard(mutex)(&hx->page_lock);
+
+	if (!hx->prepared)
+		return -EIO;
+
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = hx->dsi[0] };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 40);
+
+	dev_info(&hx->dsi[0]->dev, "redo: display off/on, err %d\n",
+		 dsi_ctx.accum_err);
+
+	return dsi_ctx.accum_err;
+}
+
+static int hx8279_redo_init_set(const char *val,
+				const struct kernel_param *kp)
+{
+	struct hx8279 *hx = hx8279_live;
+	int ret;
+
+	if (!hx)
+		return -ENODEV;
+
+	guard(mutex)(&hx->page_lock);
+
+	if (!hx->prepared)
+		return -EIO;
+
+	ret = hx8279_on(hx);
+
+	dev_info(&hx->dsi[0]->dev, "redo: init table, err %d, last_page %u\n",
+		 ret, hx->last_page);
+
+	return ret;
+}
+
+static const struct kernel_param_ops hx8279_redo_display_on_ops = {
+	.set = hx8279_redo_display_on_set,
+};
+
+static const struct kernel_param_ops hx8279_redo_init_ops = {
+	.set = hx8279_redo_init_set,
+};
+
+module_param_cb(redo_display_on, &hx8279_redo_display_on_ops, NULL, 0200);
+MODULE_PARM_DESC(redo_display_on, "Send display off and display on again");
+module_param_cb(redo_init, &hx8279_redo_init_ops, NULL, 0200);
+MODULE_PARM_DESC(redo_init, "Send the whole init table again");
+
 static int hx8279_prepare(struct drm_panel *panel)
 {
 	struct hx8279 *hx = to_hx8279(panel);
@@ -1473,6 +1548,7 @@ static int hx8279_probe(struct mipi_dsi_device *dsi)
 
 	hx->dsi[0] = dsi;
 	mipi_dsi_set_drvdata(dsi, hx);
+	hx8279_live = hx;
 
 	/*
 	 * The whole DriverIC configuration is sent from prepare(), so the
-- 
