From 67c5a912b581d8a684735cc93883af4966417b34 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 29 Sep 2026 15:58:11 +0200
Subject: [PATCH] ASoC: samsung: gtaxl: suspend the card with the system

Without the card's PM ops, snd_soc_suspend() never runs: the delayed
DAPM power-down work is not flushed and can run in the middle of an
s2idle suspend, writing to the codec after its I2C controller has been
suspended:

  i2c i2c-5: Transfer while suspended
  WARNING: drivers/i2c/i2c-core.h:57 at __i2c_transfer+0xb4/0x90c
  Workqueue: events_power_efficient close_delayed_work [snd_soc_core]
  rt5659 5-001b: ASoC error (-108): at snd_soc_component_update_bits()

The writes are lost and the codec's power state no longer matches the
DAPM state. Use snd_soc_pm_ops like the other Samsung machine drivers.

---
 sound/soc/samsung/gtaxl_rt5659.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/soc/samsung/gtaxl_rt5659.c b/sound/soc/samsung/gtaxl_rt5659.c
index 06addf7abb..aecadef31d 100644
--- a/sound/soc/samsung/gtaxl_rt5659.c
+++ b/sound/soc/samsung/gtaxl_rt5659.c
@@ -370,6 +370,7 @@ static struct platform_driver gtaxl_audio_driver = {
 	.driver = {
 		.name		= "gtaxl-audio",
 		.of_match_table	= gtaxl_audio_of_match,
+		.pm		= &snd_soc_pm_ops,
 	},
 	.probe = gtaxl_audio_probe,
 };
