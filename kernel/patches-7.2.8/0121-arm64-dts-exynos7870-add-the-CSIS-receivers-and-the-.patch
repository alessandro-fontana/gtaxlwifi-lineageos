From 2889ba0f418cc63a80e465216c2843dd0b1bf5cc Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 13:32:36 +0200
Subject: [PATCH] arm64: dts: exynos7870: add the CSIS receivers and the ISP
 SysMMU

CSIS0 and CSIS1 (MIPI CSI-2 receivers v4.1, with DMA) and the SysMMU
that translates their write masters (sysmmu_isp0 at 0x14470000).
Addresses, interrupts and PHY indexes from the vendor device tree.

---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 45 ++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index 783a7467eb..7df2d484d8 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -886,6 +886,51 @@ wakeup-interrupt-controller {
 			};
 		};
 
+		csis0: csis@14420000 {
+			compatible = "samsung,exynos7870-csis";
+			reg = <0x14420000 0x10000>;
+			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>,
+				 <&cmu_isp CLK_GOUT_ISP_CAM_HALF>;
+			clock-names = "aclk", "pclk";
+
+			phys = <&mipi_phy 0>;
+			phy-names = "csis";
+
+			iommus = <&sysmmu_isp0>;
+
+			status = "disabled";
+		};
+
+		csis1: csis@14460000 {
+			compatible = "samsung,exynos7870-csis";
+			reg = <0x14460000 0x10000>;
+			interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>,
+				 <&cmu_isp CLK_GOUT_ISP_CAM_HALF>;
+			clock-names = "aclk", "pclk";
+
+			phys = <&mipi_phy 2>;
+			phy-names = "csis";
+
+			iommus = <&sysmmu_isp0>;
+
+			status = "disabled";
+		};
+
+		/* The write masters of both CSIS DMA engines sit behind it. */
+		sysmmu_isp0: iommu@14470000 {
+			compatible = "samsung,exynos-sysmmu";
+			reg = <0x14470000 0x1000>;
+			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <0>;
+
+			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>;
+			clock-names = "sysmmu";
+		};
+
 		cmu_isp: clock-controller@144d0000 {
 			compatible = "samsung,exynos7870-cmu-isp";
 			reg = <0x144d0000 0x1000>;
-- 
2.47.3

