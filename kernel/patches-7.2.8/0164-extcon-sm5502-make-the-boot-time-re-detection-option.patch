From 29f8fde0df6e2bd22785398dc7c790fdfc054cfb Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 28 Sep 2026 17:51:41 +0200
Subject: [PATCH] extcon: sm5502: make the boot-time re-detection optional

The reset in the boot-time work, which makes the chip classify a cable
that was present at boot, opens the USB switch for a moment: every USB
session open at that point drops. In a recovery sideloading an update
over adb this kills the transfer ("UsbFfs: connection terminated") when
the reset lands 19 s after boot, in the middle of it.

Add extcon_sm5502.boot_redetect, default on. The recovery turns it off.
Moving the reset earlier instead does not work: done 0.3 s after probe
the chip classifies a CDP as an SDP again.

---
 drivers/extcon/extcon-sm5502.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/drivers/extcon/extcon-sm5502.c b/drivers/extcon/extcon-sm5502.c
index d6088abea4..f218de4e0c 100644
--- a/drivers/extcon/extcon-sm5502.c
+++ b/drivers/extcon/extcon-sm5502.c
@@ -21,6 +21,11 @@
 
 #define	DELAY_MS_DEFAULT		17000	/* unit: millisecond */
 
+static bool boot_redetect = true;
+module_param(boot_redetect, bool, 0444);
+MODULE_PARM_DESC(boot_redetect,
+		 "Reset the chip in the boot-time work so a cable present at boot is classified again (drops the USB link once)");
+
 struct muic_irq {
 	unsigned int irq;
 	const char *name;
@@ -718,8 +723,17 @@ static void sm5502_muic_detect_cable_wq(struct work_struct *work)
 	 * to enumerate, and put the configuration back afterwards: the reset
 	 * clears the interrupt masks along with everything else.
 	 */
-	regmap_write(info->regmap, SM5502_REG_RESET, SM5502_REG_RESET_MASK);
-	sm5502_init_dev_type(info);
+	/*
+	 * The reset opens the USB switch for a moment and every USB session
+	 * open at that point drops. Where that matters more than the charging
+	 * current - a recovery sideloading an update over adb - it can be
+	 * turned off with extcon_sm5502.boot_redetect=0. Done earlier instead,
+	 * 0.3 s after probe, the chip classifies a CDP as an SDP again.
+	 */
+	if (boot_redetect) {
+		regmap_write(info->regmap, SM5502_REG_RESET, SM5502_REG_RESET_MASK);
+		sm5502_init_dev_type(info);
+	}
 
 	/* Notify the state of connector cable or not  */
 	ret = sm5502_muic_cable_handler(info, true);
-- 
2.47.3

