 				vb2_buffer_done(&mb_entry->b->vb2_buf,
@@ -1319,6 +1322,8 @@ static int enc_post_frame_start(struct s5p_mfc_ctx *ctx)
 			mb_entry->b->flags |= V4L2_BUF_FLAG_BFRAME;
 			break;
 		}
