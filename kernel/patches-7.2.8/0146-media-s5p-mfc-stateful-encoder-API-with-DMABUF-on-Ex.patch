From 58b11769ff30702c81bccca1757bf3205427a6b7 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 12:50:12 +0200
Subject: [PATCH] media: s5p-mfc: stateful encoder API with DMABUF on
 Exynos7870

Android's Codec2 V4L2 encoder (external/v4l2_codec2) drives the MFC
through the stateful encoder API with buffers imported from gralloc.
Fill in what it relies on:

- G/S_SELECTION on the OUTPUT queue: the crop is the whole picture,
  which is what the MFC encodes;
- ENUM_FRAMESIZES for the coded formats;
- the timestamp of the encoded source frame is copied to the bitstream
  buffer, which is how the client matches it to its request;
- the buffer returned when the stream completes carries
  V4L2_BUF_FLAG_LAST, or the next CAPTURE buffer queued does if none
  was available, and ENC_CMD_START resumes after a drain;
- NV12M planes that share one dmabuf: the chroma address honours the
  plane's data_offset, and buf_prepare checks that what the MFC reads
  (whole macroblocks and padding) fits in the dmabuf, since a read
  past the mapping is a SysMMU fault;
- portrait input (camera recordings rotated for a portrait screen) up
  to 1080x1920, the macroblock count of 1080p, and ENUM_FRAMESIZES
  covers both orientations;
- the pitch the client asks for in S_FMT, when wider than the MFC
  needs (gralloc aligns NV12 to 32), goes to the stride registers and
  the plane sizes;
- H.264 levels up to 5.1, and the profile menu skips the profiles the
  driver rejects;
- FORCE_KEY_FRAME and FORCE_FRAME_TYPE are written to
  E_FRAME_INSERTION for the next picture;
- PREPEND_SPSPPS_TO_IDR also applies to H.264;
- the encoder keeps going after the sequence header when frames are
  already queued; the codec buffers it then allocates need process
  context (an IOMMU allocation remaps with vmalloc), so try_run from
  the interrupt handler hands that step to a worker;
- the CAPTURE queue is bidirectional, and DST_QUEUE_OFF_BASE is only
  added for MMAP buffers.

---
 .../media/platform/samsung/s5p-mfc/s5p_mfc.c  |  22 +++
 .../platform/samsung/s5p-mfc/s5p_mfc_common.h |  20 +++
 .../platform/samsung/s5p-mfc/s5p_mfc_enc.c    | 170 ++++++++++++++++--
 .../platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c |  22 ++-
 4 files changed, 217 insertions(+), 17 deletions(-)

diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
index 2b48230bc0..7899a8140d 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
@@ -163,6 +163,14 @@ static void s5p_mfc_watchdog(struct timer_list *t)
 	add_timer(&dev->watchdog_timer);
 }
 
+static void s5p_mfc_run_worker(struct work_struct *work)
+{
+	struct s5p_mfc_dev *dev = container_of(work, struct s5p_mfc_dev,
+					       run_work);
+
+	s5p_mfc_hw_call(dev->mfc_ops, try_run, dev);
+}
+
 static void s5p_mfc_watchdog_worker(struct work_struct *work)
 {
 	struct s5p_mfc_dev *dev;
@@ -585,6 +593,11 @@ static void s5p_mfc_handle_seq_done(struct s5p_mfc_ctx *ctx,
 	}
 	s5p_mfc_hw_call(dev->mfc_ops, clear_int_flags, dev);
 	clear_work_bit(ctx);
+	/* The encoder goes on with the frames already queued. */
+	if (ctx->type == MFCINST_ENCODER &&
+	    ctx->state == MFCINST_HEAD_PRODUCED &&
+	    ctx->src_queue_cnt >= 1 && ctx->dst_queue_cnt >= 1)
+		set_work_bit(ctx);
 	WARN_ON(test_and_clear_bit(0, &dev->hw_lock) == 0);
 	s5p_mfc_clock_off(dev);
 	s5p_mfc_hw_call(dev->mfc_ops, try_run, dev);
@@ -652,7 +665,12 @@ static void s5p_mfc_handle_stream_complete(struct s5p_mfc_ctx *ctx)
 		list_del(&mb_entry->list);
 		ctx->dst_queue_cnt--;
 		vb2_set_plane_payload(&mb_entry->b->vb2_buf, 0, 0);
+		if (ctx->type == MFCINST_ENCODER)
+			mb_entry->b->flags |= V4L2_BUF_FLAG_LAST;
 		vb2_buffer_done(&mb_entry->b->vb2_buf, VB2_BUF_STATE_DONE);
+	} else if (ctx->type == MFCINST_ENCODER) {
+		/* Given with the next CAPTURE buffer queued. */
+		ctx->enc_last_pending = true;
 	}
 
 	clear_work_bit(ctx);
@@ -912,6 +930,8 @@ static int s5p_mfc_open(struct file *file)
 	} else if (vdev == dev->vfd_enc) {
 		q->io_modes = VB2_MMAP | VB2_USERPTR | VB2_DMABUF;
 		q->ops = get_enc_queue_ops();
+		/* A fault on a stream buffer is a panic: map it readable too. */
+		q->bidirectional = 1;
 	} else {
 		ret = -ENOENT;
 		goto err_queue_init;
@@ -1402,6 +1422,7 @@ static int s5p_mfc_probe(struct platform_device *pdev)
 	init_waitqueue_head(&dev->queue);
 	dev->hw_lock = 0;
 	INIT_WORK(&dev->watchdog_work, s5p_mfc_watchdog_worker);
+	INIT_WORK(&dev->run_work, s5p_mfc_run_worker);
 	atomic_set(&dev->watchdog_cnt, 0);
 	timer_setup(&dev->watchdog_timer, s5p_mfc_watchdog, 0);
 
@@ -1518,6 +1539,7 @@ static void s5p_mfc_remove(struct platform_device *pdev)
 
 	timer_delete_sync(&dev->watchdog_timer);
 	flush_work(&dev->watchdog_work);
+	cancel_work_sync(&dev->run_work);
 
 	video_unregister_device(dev->vfd_enc);
 	video_unregister_device(dev->vfd_dec);
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
index a37214448e..f01e61f44e 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
@@ -342,6 +342,8 @@ struct s5p_mfc_dev {
 	struct timer_list watchdog_timer;
 	struct workqueue_struct *watchdog_workqueue;
 	struct work_struct watchdog_work;
+	/* try_run from process context, for steps that allocate memory. */
+	struct work_struct run_work;
 	unsigned long enter_suspend;
 
 	struct s5p_mfc_priv_buf ctx_buf;
@@ -728,6 +730,13 @@ struct s5p_mfc_ctx {
 	size_t tmv_buffer_size;
 
 	enum v4l2_mpeg_mfc51_video_force_frame_type force_frame_type;
+	/*
+	 * Stateful encoder API: the LAST buffer owed to a client that had
+	 * no CAPTURE buffer queued when the stream completed, and the
+	 * timestamp of the last source frame, for the bitstream buffers.
+	 */
+	bool enc_last_pending;
+	u64 enc_last_ts;
 
 	struct list_head ref_queue;
 	unsigned int ref_queue_cnt;
@@ -824,4 +833,15 @@ void s5p_mfc_cleanup_queue(struct list_head *lh, struct vb2_queue *vq);
 
 #define MFC_V10PLUS_BITS	(MFC_V10_BIT | MFC_V12_BIT)
 
+/*
+ * Encoder source planes: Android hands in one dmabuf for both NV12M planes,
+ * with the chroma at data_offset of the second one.
+ */
+static inline dma_addr_t s5p_mfc_src_plane_addr(struct vb2_buffer *vb,
+						unsigned int plane)
+{
+	return vb2_dma_contig_plane_dma_addr(vb, plane) +
+	       vb->planes[plane].data_offset;
+}
+
 #endif /* S5P_MFC_COMMON_H_ */
