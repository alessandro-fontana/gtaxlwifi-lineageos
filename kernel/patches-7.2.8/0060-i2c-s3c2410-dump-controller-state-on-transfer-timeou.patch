From 45c96401cfe093e627181586eed2aeaae14ded66 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:53 +0000
Subject: [PATCH] i2c: s3c2410: dump controller state on transfer timeout

Diagnostic only, no behavioural change.  On gtaxlwifi one of the nine
i2c controllers (0x13880000, the codec bus) never completes a transfer:
the driver writes START and the address, then no interrupt is ever
raised and the 5 second wait expires.  The pads themselves are fine -
driven as GPIO both lines follow high and low - so the failure is
inside the IP, which is unreadable from userspace because the PCLK is
gated between transfers.

Print IICCON, IICSTAT, IICDS, IICADD and the driver state machine
counters when the wait times out, while the clock is still enabled.
---
 drivers/i2c/busses/i2c-s3c2410.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/i2c/busses/i2c-s3c2410.c b/drivers/i2c/busses/i2c-s3c2410.c
index 15e14a6fe6..42f9821590 100644
--- a/drivers/i2c/busses/i2c-s3c2410.c
+++ b/drivers/i2c/busses/i2c-s3c2410.c
@@ -728,10 +728,18 @@ static int s3c24xx_i2c_doxfer(struct s3c24xx_i2c *i2c,
 	 * Having these next two as dev_err() makes life very
 	 * noisy when doing an i2cdetect
 	 */
-	if (time_left == 0)
+	if (time_left == 0) {
 		dev_dbg(i2c->dev, "timeout\n");
-	else if (ret != num)
+		dev_warn(i2c->dev,
+			 "timeout: IICCON=%#04x IICSTAT=%#04x IICDS=%#04x IICADD=%#04x state=%d msg_idx=%d msg_num=%d\n",
+			 readl(i2c->regs + S3C2410_IICCON),
+			 readl(i2c->regs + S3C2410_IICSTAT),
+			 readl(i2c->regs + S3C2410_IICDS),
+			 readl(i2c->regs + S3C2410_IICADD),
+			 i2c->state, i2c->msg_idx, i2c->msg_num);
+	} else if (ret != num) {
 		dev_dbg(i2c->dev, "incomplete xfer (%d)\n", ret);
+	}
 
 	/* For QUIRK_HDMIPHY, bus is already disabled */
 	if (i2c->quirks & QUIRK_HDMIPHY)
-- 
