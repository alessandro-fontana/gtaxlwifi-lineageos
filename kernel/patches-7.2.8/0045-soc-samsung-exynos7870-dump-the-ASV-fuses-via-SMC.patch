From 06dcece650f246ff029ac3cc765396a5c7633b2a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:48 +0000
Subject: [PATCH] soc: samsung: exynos7870: dump the ASV fuses via SMC

I fuse ASV a 0x100D9000 sono leggibili solo dal secure world
(external abort dal normal world). Replica exynos_smc_readsfr()
del downstream e stampa in dmesg le 8 parole e la decodifica G3D.
Diagnostica: rimovibile una volta letti i valori.
---
 drivers/soc/samsung/Makefile              |  3 +
 drivers/soc/samsung/exynos7870-asv-dump.c | 68 +++++++++++++++++++++++
 2 files changed, 71 insertions(+)
 create mode 100644 drivers/soc/samsung/exynos7870-asv-dump.c

diff --git a/drivers/soc/samsung/Makefile b/drivers/soc/samsung/Makefile
index 636a762608..8defd84c05 100644
--- a/drivers/soc/samsung/Makefile
+++ b/drivers/soc/samsung/Makefile
@@ -14,3 +14,6 @@ obj-$(CONFIG_EXYNOS_PMU_ARM_DRIVERS)	+= exynos3250-pmu.o exynos4-pmu.o \
 obj-$(CONFIG_EXYNOS_REGULATOR_COUPLER) += exynos-regulator-coupler.o
 
 obj-$(CONFIG_SAMSUNG_PM_CHECK)	+= s3c-pm-check.o
+
+# gtaxlwifi: dump diagnostico dei fuse ASV via SMC (vedi 0070)
+obj-y				+= exynos7870-asv-dump.o
diff --git a/drivers/soc/samsung/exynos7870-asv-dump.c b/drivers/soc/samsung/exynos7870-asv-dump.c
new file mode 100644
index 0000000000..4360ebc6e5
--- /dev/null
+++ b/drivers/soc/samsung/exynos7870-asv-dump.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * exynos7870-asv-dump.c — dump dei fuse ASV dell'Exynos 7870 via SMC.
+ *
+ * I fuse ASV (0x100D9000, struct asv_tbl_info del downstream) sono
+ * leggibili solo dal secure world: una lettura diretta dal normal world
+ * produce un external abort. Il kernel Samsung li legge con
+ * exynos_smc_readsfr() (arch/arm64/kernel/exynos-smc.S):
+ *   x0 = SMC_CMD_REG        = (u32)-101 = 0xFFFFFF9B
+ *   x1 = SMC_REG_CLASS_SFR_R | (addr >> 2)   (classe 0x3 << 30)
+ *   ritorno: x0 = stato (0 = ok), x2 = valore
+ * Qui si replica la stessa chiamata e si stampano le prime 8 parole,
+ * piu' la decodifica dei campi G3D e della versione tabella.
+ *
+ * Collocazione: drivers/soc/samsung/exynos7870-asv-dump.c
+ * Makefile (stessa directory):  obj-y += exynos7870-asv-dump.o
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/arm-smccc.h>
+
+#define SMC_CMD_REG		0xFFFFFF9BUL
+#define SMC_SFR_R(addr)		(0xC0000000UL | ((unsigned long)(addr) >> 2))
+
+#define ASV_INFO_ADDR_BASE	0x100D9000UL
+#define ASV_WORDS		8
+
+static int __init exynos7870_asv_dump(void)
+{
+	struct arm_smccc_res res;
+	unsigned long w[ASV_WORDS];
+	unsigned int g, grp, ssa10, ssa11, ssa0, ver, fused;
+	int mod, i;
+
+	for (i = 0; i < ASV_WORDS; i++) {
+		unsigned long addr = ASV_INFO_ADDR_BASE + 4UL * i;
+
+		arm_smccc_smc(SMC_CMD_REG, SMC_SFR_R(addr), 0, 0,
+			      0, 0, 0, 0, &res);
+		if (res.a0) {
+			pr_info("asv-dump: word%d @ %#lx: SMC status %ld\n",
+				i, addr, (long)res.a0);
+			return 0;
+		}
+		w[i] = res.a2;
+		pr_info("asv-dump: word%d = 0x%08lx\n", i, w[i]);
+	}
+
+	/* word1[15:0] = G3D; word3[6:0] = table_ver, word3[7] = fused */
+	g     = w[1] & 0xFFFF;
+	mod   = (g >> 4) & 0xF;
+	if (mod >= 8)
+		mod -= 16;
+	grp   = (g & 0xF) + mod;
+	ssa10 = (g >> 8) & 0x3;
+	ssa11 = (g >> 10) & 0x3;
+	ssa0  = (g >> 12) & 0xF;
+	ver   = w[3] & 0x7F;
+	fused = (w[3] >> 7) & 0x1;
+
+	pr_info("asv-dump: g3d: group %u%+d -> %u, ssa10 %u, ssa11 %u, ssa0 %u\n",
+		g & 0xF, mod, grp, ssa10, ssa11, ssa0);
+	pr_info("asv-dump: asv_table_ver %u, fused_grp %u\n", ver, fused);
+
+	return 0;
+}
+late_initcall(exynos7870_asv_dump);
-- 
2.47.3

