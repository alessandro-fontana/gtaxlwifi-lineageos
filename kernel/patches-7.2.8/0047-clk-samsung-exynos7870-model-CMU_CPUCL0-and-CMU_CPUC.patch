From 1726108fa4072cd9fa7a2ae825585a94346c3158 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:48 +0000
Subject: [PATCH] clk: samsung: exynos7870: model CMU_CPUCL0 and CMU_CPUCL1

Model the two CPU cluster CMUs (CPUCL0 @ 0x10900000, CPUCL1 @ 0x10800000,
note the inverted address order) after the existing CMU_G3D block, plus the
CLKCMU_CPUCL0/1_SWITCH divider+gate pair in CMU_MIF (0x458/0x45c and
0x858/0x85c, twins of the G3D switch already modelled).

Registers, mux/div/gate topology and bit positions verified against the
downstream pwrcal (S5E7870-cmu.c, S5E7870-cmusfr.h) and against a live
register dump on kernel #41 (S-BOOT boot state: both PLLs at 902.2 MHz
M=347/P=5/S=1, CLK_CPUCLx mux on the PLL branch, MUX_STAT convention
sel+1, all dividers at their ECT level-independent values).

Inert by itself: no consumer, no rate change. After boot, clk_summary
must show fout_cpucl0_pll and fout_cpucl1_pll at 902200000 and nothing
else may change.

dt-bindings: MIF IDs appended out of alphabetical order (129-132) to
preserve the existing numbering; the new CPUCL0/CPUCL1 sections follow
the file's alphabetical convention.

v2: the dt-bindings header is now part of this patch (it replaces the
apply-0073-bindings.sh helper script, which is obsolete: do not run it).

TODO before any OPP above/below 902.2 MHz: fill the remaining 16 P/M/S
tuples of cpucl_pll_rates[] from the decoded ECT PLL block.
---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi    |  41 +++
 drivers/clk/samsung/clk-exynos7870.c          | 327 ++++++++++++++++++
 .../clock/samsung,exynos7870-cmu.h            |  49 ++-
 3 files changed, 416 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index fd45a6185a..da6c64b010 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -193,6 +193,47 @@ cmu_mif: clock-controller@10460000 {
 			clocks = <&oscclk>;
 		};
 
+		/*
+		 * CMU dei cluster CPU. Nota l'ordine degli indirizzi: CPUCL1
+		 * sta a 0x10800000, SOTTO CPUCL0 (0x10900000) - verificato sul
+		 * silicio (dump registri, kernel #41) e in S5E7870-sfrbase.h.
+		 *
+		 * assigned-clocks: S-BOOT lascia il mux utente del ramo switch
+		 * su OSCCLK (sel=0). Il ramo switch e' il parcheggio di clk-cpu
+		 * durante il rilock del PLL: senza questo assegnamento il primo
+		 * cambio frequenza parcheggerebbe i core a 26 MHz invece che a
+		 * 800 MHz dal BUS_PLL del MIF.
+		 */
+		cmu_cpucl1: clock-controller@10800000 {
+			compatible = "samsung,exynos7870-cmu-cpucl1";
+			reg = <0x10800000 0x1000>;
+			#clock-cells = <1>;
+
+			clock-names = "oscclk", "switch";
+			clocks = <&oscclk>,
+				 <&cmu_mif CLK_GOUT_MIF_CMU_CPUCL1_SWITCH>;
+
+			assigned-clocks =
+				<&cmu_cpucl1 CLK_MOUT_CPUCL1_SWITCH_USER>;
+			assigned-clock-parents =
+				<&cmu_mif CLK_GOUT_MIF_CMU_CPUCL1_SWITCH>;
+		};
+
+		cmu_cpucl0: clock-controller@10900000 {
+			compatible = "samsung,exynos7870-cmu-cpucl0";
+			reg = <0x10900000 0x1000>;
+			#clock-cells = <1>;
+
+			clock-names = "oscclk", "switch";
+			clocks = <&oscclk>,
+				 <&cmu_mif CLK_GOUT_MIF_CMU_CPUCL0_SWITCH>;
+
+			assigned-clocks =
+				<&cmu_cpucl0 CLK_MOUT_CPUCL0_SWITCH_USER>;
+			assigned-clock-parents =
+				<&cmu_mif CLK_GOUT_MIF_CMU_CPUCL0_SWITCH>;
+		};
+
 		pmu_system_controller: system-controller@10480000 {
 			compatible = "samsung,exynos7870-pmu",
 				     "samsung,exynos7-pmu", "syscon";
diff --git a/drivers/clk/samsung/clk-exynos7870.c b/drivers/clk/samsung/clk-exynos7870.c
index 9481512f46..cd8e62313e 100644
--- a/drivers/clk/samsung/clk-exynos7870.c
+++ b/drivers/clk/samsung/clk-exynos7870.c
@@ -85,6 +85,8 @@
 #define CLK_CON_DIV_MIF_BUSD				0x0420
 #define CLK_CON_DIV_MIF_APB				0x0424
 #define CLK_CON_DIV_MIF_HSI2C				0x0430
+#define CLK_CON_DIV_MIF_CMU_CPUCL0_SWITCH		0x0458
+#define CLK_CON_DIV_MIF_CMU_CPUCL1_SWITCH		0x045c
 #define CLK_CON_DIV_MIF_CMU_G3D_SWITCH			0x0460
 #define CLK_CON_DIV_MIF_CMU_ISP_VRA			0x0464
 #define CLK_CON_DIV_MIF_CMU_ISP_CAM			0x0468
@@ -123,6 +125,8 @@
 #define CLK_CON_GAT_MIF_CP_PCLK_HSI2C			0x0840
 #define CLK_CON_GAT_MIF_CP_PCLK_HSI2C_BAT_0		0x0840
 #define CLK_CON_GAT_MIF_CP_PCLK_HSI2C_BAT_1		0x0840
+#define CLK_CON_GAT_MIF_CMU_CPUCL0_SWITCH		0x0858
+#define CLK_CON_GAT_MIF_CMU_CPUCL1_SWITCH		0x085c
 #define CLK_CON_GAT_MIF_CMU_G3D_SWITCH			0x0860
 #define CLK_CON_GAT_MIF_CMU_ISP_VRA			0x0864
 #define CLK_CON_GAT_MIF_CMU_ISP_CAM			0x0868
@@ -218,6 +222,8 @@ static const unsigned long mif_clk_regs[] __initconst = {
 	CLK_CON_DIV_MIF_BUSD,
 	CLK_CON_DIV_MIF_APB,
 	CLK_CON_DIV_MIF_HSI2C,
+	CLK_CON_DIV_MIF_CMU_CPUCL0_SWITCH,
+	CLK_CON_DIV_MIF_CMU_CPUCL1_SWITCH,
 	CLK_CON_DIV_MIF_CMU_G3D_SWITCH,
 	CLK_CON_DIV_MIF_CMU_ISP_VRA,
 	CLK_CON_DIV_MIF_CMU_ISP_CAM,
@@ -256,6 +262,8 @@ static const unsigned long mif_clk_regs[] __initconst = {
 	CLK_CON_GAT_MIF_CP_PCLK_HSI2C,
 	CLK_CON_GAT_MIF_CP_PCLK_HSI2C_BAT_0,
 	CLK_CON_GAT_MIF_CP_PCLK_HSI2C_BAT_1,
+	CLK_CON_GAT_MIF_CMU_CPUCL0_SWITCH,
+	CLK_CON_GAT_MIF_CMU_CPUCL1_SWITCH,
 	CLK_CON_GAT_MIF_CMU_G3D_SWITCH,
 	CLK_CON_GAT_MIF_CMU_ISP_VRA,
 	CLK_CON_GAT_MIF_CMU_ISP_CAM,
@@ -423,6 +431,12 @@ static const struct samsung_mux_clock mif_mux_clks[] __initconst = {
 };
 
 static const struct samsung_div_clock mif_div_clks[] __initconst = {
+	DIV(CLK_DOUT_MIF_CMU_CPUCL0_SWITCH, "dout_mif_cmu_cpucl0_switch",
+	    "ffac_mif_mux_bus_pll_div2", CLK_CON_DIV_MIF_CMU_CPUCL0_SWITCH, 0,
+	    2),
+	DIV(CLK_DOUT_MIF_CMU_CPUCL1_SWITCH, "dout_mif_cmu_cpucl1_switch",
+	    "ffac_mif_mux_bus_pll_div2", CLK_CON_DIV_MIF_CMU_CPUCL1_SWITCH, 0,
+	    2),
 	DIV(CLK_DOUT_MIF_CMU_DISPAUD_BUS, "dout_mif_cmu_dispaud_bus",
 	    "gout_mif_mux_cmu_dispaud_bus", CLK_CON_DIV_MIF_CMU_DISPAUD_BUS, 0,
 	    4),
@@ -496,6 +510,12 @@ static const struct samsung_div_clock mif_div_clks[] __initconst = {
 };
 
 static const struct samsung_gate_clock mif_gate_clks[] __initconst = {
+	GATE(CLK_GOUT_MIF_CMU_CPUCL0_SWITCH, "gout_mif_cmu_cpucl0_switch",
+	     "dout_mif_cmu_cpucl0_switch", CLK_CON_GAT_MIF_CMU_CPUCL0_SWITCH,
+	     0, CLK_IGNORE_UNUSED | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_MIF_CMU_CPUCL1_SWITCH, "gout_mif_cmu_cpucl1_switch",
+	     "dout_mif_cmu_cpucl1_switch", CLK_CON_GAT_MIF_CMU_CPUCL1_SWITCH,
+	     0, CLK_IGNORE_UNUSED | CLK_SET_RATE_PARENT, 0),
 	GATE(CLK_GOUT_MIF_CMU_DISPAUD_BUS, "gout_mif_cmu_dispaud_bus",
 	     "dout_mif_cmu_dispaud_bus", CLK_CON_GAT_MIF_CMU_DISPAUD_BUS, 0,
 	     CLK_SET_RATE_PARENT, 0),
@@ -734,6 +754,307 @@ static const struct samsung_cmu_info mif_cmu_info __initconst = {
 	.nr_clk_ids		= MIF_NR_CLK,
 };
 
+/*
+ * Register offsets for CMU_CPUCL0 (0x10900000)
+ */
+#define PLL_LOCKTIME_CPUCL0_PLL				0x0000
+#define PLL_CON0_CPUCL0_PLL				0x0100
+#define CLK_CON_GAT_CPUCL0_MUX_PLL			0x0200
+#define CLK_CON_GAT_CPUCL0_MUX_PLL_CON			0x0200
+#define CLK_CON_GAT_CPUCL0_MUX_SWITCH_USER		0x0204
+#define CLK_CON_MUX_CPUCL0_SWITCH_USER			0x0204
+#define CLK_CON_GAT_CPUCL0_MUX				0x0208
+#define CLK_CON_MUX_CPUCL0				0x0208
+#define CLK_CON_DIV_CPUCL0_1				0x0400
+#define CLK_CON_DIV_CPUCL0_2				0x0404
+#define CLK_CON_DIV_CPUCL0_ACLK				0x0408
+#define CLK_CON_DIV_CPUCL0_PCLK				0x040c
+#define CLK_CON_DIV_CPUCL0_ATCLK			0x0410
+#define CLK_CON_DIV_CPUCL0_PCLKDBG			0x0414
+#define CLK_CON_DIV_CPUCL0_CNTCLK			0x0418
+#define CLK_CON_DIV_CPUCL0_RUN_MONITOR			0x041c
+#define CLK_CON_DIV_CPUCL0_HPM				0x0420
+#define CLK_CON_DIV_CPUCL0_PLL				0x0424
+#define CLK_STAT_MUX_CPUCL0				0x0608
+
+static const unsigned long cpucl0_clk_regs[] __initconst = {
+	PLL_LOCKTIME_CPUCL0_PLL,
+	PLL_CON0_CPUCL0_PLL,
+	CLK_CON_GAT_CPUCL0_MUX_PLL,
+	CLK_CON_GAT_CPUCL0_MUX_PLL_CON,
+	CLK_CON_GAT_CPUCL0_MUX_SWITCH_USER,
+	CLK_CON_MUX_CPUCL0_SWITCH_USER,
+	CLK_CON_GAT_CPUCL0_MUX,
+	CLK_CON_MUX_CPUCL0,
+	CLK_CON_DIV_CPUCL0_1,
+	CLK_CON_DIV_CPUCL0_2,
+	CLK_CON_DIV_CPUCL0_ACLK,
+	CLK_CON_DIV_CPUCL0_PCLK,
+	CLK_CON_DIV_CPUCL0_ATCLK,
+	CLK_CON_DIV_CPUCL0_PCLKDBG,
+	CLK_CON_DIV_CPUCL0_CNTCLK,
+	CLK_CON_DIV_CPUCL0_RUN_MONITOR,
+	CLK_CON_DIV_CPUCL0_HPM,
+	CLK_CON_DIV_CPUCL0_PLL,
+};
+
+/*
+ * P/M/S tuples come from the PLL block of the ECT at 0x90000000 (domain
+ * CPUCL0_PLL/CPUCL1_PLL, type 1417x, 17 tuples from 2002 MHz down to
+ * 342.875 MHz). Only the 902.2 MHz tuple below is silicon-verified so far
+ * (boot value programmed by S-BOOT, register dump on kernel #41):
+ * CON0 = 0xa15b0501 -> M=347 P=5 S=1 -> 26 MHz * 347 / (5 * 2^1) = 902.2 MHz.
+ * TODO: fill in the remaining 16 tuples from ect-decode before enabling
+ * any OPP other than 902.2 MHz.
+ */
+static const struct samsung_pll_rate_table cpucl_pll_rates[] __initconst = {
+	PLL_35XX_RATE(26 * MHZ, 902200000U, 347, 5, 1),
+};
+
+static const struct samsung_pll_clock cpucl0_pll_clks[] __initconst = {
+	PLL(pll_1417x, CLK_FOUT_CPUCL0_PLL, "fout_cpucl0_pll", "oscclk",
+	    PLL_LOCKTIME_CPUCL0_PLL, PLL_CON0_CPUCL0_PLL, cpucl_pll_rates),
+};
+
+/* List of parent clocks for muxes in CMU_CPUCL0 */
+PNAME(mout_cpucl0_switch_user_p)	= { "oscclk",
+					    "gout_mif_cmu_cpucl0_switch" };
+PNAME(mout_cpucl0_p)			= { "gout_cpucl0_mux_pll",
+					    "gout_cpucl0_mux_switch_user" };
+
+static const struct samsung_mux_clock cpucl0_mux_clks[] __initconst = {
+	/*
+	 * CLK_SET_RATE_PARENT lets the clk-cpu alternate-parent clamp
+	 * propagate through to the CLKCMU_CPUCL0_SWITCH divider in CMU_MIF.
+	 * MUX_F keeps CLK_SET_RATE_NO_REPARENT: the switch branch is driven
+	 * exclusively by the clk-cpu notifier through direct register writes,
+	 * never by CCF rate propagation (same lesson as patch 0071 for G3D).
+	 */
+	MUX_F(CLK_MOUT_CPUCL0_SWITCH_USER, "mout_cpucl0_switch_user",
+	      mout_cpucl0_switch_user_p, CLK_CON_MUX_CPUCL0_SWITCH_USER, 12, 1,
+	      CLK_SET_RATE_PARENT, 0),
+	MUX_F(CLK_MOUT_CPUCL0, "mout_cpucl0", mout_cpucl0_p,
+	      CLK_CON_MUX_CPUCL0, 12, 1, CLK_SET_RATE_PARENT, 0),
+};
+
+/*
+ * All CMU_CPUCL0 dividers are level-independent per the ECT DVFS block
+ * (verified against the S-BOOT programmed values on kernel #41: DIV_1=1,
+ * DIV_2=1, ACLK=2, PCLK/ATCLK/PCLKDBG=8, CNTCLK=4, RUN_MONITOR=4, HPM=4,
+ * DIV "PLL"=2 - the latter is off the CPU path, cores run at full mux
+ * rate). They are modelled read-only and never reprogrammed.
+ */
+static const struct samsung_div_clock cpucl0_div_clks[] __initconst = {
+	DIV_F(CLK_DOUT_CPUCL0_1, "dout_cpucl0_1", "gout_cpucl0_mux",
+	      CLK_CON_DIV_CPUCL0_1, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_2, "dout_cpucl0_2", "dout_cpucl0_1",
+	      CLK_CON_DIV_CPUCL0_2, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_ACLK, "dout_cpucl0_aclk", "dout_cpucl0_2",
+	      CLK_CON_DIV_CPUCL0_ACLK, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_PCLK, "dout_cpucl0_pclk", "dout_cpucl0_2",
+	      CLK_CON_DIV_CPUCL0_PCLK, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_ATCLK, "dout_cpucl0_atclk", "dout_cpucl0_2",
+	      CLK_CON_DIV_CPUCL0_ATCLK, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_PCLKDBG, "dout_cpucl0_pclkdbg", "dout_cpucl0_2",
+	      CLK_CON_DIV_CPUCL0_PCLKDBG, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_CNTCLK, "dout_cpucl0_cntclk", "dout_cpucl0_2",
+	      CLK_CON_DIV_CPUCL0_CNTCLK, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_RUN_MONITOR, "dout_cpucl0_run_monitor",
+	      "dout_cpucl0_2", CLK_CON_DIV_CPUCL0_RUN_MONITOR, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_HPM, "dout_cpucl0_hpm", "gout_cpucl0_mux",
+	      CLK_CON_DIV_CPUCL0_HPM, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+	DIV_F(CLK_DOUT_CPUCL0_PLL, "dout_cpucl0_pll", "gout_cpucl0_mux",
+	      CLK_CON_DIV_CPUCL0_PLL, 0, 3,
+	      CLK_GET_RATE_NOCACHE, CLK_DIVIDER_READ_ONLY),
+};
+
+static const struct samsung_gate_clock cpucl0_gate_clks[] __initconst = {
+	GATE(CLK_GOUT_CPUCL0_MUX, "gout_cpucl0_mux", "mout_cpucl0",
+	     CLK_CON_GAT_CPUCL0_MUX, 21, CLK_IS_CRITICAL | CLK_SET_RATE_PARENT,
+	     0),
+	GATE(CLK_GOUT_CPUCL0_MUX_PLL, "gout_cpucl0_mux_pll",
+	     "gout_cpucl0_mux_pll_con", CLK_CON_GAT_CPUCL0_MUX_PLL, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_CPUCL0_MUX_PLL_CON, "gout_cpucl0_mux_pll_con",
+	     "fout_cpucl0_pll", CLK_CON_GAT_CPUCL0_MUX_PLL_CON, 12,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	/*
+	 * The switch-user branch is the clk-cpu parking path: the cores run
+	 * from it while the PLL relocks. CCF never sees it as consumed, so it
+	 * must never be gated by the unused-clock cleanup.
+	 */
+	GATE(CLK_GOUT_CPUCL0_MUX_SWITCH_USER, "gout_cpucl0_mux_switch_user",
+	     "mout_cpucl0_switch_user", CLK_CON_GAT_CPUCL0_MUX_SWITCH_USER, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+};
+
+static const struct samsung_cmu_info cpucl0_cmu_info __initconst = {
+	.pll_clks		= cpucl0_pll_clks,
+	.nr_pll_clks		= ARRAY_SIZE(cpucl0_pll_clks),
+	.mux_clks		= cpucl0_mux_clks,
+	.nr_mux_clks		= ARRAY_SIZE(cpucl0_mux_clks),
+	.div_clks		= cpucl0_div_clks,
+	.nr_div_clks		= ARRAY_SIZE(cpucl0_div_clks),
+	.gate_clks		= cpucl0_gate_clks,
+	.nr_gate_clks		= ARRAY_SIZE(cpucl0_gate_clks),
+	.clk_regs		= cpucl0_clk_regs,
+	.nr_clk_regs		= ARRAY_SIZE(cpucl0_clk_regs),
+	.nr_clk_ids		= CPUCL0_NR_CLK,
+};
+
+/*
+ * Register offsets for CMU_CPUCL1 (0x10800000)
+ */
+#define PLL_LOCKTIME_CPUCL1_PLL				0x0000
+#define PLL_CON0_CPUCL1_PLL				0x0100
+#define CLK_CON_GAT_CPUCL1_MUX_PLL			0x0200
+#define CLK_CON_GAT_CPUCL1_MUX_PLL_CON			0x0200
+#define CLK_CON_GAT_CPUCL1_MUX_SWITCH_USER		0x0204
+#define CLK_CON_MUX_CPUCL1_SWITCH_USER			0x0204
+#define CLK_CON_GAT_CPUCL1_MUX				0x0208
+#define CLK_CON_MUX_CPUCL1				0x0208
+#define CLK_CON_DIV_CPUCL1_1				0x0400
+#define CLK_CON_DIV_CPUCL1_2				0x0404
+#define CLK_CON_DIV_CPUCL1_ACLK				0x0408
+#define CLK_CON_DIV_CPUCL1_PCLK				0x040c
+#define CLK_CON_DIV_CPUCL1_ATCLK			0x0410
+#define CLK_CON_DIV_CPUCL1_PCLKDBG			0x0414
+#define CLK_CON_DIV_CPUCL1_CNTCLK			0x0418
+#define CLK_CON_DIV_CPUCL1_RUN_MONITOR			0x041c
+#define CLK_CON_DIV_CPUCL1_HPM				0x0420
+#define CLK_CON_DIV_CPUCL1_PLL				0x0424
+#define CLK_STAT_MUX_CPUCL1				0x0608
+
+static const unsigned long cpucl1_clk_regs[] __initconst = {
+	PLL_LOCKTIME_CPUCL1_PLL,
+	PLL_CON0_CPUCL1_PLL,
+	CLK_CON_GAT_CPUCL1_MUX_PLL,
+	CLK_CON_GAT_CPUCL1_MUX_PLL_CON,
+	CLK_CON_GAT_CPUCL1_MUX_SWITCH_USER,
+	CLK_CON_MUX_CPUCL1_SWITCH_USER,
+	CLK_CON_GAT_CPUCL1_MUX,
+	CLK_CON_MUX_CPUCL1,
+	CLK_CON_DIV_CPUCL1_1,
+	CLK_CON_DIV_CPUCL1_2,
+	CLK_CON_DIV_CPUCL1_ACLK,
+	CLK_CON_DIV_CPUCL1_PCLK,
+	CLK_CON_DIV_CPUCL1_ATCLK,
+	CLK_CON_DIV_CPUCL1_PCLKDBG,
+	CLK_CON_DIV_CPUCL1_CNTCLK,
+	CLK_CON_DIV_CPUCL1_RUN_MONITOR,
+	CLK_CON_DIV_CPUCL1_HPM,
+	CLK_CON_DIV_CPUCL1_PLL,
+};
+
+static const struct samsung_pll_clock cpucl1_pll_clks[] __initconst = {
+	PLL(pll_1417x, CLK_FOUT_CPUCL1_PLL, "fout_cpucl1_pll", "oscclk",
+	    PLL_LOCKTIME_CPUCL1_PLL, PLL_CON0_CPUCL1_PLL, cpucl_pll_rates),
+};
+
+/* List of parent clocks for muxes in CMU_CPUCL1 */
+PNAME(mout_cpucl1_switch_user_p)	= { "oscclk",
+					    "gout_mif_cmu_cpucl1_switch" };
+PNAME(mout_cpucl1_p)			= { "gout_cpucl1_mux_pll",
+					    "gout_cpucl1_mux_switch_user" };
+
+static const struct samsung_mux_clock cpucl1_mux_clks[] __initconst = {
+	/*
+	 * CLK_SET_RATE_PARENT lets the clk-cpu alternate-parent clamp
+	 * propagate through to the CLKCMU_CPUCL1_SWITCH divider in CMU_MIF.
+	 * MUX_F keeps CLK_SET_RATE_NO_REPARENT: the switch branch is driven
+	 * exclusively by the clk-cpu notifier through direct register writes,
+	 * never by CCF rate propagation (same lesson as patch 0071 for G3D).
+	 */
+	MUX_F(CLK_MOUT_CPUCL1_SWITCH_USER, "mout_cpucl1_switch_user",
+	      mout_cpucl1_switch_user_p, CLK_CON_MUX_CPUCL1_SWITCH_USER, 12, 1,
+	      CLK_SET_RATE_PARENT, 0),
+	MUX_F(CLK_MOUT_CPUCL1, "mout_cpucl1", mout_cpucl1_p,
+	      CLK_CON_MUX_CPUCL1, 12, 1, CLK_SET_RATE_PARENT, 0),
+};
