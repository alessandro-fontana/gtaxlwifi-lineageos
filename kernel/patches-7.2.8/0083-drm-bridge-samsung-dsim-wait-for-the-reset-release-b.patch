From 4330ec255716f0583e30ed352cd0cbd3656761b8 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Wed, 9 Sep 2026 16:49:09 +0000
Subject: [PATCH] drm: bridge: samsung-dsim: wait for the reset release before
 programming the PLL

samsung_dsim_init() issues the software reset, then programs PLLTMR and
PLLCTRL and polls the link status, and only then waits for the reset to
be released. On a link inherited from the bootloader the release takes
microseconds and the ordering never shows. On a cold link (display off
then on) the PLL registers are written while the block is still in
reset: the write is dropped - PLLCTRL reads back correctly but the PLL
never locks (cachelog-59, -64) - or the bus answers with an error and
the CPU takes an SError, which panics regardless of panic_on_oops
(cachelog-64: panic within a few ms of the second set_pll, with
panic_on_oops=0 and panic=10 the tablet rebooted by itself).

Wait for the release right after the reset, and abort the init if it
does not come within 300 ms instead of carrying on.
---
 drivers/gpu/drm/bridge/samsung-dsim.c | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 05c1623522..e4cf7831af 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -718,12 +718,13 @@ static inline u32 samsung_dsim_read(struct samsung_dsim *dsi, enum reg_idx idx)
 	return readl(dsi->reg_base + dsi->driver_data->reg_ofs[idx]);
 }
 
-static void samsung_dsim_wait_for_reset(struct samsung_dsim *dsi)
+static int samsung_dsim_wait_for_reset(struct samsung_dsim *dsi)
 {
 	if (wait_for_completion_timeout(&dsi->completed, msecs_to_jiffies(300)))
-		return;
+		return 0;
 
 	dev_err(dsi->dev, "timeout waiting for reset\n");
+	return -ETIMEDOUT;
 }
 
 static void samsung_dsim_reset(struct samsung_dsim *dsi)
@@ -1673,6 +1674,25 @@ static int samsung_dsim_init(struct samsung_dsim *dsi)
 	samsung_dsim_reset(dsi);
 	samsung_dsim_enable_irq(dsi);
 
+	/*
+	 * Wait for the software reset to be released before touching any
+	 * other register. The PLL used to be programmed first and the wait
+	 * done afterwards; on a link handed over by the bootloader the
+	 * reset is released in microseconds and that ordering never shows,
+	 * but on a cold link the PLLTMR/PLLCTRL writes and the status
+	 * reads land while the block is still in reset: the write is
+	 * dropped (PLL fails to lock) or the bus answers with an error
+	 * (SError, panic). Neither can be recovered from by continuing.
+	 */
+	if (driver_data->wait_for_reset) {
+		ret = samsung_dsim_wait_for_reset(dsi);
+		if (ret) {
+			dev_err(dsi->dev, "link init aborted, reset not released\n");
+			samsung_dsim_disable_irq(dsi);
+			return ret;
+		}
+	}
+
 	if (driver_data->reg_values[RESET_TYPE] == DSIM_FUNCRST)
 		samsung_dsim_enable_lane(dsi, BIT(dsi->lanes) - 1);
 
@@ -1683,8 +1703,6 @@ static int samsung_dsim_init(struct samsung_dsim *dsi)
 		return ret;
 	}
 
-	if (driver_data->wait_for_reset)
-		samsung_dsim_wait_for_reset(dsi);
 	samsung_dsim_set_phy_ctrl(dsi);
 	samsung_dsim_init_link(dsi);
 
-- 
2.47.3

