From 58016fc1e46e7680444e1b44f7dad87bccacad68 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 8 Sep 2026 21:34:52 +0000
Subject: [PATCH] drm: bridge: samsung-dsim: abort the init when the PLL fails
 to lock, and say why

samsung_dsim_init() ignores the return value of samsung_dsim_enable_clock().
When the PLL does not lock ("PLL failed to stabilize"), the init goes on:
wait_for_reset, phy_ctrl, init_link, and on exynos7870 the display mode and
the SFR standby are raised on a link without a clock. The state is then
declared INITIALIZED and the first panel command is queued on a halted
transmitter. On gtaxlwifi this is the first cold init ever run by this
kernel (the boot path inherits a link configured by the bootloader), and
the machine stops answering within 80 ms: no display, no USB, no adb.

Return the error instead, so that a failed wake leaves a black panel and a
live system, and leave INITIALIZED clear so that the next transfer (any
backlight write goes through host_transfer) retries the cold init.

While at it, promote the two PLL dev_dbg lines to dev_info and print
PLLCTRL, the status register and PLLTMR on timeout: the tree has no
dynamic_debug, and these are the numbers to compare against the vendor CAL.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/bridge/samsung-dsim.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 06eebc8f3b..e66ecfe4c9 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -815,7 +815,7 @@ static unsigned long samsung_dsim_set_pll(struct samsung_dsim *dsi,
 	} else {
 		fin = dsi->pll_clk_rate;
 	}
-	dev_dbg(dsi->dev, "PLL ref clock freq %lu\n", fin);
+	dev_info(dsi->dev, "PLL ref clock freq %lu\n", fin);
 
 	fout = samsung_dsim_pll_find_pms(dsi, fin, freq, &p, &m, &s);
 	if (!fout) {
@@ -823,7 +823,7 @@ static unsigned long samsung_dsim_set_pll(struct samsung_dsim *dsi,
 			"failed to find PLL PMS for requested frequency\n");
 		return 0;
 	}
-	dev_dbg(dsi->dev, "PLL freq %lu, (p %d, m %d, s %d)\n", fout, p, m, s);
+	dev_info(dsi->dev, "PLL freq %lu, (p %d, m %d, s %d)\n", fout, p, m, s);
 
 	writel(driver_data->reg_values[PLL_TIMER],
 	       dsi->reg_base + driver_data->plltmr_reg);
@@ -861,7 +861,10 @@ static unsigned long samsung_dsim_set_pll(struct samsung_dsim *dsi,
 	timeout = 3000;
 	do {
 		if (timeout-- == 0) {
-			dev_err(dsi->dev, "PLL failed to stabilize\n");
+			dev_err(dsi->dev,
+				"PLL failed to stabilize: pllctrl %08x status %08x plltmr %08x\n",
+				samsung_dsim_read(dsi, DSIM_PLLCTRL_REG), reg,
+				readl(dsi->reg_base + driver_data->plltmr_reg));
 			return 0;
 		}
 		if (driver_data->has_legacy_status_reg)
@@ -1662,6 +1665,7 @@ static void samsung_dsim_disable_irq(struct samsung_dsim *dsi)
 static int samsung_dsim_init(struct samsung_dsim *dsi)
 {
 	const struct samsung_dsim_driver_data *driver_data = dsi->driver_data;
+	int ret;
 
 	if (dsi->state & DSIM_STATE_INITIALIZED)
 		return 0;
@@ -1672,7 +1676,12 @@ static int samsung_dsim_init(struct samsung_dsim *dsi)
 	if (driver_data->reg_values[RESET_TYPE] == DSIM_FUNCRST)
 		samsung_dsim_enable_lane(dsi, BIT(dsi->lanes) - 1);
 
-	samsung_dsim_enable_clock(dsi);
+	ret = samsung_dsim_enable_clock(dsi);
+	if (ret) {
+		dev_err(dsi->dev, "link init aborted, PLL not locked (%d)\n", ret);
+		return ret;
+	}
+
 	if (driver_data->wait_for_reset)
 		samsung_dsim_wait_for_reset(dsi);
 	samsung_dsim_set_phy_ctrl(dsi);
-- 
2.47.3

