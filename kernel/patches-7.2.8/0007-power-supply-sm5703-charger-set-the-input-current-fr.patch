From 650b2be6fcfd12aee729eefc908a555d859ed3a8 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Wed, 12 Aug 2026 14:43:23 +0000
Subject: [PATCH] power: supply: sm5703-charger: set the input current from the
 cable

The charger draws whatever the device tree says regardless of what is on
the other end of the cable, so a host port good for 500 mA is asked for
the full board limit.

Follow an extcon device instead.  A dedicated charger gets the board
limit, the various host ports get what they are allowed to promise, and
anything unrecognised falls back to the least a source can offer.

The device tree value becomes a ceiling rather than a target: nothing,
including userspace, raises the limit above it, and until the first
cable event arrives the charger stays at the conservative value, because
assuming a wall charger at boot is how a host port gets overdrawn.

A board with no extcon device has nothing else to identify the port, so
there the device tree value is used as before.
---
 .../bindings/mfd/siliconmitus,sm5703.yaml     |   1 +
 .../supply/siliconmitus,sm5703-charger.yaml   |  19 ++-
 drivers/power/supply/sm5703-charger.c         | 155 +++++++++++++++++-
 3 files changed, 163 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml b/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
index 0920276f6d..91a0d08de1 100644
--- a/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
+++ b/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
@@ -63,6 +63,7 @@ examples:
             charger {
                 compatible = "siliconmitus,sm5703-charger";
                 monitored-battery = <&battery>;
+                extcon = <&muic>;
                 enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
                 input-current-limit-microamp = <1650000>;
             };
diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
index 1e8cdd7c26..90a796abec 100644
--- a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
@@ -32,13 +32,23 @@ properties:
 
   input-current-limit-microamp:
     description:
-      Maximum current drawn from the charging port.  The charger cannot
-      identify the port on its own, so this applies to every source and
-      must not exceed what the least capable one can supply.
-    default: 500000
+      Highest current the board can carry from the charging port.  This
+      is a ceiling rather than a target, so nothing raises the limit
+      above it, and the charger only draws this much once something has
+      identified the port as a dedicated charger.  Without an extcon
+      device to do that identification the charger has nothing else to
+      go on and uses this value directly, so it must then be safe for
+      every source the port may see.
     minimum: 100000
     maximum: 2100000
 
+  extcon:
+    maxItems: 1
+    description:
+      Phandle to the MUIC that reports what kind of charging port is
+      attached.  Without it the charger cannot tell a wall adapter from
+      a host port.
+
 required:
   - compatible
   - monitored-battery
@@ -52,6 +62,7 @@ examples:
     charger {
         compatible = "siliconmitus,sm5703-charger";
         monitored-battery = <&battery>;
+        extcon = <&muic>;
         enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
         input-current-limit-microamp = <1650000>;
     };
diff --git a/drivers/power/supply/sm5703-charger.c b/drivers/power/supply/sm5703-charger.c
index 327a409382..2df531dd63 100644
--- a/drivers/power/supply/sm5703-charger.c
+++ b/drivers/power/supply/sm5703-charger.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/extcon.h>
 #include <linux/gpio/consumer.h>
 #include <linux/interrupt.h>
 #include <linux/mfd/sm5703.h>
@@ -38,19 +39,28 @@
 #define SM5703_TERM_CURRENT_STEP	25000
 
 /*
- * Input current limit used when nothing better is known.  The charger
- * cannot tell a wall adapter from a host port on its own: that is the
- * MUIC's job, and until a driver for it feeds us a cable type this is
- * the most any USB source has to provide.
+ * The charger cannot tell a wall adapter from a host port on its own:
+ * that is the MUIC's job.  Until one tells us otherwise, assume the
+ * least a USB source is required to provide.
  */
-#define SM5703_INPUT_CURRENT_DEFAULT	500000
+#define SM5703_INPUT_CURRENT_SDP	500000
+#define SM5703_INPUT_CURRENT_CDP	1500000
+#define SM5703_INPUT_CURRENT_ACA	1500000
 
 struct sm5703_charger {
 	struct device *dev;
 	struct regmap *regmap;
 	struct power_supply *psy;
 	struct gpio_desc *enable_gpio;
+	struct extcon_dev *edev;
+	struct notifier_block extcon_nb;
+	struct work_struct extcon_work;
 
+	/*
+	 * What the board can take, from the device tree, and what we are
+	 * drawing right now, which never exceeds it.
+	 */
+	unsigned int input_current_max;
 	unsigned int input_current_limit;
 	unsigned int charge_current;
 	unsigned int battery_regulation_voltage;
@@ -100,7 +110,8 @@ static int sm5703_charger_configure(struct sm5703_charger *chg)
 
 	ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
 				       SM5703_VBUSCNTL_VBUSLIMIT,
-				       chg->input_current_limit,
+				       min(chg->input_current_limit,
+					   chg->input_current_max),
 				       SM5703_INPUT_CURRENT_MIN,
 				       SM5703_INPUT_CURRENT_MAX,
 				       SM5703_INPUT_CURRENT_STEP);
@@ -314,6 +325,12 @@ static int sm5703_charger_set_property(struct power_supply *psy,
 		if (val->intval < 0)
 			return -EINVAL;
 
+		/* The board limit is a property of the wiring, not a
+		 * preference: nothing may ask for more.
+		 */
+		if ((unsigned int)val->intval > chg->input_current_max)
+			return -EINVAL;
+
 		ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
 					       SM5703_VBUSCNTL_VBUSLIMIT,
 					       val->intval,
@@ -383,6 +400,71 @@ static const struct power_supply_desc sm5703_charger_desc = {
 	.property_is_writeable	= sm5703_charger_property_is_writeable,
 };
 
+/*
+ * Pick how much may be drawn from what the MUIC says is attached.  A
+ * dedicated charger gets whatever the board allows; the various host
+ * ports get what the USB specification lets them promise.  Anything
+ * unrecognised, or nothing attached at all, falls back to the least a
+ * source can offer, because guessing high is how a hub gets shut down.
+ */
+static unsigned int sm5703_charger_extcon_current(struct sm5703_charger *chg)
+{
+	struct extcon_dev *edev = chg->edev;
+
+	if (extcon_get_state(edev, EXTCON_CHG_USB_DCP) > 0)
+		return chg->input_current_max;
+
+	if (extcon_get_state(edev, EXTCON_CHG_USB_CDP) > 0)
+		return SM5703_INPUT_CURRENT_CDP;
+
+	if (extcon_get_state(edev, EXTCON_CHG_USB_ACA) > 0)
+		return SM5703_INPUT_CURRENT_ACA;
+
+	return SM5703_INPUT_CURRENT_SDP;
+}
+
+static void sm5703_charger_extcon_work(struct work_struct *work)
+{
+	struct sm5703_charger *chg = container_of(work, struct sm5703_charger,
+						  extcon_work);
+	unsigned int current_limit;
+	int ret;
+
+	current_limit = min(sm5703_charger_extcon_current(chg),
+			    chg->input_current_max);
+
+	if (current_limit == chg->input_current_limit)
+		return;
+
+	ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
+				       SM5703_VBUSCNTL_VBUSLIMIT,
+				       current_limit,
+				       SM5703_INPUT_CURRENT_MIN,
+				       SM5703_INPUT_CURRENT_MAX,
+				       SM5703_INPUT_CURRENT_STEP);
+	if (ret) {
+		dev_err(chg->dev, "Failed to set input current limit: %d\n",
+			ret);
+		return;
+	}
+
+	chg->input_current_limit = current_limit;
+	dev_dbg(chg->dev, "Input current limit now %u uA\n", current_limit);
+
+	power_supply_changed(chg->psy);
+}
+
+static int sm5703_charger_extcon_notify(struct notifier_block *nb,
+					unsigned long event, void *data)
+{
+	struct sm5703_charger *chg = container_of(nb, struct sm5703_charger,
+						  extcon_nb);
+
+	schedule_work(&chg->extcon_work);
+
+	return NOTIFY_OK;
+}
+
 /*
  * A plugged in cable makes the chip restart charging, and that restart
  * is where it reapplies its own idea of the input current limit.  Push
@@ -431,6 +513,13 @@ static void sm5703_charger_request_irq(struct sm5703_charger *chg,
 			 name, ret);
 }
 
+static void sm5703_charger_cancel_work(void *data)
+{
+	struct sm5703_charger *chg = data;
+
+	cancel_work_sync(&chg->extcon_work);
+}
+
 static int sm5703_charger_probe(struct platform_device *pdev)
 {
 	struct power_supply_battery_info *info;
@@ -458,9 +547,40 @@ static int sm5703_charger_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(chg->enable_gpio),
 				     "Cannot get charge enable GPIO\n");
 
-	chg->input_current_limit = SM5703_INPUT_CURRENT_DEFAULT;
+	/*
+	 * The device tree value is a ceiling, not a target: it says what
+	 * the board can carry, and nothing raises the limit above it.
+	 */
+	chg->input_current_max = SM5703_INPUT_CURRENT_MAX;
 	device_property_read_u32(dev, "input-current-limit-microamp",
-				 &chg->input_current_limit);
+				 &chg->input_current_max);
+	chg->input_current_max = clamp_t(unsigned int, chg->input_current_max,
+					 SM5703_INPUT_CURRENT_MIN,
+					 SM5703_INPUT_CURRENT_MAX);
+
+	chg->edev = extcon_get_edev_by_phandle(dev, 0);
+	if (IS_ERR(chg->edev)) {
+		if (PTR_ERR(chg->edev) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+
+		/*
+		 * No cable detection on this board.  The device tree is
+		 * then the only thing that knows what is safe to draw, so
+		 * take it at its word.
+		 */
+		chg->edev = NULL;
+		chg->input_current_limit = chg->input_current_max;
+	} else {
+		/*
+		 * Start low and let the first cable event raise it.  At
+		 * this point nothing has said what is on the other end of
+		 * the cable, and assuming a wall charger is how a host
+		 * port gets overdrawn.
+		 */
+		chg->input_current_limit = min_t(unsigned int,
+						 chg->input_current_max,
+						 SM5703_INPUT_CURRENT_SDP);
+	}
 
 	cfg.drv_data = chg;
 	cfg.fwnode = dev_fwnode(dev);
@@ -502,6 +622,25 @@ static int sm5703_charger_probe(struct platform_device *pdev)
 	sm5703_charger_request_irq(chg, pdev, "TOPOFF");
 	sm5703_charger_request_irq(chg, pdev, "DONE");
 
+	if (chg->edev) {
+		INIT_WORK(&chg->extcon_work, sm5703_charger_extcon_work);
+
+		ret = devm_add_action_or_reset(dev, sm5703_charger_cancel_work,
+					       chg);
+		if (ret)
+			return ret;
+
+		chg->extcon_nb.notifier_call = sm5703_charger_extcon_notify;
+		ret = devm_extcon_register_notifier_all(dev, chg->edev,
+							&chg->extcon_nb);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "Failed to register extcon notifier\n");
+
+		/* A cable may already be in when we get here. */
+		schedule_work(&chg->extcon_work);
+	}
+
 	return 0;
 }
 
-- 
2.47.3

