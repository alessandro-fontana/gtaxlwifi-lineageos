From e65f57613ce4b65b94c7a0eb6ee9c132450c2e11 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 29 Sep 2026 12:51:14 +0200
Subject: [PATCH] wifi: ath10k: sdio: keep the SDIO interrupt as a wakeup
 source for WoWLAN

With WoWLAN armed the firmware wakes the host through the SDIO
interrupt, but the driver only asks the host to keep the card powered.
Also ask for MMC_PM_WAKE_SDIO_IRQ when a WoWLAN configuration is set and
the host supports it, so that the host leaves the interrupt able to wake
the system.

---
 drivers/net/wireless/ath/ath10k/sdio.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/net/wireless/ath/ath10k/sdio.c b/drivers/net/wireless/ath/ath10k/sdio.c
index 65e941b527..ae933c290b 100644
--- a/drivers/net/wireless/ath/ath10k/sdio.c
+++ b/drivers/net/wireless/ath/ath10k/sdio.c
@@ -2156,6 +2156,14 @@ static int ath10k_sdio_pm_suspend(struct device *device)
 
 	pm_flag = MMC_PM_KEEP_POWER;
 
+	/*
+	 * With WoWLAN armed the firmware wakes the host through the SDIO
+	 * interrupt, so ask the host to leave it working while suspended.
+	 */
+	if (ar->hw->wiphy->wowlan_config &&
+	    (sdio_get_host_pm_caps(func) & MMC_PM_WAKE_SDIO_IRQ))
+		pm_flag |= MMC_PM_WAKE_SDIO_IRQ;
+
 	ret = sdio_set_host_pm_flags(func, pm_flag);
 	if (ret) {
 		pm_caps = sdio_get_host_pm_caps(func);
-- 
