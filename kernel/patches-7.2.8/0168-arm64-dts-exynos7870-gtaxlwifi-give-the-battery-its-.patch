From dc338ec1e5ef554e30c746470c9d45d5159715ac Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 28 Sep 2026 21:03:02 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: give the battery its
 operating range

0 to 50 C, the vendor's charging block temperatures
(battery,temp_low_threshold_normal and battery,temp_high_threshold_normal).
The charger stops charging outside it and the fuel gauge reports Cold or
Overheat.

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index e410bb7127..d700a9998d 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -176,6 +176,16 @@ battery: battery {
 		constant-charge-voltage-max-microvolt = <4300000>;
 		constant-charge-current-max-microamp = <2400000>;
 		charge-term-current-microamp = <375000>;
+
+		/*
+		 * Fuori da questo intervallo il charger smette di caricare, e
+		 * riprende 5 gradi dentro; il fuel gauge riporta Overheat o
+		 * Cold. Dal downstream: battery,temp_high_threshold_normal =
+		 * <500> (recovery 450) e battery,temp_low_threshold_normal =
+		 * <0> (recovery 50), in decimi di grado. Nel chip nessuno
+		 * guarda la cella: la sua regolazione termica e' per il die.
+		 */
+		operating-range-celsius = <0 50>;
 	};
 
 	/*
-- 
2.47.3

