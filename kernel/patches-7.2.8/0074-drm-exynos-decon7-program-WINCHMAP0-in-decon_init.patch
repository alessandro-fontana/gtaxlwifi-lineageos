From 5c0bb3934fb9b1619d557fa6f7c90f104afd6aca Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 6 Sep 2026 16:00:00 +0200
Subject: [PATCH] drm/exynos: decon7: program WINCHMAP0 in decon_init()

The Exynos7870 DECON has three DMA channels and three windows. The vendor
driver (decon_reg_config_win_channel()) maps window N to channel N, using
its IDMA_G2/G0/G1 naming for channels 0/1/2, and the bootloader leaves
WINCHMAP0 = 0x210. The mainline driver never touches the register and
relies on that value surviving the reset sequence, which only holds on a
warm handoff. Write the identity mapping after the reset, like the
vendor driver does.

No functional change on a warm boot: the value written is the one found.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/exynos/exynos7_drm_decon.c | 14 ++++++++++++++
 drivers/gpu/drm/exynos/regs-decon7.h       |  5 +++++
 2 files changed, 19 insertions(+)

diff --git a/drivers/gpu/drm/exynos/exynos7_drm_decon.c b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
index 2d880c0aca..defda17902 100644
--- a/drivers/gpu/drm/exynos/exynos7_drm_decon.c
+++ b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
@@ -662,6 +662,7 @@ static void decon_stop(struct decon_context *ctx)
 static void decon_init(struct decon_context *ctx)
 {
 	u32 val;
+	unsigned int win;
 
 	decon_stop(ctx);
 
@@ -674,6 +675,19 @@ static void decon_init(struct decon_context *ctx)
 
 	if (!ctx->i80_if)
 		writel(VIDCON1_VCLK_HOLD, ctx->regs + VIDCON1(0));
+
+	/*
+	 * Map every window to its own DMA channel. The Exynos7870 DECON has
+	 * three channels (0..2) and the vendor driver programs window N to
+	 * channel N (IDMA_G2/G0/G1 in its naming); relying on the bootloader
+	 * leaving WINCHMAP0 = 0x210 works on a warm handoff only.
+	 */
+	val = readl(ctx->regs + WINCHMAP0);
+	for (win = 0; win < WINDOWS_NR; win++) {
+		val &= ~WINCHMAP_MASK(win);
+		val |= WINCHMAP_DMA(win, win);
+	}
+	writel(val, ctx->regs + WINCHMAP0);
 }
 
 static void decon_atomic_enable(struct exynos_drm_crtc *crtc)
diff --git a/drivers/gpu/drm/exynos/regs-decon7.h b/drivers/gpu/drm/exynos/regs-decon7.h
index 216c106dac..974c056c08 100644
--- a/drivers/gpu/drm/exynos/regs-decon7.h
+++ b/drivers/gpu/drm/exynos/regs-decon7.h
@@ -45,6 +45,11 @@
 #define VCLKCON1_CLKVAL_NUM_VCLK(val)		(((val) & 0xff) << 0)
 #define VCLKCON2				0x18
 
+/* WINCHMAP0: DMA channel of each window, 4 bits per window */
+#define WINCHMAP0				0x40
+#define WINCHMAP_MASK(_win)			(0x7 << ((_win) * 4))
+#define WINCHMAP_DMA(_ch, _win)			((_ch) << ((_win) * 4))
+
 /* SHADOWCON */
 #define SHADOWCON				0x30
 
-- 
2.47.3

