From 9d6be1e67fe4499a4b8eddb63874ee6dacc279b8 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 15:36:37 +0000
Subject: [PATCH] drm/panel: himax-hx8279: require the DSI host to be enabled
 before prepare

---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index df31779085..a253e86f2d 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -1368,6 +1368,13 @@ static int hx8279_probe(struct mipi_dsi_device *dsi)
 	hx->dsi[0] = dsi;
 	mipi_dsi_set_drvdata(dsi, hx);
 
+	/*
+	 * The whole DriverIC configuration is sent from prepare(), so the
+	 * DSI host must be up by then: without this the first transfer is
+	 * rejected with -EINVAL by hosts that check their enabled state.
+	 */
+	hx->panel.prepare_prev_first = true;
+
 	ret = hx8279_init_backlight(hx, dev);
 	if (ret)
 		return ret;
-- 
2.47.3

