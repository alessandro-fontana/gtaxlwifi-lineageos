From 284f2586f355e443f23f0c5e7de40814fcebb464 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 14 Aug 2026 20:00:00 +0000
Subject: [PATCH] extcon: sm5502: add support for charging downstream ports

DEV_TYPE1 bit 5 marks a charging downstream port, a USB port that both
carries data and supplies charging current.  The driver knows the bit -
SM5502_REG_DEV_TYPE1_USB_CHG_MASK is already defined - but never matches
on it, so a CDP falls through to -EINVAL and no cable state is published
at all.

On a Galaxy Tab A (SM-T580) the USB port of an ordinary desktop machine
enumerates as a CDP.  Plugging it in after a wall charger leaves the
extcon device still reporting DCP, so the charger driver keeps asking a
data port for the wall-charger current.  Measured with the cable
attached: ADC 0x1f, DEV_TYPE1 0x20, and "cannot identify the cable type"
in the log.

The accessory value follows the encoding already used by this enum,
where the upper three bits hold the DEV_TYPE1 bit index: 0x5f for USB
(bit 2), 0xdf for a dedicated charger (bit 6), and so 0xbf for a CDP
(bit 5).

Report both EXTCON_CHG_USB_CDP and EXTCON_USB for this cable, mirroring
how EXTCON_USB already implies EXTCON_CHG_USB_SDP: a CDP is a data port
as much as a charging one.
---
 drivers/extcon/extcon-sm5502.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/extcon/extcon-sm5502.c b/drivers/extcon/extcon-sm5502.c
index a290a21c1c..4d422e1f13 100644
--- a/drivers/extcon/extcon-sm5502.c
+++ b/drivers/extcon/extcon-sm5502.c
@@ -131,6 +131,7 @@ static const unsigned int sm5502_extcon_cable[] = {
 	EXTCON_USB,
 	EXTCON_USB_HOST,
 	EXTCON_CHG_USB_SDP,
+	EXTCON_CHG_USB_CDP,
 	EXTCON_CHG_USB_DCP,
 	EXTCON_NONE,
 };
@@ -181,6 +182,7 @@ enum sm5502_muic_acc_type {
 							/* |Dev Type1|--ADC| */
 	SM5502_MUIC_ADC_GROUND_USB_OTG = 0x80,		/* |      100|00000| */
 	SM5502_MUIC_ADC_OPEN_USB = 0x5f,		/* |      010|11111| */
+	SM5502_MUIC_ADC_OPEN_CDP = 0xbf,		/* |      101|11111| */
 	SM5502_MUIC_ADC_OPEN_TA = 0xdf,			/* |      110|11111| */
 	SM5502_MUIC_ADC_OPEN_USB_OTG = 0xff,		/* |      111|11111| */
 };
@@ -448,6 +450,9 @@ static unsigned int sm5502_muic_get_cable_type(struct sm5502_muic_info *info)
 		case SM5502_REG_DEV_TYPE1_USB_SDP_MASK:
 			cable_type = SM5502_MUIC_ADC_OPEN_USB;
 			break;
+		case SM5502_REG_DEV_TYPE1_USB_CHG_MASK:
+			cable_type = SM5502_MUIC_ADC_OPEN_CDP;
+			break;
 		case SM5502_REG_DEV_TYPE1_DEDICATED_CHG_MASK:
 			cable_type = SM5502_MUIC_ADC_OPEN_TA;
 			break;
@@ -510,6 +515,11 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 		con_sw	= DM_DP_SWITCH_USB;
 		vbus_sw	= VBUSIN_SWITCH_VBUSOUT_WITH_USB;
 		break;
+	case SM5502_MUIC_ADC_OPEN_CDP:
+		id	= EXTCON_CHG_USB_CDP;
+		con_sw	= DM_DP_SWITCH_USB;
+		vbus_sw	= VBUSIN_SWITCH_VBUSOUT_WITH_USB;
+		break;
 	case SM5502_MUIC_ADC_OPEN_TA:
 		id	= EXTCON_CHG_USB_DCP;
 		con_sw	= DM_DP_SWITCH_OPEN;
@@ -542,7 +552,8 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 		unsigned int cable = sm5502_extcon_cable[i];
 
 		if (cable == id ||
-		    (id == EXTCON_USB && cable == EXTCON_CHG_USB_SDP))
+		    (id == EXTCON_USB && cable == EXTCON_CHG_USB_SDP) ||
+		    (id == EXTCON_CHG_USB_CDP && cable == EXTCON_USB))
 			continue;
 
 		extcon_set_state_sync(info->edev, cable, false);
@@ -553,6 +564,8 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 	if (id == EXTCON_USB)
 		extcon_set_state_sync(info->edev, EXTCON_CHG_USB_SDP,
 					attached);
+	if (id == EXTCON_CHG_USB_CDP)
+		extcon_set_state_sync(info->edev, EXTCON_USB, attached);
 
 	return 0;
 }
-- 
2.47.3

