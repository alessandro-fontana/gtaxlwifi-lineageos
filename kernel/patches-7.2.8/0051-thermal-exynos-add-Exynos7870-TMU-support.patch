From bb77726ad0218af55c42383287d3315263f59248 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:51 +0000
Subject: [PATCH] thermal: exynos: add Exynos7870 TMU support

Exynos7870 carries a single TEM1455X thermal probe at 0x10130000 with
the same register layout as "samsung,exynos7-tmu" (9-bit temperature,
paired thresholds at 0x50-0x6c, INTEN 0x110, INTPEND 0x118, EMUL 0x160),
so the new SOC_ARCH_EXYNOS7870 reuses the exynos7 callbacks wherever the
silicon matches, with four deviations - all verified on a live register
dump (kernel #44, gates opened by hand):

- tmu_control never touches the buffer slope / reference voltage /
  noise-cancel fields: on TEM1455X they are OTP-managed (the vendor
  driver explicitly skips them for this sensor type) and the silicon
  reads vref=0/slope=9 while converting correctly. get_con_reg() would
  detune the analog calibration. Only CORE_EN is driven.
- One-point trimming with a 9-bit trim value: efuse window 100..500,
  default 330 (= the gtaxlwifi silicon value; the generic 8-bit window
  15..100 would reject every valid 7870 fuse and wreck the readouts by
  ~250 codes).
- TEM1455X readout quirk: +12.5% compensation when the PTAT control OTP
  (TRIMINFO[20:18]) is zero, as the vendor driver does. Inert on the
  known units (OTP reads 1) but kept for other specimens.
- Clocks taken in bulk: six PERI gates for one block. The register file
  aborts without the CPUCL0 APB gate, and gating a probe sclk while the
  block is live hangs the interconnect (both learned the hard way), so
  all six stay enabled for the life of the device.

The five exynos7-conditional sites (two 9-bit masks, emul data field,
emul_con offset, intpend offset) are extended to the new soc type.

Trip points and cooling maps come from the DT (patch 0078), translated
from the ECT AP_THERMAL block of this SoC.
---
 drivers/thermal/samsung/exynos_tmu.c | 123 +++++++++++++++++++++++++--
 1 file changed, 114 insertions(+), 9 deletions(-)

diff --git a/drivers/thermal/samsung/exynos_tmu.c b/drivers/thermal/samsung/exynos_tmu.c
index 47a99b3c53..05e9654262 100644
--- a/drivers/thermal/samsung/exynos_tmu.c
+++ b/drivers/thermal/samsung/exynos_tmu.c
@@ -116,6 +116,10 @@
 #define EXYNOS7_EMUL_DATA_SHIFT			7
 #define EXYNOS7_EMUL_DATA_MASK			0x1ff
 
+/* Exynos7870 specific registers (TEM1455X sensor) */
+#define EXYNOS7870_TMU_PTAT_CONT_SHIFT		18
+#define EXYNOS7870_TMU_PTAT_CONT_MASK		0x7
+
 #define EXYNOS_FIRST_POINT_TRIM			25
 #define EXYNOS_SECOND_POINT_TRIM		85
 
@@ -133,6 +137,7 @@ enum soc_type {
 	SOC_ARCH_EXYNOS5420_TRIMINFO,
 	SOC_ARCH_EXYNOS5433,
 	SOC_ARCH_EXYNOS7,
+	SOC_ARCH_EXYNOS7870,
 };
 
 /**
@@ -159,6 +164,7 @@ enum soc_type {
  *	0 < reference_voltage <= 31
  * @tzd: pointer to thermal_zone_device structure
  * @enabled: current status of TMU device
+ * @ptat_comp: apply the TEM1455X +12.5%% readout compensation (Exynos7870)
  * @tmu_set_low_temp: SoC specific method to set trip (falling threshold)
  * @tmu_set_high_temp: SoC specific method to set trip (rising threshold)
  * @tmu_set_crit_temp: SoC specific method to set critical temperature
@@ -186,6 +192,7 @@ struct exynos_tmu_data {
 	u8 reference_voltage;
 	struct thermal_zone_device *tzd;
 	bool enabled;
+	bool ptat_comp;
 
 	void (*tmu_set_low_temp)(struct exynos_tmu_data *data, u8 temp);
 	void (*tmu_set_high_temp)(struct exynos_tmu_data *data, u8 temp);
@@ -220,8 +227,15 @@ static int temp_to_code(struct exynos_tmu_data *data, u8 temp)
  */
 static int code_to_temp(struct exynos_tmu_data *data, u16 temp_code)
 {
-	if (data->cal_type == TYPE_ONE_POINT_TRIMMING)
-		return temp_code - data->temp_error1 + EXYNOS_FIRST_POINT_TRIM;
+	int temp;
+
+	if (data->cal_type == TYPE_ONE_POINT_TRIMMING) {
+		temp = temp_code - data->temp_error1 + EXYNOS_FIRST_POINT_TRIM;
+		/* TEM1455X PTAT-control quirk, see exynos7870_tmu_initialize() */
+		if (data->ptat_comp)
+			temp += temp >> 3;
+		return temp;
+	}
 
 	return (temp_code - data->temp_error1) *
 		(EXYNOS_SECOND_POINT_TRIM - EXYNOS_FIRST_POINT_TRIM) /
@@ -232,8 +246,9 @@ static int code_to_temp(struct exynos_tmu_data *data, u16 temp_code)
 static void sanitize_temp_error(struct exynos_tmu_data *data, u32 trim_info)
 {
 	u16 tmu_temp_mask =
-		(data->soc == SOC_ARCH_EXYNOS7) ? EXYNOS7_TMU_TEMP_MASK
-						: EXYNOS_TMU_TEMP_MASK;
+		(data->soc == SOC_ARCH_EXYNOS7 ||
+		 data->soc == SOC_ARCH_EXYNOS7870) ? EXYNOS7_TMU_TEMP_MASK
+						   : EXYNOS_TMU_TEMP_MASK;
 
 	data->temp_error1 = trim_info & tmu_temp_mask;
 	data->temp_error2 = ((trim_info >> EXYNOS_TRIMINFO_85_SHIFT) &
@@ -355,8 +370,9 @@ static void exynos_tmu_update_temp(struct exynos_tmu_data *data, int reg_off,
 	u32 th;
 
 	tmu_temp_mask =
-		(data->soc == SOC_ARCH_EXYNOS7) ? EXYNOS7_TMU_TEMP_MASK
-						: EXYNOS_TMU_TEMP_MASK;
+		(data->soc == SOC_ARCH_EXYNOS7 ||
+		 data->soc == SOC_ARCH_EXYNOS7870) ? EXYNOS7_TMU_TEMP_MASK
+						   : EXYNOS_TMU_TEMP_MASK;
 
 	th = readl(data->base + reg_off);
 	th &= ~(tmu_temp_mask << bit_off);
@@ -582,6 +598,23 @@ static void exynos7_tmu_initialize(struct platform_device *pdev)
 	sanitize_temp_error(data, trim_info);
 }
 
+static void exynos7870_tmu_initialize(struct platform_device *pdev)
+{
+	struct exynos_tmu_data *data = platform_get_drvdata(pdev);
+	unsigned int trim_info;
+
+	trim_info = readl(data->base + EXYNOS_TMU_REG_TRIMINFO);
+	/*
+	 * TEM1455X sensor: readouts need a +12.5% compensation when the
+	 * PTAT control OTP value is zero (vendor driver behaviour). Not
+	 * the case on the known gtaxlwifi units (OTP reads 1), but keep
+	 * the vendor rule for other specimens.
+	 */
+	data->ptat_comp = !((trim_info >> EXYNOS7870_TMU_PTAT_CONT_SHIFT) &
+			    EXYNOS7870_TMU_PTAT_CONT_MASK);
+	sanitize_temp_error(data, trim_info);
+}
+
 static void exynos4210_tmu_control(struct platform_device *pdev, bool on)
 {
 	struct exynos_tmu_data *data = platform_get_drvdata(pdev);
@@ -633,6 +666,30 @@ static void exynos7_tmu_control(struct platform_device *pdev, bool on)
 	writel(con, data->base + EXYNOS_TMU_REG_CONTROL);
 }
 
+static void exynos7870_tmu_control(struct platform_device *pdev, bool on)
+{
+	struct exynos_tmu_data *data = platform_get_drvdata(pdev);
+	unsigned int con;
+
+	/*
+	 * On the Exynos7870 TEM1455X sensor the buffer slope and reference
+	 * voltage fields in TMU_CONTROL are OTP-managed and must be left
+	 * exactly as programmed by the bootloader: the vendor driver
+	 * explicitly skips writing them for this sensor type, and the
+	 * generic get_con_reg() values would detune the analog calibration
+	 * (silicon reads vref=0/slope=9 and converts correctly as-is).
+	 * Only the core enable bit is touched here.
+	 */
+	con = readl(data->base + EXYNOS_TMU_REG_CONTROL);
+
+	if (on)
+		con |= BIT(EXYNOS_TMU_CORE_EN_SHIFT);
+	else
+		con &= ~BIT(EXYNOS_TMU_CORE_EN_SHIFT);
+
+	writel(con, data->base + EXYNOS_TMU_REG_CONTROL);
+}
+
 static int exynos_get_temp(struct thermal_zone_device *tz, int *temp)
 {
 	struct exynos_tmu_data *data = thermal_zone_device_priv(tz);
@@ -671,7 +728,8 @@ static u32 get_emul_con_reg(struct exynos_tmu_data *data, unsigned int val,
 
 		val &= ~(EXYNOS_EMUL_TIME_MASK << EXYNOS_EMUL_TIME_SHIFT);
 		val |= (EXYNOS_EMUL_TIME << EXYNOS_EMUL_TIME_SHIFT);
-		if (data->soc == SOC_ARCH_EXYNOS7) {
+		if (data->soc == SOC_ARCH_EXYNOS7 ||
+		    data->soc == SOC_ARCH_EXYNOS7870) {
 			val &= ~(EXYNOS7_EMUL_DATA_MASK <<
 				EXYNOS7_EMUL_DATA_SHIFT);
 			val |= (temp_to_code(data, temp) <<
@@ -701,7 +759,8 @@ static void exynos4412_tmu_set_emulation(struct exynos_tmu_data *data,
 		emul_con = EXYNOS5260_EMUL_CON;
 	else if (data->soc == SOC_ARCH_EXYNOS5433)
 		emul_con = EXYNOS5433_TMU_EMUL_CON;
-	else if (data->soc == SOC_ARCH_EXYNOS7)
+	else if (data->soc == SOC_ARCH_EXYNOS7 ||
+		 data->soc == SOC_ARCH_EXYNOS7870)
 		emul_con = EXYNOS7_TMU_REG_EMUL_CON;
 	else
 		emul_con = EXYNOS_EMUL_CON;
@@ -782,7 +841,8 @@ static void exynos4210_tmu_clear_irqs(struct exynos_tmu_data *data)
 	if (data->soc == SOC_ARCH_EXYNOS5260) {
 		tmu_intstat = EXYNOS5260_TMU_REG_INTSTAT;
 		tmu_intclear = EXYNOS5260_TMU_REG_INTCLEAR;
-	} else if (data->soc == SOC_ARCH_EXYNOS7) {
+	} else if (data->soc == SOC_ARCH_EXYNOS7 ||
+		   data->soc == SOC_ARCH_EXYNOS7870) {
 		tmu_intstat = EXYNOS7_TMU_REG_INTPEND;
 		tmu_intclear = EXYNOS7_TMU_REG_INTPEND;
 	} else if (data->soc == SOC_ARCH_EXYNOS5433) {
@@ -833,6 +893,9 @@ static const struct of_device_id exynos_tmu_match[] = {
 	}, {
 		.compatible = "samsung,exynos7-tmu",
 		.data = (const void *)SOC_ARCH_EXYNOS7,
+	}, {
+		.compatible = "samsung,exynos7870-tmu",
+		.data = (const void *)SOC_ARCH_EXYNOS7870,
 	},
 	{ },
 };
@@ -945,6 +1008,29 @@ static int exynos_map_dt_data(struct platform_device *pdev)
 		data->min_efuse_value = 15;
 		data->max_efuse_value = 100;
 		break;
+	case SOC_ARCH_EXYNOS7870:
+		data->tmu_set_low_temp = exynos7_tmu_set_low_temp;
+		data->tmu_set_high_temp = exynos7_tmu_set_high_temp;
+		data->tmu_disable_low = exynos7_tmu_disable_low;
+		data->tmu_disable_high = exynos7_tmu_disable_high;
+		data->tmu_set_crit_temp = exynos7_tmu_set_crit_temp;
+		data->tmu_initialize = exynos7870_tmu_initialize;
+		data->tmu_control = exynos7870_tmu_control;
+		data->tmu_read = exynos7_tmu_read;
+		data->tmu_set_emulation = exynos4412_tmu_set_emulation;
+		data->tmu_clear_irqs = exynos4210_tmu_clear_irqs;
+		/*
+		 * One-point trimming at 25C with a 9-bit trim value: the
+		 * generic 8-bit sanity window would reject every valid
+		 * Exynos7870 fuse. Window and default from silicon
+		 * (gtaxlwifi fuses read trim25 = 330).
+		 * gain/reference_voltage are intentionally left unset:
+		 * exynos7870_tmu_control() never writes them (OTP-managed).
+		 */
+		data->efuse_value = 330;
+		data->min_efuse_value = 100;
+		data->max_efuse_value = 500;
+		break;
 	default:
 		dev_err(&pdev->dev, "Platform not supported\n");
 		return -EINVAL;
@@ -1036,6 +1122,24 @@ static int exynos_tmu_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	if (data->soc == SOC_ARCH_EXYNOS7870) {
+		struct clk_bulk_data *clks;
+
+		/*
+		 * Single TMU block behind six PERI gates (three sclk, three
+		 * APB gates). The register file dies without the CPUCL0 APB
+		 * gate, and gating a probe sclk while the block is live
+		 * hangs the interconnect (both verified on silicon), so all
+		 * six are kept enabled for the life of the device. data->clk
+		 * stays NULL: clk_enable(NULL) in the read paths is a no-op.
+		 */
+		ret = devm_clk_bulk_get_all_enabled(dev, &clks);
+		if (ret < 0)
+			return dev_err_probe(dev, ret,
+					     "Failed to enable bulk clocks\n");
+		goto clocks_ready;
+	}
+
 	data->clk = devm_clk_get(dev, "tmu_apbif");
 	if (IS_ERR(data->clk))
 		return dev_err_probe(dev, PTR_ERR(data->clk), "Failed to get clock\n");
@@ -1078,6 +1182,7 @@ static int exynos_tmu_probe(struct platform_device *pdev)
 		break;
 	}
 
+clocks_ready:
 	ret = exynos_tmu_initialize(pdev);
 	if (ret) {
 		dev_err(dev, "Failed to initialize TMU\n");
-- 
2.47.3

