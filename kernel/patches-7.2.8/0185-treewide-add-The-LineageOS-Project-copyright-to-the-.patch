  * Derived from the vendor driver drivers/battery_v2/sm5703_charger.c:
  *   Copyright (C) 2013 Silicon Mitus Technology Corp.
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/bitfield.h>
diff --git a/drivers/power/supply/sm5703_fuelgauge.c b/drivers/power/supply/sm5703_fuelgauge.c
index 3403ebc5f2..b07868ef41 100644
--- a/drivers/power/supply/sm5703_fuelgauge.c
+++ b/drivers/power/supply/sm5703_fuelgauge.c
@@ -16,6 +16,8 @@
  * Derived from the vendor driver drivers/battery_v2/sm5703_fuelgauge.c:
  *   Copyright (C) 2013 Samsung Electronics, Dongik Sin <dongik.sin@samsung.com>
  *   Copyright (C) 2015 Silicon Mitus, SW Jung
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/bits.h>
diff --git a/drivers/soc/samsung/exynos7870-asv-dump.c b/drivers/soc/samsung/exynos7870-asv-dump.c
index 4360ebc6e5..e47a9abb49 100644
--- a/drivers/soc/samsung/exynos7870-asv-dump.c
+++ b/drivers/soc/samsung/exynos7870-asv-dump.c
@@ -14,6 +14,8 @@
  *
  * Collocazione: drivers/soc/samsung/exynos7870-asv-dump.c
  * Makefile (stessa directory):  obj-y += exynos7870-asv-dump.o
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/init.h>
diff --git a/drivers/soc/samsung/exynos7870-pmu.c b/drivers/soc/samsung/exynos7870-pmu.c
index a6dda2a5f1..e6936254f7 100644
--- a/drivers/soc/samsung/exynos7870-pmu.c
+++ b/drivers/soc/samsung/exynos7870-pmu.c
@@ -14,6 +14,8 @@
  * power on the next plain WFI.
  *
  * CPU_OFF (hotplug) needs none of this: the firmware programs the PMU itself.
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/bits.h>
diff --git a/include/linux/mfd/sm5703.h b/include/linux/mfd/sm5703.h
index 6472dc9c61..5ec6ad00a3 100644
--- a/include/linux/mfd/sm5703.h
+++ b/include/linux/mfd/sm5703.h
@@ -3,6 +3,8 @@
