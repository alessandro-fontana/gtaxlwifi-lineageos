  *
  * Copyright (C) 2022 Markuss Broks <markuss.broks@gmail.com>
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #ifndef __MFD_SM5703_H__
diff --git a/sound/soc/samsung/gtaxl_rt5659.c b/sound/soc/samsung/gtaxl_rt5659.c
index aecadef31d..e8de74d184 100644
--- a/sound/soc/samsung/gtaxl_rt5659.c
+++ b/sound/soc/samsung/gtaxl_rt5659.c
@@ -16,6 +16,8 @@
  * pad (not yet modelled) at the price of nothing, since clock
  * coherency is guaranteed by construction when the reference is the
  * bus clock itself.
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/io.h>
diff --git a/sound/soc/samsung/s1402x.c b/sound/soc/samsung/s1402x.c
index da87a25f0d..56543ae2e7 100644
--- a/sound/soc/samsung/s1402x.c
+++ b/sound/soc/samsung/s1402x.c
@@ -20,6 +20,8 @@
  * The IP is reset by the LPASS wrapper (MFD_EXYNOS_LPASS, DISPAUD_CFG
  * bit 0) before this device is populated; probe order is guaranteed by
  * the device hierarchy.
+ *
+ * Copyright (C) 2026 The LineageOS Project
  */
 
 #include <linux/clk.h>
