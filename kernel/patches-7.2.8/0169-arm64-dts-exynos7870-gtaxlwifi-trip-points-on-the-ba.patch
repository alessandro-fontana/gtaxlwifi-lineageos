From 69f1d7c294f1723538902a6794aa493fd0bb98df Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 28 Sep 2026 21:05:39 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: trip points on the battery
 zone

Android's thermal HAL learns about a temperature change from the thermal
netlink events, which are sent when a trip point is crossed; a zone
without trips is only read at boot.  Give the battery zone passive trips
at the thresholds the HAL configuration uses for it, with no cooling
maps: they exist to be reported, not to cool anything.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 40 +++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index d700a9998d..89d4ab57f0 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -244,6 +244,46 @@ battery-thermal {
 			polling-delay = <10000>;
 			polling-delay-passive = <5000>;
 			thermal-sensors = <&battery_thermistor>;
+
+			/*
+			 * Nessun raffreddamento: i trip servono perche' la HAL
+			 * termica di Android riceve un evento netlink a ogni
+			 * attraversamento, e sono le soglie che la sua
+			 * configurazione da' a questa zona (thermal.json). La
+			 * carica la ferma il charger, a 50 gradi, per conto suo.
+			 */
+			trips {
+				trip-light {
+					temperature = <40000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				trip-moderate {
+					temperature = <42000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				trip-severe {
+					temperature = <45000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				trip-critical {
+					temperature = <48000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				trip-emergency {
+					temperature = <52000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				trip-shutdown {
+					temperature = <60000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+			};
 		};
 	};
 
-- 
