From f644e2ceb9f4f24f29400512fc4138f57984b2d0 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 6 Sep 2026 10:00:00 +0200
Subject: [PATCH] drm/exynos: decon7: leave the blending bits to
 decon_win_set_bldmod()

decon_win_set_pixfmt() sets WINCONx_BLD_PIX and WINCONx_ALPHA_SEL for
every format that carries an alpha channel, on the sole basis of the
framebuffer format. Since "drm/exynos: decon7: implement per-window
blending" those two bits belong to decon_win_set_bldmod(), which
derives them from the plane's pixel blend mode and alpha properties.

decon_update_plane() calls decon_win_set_bldmod() and then
decon_win_set_pixfmt(), so the switch statement runs last and
overwrites the decision that was just taken: a plane whose pixel blend
mode is DRM_MODE_BLEND_PIXEL_NONE still ends up with per-pixel blending
enabled as soon as its framebuffer has an alpha channel.

Drop the two bits from the format switch. decon_win_set_pixfmt() only
clears WINCONx_BPPMODE_MASK before its read-modify-write, so whatever
decon_win_set_bldmod() programmed is preserved. This matches
exynos5433_drm_decon.c, whose format switch touches the pixel format
alone and leaves blending to bldmod/bldeq.

No functional change with drmfb-composer, which asks for XBGR8888 on
the primary plane and never reaches those cases.
---
 drivers/gpu/drm/exynos/exynos7_drm_decon.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/exynos/exynos7_drm_decon.c b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
index c5ffba7e21..2d880c0aca 100644
--- a/drivers/gpu/drm/exynos/exynos7_drm_decon.c
+++ b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
@@ -407,24 +407,20 @@ static void decon_win_set_pixfmt(struct decon_context *ctx, unsigned int win,
 		val |= WINCONx_BURSTLEN_16WORD(shift);
 		break;
 	case DRM_FORMAT_ARGB8888:
-		val |= WINCONx_BPPMODE_32BPP_ARGB | WINCONx_BLD_PIX |
-			WINCONx_ALPHA_SEL;
+		val |= WINCONx_BPPMODE_32BPP_ARGB;
 		val |= WINCONx_BURSTLEN_16WORD(shift);
 		break;
 	case DRM_FORMAT_ABGR8888:
-		val |= WINCONx_BPPMODE_32BPP_ABGR | WINCONx_BLD_PIX |
-			WINCONx_ALPHA_SEL;
+		val |= WINCONx_BPPMODE_32BPP_ABGR;
 		val |= WINCONx_BURSTLEN_16WORD(shift);
 		break;
 	case DRM_FORMAT_RGBA8888:
-		val |= WINCONx_BPPMODE_32BPP_RGBA | WINCONx_BLD_PIX |
-			WINCONx_ALPHA_SEL;
+		val |= WINCONx_BPPMODE_32BPP_RGBA;
 		val |= WINCONx_BURSTLEN_16WORD(shift);
 		break;
 	case DRM_FORMAT_BGRA8888:
 	default:
-		val |= WINCONx_BPPMODE_32BPP_BGRA | WINCONx_BLD_PIX |
-			WINCONx_ALPHA_SEL;
+		val |= WINCONx_BPPMODE_32BPP_BGRA;
 		val |= WINCONx_BURSTLEN_16WORD(shift);
 		break;
 	}
