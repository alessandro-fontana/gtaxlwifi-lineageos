From 0064139b4d9f8c1c8474511ccd6a5cdc709e919d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:55 +0000
Subject: [PATCH] Bluetooth: add HCI_QUIRK_BROKEN_LE_DATA_LEN_EXT and set it
 for QCA ROME

Il QCA9377 del gtaxlwifi, caricato con l'NVM di Samsung
(nvm_tlv_tf_1.1.bin, rinominato nvm_00230302.bin), riporta il feature bit
LE Data Length Extension ma risponde a HCI_OP_LE_READ_MAX_DATA_LEN con un
command complete malformato:

  Bluetooth: hci0: unexpected cc 0x202f length: 1 < 9
  Bluetooth: hci0: Opcode 0x202f failed: -38

L'inizializzazione HCI si interrompe con -ENOSYS, hdev resta registrato ma
non viene mai acceso, e BlueZ non espone il controller.

Con l'NVM generico di linux-firmware il bit non e' impostato e il comando
non viene mai inviato, quindi il difetto e' invisibile: e' la
configurazione NVM a dichiarare una capacita' che il controller non ha.

Il quirk segue la forma di HCI_QUIRK_BROKEN_LE_CODED, che copre lo stesso
tipo di difetto (bit dichiarato, uso non supportato). Tutti e quattro i
punti in cui il kernel si fida di HCI_LE_DATA_LEN_EXT passano ora da un
helper unico, cosi' che anche l'evento LE Data Length Change non venga
abilitato per un controller che non lo genererebbe.

NOTA DA RISOLVERE PRIMA DI PROPORRE A MONTE: qui il quirk e' impostato per
tutti i QCA_ROME, il che e' troppo largo -- il difetto viene dalla
configurazione NVM, non dal silicio. La forma accettabile a monte richiede
o una rilevazione a runtime, o un aggancio piu' stretto alla
configurazione caricata.
---
 drivers/bluetooth/hci_qca.c | 18 ++++++++++++++++--
 include/net/bluetooth/hci.h | 11 +++++++++++
 net/bluetooth/hci_sync.c    | 25 ++++++++++++++++++++-----
 3 files changed, 47 insertions(+), 7 deletions(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 875093e61c..d640e500e8 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -2074,10 +2074,24 @@ static int qca_setup(struct hci_uart *hu)
 	}
 
 	/* Setup bdaddr */
-	if (soc_type == QCA_ROME)
+	if (soc_type == QCA_ROME) {
 		hu->hdev->set_bdaddr = qca_set_bdaddr_rome;
-	else
+
+		/* Some ROME NVM configurations, among them the one Samsung
+		 * ships for the QCA9377 in the Galaxy Tab A 10.1, advertise
+		 * the LE Data Length Extension feature bit but answer the
+		 * related commands with a malformed command complete event:
+		 *
+		 *   unexpected cc 0x202f length: 1 < 9
+		 *   Opcode 0x202f failed: -38
+		 *
+		 * which aborts HCI initialisation and leaves the controller
+		 * registered but never powered on.
+		 */
+		hci_set_quirk(hu->hdev, HCI_QUIRK_BROKEN_LE_DATA_LEN_EXT);
+	} else {
 		hu->hdev->set_bdaddr = qca_set_bdaddr;
+	}
 
 	if (qcadev && qcadev->support_hfp_hw_offload)
 		qca_configure_hfp_offload(hdev);
diff --git a/include/net/bluetooth/hci.h b/include/net/bluetooth/hci.h
index 50f0eef71f..6b1b00a3f1 100644
--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -375,6 +375,17 @@ enum {
 	 */
 	HCI_QUIRK_BROKEN_READ_PAGE_SCAN_TYPE,
 
+	/* When this quirk is set, the LE Data Length Extension feature bit is
+	 * reported by the controller, but the related commands
+	 * (HCI_OP_LE_READ_MAX_DATA_LEN, HCI_OP_LE_READ_DEF_DATA_LEN and
+	 * HCI_OP_LE_WRITE_DEF_DATA_LEN) answer with a malformed command
+	 * complete event, which aborts initialisation with -ENOSYS.
+	 *
+	 * This quirk can be set before hci_register_dev is called or
+	 * during the hdev->setup vendor callback.
+	 */
+	HCI_QUIRK_BROKEN_LE_DATA_LEN_EXT,
+
 	__HCI_NUM_QUIRKS,
 };
 
diff --git a/net/bluetooth/hci_sync.c b/net/bluetooth/hci_sync.c
index 9d9e270492..d6b975aae7 100644
--- a/net/bluetooth/hci_sync.c
+++ b/net/bluetooth/hci_sync.c
@@ -4430,6 +4430,18 @@ static const struct hci_init_stage hci_init3[] = {
 	{}
 };
 
+/* The LE Data Length Extension feature bit is only usable if the controller
+ * actually implements the related commands. Some of them advertise the bit
+ * but answer with a malformed command complete event.
+ */
+static bool hci_le_data_len_ext_capable(struct hci_dev *hdev)
+{
+	if (hci_test_quirk(hdev, HCI_QUIRK_BROKEN_LE_DATA_LEN_EXT))
+		return false;
+
+	return !!(hdev->le_features[0] & HCI_LE_DATA_LEN_EXT);
+}
+
 static int hci_le_set_event_mask_sync(struct hci_dev *hdev)
 {
 	u8 events[8];
@@ -4452,7 +4464,7 @@ static int hci_le_set_event_mask_sync(struct hci_dev *hdev)
 	/* If the controller supports the Data Length Extension
 	 * feature, enable the corresponding event.
 	 */
-	if (hdev->le_features[0] & HCI_LE_DATA_LEN_EXT)
+	if (hci_le_data_len_ext_capable(hdev))
 		events[0] |= 0x40;	/* LE Data Length Change */
 
 	/* If the controller supports LL Privacy feature or LE Extended Adv,
@@ -4656,7 +4668,7 @@ static int hci_le_set_rpa_timeout_sync(struct hci_dev *hdev)
 /* Read LE Maximum Data Length */
 static int hci_le_read_max_data_len_sync(struct hci_dev *hdev)
 {
-	if (!(hdev->le_features[0] & HCI_LE_DATA_LEN_EXT))
+	if (!hci_le_data_len_ext_capable(hdev))
 		return 0;
 
 	return __hci_cmd_sync_status(hdev, HCI_OP_LE_READ_MAX_DATA_LEN, 0, NULL,
@@ -4666,7 +4678,7 @@ static int hci_le_read_max_data_len_sync(struct hci_dev *hdev)
 /* Read LE Suggested Default Data Length */
 static int hci_le_read_def_data_len_sync(struct hci_dev *hdev)
 {
-	if (!(hdev->le_features[0] & HCI_LE_DATA_LEN_EXT))
+	if (!hci_le_data_len_ext_capable(hdev))
 		return 0;
 
 	return __hci_cmd_sync_status(hdev, HCI_OP_LE_READ_DEF_DATA_LEN, 0, NULL,
@@ -4997,7 +5009,7 @@ static int hci_le_set_write_def_data_len_sync(struct hci_dev *hdev)
 {
 	struct hci_cp_le_write_def_data_len cp;
 
-	if (!(hdev->le_features[0] & HCI_LE_DATA_LEN_EXT))
+	if (!hci_le_data_len_ext_capable(hdev))
 		return 0;
 
 	memset(&cp, 0, sizeof(cp));
@@ -5156,7 +5168,10 @@ static const struct {
 			 "and will not be used."),
 	HCI_QUIRK_BROKEN(LE_CODED,
 			 "HCI LE Coded PHY feature bit is set, "
-			 "but its usage is not supported.")
+			 "but its usage is not supported."),
+	HCI_QUIRK_BROKEN(LE_DATA_LEN_EXT,
+			 "HCI LE Data Length Extension feature bit is set, "
+			 "but the related commands are not supported.")
 };
 
 /* This function handles hdev setup stage:
-- 
2.47.3

