From 87f36e432681a3f60637fa868838e81a99bdeffb Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 29 Sep 2026 12:51:15 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: the Wi-Fi SDIO bus is a
 wakeup source

WoWLAN wakes the host through the in-band SDIO interrupt: the stock
out-of-band line (gpa2-2) is not driven by the chip under ath10k.

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 89d4ab57f0..be33e5d8f1 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -1519,6 +1519,12 @@ &mmc1 {
 	cap-sd-highspeed;
 	cap-sdio-irq;
 	keep-power-in-suspend;
+	/*
+	 * WoWLAN (§68): in sospensione il firmware sveglia l'host con
+	 * l'interrupt SDIO. Lo stock usava una linea fuori banda (gpa2-2,
+	 * wlan-host-wake del nodo cnss), che con ath10k il chip non pilota.
+	 */
+	wakeup-source;
 
 	status = "okay";
 
-- 
2.47.3

