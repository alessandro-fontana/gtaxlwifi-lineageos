From f3d76b6dbb0b9ea5eb985fabe5af4e9ef517a96d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 13:32:36 +0200
Subject: [PATCH] arm64: configs: gtaxlwifi: enable the front camera

Media core, V4L2 subdevice API, the Exynos7870 CSIS receiver and the
SR259 sensor, all as modules.

---
 arch/arm64/configs/gtaxlwifi_defconfig | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/gtaxlwifi_defconfig b/arch/arm64/configs/gtaxlwifi_defconfig
index a08060e475..82f5420ad5 100644
--- a/arch/arm64/configs/gtaxlwifi_defconfig
+++ b/arch/arm64/configs/gtaxlwifi_defconfig
@@ -3218,7 +3218,16 @@ CONFIG_REGULATOR_S2MPS11=y
 # CONFIG_MEDIA_CEC_SUPPORT is not set
 # end of CEC support
 
-# CONFIG_MEDIA_SUPPORT is not set
+CONFIG_MEDIA_SUPPORT=m
+CONFIG_MEDIA_SUPPORT_FILTER=y
+CONFIG_MEDIA_CAMERA_SUPPORT=y
+CONFIG_MEDIA_PLATFORM_SUPPORT=y
+CONFIG_MEDIA_CONTROLLER=y
+CONFIG_VIDEO_V4L2_SUBDEV_API=y
+CONFIG_V4L_PLATFORM_DRIVERS=y
+CONFIG_VIDEO_EXYNOS7870_CSIS=m
+CONFIG_VIDEO_CAMERA_SENSOR=y
+CONFIG_VIDEO_SR259=m
 
 #
 # Graphics support
-- 
2.47.3

