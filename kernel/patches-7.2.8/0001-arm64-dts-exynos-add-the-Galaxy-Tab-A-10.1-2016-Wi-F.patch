+			 * comunque, ma senza questo nodo non ha vincoli
+			 * macchina e regulator_set_voltage() viene
+			 * rifiutato: dichiararlo serve al DVFS GPU.
+			 * Intervallo e ramp identici al downstream
+			 * (500000-1300000, 12000). always-on/boot-on come
+			 * il vendor: e' il rail di un dominio del SoC, non
+			 * deve mai essere spento dal cleanup dei regolatori.
+			 */
+			/*
+			 * BUCK1 = VDD_CPU, UNICO rail per entrambi i cluster:
+			 * exynos7870.dtsi downstream righe 432/442, cl0_regulator
+			 * e cl1_regulator entrambi "BUCK1". Il downstream lo
+			 * protegge con regulator-expected-consumer=2 (il buck non
+			 * scende finche' entrambi i consumer non sono registrati);
+			 * in mainline lo stesso ruolo lo fa l'aggregazione dei
+			 * consumer del regulator framework, con gli opp-microvolt
+			 * a tripletta <target min max> nelle tabelle OPP: il rail
+			 * resta sempre alla tensione del cluster piu' esigente.
+			 * Misurato al boot: 762.5 mV = ASV(902 MHz) grp5 esatto.
+			 */
+			buck1_reg: buck1 {
+				regulator-name = "vdd_cpu";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			buck2_reg: buck2 {
+				regulator-name = "vdd_g3d";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/*
+			 * microSD: vqmmc. Il downstream lo chiama letteralmente
+			 * "vqmmc" (exynos7870-gtaxlwifi_chn_open_00.dts, blocco
+			 * s2mpu05, ldo2_reg), con le stesse identiche tensioni e
+			 * lo stesso ramp-delay che exynos7870-j6lte.dts mette in
+			 * vdd_ldo2. La forcella 1,8-2,8 V non e' decorativa: e' il
+			 * rail di segnalazione a doppio intervallo su cui poggia
+			 * la commutazione UHS, e senza di essa mmc2 resterebbe
+			 * confinata alle modalita' a 2,8 V.
+			 *
+			 * Attenzione all'omonimia: nello stesso DTS downstream
+			 * esiste un sm5703_ldo2_reg, che sta su un altro PMIC ed
+			 * e' VDD_SENSOR_2P8. Non c'entra nulla.
+			 */
+			vdd_ldo2: ldo2 {
+				regulator-name = "vqmmc";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/*
+			 * Accelerometro LIS2HH12 su i2c7: rail di I/O. Il
+			 * downstream lo lega come "k2hh,vio-supply", con gli
+			 * stessi identici valori dichiarati qui.
+			 *
+			 * Il VDD del chip non e' dichiarato in nessuno dei due
+			 * alberi. Il driver vendor non lo gestisce affatto
+			 * (CONFIG_SENSORS_K2HH_VDD non e' impostata nel
+			 * defconfig di questa scheda), quindi arriva acceso.
+			 * Il nome sospetto e' VDD_SENSOR_2P8 sull'SM5703, ma
+			 * quel nodo (sm5703_ldo2_reg) e' codice morto: nessuno
+			 * lo referenzia e ha boot-on e always-on entrambi
+			 * commentati. Vale la stessa nota dell'ADC piu' sotto:
+			 * st_sensors_core chiede "vdd" e "vddio", e senza la
+			 * proprieta' ripiega su un regolatore fittizio con un
+			 * warning. Mettere un LDO a caso e' peggio che ometterlo.
+			 */
+			vdd_ldo3: ldo3 {
+				regulator-name = "vdd_ldo3";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/*
+			 * usbdrd: vdd33. Serve sia a U-Boot (senza, il
+			 * gadget fastboot non parte e il menu risponde
+			 * "no USB device found") sia al kernel, dove la
+			 * sua assenza produce il warning
+			 * "supply vbus not found, using dummy regulator".
+			 * Tensioni identiche al J6 e al downstream.
+			 */
+			vdd_ldo8: ldo8 {
+				regulator-name = "vdd_ldo8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3375000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/* eMMC: vmmc — downstream lo chiama "vemmc" */
+			vdd_ldo26: ldo26 {
+				regulator-name = "vemmc";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+			};
+
+			/* eMMC: vqmmc — downstream lo chiama "vqemmc" */
+			vdd_ldo27: ldo27 {
+				regulator-name = "vqemmc";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+			};
+
+			/*
+			 * Sensore di luce CM3323 su i2c7. Il downstream lo lega
+			 * come "cm3323-i2c,vdd-supply" e NON dichiara ne' boot-on
+			 * ne' always-on sull'LDO: e' il driver vendor a tenerlo
+			 * acceso, guidato dalla proprieta' non-standard
+			 * "cm3323-i2c,vdd-alwayson = <1>" sul nodo del sensore.
+			 *
+			 * cm3323.c in mainline non ha quel meccanismo, quindi
+			 * always-on qui non e' pigrizia: senza, nessuno accende
+			 * il rail e il chip non risponde. Tensione fissa a 2,8 V,
+			 * identica al downstream.
+			 */
+			vdd_ldo33: ldo33 {
+				regulator-name = "vdd_ldo33";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/*
+			 * Pannello. always-on e' voluto: finche' si usa
+			 * simple-framebuffer nessun driver lo richiede, e
+			 * spegnerlo significa perdere lo schermo.
+			 * Da rivedere quando arrivera' DECON/DSI.
+			 */
+			vdd_ldo35: ldo35 {
+				regulator-name = "LCD_1P8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/*
+			 * Codec audio RT5659: LDO25 (1,8 V) e LDO32 (3,3 V).
+			 *
+			 * La mappa viene dal downstream, per label e non per
+			 * nome: exynos7870-gtaxl_sound_07.dtsi righe 149-150
+			 *
+			 *     realtek,regulator_1v8 = <&ldo25_reg>;
+			 *     realtek,regulator_3v3 = <&ldo32_reg>;
+			 *
+			 * e exynos7870-gtaxlwifi_eur_open_04/05.dts, dove
+			 * ldo25_reg porta regulator-name = "VDD_CODEC_1P8"
+			 * con always-on.
+			 *
+			 * Fino al 21 agosto questo file dava il nome
+			 * VDD_CODEC_1P8 a LDO30, che con questa scheda non
+			 * c'entra nulla. LDO25 non era dichiarato affatto,
+			 * S-BOOT lo lascia spento (reg 0x47 = 0x28, enable
+			 * a 00) e nulla lo accendeva: il codec e' rimasto
+			 * senza alimentazione digitale per l'intera campagna.
+			 * Da qui la firma da slave non alimentato su gpc1-2/3
+			 * e l'irrilevanza del ciclo su LDO30/LDO32.
+			 *
+			 * boot-on + always-on perche' il driver rt5659
+			 * mainline non ha una tabella di supply (nessun
+			 * rt5659_supply_names[] in sound/soc/codecs/rt5659.c):
+			 * non esiste un consumer che possa reclamarli, e
+			 * senza always-on resterebbero in balia del cleanup
+			 * dei regolatori non usati.
+			 *
+			 * La sequenza di accensione vera la fanno i GPIO
+			 * ldo1-en/reset del nodo del codec, ma solo dopo che
+			 * questi due rail sono su.
+			 */
+			vdd_ldo25: ldo25 {
+				regulator-name = "VDD_CODEC_1P8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo32: ldo32 {
+				regulator-name = "VDD_CODEC_3P3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/*
+			 * LDO30: rail da 1,8 V acceso da S-BOOT (0x4c = 0xe8),
+			 * destinazione non identificata. Dichiarato con nome
+			 * neutro perche' l'etichetta precedente era falsa e
+			 * ha depistato due sessioni di diagnosi. Non toccarlo
+			 * finche' non si sa cosa alimenta.
+			 */
+			vdd_ldo30: ldo30 {
+				regulator-name = "vdd_ldo30";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+		};
+	};
+};
+
+/*
+ * ======================================================================
+ * eMMC
+ * ======================================================================
+ * Valori identici tra il J6 mainline e il downstream del tablet:
+ * ciu-div = 3, fifo-depth = 64 (0x40), non-removable, 8 bit,
+ * HS200/HS400 a 1,8 V.
+ *
+ * Le timing sdr/ddr sono quelle del J6 MAINLINE (due campi). Il
+ * downstream ne ha quattro — <3 0 4 0> e <3 0 4 2> — perche' e' un
+ * formato Samsung diverso: NON convertirle a mano.
+ *
+ * I pinctrl sd0_* stanno in exynos7870-pinctrl.dtsi, quindi sono gia'
+ * disponibili senza doverli definire.
+ */
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd0_clk &sd0_cmd &sd0_rdqs &sd0_bus1 &sd0_bus4 &sd0_bus8>;
+
+	vmmc-supply = <&vdd_ldo26>;
+	vqmmc-supply = <&vdd_ldo27>;
+
+	bus-width = <8>;
+	fifo-depth = <64>;
+
+	/*
+	 * Senza cap-mmc-highspeed il core MMC resta in legacy a 25 MHz:
+	 * mmc_select_timing() non entra in mmc_select_hs(), e mmc_select_hs_ddr()
+	 * e' subordinata a mmc_card_hs(card), quindi non viene mai raggiunta
+	 * nemmeno avendo la capability DDR. Misurato: 21 MB/s, bus saturo
+	 * all'82% del tetto legacy.
+	 *
+	 * MMC_CAP_1_8V_DDR e MMC_CAP_8_BIT_DATA arrivano gia' dal driver
+	 * (exynos_dwmmc_caps[0] in dw_mmc-exynos.c), la carta dichiara 0x57
+	 * in DEVICE_TYPE (HS26|HS52|DDR52|HS200|HS400) e vqmmc e' gia' a
+	 * 1,8 V: questa sola proprieta' porta quindi direttamente a DDR52.
+	 *
+	 * Il ctrl_id che indicizza quell'array e' mmc->index, e mmc->index
+	 * viene da of_alias_get_id(np, "mmc"): lo stem cercato dal codice e'
+	 * "mmc", non "mshc". E' l'alias mmc0 = &mmc0 in cima a questo file a
+	 * garantire l'indice 0, quindi caps[0], quindi DDR52. Senza gli alias
+	 * l'indice verrebbe da un ida_alloc_range() nell'ordine di probe, e
+	 * con tre controller attivi l'eMMC potrebbe perdere silenziosamente
+	 * MMC_CAP_1_8V_DDR e ricadere a HS52. Gli alias non sono cosmetici:
+	 * non toccarli.
+	 *
+	 * NON serve clock-frequency: dw_mci_exynos_adjust_clock() imposta il
+	 * rate del CIU a ogni set_ios. In legacy "wanted" viene alzato a
+	 * EXYNOS_CCLKIN_MIN, da cui bus_hz = 199,875/4 = 49,97 MHz, che e'
+	 * esattamente il "Bus speed = 49968750Hz" del dmesg.
+	 *
+	 * HS200/HS400 sono un passo separato: vogliono mmc-hs200-1_8v e poi
+	 * mmc-hs400-1_8v + samsung,dw-mshc-hs400-timing + read-strobe-delay,
+	 * con gli stessi vincoli di formato a due celle descritti sotto.
+	 */
+	cap-mmc-highspeed;
+
+	/*
+	 * Timing nel formato MAINLINE a due celle: dw_mci_exynos_parse_dt()
+	 * fa of_property_read_u32_array(..., timing, 2) e poi
+	 * SDMMC_CLKSEL_TIMING(timing[0], timing[1], div). Il downstream usa
+	 * quattro campi (<3 0 4 0>): NON convertirli a mano.
+	 */
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 4>;
+	samsung,dw-mshc-ddr-timing = <2 4>;
+	non-removable;
+
+	status = "okay";
+};
+
+/*
+ * ======================================================================
+ * WI-FI — bus SDIO (QCA9377)
+ * ======================================================================
+ * Il downstream conferma la mappa dei controller: dwmmc_1 @ 0x13550000
+ * e' il Wi-Fi (pin sd1_*, keep-power-in-suspend, nessuna card-detect),
+ * dwmmc_2 @ 0x13560000 e' la microSD (card-detect = <&gpa0 1>). Gli
+ * indirizzi coincidono uno a uno con mmc1/mmc2 di exynos7870.dtsi
+ * mainline.
+ *
+ * Valori da exynos7870-gtaxl_common.dtsi righe 238-274:
+ *   fifo-depth = <0x40>, samsung,dw-mshc-ciu-div = <3>, supports-4bit,
+ *   keep-power-in-suspend, supports-highspeed.
+ *
+ * La sdr-timing e' quella del J6 MAINLINE (due campi). Il downstream ha
+ * <3 0 3 0>, formato Samsung a quattro campi: NON convertirla a mano.
+ * La ddr-timing e' OBBLIGATORIA anche se il modulo non usa DDR:
+ * dw_mci_exynos_parse_dt() legge sdr-timing e ddr-timing con
+ * of_property_read_u32_array() e ritorna l'errore per entrambe, quindi
+ * senza di essa il probe muore con "parse dt failed" / -EINVAL. Solo
+ * hs400-timing e' opzionale. Valore dal J6, che deriva dal downstream
+ * <3 0 2 1> con la stessa conversione di formato della sdr.
+ *
+ * #address-cells/#size-cells servono per poter appendere un figlio
+ * wifi@1 piu' avanti: i nodi mmc di exynos7870.dtsi non li dichiarano.
+ * Al primo giro il figlio NON c'e' apposta — cosi' l'enumerazione SDIO
+ * avviene comunque e il manfid stampato in dmesg e' la prova finale
+ * dell'identita' del chip (atteso: vendor 0x0271, Atheros).
+ *
+ * I pinctrl sd1_* stanno in exynos7870-pinctrl.dtsi righe 385-416.
+ * WLAN_EN e DCDC_EN non hanno bisogno di un nodo pinctrl: il driver
+ * pinctrl-samsung imposta la funzione di uscita quando gpiolib chiede
+ * la direzione.
+ */
+&mmc1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus1 &sd1_bus4>;
+
+	mmc-pwrseq = <&pwrseq_wlan>;
+
+	bus-width = <4>;
+	fifo-depth = <64>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 3>;
+	samsung,dw-mshc-ddr-timing = <1 2>;
+	non-removable;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+
+	status = "okay";
+};
+
+/*
+ * ======================================================================
+ * microSD — bus SD (dwmmc_2 @ 0x13560000)
+ * ======================================================================
+ * Il blocco &mmc2 e' preso alla lettera da exynos7870-j6lte.dts righe
+ * 478-497, che a sua volta e' identico carattere per carattere a quello
+ * di on7xelte e a2corelte: non e' una scelta per scheda, e' il cablaggio
+ * di riferimento del SoC. I pinctrl sd2_* stanno gia' in
+ * exynos7870-pinctrl.dtsi righe 417-471, quindi l'unico gruppo da
+ * definire e' dwmmc2_irq, in fondo a questo file sotto &pinctrl_alive.
+ *
+ * TIMING. Formato mainline a due celle, come per mmc0 e mmc1. La
+ * corrispondenza col downstream e' esatta, verificata sulla macro
+ * SDMMC_CLKSEL_TIMING(x, y, z) = CCLK_SAMPLE(x) | CCLK_DRIVE(y) |
+ * CCLK_DIVIDER(z) di dw_mmc-exynos.h:
+ *
+ *   downstream <3 0 3 0>  =  div 3, drive 3, sample 0  ->  <0 3>
+ *   downstream <3 0 2 1>  =  div 3, drive 2, sample 1  ->  <1 2>
+ *
+ * L'ordine downstream e' <div, x, drive, sample>, il mainline e'
+ * <sample, drive> con il div nella proprieta' ciu-div. Sono gli stessi
+ * numeri, riordinati: NON convertirli a mano.
+ *
+ * La ddr-timing e' obbligatoria anche qui, per la stessa ragione
+ * spiegata in &mmc1: dw_mci_exynos_parse_dt() ritorna errore se manca.
+ *
+ * UHS. Il downstream ha due timing in piu' che mainline non sa leggere,
+ * sdr50-timing <3 0 4 2> e sdr104-timing <3 0 3 0>. Mainline usa
+ * sdr-timing per tutti i modi SDR, che coincide con l'SDR104 del vendor
+ * ma NON con l'SDR50, dove Samsung mette drive 4 / sample 2 contro drive
+ * 3 / sample 0. Il sample lo recupera dw_mci_exynos_execute_tuning(),
+ * che cerca la fase; il drive no, non e' accordabile. Se l'SDR50 dovesse
+ * risultare instabile, quello e' il primo indiziato — ed e' l'unica cosa
+ * di questa campagna che chiederebbe una patch al driver, non al DTS.
+ *
+ * Il tetto del clock, letto su clk_summary a nodo attivo:
+ *
+ *   mout_mif_cmu_fsys_mmc2    799 500 000    (BUS_PLL 1599 MHz, div2)
+ *   dout_mif_cmu_fsys_mmc2    199 875 000    DIV a 10 bit, qui a 4
+ *
+ * Il DIV puo' scendere fino a 1 — lo dimostra mmc0, che sta a 399,75 —
+ * quindi il clock di carta massimo e' 799,5 / 4 (ciu-div) = 199,9 MHz.
+ * Torna riga per riga con la tabella ciu_clkin del downstream
+ * (25 / 50 / 100 / 200 per legacy / HS / SDR50 / SDR104) e con il suo
+ * clock-frequency = <800000000>, che non era una sorgente irraggiungibile
+ * ma proprio questo mux. Entrambe le modalita' UHS sono quindi
+ * raggiungibili dall'albero dei clock.
+ *
+ * NON SONO PERO' ANCORA STATE COLLAUDATE. Al primo boot con carta la
+ * negoziazione si e' fermata a sd high-speed:
+ *
+ *   mmc2: new high speed SDHC card at address 1234
+ *   timing spec: 2 (sd high-speed)   clock: 50000000   signal voltage: 3.30 V
+ *
+ * Il core stampa "ultra high speed" quando entra in UHS, e la
+ * commutazione a 1,8 V non e' stata nemmeno tentata: la carta di prova
+ * e' una SDHC da 16 GB che non alza S18A nella risposta ad ACMD41. Il
+ * ramo UHS del nodo resta dichiarato e mai eseguito finche' non passa
+ * una carta UHS-I vera (SDXC, oppure marcata U3 / V30).
+ *
+ * Nota su vqmmc: ios dichiara la classe 3,30 V mentre il regolatore sta
+ * a 2800 mV. Non e' un difetto — ldo2 arriva a 2,8 V e basta, sia qui
+ * sia nel downstream sia nel j6lte, e il core chiede la classe mentre il
+ * regolatore consegna il massimo che ha.
+ *
+ * CARD DETECT: cd-gpios, ed e' LA SECONDA DEVIAZIONE VOLUTA da mainline.
+ *
+ * Tutte e tre le schede upstream mettono broken-cd, cioe'
+ * MMC_CAP_NEEDS_POLL: dw_mci_get_cd() ritorna sempre 1 e la presenza la
+ * stabilisce mmc_rescan, che si riaccoda a HZ. Un risveglio al secondo
+ * per sempre, piu' un tentativo di init a slot vuoto.
+ *
+ * E' una rinuncia, non un vincolo. Su questa scheda il card detect e' un
+ * EINT vero su gpa0-1, che il downstream usa (card-detect = <&gpa0 1 0xf>
+ * piu' card-detect-gpio). Mainline dichiara il gruppo pinctrl dwmmc2_irq,
+ * lo referenzia in pinctrl-0, e poi lo scavalca con broken-cd: il pin
+ * resta configurato e inutilizzato su tutte e tre le schede upstream. Il
+ * motivo probabile e' che il pinctrl del SoC non ha un gruppo sd2_cd,
+ * quindi il CDETECT interno del controller non vede nulla di sensato --
+ * ma questo e' un argomento contro il CDETECT interno, non contro il
+ * GPIO.
+ *
+ * Il costo del polling e' stato misurato al primo boot con broken-cd:
+ *
+ *   mmc2: error -110 whilst initialising SD card
+ *   mmc2: new high speed SD card at address e624    (mezzo secondo dopo)
+ *
+ * mmc_rescan aveva campionato DURANTE l'inserimento meccanico, a contatti
+ * non ancora tutti chiusi. Con cd-gpios non succede: mmc_of_parse() legge
+ * cd-debounce-delay-ms col default di 200 ms -- lo stesso valore del
+ * card-detect-delay gia' presente -- e l'init parte a inserimento
+ * concluso.
+ *
+ * broken-cd NON e' l'alternativa di cd-gpios, e i due non convivono.
+ * mmc_of_parse() chiama mmc_gpiod_request_cd() in ogni caso, ma in
+ * mmc_gpiod_request_cd_irq() l'interrupt viene armato solo se
+ *
+ *     else if (!(host->caps & MMC_CAP_NEEDS_POLL))
+ *             irq = gpiod_to_irq(ctx->cd_gpio);
+ *
+ * e dw_mci_get_cd() ritorna 1 prima ancora di guardare il GPIO. Lasciare
+ * broken-cd significherebbe avere il GPIO richiesto e inutile: il
+ * polling vincerebbe comunque. Va tolto, e infatti non c'e'.
+ *
+ * Il pin resta in FUNC_EINT nonostante devm_gpiod_get_index(..., GPIOD_IN)
+ * riscriva il CON a input: devm_request_threaded_irq() arriva dopo, da
+ * mmc_start_host(), ed exynos_irq_set_type() rimette la funzione a EINT.
+ * L'ordine e' quello giusto ma va letto in dmesg, non dedotto: la firma
+ * di successo e' "Got CD GPIO" da mmc_of_parse() e la SPARIZIONE di
+ * "mmc_host mmc2: card is polling".
+ *
+ * Nessun MMC_CAP_CD_WAKE: dw_mmc non lo imposta, quindi l'inserimento
+ * non sveglia il dispositivo dalla sospensione. Non e' una regressione,
+ * col polling non succedeva comunque.
+ *
+ * cap-sd-highspeed E' L'UNICA DEVIAZIONE VOLUTA dalle tre schede
+ * mainline, che non ce l'hanno. mmc_of_parse() non lo deduce da nessun
+ * altro flag: le sd-uhs-* accendono solo le MMC_CAP_UHS_*, e
+ * mmc_sd_init_card() entra in mmc_sd_switch_hs() solo con
+ * MMC_CAP_SD_HIGHSPEED. Senza questa riga, una carta non-UHS — o una
+ * carta UHS su cui la commutazione a 1,8 V fallisse — resterebbe a
+ * 25 MHz in default speed. E' la stessa identica trappola del
+ * cap-mmc-highspeed mancante su &mmc0, che aveva inchiodato l'eMMC a
+ * 20 MB/s: una proprieta' assente che tappa il bus senza dire niente.
+ * Il controller la supporta (il downstream dichiara supports-highspeed),
+ * quindi la riga c'e'. Misurato al primo boot: timing spec 2, clock a
+ * 50 MHz, 20,3 e 18,6 MB/s in lettura sequenziale contro un tetto
+ * teorico di 24,98 MB/s per 4 bit a 49,97 MHz — 81% e 74%, efficienza
+ * normale. Senza questa riga sarebbero stati 25 MHz e la meta' esatta
+ * della banda. Da proporre a monte per j6lte, on7xelte e a2corelte
+ * insieme al resto della serie.
+ *
+ * Restano fuori, senza corrispettivo mainline: clock-gate, bypass-smu,
+ * bypass-for-allpass, use-fine-tuning, card-init-hwacg-ctrl,
+ * only_once_tune, skip-init-mmc-scan, ignore-phase, desc-size,
+ * hto-timeout, data-timeout, num-ref-clks, ciu_clkin, clk-drive-number,
+ * samsung,voltage-int-extra, num-slots, supports-*, e i cinque stati
+ * pinctrl fast-slew-rate. Un solo caso merita una nota: bypass-smu fa a
+ * mano cio' che mainline ottiene per costruzione, perche'
+ * dw_mci_exynos_config_smu() scrive MPSCTRL0 in modalita' non cifrata su
+ * tutti i compatible -dw-mshc-smu.
+ */
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &dwmmc2_irq>;
+
+	vmmc-supply = <&vdd_fixed_mmc2>;
+	vqmmc-supply = <&vdd_ldo2>;
+
+	bus-width = <4>;
+	card-detect-delay = <200>;
+	fifo-depth = <64>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 3>;
+	samsung,dw-mshc-ddr-timing = <1 2>;
+	cap-sd-highspeed;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	cd-gpios = <&gpa0 1 GPIO_ACTIVE_LOW>;
+	disable-wp;
+
+	status = "okay";
+};
+
+/*
+ * ======================================================================
+ * USB
+ * ======================================================================
+ * exynos7870.dtsi dichiara usbdrd con status = "disabled": va abilitato
+ * qui, come fa il J6. Senza questo nodo U-Boot non istanzia il
+ * controller e "Enter fastboot mode" risponde "no USB device found".
+ */
+&usbdrd {
+	vdd33-supply = <&vdd_ldo8>;
+
+	status = "okay";
+
+	/*
+	 * exynos7870.dtsi dichiara usb-role-switch sul nodo dwc3: senza
+	 * qualcuno che comunichi il ruolo, il controller non registra
+	 * l'UDC e il gadget non parte. Qui il ruolo e' sempre device.
+	 */
+	usb@0 {
+		dr_mode = "peripheral";
+	};
+};
+
+/*
+ * ADC del SoC. Non e' dichiarato in exynos7870.dtsi, quindi lo aggiungo
+ * qui riaprendo il bus soc.
+ *
+ * Indirizzo e interrupt dal downstream (exynos7870.dtsi dell'albero
+ * Samsung): adc@10550000, SPI 395. I clock del blocco ADC nel driver
+ * mainline stanno in CMU_MIF (gout_mif_wrap_adc_if_*), e pinctrl_mif e'
+ * a 0x10530000: indirizzo e clock cadono nello stesso blocco, il che
+ * conferma il dato.
+ *
+ * Il downstream usa compatible "samsung,exynos-adc-v3", che in mainline
+ * non esiste. Nemmeno "samsung,exynos7-adc" va bene: il probe riesce ma
+ * ogni lettura va in timeout, perche' quella variante lascia il blocco
+ * in reset e il risultato non sta dove lo cerca. Serve
+ * "samsung,exynos7870-adc", aggiunto a exynos_adc.c.
+ *
+ * NOTA: il binding mainline elenca vdd-supply fra le proprieta'
+ * obbligatorie, ma quale rail del PMIC S2MPU05 alimenti l'ADC non e'
+ * noto: il DTS downstream non lo dichiara, perche' il loro driver non
+ * lo richiede. Senza la proprieta' il driver ripiega su un regolatore
+ * fittizio e funziona, dato che l'alimentazione e' gia' accesa
+ * all'avvio. Va risolto prima di proporre il DTS upstream: mettere un
+ * LDO a caso e' peggio che ometterlo.
+ */
+&soc {
+	adc: adc@10550000 {
+		compatible = "samsung,exynos7870-adc";
+		reg = <0x10550000 0x100>;
+
+		interrupts = <GIC_SPI 395 IRQ_TYPE_LEVEL_HIGH>;
+
+		clocks = <&cmu_mif CLK_GOUT_MIF_WRAP_ADC_IF_PCLK_S0>;
+		clock-names = "adc";
+
+		#io-channel-cells = <1>;
+	};
+};
+
+/*
+ * Audio, lotto A: wrapper LPASS e DMA audio (ADMA), senza I2S, mixer e
+ * codec, che arrivano col lotto B. Serve a collaudare in isolamento
+ * l'unica parte rischiosa: i clock e i reset in CMU_DISPAUD, condivisa
+ * col display (che e' ancora lo scanout lasciato da S-BOOT: se lo
+ * spegniamo, nessun driver puo' riaccenderlo).
+ *
+ * Il nodo lpass mappa SOLO la word DISPAUD_CFG (0x148f1000, 4 byte):
+ * i bit 0-3 sono i soft reset attivi-alti di MIXER/MI2S/AMP/ADMA
+ * (downstream lpass-exynos7870.c). La word a +0xc appartiene al
+ * syscon_disp del dtsi mainline e non va toccata ne' sovrapposta.
+ *
+ * Driver: mfd exynos-lpass con la variante 7870 (patch 0080). I figli
+ * vengono popolati dal probe del lpass, DOPO il rilascio dei reset:
+ * l'ordinamento e' garantito dalla gerarchia, non dal caso.
+ *
+ * ADMA: PL330 standard. Il downstream forza il microcodice del DMAC
+ * nella SRAM del LPASS (0x03002000) con estensioni Samsung che mainline
+ * non ha; qui il microcodice sta in DRAM, dove il master AXI del DMAC
+ * arriva comunque (e' lo stesso che legge i buffer audio). Da verificare
+ * al primo trasferimento, non al probe. periphid dal downstream.
+ *
+ * Verifica PMU 2026-08: pd_dispaud CONF=0xf STATUS=0x3000f (acceso).
+ */
+&soc {
+	lpass: audio-subsystem@148f1000 {
+		compatible = "samsung,exynos7870-lpass";
+		reg = <0x148f1000 0x4>;
+
+		clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_APB_AUD>,
+			 <&cmu_dispaud CLK_FOUT_DISPAUD_AUD_PLL>,
+			 <&cmu_dispaud CLK_DOUT_DISPAUD_MI2S>;
+		clock-names = "apb_aud", "fout_aud_pll", "dout_mi2s";
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		adma: dma-controller@14890000 {
+			compatible = "arm,pl330", "arm,primecell";
+			reg = <0x14890000 0x1000>;
+			interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_BUS>;
+			clock-names = "apb_pclk";
+
+			#dma-cells = <1>;
+			arm,primecell-periphid = <0x341330>;
+		};
+
+		/*
+		 * I2S0: il layout registri coincide campo per campo con
+		 * la variante mainline i2sv5_i2s1 (undici campi su
+		 * undici, verificati su i2s-regs.h downstream contro
+		 * i2s.c mainline), da cui il compatible. opclk0 e
+		 * opclk1 puntano allo stesso gate: il mux RCLKSRC
+		 * diventa indifferente. Canali DMA 0 (tx) e 2 (rx) dal
+		 * downstream.
+		 */
+		i2s0: i2s@148a0000 {
+			compatible = "samsung,exynos7-i2s1";
+			reg = <0x148a0000 0x100>;
+			interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
+
+			dmas = <&adma 0>, <&adma 2>;
+			dma-names = "tx", "rx";
+
+			clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_APB_AUD>,
+				 <&cmu_dispaud CLK_GOUT_DISPAUD_MI2S_AUD_I2SCODCLKI>,
+				 <&cmu_dispaud CLK_GOUT_DISPAUD_MI2S_AUD_I2SCODCLKI>;
+			clock-names = "iis", "i2s_opclk0", "i2s_opclk1";
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2s_extcodec_bus>;
+
+			/*
+			 * PROVA, non definitiva: porta il clock in
+			 * ingresso all'I2S da 49,152 a 24,576 MHz, cosi'
+			 * config_setup() calcola psr = 1 e il prescaler
+			 * non divide piu' nulla.
+			 *
+			 * Serve a separare due cause possibili del fattore
+			 * due misurato il 21 agosto (un file da 10 s
+			 * riprodotto in 4,87 s, fs reale 96 kHz invece di
+			 * 48): o il PSR non divide malgrado il registro
+			 * dica di si' (I2SPSR rilegge 0x8100, PSREN + div
+			 * 1), oppure RFS vale 256 invece dei 512 scritti
+			 * in I2SMOD.
+			 *
+			 * Esito atteso: 10 s -> era il PSR, e questa
+			 * diventa la correzione definitiva.  Ancora 4,87 s
+			 * -> e' l'RFS, e questa prova va ritirata.
+			 */
+			assigned-clocks = <&cmu_dispaud CLK_DOUT_DISPAUD_MI2S>;
+			assigned-clock-rates = <98304019>;
+
+			#sound-dai-cells = <1>;
+		};
+
+		/*
+		 * Mixer digitale s1402x: sta fisicamente fra I2S0 e il
+		 * codec (che e' cablato sulla porta AMP del mixer).
+		 * Driver minimale, solo percorso AP: patch 0083.
+		 */
+		audmixer: audio-mixer@14880000 {
+			compatible = "samsung,s1402x";
+			reg = <0x14880000 0x200>;
+
+			clocks = <&cmu_dispaud CLK_DOUT_DISPAUD_MIXER>,
+				 <&cmu_dispaud CLK_GOUT_DISPAUD_MIXER_AUD_SYSCLK>;
+			clock-names = "audmixer_dout", "audmixer_aclk";
+
+			#sound-dai-cells = <1>;
+		};
+	};
+};
+
+/*
+ * Pin del bus I2S verso il codec esterno: gpz1-0..3 in funzione 2,
+ * banca del pinctrl DISPAUD. Valori numerici grezzi (funzione 2,
+ * pull-up = 3, drv = 2) copiati dal gruppo downstream
+ * i2s_pmic_bus_extcodec di exynos7870-gtaxl_common.dtsi: niente macro
+ * nuove, cosi' anche la copia di U-Boot compila senza ritocchi. I
+ * gruppi mainline esistenti sulla stessa banca (i2s_pmic_bus e
+ * affini) appartengono ad altre schede e usano pin diversi.
+ */
+&pinctrl_dispaud {
+	i2s_extcodec_bus: i2s-extcodec-bus-pins {
+		samsung,pins = "gpz1-0", "gpz1-1", "gpz1-2", "gpz1-3";
+		samsung,pin-function = <2>;
+		samsung,pin-pud = <3>;
+		samsung,pin-drv = <2>;
+	};
+};
+
+/*
+ * Codec Realtek RT5659 su i2c5 (0x13880000), indirizzo 0x1b.
+ * Le estensioni Samsung del nodo downstream tradotte nel binding
+ * mainline: gpio_ldo -> realtek,ldo1-en-gpios (gpd3-2), gpio_reset ->
+ * realtek,reset-gpios (gpd3-3); la sequenza di accensione la fa il
+ * driver. LDO30/LDO32 (always-on anche nel vendor) stanno nel nodo
+ * PMIC. IRQ su gpd3-7; il trigger e' quello dell'esempio del binding,
+ * da rivedere nella campagna jack detection.
+ *
+ * Omesse per ora realtek,in3/in4-differential del downstream: il
+ * binding mainline non le conosce (unevaluatedProperties: false) —
+ * riguardano la cattura, da riaffrontare col microfono.
+ */
+&i2c5 {
+	status = "okay";
+
+	/*
+	 * Come i2c0 e i2c4 (che funzionano): senza sda-delay questo
+	 * controller campiona male e le letture tornano zero con bus
+	 * elettricamente sano. Valori dal downstream.
+	 */
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	audio_codec: audio-codec@1b {
+		compatible = "realtek,rt5659";
+		reg = <0x1b>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_ctrl>;
+
+		/*
+		 * Interrupt su gpd3-7 RIMOSSO di proposito per la sola
+		 * riproduzione. Serve al jack detect e a nient'altro; con
+		 * il codec vivo produce due problemi reali:
+		 *
+		 *  - rt5659_irq() accoda jack_detect_work prima che il
+		 *    probe del component la inizializzi -> WARNING in
+		 *    __queue_delayed_work (workqueue.c:2549 e :2551);
+		 *  - dopo un rmmod il descrittore resta mappato col
+		 *    trigger precedente e il request_irq successivo da
+		 *    "irq: type mismatch, failed to map hwirq-7 for
+		 *    gpd3-gpio-bank", che non si recupera senza reboot.
+		 *
+		 * Da rimettere quando si affrontera' il jack, confrontando
+		 * il trigger dichiarato dal downstream con quello che il
+		 * driver mainline chiede in request_threaded_irq().
+		 *
+		 * interrupt-parent = <&gpd3>;
+		 * interrupts = <7 IRQ_TYPE_LEVEL_HIGH>;
+		 */
+
+		realtek,ldo1-en-gpios = <&gpd3 2 GPIO_ACTIVE_HIGH>;
+		realtek,reset-gpios = <&gpd3 3 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * Scheda audio: un solo dai_link con due codec (AP0 del mixer +
+ * aif1 del RT5659), machine driver gtaxl_rt5659 (patch 0085).
+ * Routing dal nodo sound del downstream; fully_routed nel driver
+ * pota i widget non collegati.
+ */
+/*
+ * Scheda di COLLAUDO della sola catena SoC: I2S0 -> mixer, senza codec.
+ * Serve a esercitare il percorso DMA/I2S/mixer quando il RT5659 non
+ * risponde: non produce suono udibile (manca l'ultimo anello) ma valida
+ * ADMA, clock I2S e hw_params del mixer.
+ *
+ * Dal 21 agosto e' DISABILITATA: il codec risponde (0x00ff -> 0x6311)
+ * e la scheda vera e' il nodo "sound" qui sotto. Le due si escludono a
+ * vicenda: per tornare al collaudo della sola catena SoC basta
+ * scambiare i due status.
+ */
+/ {
+	sound_test: sound-test {
+		status = "disabled";
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "gtaxl-soc-chain-test";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&cpu_dai_test>;
+		simple-audio-card,frame-master = <&cpu_dai_test>;
+
+		cpu_dai_test: simple-audio-card,cpu {
+			sound-dai = <&i2s0 0>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&audmixer 0>;
+		};
+	};
+};
+
+/ {
+	sound {
+		status = "okay";
+		compatible = "samsung,gtaxl-rt5659";
+		model = "gtaxlwifi";
+
+		i2s-controller = <&i2s0>;
+		audio-mixer = <&audmixer>;
+		audio-codec = <&audio_codec>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&jack_det>;
+
+		/*
+		 * Rilevamento cuffie ESTERNO al codec, su gpa0-5: alto a
+		 * riposo, basso all'inserimento. Misurato su GPA0DAT
+		 * (0x139F0044, bit 5) con piu' cicli inserisci/estrai.
+		 * Downstream: nodo earjack, compatible "sec_jack",
+		 * detect-gpio = <&gpa0 5 0>, det-dbtime = <50>.
+		 *
+		 * Il nome deve restare headset-det-gpios: e' il con-id che
+		 * snd_soc_jack_add_gpios() passa a devm_gpiod_get_index().
+		 * La polarita' sta qui, non nel campo invert del driver:
+		 * metterle entrambe si annullerebbero.
+		 *
+		 * Non c'entra con l'IRQ del codec su gpd3-7, tuttora
+		 * rimosso: quello serve al rilevamento interno al RT5659,
+		 * che qui non usiamo.
+		 */
+		headset-det-gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;
+
+		audio-routing =
+			"SPK", "SPOL",
+			"SPK", "SPOR",
+			"HP", "HPOL",
+			"HP", "HPOR",
+			"RCV", "MONOOUT",
+			"IN1P", "Headset Mic",
+			"IN3P", "MICBIAS2",
+			"IN3P", "Main Mic",
+			"IN3N", "Main Mic";
+	};
+};
+
+/*
+ * Nodi pinctrl per i tasti, sullo schema di exynos7870-j6lte.dts
+ * (righe 549-568). I banchi gpa0/gpa1/gpa2 stanno sotto pinctrl_alive.
+ *
+ * Se dtc si lamenta che pinctrl_alive non esiste, controlla il nome
+ * reale con:
+ *   grep -n "pinctrl_alive\|pinctrl0" arch/arm64/boot/dts/exynos/exynos7870.dtsi
+ * E' un errore che si manifesta in compilazione, non a runtime: costa
+ * poco correggerlo.
+ */
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa2-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * Rilevamento del jack cuffie. Downstream: earjack_jack_det su
+	 * gpa0-5, pin-function 0xf (EINT), nessun pull. S-BOOT lo lascia
+	 * gia' in EINT con un pull-down, ma senza dichiararlo qui la
+	 * configurazione resterebbe quella del bootloader.
+	 */
+	jack_det: jack-det-pins {
+		samsung,pins = "gpa0-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/* Specifico del tablet: il J6 non ha il tasto Home fisico. */
+	key_home: key-home-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/* IRQ del PMIC S2MPU05, come nel J6 (righe 570-574). */
+	pmic_irq: pmic-irq-pins {
+		samsung,pins = "gpa0-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
+	};
+
+	/*
+	 * IRQ del touchscreen. Downstream: attn_irq su gpa0-4 con
+	 * pin-function 0xf (EINT) e pull disabilitato.
+	 */
+	touch_irq: touch-irq-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * IRQ dell'MFD SM5703. Downstream: "if_pmic_irq" su gpa2-7,
+	 * pin-function 0 (input), nessun pull. Si chiamava "muic_irq" qui,
+	 * ma il MUIC e' un altro pin: vedi sotto.
+	 */
+	if_pmic_irq: if-pmic-irq-pins {
+		samsung,pins = "gpa2-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * IRQ del MUIC. Downstream (exynos7870-gtaxlwifi_eur_open_05.dts):
+	 * "muic_irq" su gpa2-6, pin-function 0, pin-pud 3 (pull-up).
+	 * Il pull-up serve: la linea e' attiva bassa e a riposo va tenuta
+	 * alta, e nessun altro la pilota.
+	 */
+	muic_irq: muic-irq-pins {
+		samsung,pins = "gpa2-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * IRQ del fuel gauge SM5703. Downstream: "fuel_irq" su gpa0-3,
+	 * pin-function 0 (input), nessun pull. Dichiarato in anticipo per
+	 * quando arrivera' il driver.
+	 */
+	fuel_irq: fuel-irq-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * Card detect della microSD. Downstream: dwmmc2_cd_ext_irq su
+	 * gpa0-1, pin-function 0xf (EINT), nessun pull — e il nodo dwmmc2
+	 * lo referenzia con card-detect = <&gpa0 1 0xf>. Stesso pin e
+	 * stessa configurazione in exynos7870-j6lte.dts, dove il gruppo si
+	 * chiama dwmmc2_irq.
+	 *
+	 * pin-pud a NONE perche' il pull-up e' sullo slot: a carta assente
+	 * la linea sta alta, a carta inserita viene tirata a massa. Da qui
+	 * la polarita' attiva bassa che servira' quando si passera' a
+	 * cd-gpios (vedi il commento in &mmc2).
+	 */
+	dwmmc2_irq: dwmmc2-irq-pins {
+		samsung,pins = "gpa0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+/*
+ * Abilitazione della ricarica, nCHGEN dell'SM5703. Downstream: "chg_en"
+ * su gpd1-3 con pin-function 1 (uscita). Attivo basso: il pin alto
+ * spegne lo stadio d'ingresso qualunque cosa dicano i registri.
+ */
+&pinctrl_top {
+	chg_en: chg-en-pins {
+		samsung,pins = "gpd1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	/*
+	 * LDO_EN e RESET del codec. Il downstream li porta alti via
+	 * pinctrl al boot, con due gruppi separati referenziati dal nodo
+	 * del codec (codec_ldoena su gpd3-2 e codec_reset su gpd3-3,
+	 * entrambi function 1, pud 0, pin-val 1, con-pdn 3).
+	 *
+	 * Senza questo, S-BOOT lascia GPD3CON con i nibble 2 e 3 a zero
+	 * (pin in ingresso) e il segnale non esce mai dal SoC: misurato
+	 * con GPD3CON=0x01010000 a driver scarico. `samsung,pin-val` e'
+	 * PINCFG_TYPE_DAT in pinctrl-samsung.c, quindi supportato.
+	 */
+	codec_ctrl: codec-ctrl-pins {
+		samsung,pins = "gpd3-2", "gpd3-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+		samsung,pin-val = <1>;
+	};
+};
+
+/*
+ * ======================================================================
+ * TOUCHSCREEN — STMicroelectronics FingerTipS
+ * ======================================================================
+ * Downstream lo dichiara come "stm,fts_touch" su i2c@13840000 addr 0x49.
+ * In mainline il driver e' drivers/input/touchscreen/stmfts.c con
+ * compatible "st,stmfts": stesso hardware, nome diverso.
+ *
+ * Dati dal downstream (exynos7870-gtaxl_common.dtsi righe 387-399):
+ *   stm,irq_gpio  = <&gpa0 4 0>
+ *   stm,max_coords = <1199 1919>   (coerente col pannello 1200x1920)
+ *   stm,num_touchkey = <2>          -> touch-key-connected
+ *
+ * Serve CONFIG_TOUCHSCREEN_STMFTS, disattivato nella config pmOS.
+ *
+ * ledvdd-supply e' opzionale e sul tablet non risulta presente: i tasti
+ * capacitivi non hanno retroilluminazione dedicata.
+ */
+&i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/*
+	 * Parametri dichiarati dal downstream su questo bus
+	 * (exynos7870-gtaxl_common.dtsi righe 383-385). Senza, il driver usa
+	 * i default e il touch non risponde: probe fallito con -110
+	 * (ETIMEDOUT) pur essendo i regolatori tsp_dvdd/tsp_avdd entrambi
+	 * "enabled" — quindi il chip e' alimentato ma il timing del bus non
+	 * gli permette di rispondere.
+	 */
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	touchscreen@49 {
+		compatible = "st,stmfts";
+		reg = <0x49>;
+
+		interrupt-parent = <&gpa0>;
+		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq>;
+
+		touchscreen-size-x = <1199>;
+		touchscreen-size-y = <1919>;
+		touch-key-connected;
+
+		vdd-supply = <&tsp_dvdd>;
+		avdd-supply = <&tsp_avdd>;
+	};
+};
+
+/*
+ * ======================================================================
+ * BATTERIA — Silicon Mitus SM5703
+ * ======================================================================
+ * L'SM5703 e' un MFD che integra caricabatterie, fuel gauge, MUIC,
+ * regolatori e flash LED, esposti su indirizzi I2C diversi e su due bus:
+ *
+ *   i2c0 (0x13830000)  0x71  fuel gauge   -> driver scritto per questo port
+ *   i2c4 (0x13870000)  0x49  MFD/charger  -> driver scritti per questo port
+ *   i2c2 (0x13850000)  0x25  MUIC         -> extcon-sm5502.c, invariato
+ *
+ * I tre driver SM5703 (MFD core, fuel gauge, charger) sono scritti in
+ * stile mainline ma non ancora upstream: arrivano dalle patch
+ * dell'APKBUILD. Il fuel gauge non dipende dall'MFD, e' su un altro bus
+ * e a un altro indirizzo; da' percentuale, tensione, corrente e la
+ * temperatura della cella letta via ADC del SoC.
+ *
+ * Il charger sta nell'MFD a 0x49 (drivers/mfd/sm5703.c +
+ * drivers/power/supply/sm5703-charger.c). Serve davvero: senza, il chip
+ * si ferma a 450 mA in ingresso, che a schermo acceso e' meno di quanto
+ * consuma il sistema, e la batteria non sale.
+ *
+ * Il MUIC e' su un terzo bus ancora, i2c2 a 0x25: vedi piu' sotto.
+ */
+&i2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	/*
+	 * Fuel gauge SM5703 @ 0x71.
+	 *
+	 * Le tabelle qui sotto sono specifiche della cella di questo
+	 * modello e vengono da battery_params in
+	 * exynos7870-gtaxlwifi_eur_open_battery_05.dtsi:
+	 *   battery_table0 -> discharge, battery_table1 -> charge,
+	 *   battery_table2 -> soc.
+	 * L'unita' delle due tabelle di tensione e' 1/2.048 mV: 0x2400 sono
+	 * 4500 mV, 0x220c sono 4256 mV. Non sono valori inventabili, quindi
+	 * se cambi cella vanno rifatte, non ritoccate.
+	 *
+	 * IRQ su gpa0-3, a fronte di discesa: il gauge la alza quando la
+	 * carica scende sotto siliconmitus,alert-soc-percent oppure quando
+	 * la tensione scende sotto 3125 mV.
+	 */
+	fuel-gauge@71 {
+		compatible = "siliconmitus,sm5703-fuelgauge";
+		reg = <0x71>;
+
+		interrupt-parent = <&gpa0>;
+		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fuel_irq>;
+
+		monitored-battery = <&battery>;
+
+		siliconmitus,battery-table-discharge =
+			<0x1400 0x1b88 0x1ce5 0x1d35 0x1d5a 0x1d78 0x1ddd 0x1e37
+			 0x1e78 0x1ed7 0x1efb 0x1f72 0x2008 0x2133 0x220c 0x2400>;
+		siliconmitus,battery-table-charge =
+			<0x1400 0x1b88 0x1ce5 0x1d35 0x1d5a 0x1d78 0x1ddd 0x1e37
+			 0x1e78 0x1ed7 0x1efb 0x1f72 0x2008 0x2133 0x220c 0x2400>;
+		siliconmitus,battery-table-soc =
+			<0x0 0x81 0x1f7 0x28c 0x36d 0x658 0xaba 0x1207
+			 0x1954 0x1f2b 0x20a1 0x238d 0x2964 0x31dc 0x371e 0x3749>;
+
+		siliconmitus,rce-values = <0x0749 0x0580 0x0371>;
+		siliconmitus,dtcd-value = <0x1>;
+		siliconmitus,rs-values = <0x9b 0x47a 0x3800 0x00a4>;
+		siliconmitus,vit-period = <0x3506>;
+		siliconmitus,mix-values = <0x0503 0x0004>;
+		siliconmitus,topoff-soc = <0x0 0x5>;
+		siliconmitus,volt-cal = <0x809e>;
+		siliconmitus,curr-cal = <0x7a85>;
+		siliconmitus,temp-std = <25>;
+		siliconmitus,temp-offset = <10>;
+		siliconmitus,temp-offset-cal = <0x1>;
+		siliconmitus,charge-offset-cal = <(-1)>;
+		siliconmitus,tem-poff = <3400 50 3350 50>;
+		siliconmitus,alert-soc-percent = <2>;
+	};
+};
+
+&i2c4 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	/*
+	 * PMIC SM5703 @ 0x49: charger, regolatori e flash LED. Il fuel gauge
+	 * dello stesso chip sta su i2c0 a 0x71 ed e' indipendente.
+	 *
+	 * Il MUIC dello stesso chip NON e' su questo bus: sta su i2c2 a
+	 * 0x25, ed e' dichiarato piu' sotto. Cercarlo qui e' stato a lungo
+	 * fuorviante: su i2c4 a 0x25 non risponde nulla, il che aveva
+	 * fatto concludere che fosse raggiungibile solo tramite l'MFD.
+	 * Non e' cosi': e' semplicemente su un altro bus.
+	 */
+	pmic@49 {
+		compatible = "siliconmitus,sm5703";
+		reg = <0x49>;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&if_pmic_irq>;
+
+		reset-gpios = <&gpc7 4 GPIO_ACTIVE_LOW>;
+
+		charger {
+			compatible = "siliconmitus,sm5703-charger";
+
+			monitored-battery = <&battery>;
+			extcon = <&muic>;
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&chg_en>;
+			enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
+
+			/*
+			 * Tetto, non valore d'esercizio: e' quanto il
+			 * dispositivo regge, e viene raggiunto solo quando il
+			 * MUIC dice che dall'altra parte c'e' un caricatore
+			 * vero. Su una porta USB il driver si ferma a 500 mA.
+			 *
+			 * Downstream: battery,input_current_limit, primo
+			 * elemento (caricatore da parete) = 1650 mA.
+			 */
+			input-current-limit-microamp = <1650000>;
+		};
+	};
+};
+
+/*
+ * MUIC dell'SM5703 su i2c2 (0x13850000), indirizzo 0x25.
+ *
+ * Il bus non era dichiarato, ed e' il motivo per cui i2cdetect non
+ * vedeva niente a 0x25: veniva cercato su i2c4, dove il MUIC non sta.
+ * Downstream (exynos7870-gtaxlwifi_eur_open_05.dts):
+ *
+ *   i2c@13850000 {
+ *           muic-s2mm001@25 {
+ *                   compatible = "sm,sm5703";
+ *                   sm5703,irq-gpio = <&gpa2 6 0>;
+ *           };
+ *   };
+ *
+ * Il nome del nodo dice s2mm001 ma il compatible dice sm5703: Samsung ha
+ * riusato il file di un altro modello senza rinominarlo. Il chip e' il
+ * MUIC dell'SM5703, che in mainline e' gestito da extcon-sm5502.
+ *
+ * L'interrupt e' su gpa2-6, non su gpa2-7: quello e' l'IRQ dell'MFD.
+ */
+&i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	muic: extcon@25 {
+		compatible = "siliconmitus,sm5703-muic";
+		reg = <0x25>;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&muic_irq>;
+	};
+};
+
+/*
+ * ----------------------------------------------------------------------
+ * i2c7 (0x138d0000) - ACCELEROMETRO
+ * ----------------------------------------------------------------------
+ * Il bus e' gia' in exynos7870.dtsi come i2c7, con pinctrl-0 = <&i2c7_bus>
+ * (gpc4-3, gpc4-2, pull-up) e status = "disabled". Qui basta abilitarlo.
+ *
+ * Downstream (exynos7870-gtaxlwifi_eur_open_05.dts, blocco i2c@138D0000):
+ *
+ *   k2hh-i2c@1D {
+ *           compatible = "k2hh-i2c";
+ *           reg = <0x1D>;
+ *           k2hh,irq_gpio = <&gpa0 7 0>;
+ *           k2hh,vio-supply = <&ldo3_reg>;
+ *           k2hh,axis_map_x = <0>;  k2hh,negate_x = <0>;
+ *           k2hh,axis_map_y = <1>;  k2hh,negate_y = <0>;
+ *           k2hh,axis_map_z = <2>;  k2hh,negate_z = <1>;
+ *   };
+ *
+ * "K2HH" e' il nome commerciale Samsung del LIS2HH12 di ST: il driver
+ * vendor drivers/sensors/k2hh.c si aspetta 0x41 in WHOAMI (0x0F), che e'
+ * esattamente il .wai della voce lis2hh12 in st_accel_core.c. In mainline
+ * il chip e' gestito da st_accel con compatible "st,lis2hh12".
+ *
+ * Sullo stesso bus, a 0x10, c'e' anche il sensore di luce CM3323,
+ * dichiarato qui sotto con la sua riserva.
+ *
+ * IRQ NON dichiarato di proposito, primo giro. Per la rotazione dello
+ * schermo basta il polling, e senza IRQ un probe fallito ha una sola
+ * causa possibile invece di due. La linea, quando servira', e' gpa0-7
+ * EINT (downstream: acc_int, pin-function 0xF, pin-pud 0, cioe' nessun
+ * pull: la pilota il chip). gpa0 e' gia' interrupt-controller a due
+ * celle, quindi <7 IRQ_TYPE_...>; il tipo va letto da k2hh.c, non
+ * dedotto dal DTS downstream che usa tre celle.
+ *
+ * MOUNT-MATRIX misurata con sei pose: vedi il commento sul nodo.
+ * ----------------------------------------------------------------------
+ */
+&i2c7 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	accelerometer@1d {
+		compatible = "st,lis2hh12";
+		reg = <0x1d>;
+
+		vddio-supply = <&vdd_ldo3>;
+
+		/*
+		 * Misurata con sei pose statiche, media di 20 campioni
+		 * ciascuna, fondo scala +-2 g (scale 0,000598 -> 1 g =
+		 * 16399 raw). Ampiezze fra coppie opposte: 16497 / 16376 /
+		 * 16174, cioe' entro l'1,4% del valore atteso. Offset
+		 * residui -833 / +169 / +93 raw, sotto 0,05 g: chip sano e
+		 * centrato, nessuna calibrazione necessaria.
+		 *
+		 * Il montaggio e' ruotato di 180 gradi attorno a X rispetto
+		 * alla convenzione IIO. Due riscontri indipendenti:
+		 * schermo in su il chip legge -1 g su Z invece di +1 g
+		 * (le pose piatte, le uniche non ambigue a parole), e con
+		 * matrice identita' KWin ruotava esattamente al contrario
+		 * in tutte e quattro le posizioni - un errore di 180 gradi,
+		 * non uno specchiamento.
+		 *
+		 * Vale per tutte e sedici le schede gtaxl: axis_map e
+		 * negate del nodo k2hh downstream sono identici in tutti i
+		 * DTS della famiglia, quindi il sensore non e' mai stato
+		 * ruotato in produzione. Quei campi NON sono convertibili a
+		 * mano in una mount-matrix: axis_map identita' con
+		 * negate_z = 1 darebbe diag(1,1,-1), determinante -1, cioe'
+		 * una riflessione. Nessun montaggio fisico e' una
+		 * riflessione. La matrice qui sotto e' misurata, non
+		 * dedotta.
+		 */
+		mount-matrix = "-1",  "0",  "0",
+			        "0", "-1",  "0",
+			        "0",  "0",  "1";
+	};
+
+	/*
+	 * Sensore di luce ambientale. Downstream:
+	 *
+	 *   cm3323-i2c@10 {
+	 *           compatible = "cm3323-i2c";
+	 *           reg = <0x10>;
+	 *           cm3323-i2c,vdd-supply = <&ldo33_reg>;
+	 *           cm3323-i2c,vdd-alwayson = <1>;
+	 *   };
+	 *
+	 * ATTENZIONE, non e' un lux-meter: cm3323.c espone quattro canali
+	 * IIO_INTENSITY (rosso, verde, blu, clear) e nessun IIO_LIGHT.
+	 * iio-sensor-proxy cerca in_illuminance_raw e quindi NON lo
+	 * riconoscera' come sorgente di luce ambientale: la luminosita'
+	 * automatica non funzionera' con questo nodo da solo. Serve un
+	 * consumatore che calcoli i lux dai canali di colore - che e'
+	 * quello che fa il vendor code, e che dovra' fare un eventuale
+	 * HAL Android.
+	 *
+	 * Dichiarato comunque: il bus e' gia' abilitato per
+	 * l'accelerometro, il costo e' nullo, e il device IIO serve a
+	 * chiunque voglia leggerlo.
+	 */
+	light-sensor@10 {
+		compatible = "capella,cm3323";
+		reg = <0x10>;
+	};
+};
+
+/*
+ * ----------------------------------------------------------------------
+ * ANCORA ASSENTI
+ * ----------------------------------------------------------------------
+ * - mmc1 (SD) e mmc2 (WiFi SDIO): il J6 ha mmc1 con il chip Broadcom
+ *   in SDIO. Il tuo tablet ha uno slot microSD reale, quindi la
+ *   configurazione sara' diversa: removable, con card-detect.
+ * - audio, camera, sensori.
+ * - regolatori e flash LED dell'MFD SM5703: dichiarati nel core del
+ *   driver e mai esposti qui.
+ * - DSI / DECON / pannello: NON esiste un driver DSIM specifico per
+ *   exynos7870 in drivers/gpu/drm/exynos/, nemmeno sul branch 7.1. Il
+ *   percorso e' il bridge generico drivers/gpu/drm/bridge/samsung-dsim.c.
+ *   Il pannello HX8279D non e' tra i moduli di device-samsung-exynos7
+ *   in pmaports, quindi il driver del pannello va scritto.
+ *
+ *   Dati gia' raccolti (nodo hx8279d in exynos7870-gtaxl_common.dtsi):
+ *     Himax HX8279D, 1200x1920, 135x216 mm, video mode (psr_mode = 0)
+ *     refresh 60 Hz
+ *     h-porch = <32 120 8>   (back, front, sync)
+ *     v-porch = <16 16 4>
+ *     dsi-hs-clk = 980 MHz, pms = <3 226 1>, escape-clk = 16 MHz
+ *     reset GPIO: gpd4 1     buck enable GPIO: gpd3 4
+ *     alimentazione: LDO35 "LCD_1P8" + buck_en, poi reset sequence
+ * ----------------------------------------------------------------------
+ */
-- 
2.47.3

