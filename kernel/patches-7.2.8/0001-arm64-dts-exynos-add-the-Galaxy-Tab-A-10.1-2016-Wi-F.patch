From 7c1d2636c542cad034de8bf9ee674dff9c7c3a89 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 16:07:35 +0000
Subject: [PATCH] arm64: dts: exynos: add the Galaxy Tab A 10.1 (2016) Wi-Fi
 board

Add the board file for the SM-T580 (gtaxlwifi), an Exynos7870 tablet.
Modelled on exynos7870-j6lte.dts.
---
 arch/arm64/boot/dts/exynos/Makefile           |    1 +
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 2381 +++++++++++++++++
 2 files changed, 2382 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index 76cc23acb9..b2dd1ec1ca 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -22,3 +22,4 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos990-x1slte.dtb		\
 	exynosautov9-sadk.dtb		\
 	exynosautov920-sadk.dtb
+dtb-$(CONFIG_ARCH_EXYNOS) += exynos7870-gtaxlwifi.dtb
diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
new file mode 100644
index 0000000000..4b8555bcc0
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -0,0 +1,2381 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab A 10.1 (2016) - SM-T580 - codename "gtaxlwifi"
+ * SoC: Exynos 7870 (Joshua)
+ *
+ * Stato: dispositivo autonomo. eMMC, USB gadget, touchscreen, tasti, GPU
+ * (Panfrost), PMIC, ADC del SoC e catena batteria completa (fuel gauge,
+ * charger, MUIC) funzionano. Il display e' ancora il framebuffer lasciato
+ * acceso da S-BOOT via simpledrm: niente DECON/DSI, niente backlight.
+ * Entrambi i banchi di RAM sono dichiarati (vedi memory@ qui sotto).
+ * Assenti: camera. Sensori: accelerometro LIS2HH12 su i2c7
+ * dichiarato con mount-matrix misurata (senza IRQ), piu' il sensore
+ * di luce CM3323 sullo stesso bus (vedi in fondo). Audio in lavorazione:
+ * catena completa dichiarata (lpass, adma, i2s0, mixer s1402x,
+ * codec RT5659 su i2c5, scheda sound); collaudo del primo suono in
+ * corso. Manca la cattura (mic differenziali, jack detection).
+ *
+ * Basato su arch/arm64/boot/dts/exynos/exynos7870-j6lte.dts
+ * (Kaustabh Chakraborty, mainline dal ciclo 6.16)
+ *
+ * Questo file e' compilato sia dal kernel sia da U-Boot: ogni macro o
+ * label nuova deve esistere anche nella copia dei binding dentro U-Boot.
+ */
+
+/dts-v1/;
+#include "exynos7870.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "Samsung Galaxy Tab A 10.1 (2016)";
+	compatible = "samsung,gtaxlwifi", "samsung,exynos7870";
+	chassis-type = "tablet";
+
+	/*
+	 * ------------------------------------------------------------------
+	 * PROPRIETA' NON-STANDARD LETTE DA dtbhtoolExynos
+	 * ------------------------------------------------------------------
+	 * exynos7870.dtsi dichiara GIA' model_info-chip = <7870>,
+	 * model_info-hw_rev = <0> e model_info-hw_rev_end = <255>, con il
+	 * commento "Stock Samsung bootloader looks for these properties".
+	 * Sono esattamente i valori che servono: non li ridichiaro.
+	 *
+	 * Mancano pero' platform e subtype, che nessun DTS mainline definisce.
+	 * dtbhtoolExynos li converte nei codici dell'header DTBH; i valori
+	 * qui sotto sono quelli che producono 0x50a6 / 0x217584da, estratti
+	 * dal boot.img funzionante di LineageOS.
+	 */
+	model_info-platform = "android";
+	model_info-subtype = "samsung";
+
+	aliases {
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+		mmc2 = &mmc2;
+		serial0 = &serial0;
+		serial1 = &serial1;
+		serial2 = &serial2;
+	};
+
+	chosen {
+		/*
+		 * Confermato: exynos7870.dtsi usa #address-cells = <2> /
+		 * #size-cells = <1>, come exynos850 e exynos7885. Tutti i reg
+		 * di questo file seguono quel formato: due celle di indirizzo
+		 * (la prima e' sempre 0, la RAM sta sotto i 4 GB) e una sola
+		 * cella di dimensione, che basta fino a 4 GB per regione.
+		 */
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * ttySAC2 e' la console di debug su tutta la famiglia 7870, ed e'
+		 * confermata dal cmdline stock: androidboot.sec_atd.tty=/dev/ttySAC2
+		 * Con "earlycon" (senza argomenti) nel cmdline il kernel usa
+		 * automaticamente questo nodo, il che ti da' output seriale
+		 * prima ancora che il framebuffer sia inizializzato.
+		 */
+		stdout-path = &serial2;
+
+		/*
+		 * Framebuffer lasciato attivo da S-BOOT.
+		 * L'indirizzo viene dal cmdline stock: s3cfb.bootloaderfb=0x67000000
+		 * (identico al J6, al J7 Prime e all'A2 Core: S-BOOT lo mette
+		 * sempre li' su questo SoC).
+		 *
+		 * CONFERMATO dal DTS downstream, exynos7870-gtaxl_common.dtsi:
+		 *   decon_fb@14830000 { bootloader_fb = <0x67000000 0 0 1200 1920 0>; }
+		 * e da sysfs sul dispositivo acceso:
+		 *   virtual_size   = 1200,1920
+		 *   stride         = 4800   (= 1200*4, nessun padding di riga)
+		 *   bits_per_pixel = 32
+		 *
+		 * Nessun double buffering. Il DECON fa lo scanout in PORTRAIT
+		 * anche se il pannello e' un 10.1" landscape: il pannello
+		 * (Himax HX8279D, 135x216 mm) e' montato ruotato di 90 gradi.
+		 * La console apparira' quindi ruotata; si corregge da cmdline
+		 * con fbcon=rotate:1 (oppure :3), non toccando questi numeri,
+		 * che descrivono la memoria e sono corretti cosi'.
+		 */
+		framebuffer0: framebuffer@67000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x67000000 (1200 * 1920 * 4)>;
+			width = <1200>;
+			height = <1920>;
+			stride = <(1200 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/*
+	 * Layout REALE, da exynos7870-gtaxl_common.dtsi (righe 22-30).
+	 * Il downstream dichiara DUE banchi con un buco in mezzo:
+	 *
+	 *   banco 1: 0x40000000 + 0x3E400000  -> fino a 0x7E400000
+	 *   [ BUCO:  0x7E400000 .. 0x80000000 = 28 MB, TrustZone/secure ]
+	 *   banco 2: 0x80000000 + 0x40000000  -> fino a 0xC0000000
+	 *
+	 * Totale 0x7E400000 = ~2020 MB, coerente con MemTotal 1994048 kB
+	 * una volta tolto l'overhead del kernel.
+	 *
+	 * Entrambi i banchi sono dichiarati. Nel banco 2 vive la ECT
+	 * (Exynos Character Table, parametri DVFS depositati dal bootloader
+	 * a 0x90000000, 0x14000 byte): e' riservata no-map nel blocco
+	 * reserved-memory qui sotto, altrimenti l'allocatore ci scrive
+	 * sopra appena il banco 2 diventa disponibile.
+	 *
+	 * ATTENZIONE al buco: NON accorpare i due banchi in un unico range
+	 * 0x40000000..0xC0000000. I 28 MB in mezzo non sono RAM utilizzabile
+	 * e mapparli produce un external abort senza log leggibili. E'
+	 * l'unica ragione per cui i nodi restano due: non unificarli.
+	 *
+	 * Attesa dopo la dichiarazione di entrambi i banchi: la riga
+	 * "Memory: ...K/2068480K available" nel dmesg (2020 MiB), contro
+	 * 1019904K con il solo banco 1.
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x3e400000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x40000000>;
+	};
+
+	/*
+	 * Dati di targa della cella, letti dal fuel gauge tramite
+	 * monitored-battery. Da exynos7870-gtaxlwifi_eur_open_battery_05.dtsi:
+	 *   battery,battery_full_capacity = <7300>   (mAh)
+	 *   battery0,battery_type = <4350>           (mV, tensione massima)
+	 * La tensione minima e' la soglia di cut-off usata dal downstream
+	 * (battery0,tem_poff, primo valore).
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <7300000>;
+		voltage-max-design-microvolt = <4350000>;
+		voltage-min-design-microvolt = <3400000>;
+
+		/*
+		 * Parametri di ricarica, dal downstream:
+		 *   battery,chg_float_voltage = <4300>
+		 *   battery,fast_charging_current: 2400 mA per il caricatore
+		 *     da parete (primo elemento della tabella per tipo di cavo)
+		 *   battery,full_check_current_1st = <375>
+		 * La tensione di float scende con l'invecchiamento della cella
+		 * (battery,age_data downstream); qui resta il valore per cella
+		 * nuova, perche' mainline non tiene il conteggio dei cicli.
+		 */
+		constant-charge-voltage-max-microvolt = <4300000>;
+		constant-charge-current-max-microamp = <2400000>;
+		charge-term-current-microamp = <375000>;
+	};
+
+	/*
+	 * Termistore della batteria. Non e' nel fuel gauge: quello misura la
+	 * temperatura del proprio die, che a riposo legge una ventina di
+	 * gradi piu' del pacco. Il termistore vero e' letto dall'ADC del SoC
+	 * sul canale 1 (downstream: io-channel-names = "adc-temp").
+	 *
+	 * La tabella e' battery,temp_table_adc / battery,temp_table_data da
+	 * exynos7870-gtaxlwifi_eur_open_battery_05.dtsi, con due conversioni:
+	 * i decimi di grado diventano millesimi, e l'ordine e' rovesciato
+	 * perche' thermal-generic-adc cerca il primo elemento con valore ADC
+	 * minore o uguale a quello letto, quindi vuole gli ADC decrescenti.
+	 */
+	battery_thermistor: thermal-sensor {
+		compatible = "generic-adc-thermal";
+		#thermal-sensor-cells = <0>;
+
+		io-channels = <&adc 1>;
+		io-channel-names = "sensor-channel";
+
+		temperature-lookup-table =
+			<(-20000) 3551>,
+			<(-15000) 3431>,
+			<(-10000) 3284>,
+			<(-5000) 3141>,
+			<0 2964>,
+			<5000 2782>,
+			<10000 2586>,
+			<15000 2392>,
+			<20000 2196>,
+			<25000 2002>,
+			<30000 1816>,
+			<35000 1648>,
+			<40000 1476>,
+			<45000 1310>,
+			<50000 1177>,
+			<55000 1043>,
+			<60000 940>,
+			<65000 838>,
+			<70000 746>,
+			<75000 676>,
+			<80000 581>,
+			<85000 500>,
+			<90000 430>;
+	};
+
+	/*
+	 * Nessun trip point: non c'e' niente da raffreddare su un tablet, e
+	 * un trip "critical" qui spegnerebbe il dispositivo su una lettura
+	 * sbagliata. La zona serve a esporre la temperatura in
+	 * /sys/class/thermal, dove il resto del sistema puo' leggerla.
+	 */
+	thermal-zones {
+		battery-thermal {
+			polling-delay = <10000>;
+			polling-delay-passive = <5000>;
+			thermal-sensors = <&battery_thermistor>;
+		};
+	};
+
+	/*
+	 * Cells confermate identiche al downstream (rmem-2000MB.dtsi).
+	 *
+	 * NON replico gli heap ION del downstream (crypto@80000000,
+	 * video_fw, video_stream, video_frame, video_scaler...): sono tutti
+	 * marcati "reusable", cioe' pool CMA, non zone intoccabili. Un pool
+	 * CMA e' RAM normale con un vincolo di allocazione: non replicarlo
+	 * non perde memoria, perde solo il pool. Servono a codec video,
+	 * camera e crypto engine, nessuno dei quali ha un driver qui.
+	 *
+	 * Questo vale anche per crypto@80000000, che cade esattamente
+	 * all'inizio del banco 2: e' un heap reusable, quindi quella zona e'
+	 * RAM buona e va lasciata all'allocatore. L'unica regione del banco
+	 * 2 che va davvero sottratta e' la ECT, qui sotto.
+	 *
+	 * I nodi modem_if/gnss_if non riguardano questo modello: la variante
+	 * WiFi li cancella con /delete-node/.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Il framebuffer DEVE essere no-map, altrimenti il kernel ci
+		 * alloca sopra e i log a video diventano rumore colorato.
+		 */
+		fb_mem: framebuffer@67000000 {
+			reg = <0x0 0x67000000 (1200 * 1920 * 4)>;	/* 0x8CA000 */
+			no-map;
+		};
+
+		/*
+		 * Carveout ricavati dal cmdline stock. Non sono usati dal kernel
+		 * mainline, ma S-BOOT / TrustZone ci scrivono dentro: meglio non
+		 * lasciarli all'allocatore.
+		 *   ess_setup=0x46000000
+		 *   sec_avc_log=0x40000@0x47002000
+		 *   sec_tsp_log=0x40000@0x47044000
+		 *   tima_log=0x200000@0x52a00000
+		 */
+		ess_mem: debug-snapshot@46000000 {
+			reg = <0x0 0x46000000 0x1000000>;
+			no-map;
+		};
+
+		sec_log_mem: sec-log@47000000 {
+			reg = <0x0 0x47000000 0x100000>;
+			no-map;
+		};
+
+		tima_mem: tima-log@52a00000 {
+			reg = <0x0 0x52a00000 0x200000>;
+			no-map;
+		};
+
+		/*
+		 * ramoops: piano B se non hai la UART.
+		 * Il kernel mainline scrive qui il panic; poi riavvii in
+		 * LineageOS e recuperi il contenuto con:
+		 *   dd if=/dev/mem bs=1 skip=$((0x56000000)) count=$((0x100000)) \
+		 *      of=/sdcard/ramoops.bin
+		 *   strings /sdcard/ramoops.bin
+		 *
+		 * 0x56000000 e' scelto dentro il banco 1, lontano sia dai
+		 * carveout bassi (0x46-0x53) sia dal framebuffer (0x67) sia
+		 * dalla zona initrd che S-BOOT usa (linux,initrd-start =
+		 * 0x42000000, vedi chosen del DTS downstream).
+		 */
+		ramoops@56000000 {
+			compatible = "ramoops";
+			reg = <0x0 0x56000000 0x100000>;
+			console-size = <0x40000>;
+			record-size = <0x40000>;
+			ftrace-size = <0x0>;
+			pmsg-size = <0x40000>;
+		};
+
+		/*
+		 * ECT — Exynos Character Table: le tabelle DVFS (frequenze,
+		 * tensioni, margini, timing) che il bootloader deposita in RAM
+		 * a 0x90000000, 0x14000 byte = 80 KiB. E' l'UNICA regione del
+		 * banco 2 che va sottratta all'allocatore.
+		 *
+		 * Oggi in mainline non la legge nessuno: il DVFS CPU non
+		 * esiste, perche' i CMU dei cluster non sono descritti in
+		 * clk-exynos7870.c e le frequenze downstream stanno qui dentro
+		 * e non nel device tree. Serve pero' a quel lavoro, ed e' un
+		 * deposito di un altro proprietario (S-BOOT, potenzialmente
+		 * anche EL3): sovrascriverlo e' un danno silenzioso.
+		 *
+		 * Perche' no-map e non una riserva semplice. Entrambe tengono
+		 * fuori l'allocatore; la differenza e' la mappatura.
+		 *  - Senza no-map la regione resta nella linear map come RAM
+		 *    normale cacheable. Quando il codice ECT arrivera' e la
+		 *    mappera' per conto suo, avra' due alias con attributi
+		 *    diversi sulla stessa memoria fisica: su ARMv8 e'
+		 *    comportamento non definito, non un warning.
+		 *  - Con no-map la regione non entra affatto nella linear map.
+		 *    Chi la vuole la chiede con memremap()/ioremap_cache(), che
+		 *    e' l'unico alias esistente. In piu' compare in /proc/iomem
+		 *    come "reserved" e non come "System RAM", quindi resta
+		 *    leggibile da /dev/mem anche con CONFIG_STRICT_DEVMEM=y:
+		 *    utile per controllarne il contenuto senza scrivere codice.
+		 * Il costo di no-map e' che il blocco da 2 MB che la contiene
+		 * viene mappato a granularita' di pagina invece che a sezione.
+		 * Su 2 GB e' irrilevante.
+		 *
+		 * L'indirizzo e' 2 MB allineato e la dimensione e' multipla di
+		 * 4 KiB (0x14000 = 20 pagine): no-map non richiede altro.
+		 */
+		ect_mem: ect@90000000 {
+			reg = <0x0 0x90000000 0x14000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * ======================================================================
+	 * TOUCHSCREEN — alimentazione
+	 * ======================================================================
+	 * Due regolatori fissi pilotati da GPIO, non dal PMIC (downstream:
+	 * exynos7870-gtaxlwifi_eur_open_05.dts righe 660-676).
+	 * Il binding st,stmfts li richiede entrambi come obbligatori.
+	 */
+	tsp_dvdd: regulator-tsp-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_dvdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&gpd1 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	tsp_avdd: regulator-tsp-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpd1 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * ======================================================================
+	 * WI-FI — alimentazione e sequenza di accensione
+	 * ======================================================================
+	 * Il modulo e' un Qualcomm Atheros QCA9377 su SDIO, cablato su mmc1
+	 * (dwmmc_1 @ 0x13550000 nel downstream). Sorgenti:
+	 *
+	 *   exynos7870-gtaxlwifi_eur_open_05.dts righe 28-34 e 539-547
+	 *     cnss_dcdc_en: regulator-fixed, gpio = <&gpa0 6 0>,
+	 *                   startup-delay-us = <4000>
+	 *     wlan { compatible = "qcom,cnss_sdio";
+	 *            wlan-en-gpio   = <&gpd3 6 0x1>;   WLAN_EN
+	 *            wlan-host-wake = <&gpa2 2 0>;     WLAN_HOST_WAKE
+	 *            vdd-wlan-supply = <&cnss_dcdc_en>; }
+	 *
+	 * Il flag 0x1 su wlan-en-gpio e' GPIO_ACTIVE_LOW: un WLAN_EN attivo
+	 * alto diventa, nella semantica reset-gpios di mmc-pwrseq-simple, un
+	 * reset attivo basso. Gli stessi due pin (gpd3-6, gpa2-2) sono gia'
+	 * usati da exynos7870-j6lte.dts righe 82-85 e 467-475: Samsung ha
+	 * cablato allo stesso modo tutta la famiglia 7870 cambiando solo il
+	 * modulo montato.
+	 *
+	 * I ritardi vengono da drivers/net/wireless/cnss/cnss_sdio.c righe
+	 * 1264-1286, che e' la sequenza che gira su Android:
+	 *
+	 *   regulator_enable(vdd-wlan)
+	 *   usleep_range(POWER_ON_DELAY)      2 ms
+	 *   WLAN_EN -> HIGH
+	 *   usleep_range(WLAN_ENABLE_DELAY)  10 ms
+	 *   enumerazione SDIO
+	 *
+	 * Il core MMC riproduce lo stesso ordine: mmc_power_up() chiama
+	 * pre_power_on (reset asserito), accende vmmc, poi post_power_on
+	 * (reset rilasciato + post-power-on-delay-ms). Lo startup-delay-us
+	 * del regolatore, 4000, copre gia' i 2 ms del primo sleep.
+	 *
+	 * Il downstream non dichiara una tensione per cnss_dcdc_en: e' un
+	 * DC-DC esterno con uscita fissa, il GPIO ne comanda solo l'enable.
+	 * Per questo qui non ci sono regulator-min/max-microvolt — e per la
+	 * stessa ragione il regolatore NON puo' essere usato come
+	 * vmmc-supply: mmc_regulator_get_ocrmask() ricava la maschera OCR
+	 * dalle tensioni dichiarate e senza di esse ritorna -EINVAL. In
+	 * dw_mci_set_ios(), caso MMC_POWER_UP, il fallimento di
+	 * mmc_regulator_set_ocr() provoca un return anticipato che salta
+	 * DW_MMC_CARD_NEED_INIT e la scrittura di PWREN, lasciando il
+	 * controller in uno stato di power-up incompleto (kernel #51:
+	 * "Failed getting OCR mask: -22" / "failed to enable vmmc
+	 * regulator", con la card enumerata lo stesso perche' S-BOOT
+	 * lasciava il DC-DC acceso).
+	 *
+	 * Da qui regulator-always-on: il rail viene acceso dal framework in
+	 * modo esplicito e deterministico, senza passare dal core MMC.
+	 * Serve anche a togliere di mezzo regulator_ignore_unused, che su
+	 * un regolatore non reclamato maschererebbe lo stato reale.
+	 * exynos7870-j6lte.dts fa lo stesso: il suo mmc1 non ha
+	 * vmmc-supply, solo il pwrseq.
+	 *
+	 * WLAN_HOST_WAKE (gpa2-2) NON e' dichiarato: ath10k sul bus SDIO usa
+	 * l'interrupt in-band, non una linea out-of-band. Il pin resta
+	 * libero per un eventuale nodo figlio in seguito.
+	 */
+	wlan_pwr: regulator-wlan {
+		compatible = "regulator-fixed";
+		regulator-name = "cnss_dcdc_en";
+		gpio = <&gpa0 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <4000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	pwrseq_wlan: pwrseq-wlan {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;	/* WLAN_EN */
+		post-power-on-delay-ms = <10>;
+	};
+
+	/*
+	 * ======================================================================
+	 * microSD — alimentazione dello slot
+	 * ======================================================================
+	 * vmmc dello slot: DC-DC esterno a 2,8 V comandato da gpc0-0, come in
+	 * exynos7870-j6lte.dts righe 88-96 (identico anche su on7xelte e
+	 * a2corelte: e' il cablaggio di riferimento della famiglia 7870).
+	 * Il downstream lo chiama sd_fixed_vcc, regulator-name "vmmc",
+	 * exynos7870-gtaxl_common.dtsi, con lo stesso gpio e le stesse
+	 * tensioni.
+	 *
+	 * Al contrario di cnss_dcdc_en qui sopra, questo regolatore PUO'
+	 * essere usato come vmmc-supply, e la differenza sta tutta nelle due
+	 * righe di tensione: mmc_regulator_get_ocrmask() ricava la maschera
+	 * OCR da regulator-min/max-microvolt, e min = max = 2800000 le da'
+	 * qualcosa da cui ricavarla. E' esattamente il caso opposto a quello
+	 * documentato sopra per il Wi-Fi.
+	 *
+	 * NIENTE pinctrl, ed e' voluto. Il downstream ci attacca un gruppo
+	 * boot_ldo che dichiara samsung,pins = "gpc0-0", ma il commento
+	 * accanto spiega che non serve a questo pin:
+	 *
+	 *     // gpc0-0 and gpc0-2 register is switched
+	 *     // This is to make gpc0-2 pull-down enabled
+	 *
+	 * cioe' il registro di configurazione di gpc0-0 atterra su gpc0-2, e
+	 * Samsung sfrutta l'inversione per mettere in pull-down gpc0-2, che
+	 * su questa scheda e' NC (exynos7870-gtaxlwifi_eur_open_gpio_05.dtsi
+	 * lo dichiara PIN_IN(gpc0-2, DOWN) in initial e in sleep). Lo scambio
+	 * vive nei registri di configurazione, non nel percorso dato: gpiolib
+	 * su gpc0-0 pilota il pin giusto, come dimostra il fatto che il
+	 * downstream accenda l'LDO proprio cosi'. Dichiarare qui un gruppo
+	 * pinctrl su gpc0-0 significherebbe scrivere in un registro che, per
+	 * ammissione del vendor, finisce altrove.
+	 *
+	 * Come per WLAN_EN, la funzione di uscita la imposta pinctrl-samsung
+	 * quando gpiolib chiede la direzione: nessun nodo pinctrl necessario.
+	 */
+	vdd_fixed_mmc2: regulator-fixed-mmc2 {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_fixed_mmc2";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpc0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * Tasti fisici. GPIO da exynos7870-gtaxl_common.dtsi (nodo gpio_keys,
+	 * righe 133-173); stile e nodi pinctrl copiati da exynos7870-j6lte.dts.
+	 * Il downstream usa il flag 0xf, convenzione Samsung che in mainline
+	 * si traduce in GPIO_ACTIVE_LOW.
+	 *
+	 * Il tablet ha in piu' il tasto Home su gpa1-7, che il J6 non ha:
+	 * il nodo pinctrl key_home lo definisco in fondo a questo file.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "GPIO Keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home>;
+
+		key-power {
+			label = "Power Key";
+			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;		/* 116 */
+			wakeup-source;
+		};
+
+		key-voldown {
+			label = "Volume Down Key";
+			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;		/* 114 */
+		};
+
+		key-volup {
+			label = "Volume Up Key";
+			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;		/* 115 */
+		};
+
+		key-home {
+			label = "Home Key";
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_HOMEPAGE>;		/* 172 */
+			wakeup-source;
+		};
+	};
+};
