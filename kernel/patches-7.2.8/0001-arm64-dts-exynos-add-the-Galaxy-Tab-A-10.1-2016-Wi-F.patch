+/*
+ * ======================================================================
+ * BLUETOOTH — QCA9377 su UART
+ * ======================================================================
+ * Stesso silicio del Wi-Fi: il QCA9377 e' un combo che espone la WLAN su
+ * SDIO (mmc1) e il Bluetooth su UART, protocollo H4 con IBS. Sono due
+ * interfacce host separate; in comune hanno solo l'alimentazione
+ * (cnss_dcdc_en su gpa0-6, gia' dichiarato sopra come wlan_pwr con
+ * regulator-always-on) e l'antenna.
+ *
+ * ATTENZIONE ALLA NUMERAZIONE: downstream e mainline chiamano le due
+ * UART al contrario. Il blocco e' lo stesso, il nome no.
+ *
+ *   0x13810000  downstream serial_0 "UART_BTWIFIFM"  -> mainline serial1
+ *   0x13800000  downstream serial_1 "UART_SENSOR"    -> mainline serial0
+ *   0x13820000  downstream serial_2 "UART_DEBUG"     -> mainline serial2
+ *
+ * Il Bluetooth sta su 0x13810000. Tre catene indipendenti concordano:
+ *   - i pin: gpb0-0..3 sono etichettati BT_UART_RXD/TXD/CTS/RTS in tutti
+ *     i *_gpio_NN.dtsi della famiglia 7870, e sia il downstream
+ *     (uart0_bus) sia mainline (uart1_bus) li assegnano a 0x13810000;
+ *   - le FIFO: 16 su 0x13800000 e 256 su 0x13810000 in entrambi gli
+ *     alberi;
+ *   - i gate CMU: il pwrcal downstream nomina per funzione
+ *     (UART_BTWIFIFM / UART_DEBUG / UART_SENSOR) e l'ordine corrisponde
+ *     a UART1 / UART2 / UART0 di clk-exynos7870.c. La gamba DEBUG e'
+ *     verificata sul silicio: nel clk_summary gout_peri_uart2_pclk e
+ *     gout_peri_uart2_ext_uclk sono agganciati a 13820000.serial.
+ *
+ * Cablaggio, da exynos7870-gtaxlwifi_eur_open_05.dts righe 572-581:
+ *
+ *   bluetooth { compatible = "qca,qca6174";
+ *               gpios = <&gpd4 0 0x1   BT_EN
+ *                        &gpa1 2 0x1   BT_WAKE
+ *                        &gpa1 6 0xF   BT_HOST_WAKE>;
+ *               vdd-wlan-supply = <&cnss_dcdc_en>; }
+ *
+ * "qca,qca6174" e' l'etichetta di famiglia (ROME): in mainline sia
+ * qcom,qca6174-bt sia qcom,qca9377-bt cadono nello stesso ramo di
+ * qca_serdev_probe(), quello senza .data, e diventano QCA_ROME. Uso il
+ * compatible del silicio vero, accertato dal lato WLAN.
+ *
+ * BT_EN e' attivo alto: bluetooth-power.c scrive 1 per accendere
+ * (gpio_set_value(bt_reset_gpio, 0); msleep(50); ... 1; msleep(50)).
+ * Il flag 0x1 nel DTS downstream e' decorativo, come per wlan-en-gpio.
+ * Mainline copre la sequenza: GPIOD_OUT_LOW al probe, poi alto con
+ * msleep(150) in qca_power_on(), tre volte il tempo del vendor.
+ *
+ * BT_WAKE e BT_HOST_WAKE non sono dichiarati: sul ramo ROME l'IBS e'
+ * in-band, esattamente come WLAN_HOST_WAKE (gpa2-2) per ath10k su SDIO.
+ *
+ * Nessun "clocks": il nodo downstream non ne dichiara, quindi il 32 kHz
+ * di sleep non viene dall'AP. In qca_serdev_probe() il clock e'
+ * opzionale ma, se dichiarato e incapace di 32768 Hz, il probe FALLISCE.
+ *
+ * max-speed: 921600. Il valore NON e' libero, lo vincola il download
+ * del firmware. HCI_CMD_TIMEOUT e' 2000 ms e il timer parte quando il
+ * comando viene ACCODATO, non quando finisce di essere trasmesso:
+ * __hci_cmd_send() mette lo skb in coda e torna, mentre la work di TX
+ * svuota la coda al ritmo della seriale. Il rampatch e' ~33 KB, che a
+ * 115200 (8N1, 10 bit/byte) richiedono 2,87 s: il timer scade mentre la
+ * UART sta ancora trasmettendo, e si vede "command 0xfc00 tx timeout"
+ * seguito da "QCA Failed to send TLV segment (-110)". Misurato: due
+ * rampatch di dimensione molto diversa (33.064 e 68.600 byte) falliscono
+ * entrambi a 2,012 s esatti, perche' il numero misura il timer e non il
+ * file.
+ *
+ *   33 KB @ 115200 -> 2,87 s   oltre soglia
+ *   33 KB @ 921600 -> 0,36 s   margine 5,5x
+ *   33 KB @ 3 Mbps -> 0,11 s
+ *
+ * clk_uart_baud0 misurato: 133,25 MHz. Con has_divslot il divisore e'
+ * troncato, quindi l'errore e' sempre in eccesso:
+ *   115200 -> div 1156 -> 115268   (+0,06%)
+ *   921600 -> div  144 -> 925347   (+0,41%)
+ *  3000000 -> div   44 -> 3028409  (+0,95%)
+ * 921600 e' il gradino piu' conservativo che risolva il download. I
+ * 3 Mbps restano un passo successivo, motivato dalle prestazioni A2DP e
+ * non dalla correttezza.
+ *
+ * Nota storica: il primo collaudo uso' 115200 di proposito, per separare
+ * la verifica del cablaggio da quella del baud. Ha funzionato -- la
+ * lettura di versione riusci' al primo tentativo -- ma quel valore rende
+ * impossibile lo stadio successivo. La cautela va scongelata prima di
+ * dichiarare fallito cio' che viene dopo.
+ */
+&serial1 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qca9377-bt";
+		enable-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;	/* BT_EN */
+		max-speed = <921600>;
+	};
+};
+
+/*
+ * ======================================================================
+ * PMIC S2MPU05
+ * ======================================================================
+ * Confermato su hsi2c@10510000 addr 0x66, IRQ gpa0-2, identico al J6
+ * (exynos7870-gtaxlwifi_eur_open_05.dts righe 222-256).
+ *
+ * ATTENZIONE - LEGGERE PRIMA DI FLASHARE:
+ * LDO35 = "LCD_1P8" alimenta il pannello. Nessun driver lo reclama,
+ * perche' simple-framebuffer non conosce l'hardware di alimentazione.
+ * Senza "regulator_ignore_unused" nel cmdline il kernel lo spegne a fine
+ * boot e perdi lo schermo, cioe' l'unico canale di diagnostica.
+ *
+ * Dichiaro solo i regolatori che servono ora. I buck principali
+ * (core, memoria, I/O) li lascio fuori: sono gestiti dal bootloader e
+ * toccarli senza necessita' aggiunge rischio a zero beneficio.
+ * Eccezione: BUCK2 (rail G3D), dichiarato per il DVFS della GPU — vedi
+ * il nodo piu' sotto.
+ */
+/*
+ * ======================================================================
+ * GPU — Mali-T830
+ * ======================================================================
+ * Il nodo e' completo in exynos7870.dtsi (compatible
+ * "samsung,exynos7870-mali", "arm,mali-t830", clock e interrupt gia'
+ * dichiarati) ma con status = "disabled": va solo abilitato, come fa il
+ * J6.
+ *
+ * Serve a Panfrost (CONFIG_DRM_PANFROST=y nella config pmOS): senza,
+ * il rendering di un compositor Wayland ricade su llvmpipe.
+ *
+ * OPP + regolatore (campagna DVFS GPU, fase C): i sette gradini abilitati
+ * dal vendor (dominio ECT "dvfs_g3d", en=1), con le tensioni ASV di
+ * QUESTO esemplare: fuse grp5 / tabella 5, ssa tutti a zero (dump 0070),
+ * colonna grp5 della tabella ASV + 20000 uV di margine (lo stesso del
+ * driver Mali downstream), arrotondati al passo PMIC di 6250 uV.
+ * Il rilock del PLL sotto carico e' stato collaudato a mano su tutta la
+ * scala via debugfs (kernel #40): nessun fault, nessun glitch.
+ * Nota: niente TMU in mainline, quindi niente throttling termico. Il
+ * tetto si governa a runtime con /sys/class/devfreq/.../max_freq.
+ */
+&gpu {
+	status = "okay";
+
+	mali-supply = <&buck2_reg>;
+	operating-points-v2 = <&gpu_opp_table>;
+
+	gpu_opp_table: opp-table {
+		compatible = "operating-points-v2";
+
+		opp-343000000 {
+			opp-hz = /bits/ 64 <343000000>;
+			opp-microvolt = <625000>;
+		};
+
+		opp-450000000 {
+			opp-hz = /bits/ 64 <450000000>;
+			opp-microvolt = <662500>;
+		};
+
+		opp-545000000 {
+			opp-hz = /bits/ 64 <545000000>;
+			opp-microvolt = <706250>;
+		};
+
+		opp-676000000 {
+			opp-hz = /bits/ 64 <676000000>;
+			opp-microvolt = <768750>;
+		};
+
+		opp-728000000 {
+			opp-hz = /bits/ 64 <728000000>;
+			opp-microvolt = <787500>;
+		};
+
+		opp-845000000 {
+			opp-hz = /bits/ 64 <845000000>;
+			opp-microvolt = <862500>;
+		};
+
+		opp-1001000000 {
+			opp-hz = /bits/ 64 <1001000000>;
+			opp-microvolt = <956250>;
+		};
+	};
+};
