From c20e76fe324cc10564ebed1b45dad108a40838f2 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 16:55:56 +0200
Subject: [PATCH] media: exynos7870-csis: one device, two channels

CSIS0 and CSIS1 write through the same SysMMU (sysmmu_isp0), and
exynos-iommu keeps one master device per SysMMU: two devices attached to
it make the second probe steal the first's IOMMU. Describe both receivers
as one node with two register ranges, two interrupts, two PHYs and two
ports; the driver keeps one media device and creates a capture node per
connected port.

---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi    |  42 +--
 .../samsung/exynos7870-csis/exynos7870-csis.c | 302 +++++++++++-------
 2 files changed, 208 insertions(+), 136 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index 7df2d484d8..9752662c28 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -886,38 +886,42 @@ wakeup-interrupt-controller {
 			};
 		};
 
-		csis0: csis@14420000 {
+		/*
+		 * CSIS0 and CSIS1, each a CSI-2 receiver with its own DMA. One
+		 * node because both write through sysmmu_isp0, and the SysMMU
+		 * driver takes one master device per SysMMU. Port 0 is CSIS0
+		 * (four lanes, PHY shared with DSIM0), port 1 is CSIS1.
+		 */
+		csis: csis@14420000 {
 			compatible = "samsung,exynos7870-csis";
-			reg = <0x14420000 0x10000>;
-			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0x14420000 0x10000>,
+			      <0x14460000 0x10000>;
+			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
 
 			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>,
 				 <&cmu_isp CLK_GOUT_ISP_CAM_HALF>;
 			clock-names = "aclk", "pclk";
 
-			phys = <&mipi_phy 0>;
-			phy-names = "csis";
+			phys = <&mipi_phy 0>, <&mipi_phy 2>;
+			phy-names = "csis0", "csis1";
 
 			iommus = <&sysmmu_isp0>;
 
 			status = "disabled";
-		};
-
-		csis1: csis@14460000 {
-			compatible = "samsung,exynos7870-csis";
-			reg = <0x14460000 0x10000>;
-			interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
-
-			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>,
-				 <&cmu_isp CLK_GOUT_ISP_CAM_HALF>;
-			clock-names = "aclk", "pclk";
 
-			phys = <&mipi_phy 2>;
-			phy-names = "csis";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
 
-			iommus = <&sysmmu_isp0>;
+				csis0_port: port@0 {
+					reg = <0>;
+				};
 
-			status = "disabled";
+				csis1_port: port@1 {
+					reg = <1>;
+				};
+			};
 		};
 
 		/* The write masters of both CSIS DMA engines sit behind it. */
diff --git a/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c b/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
index 42483673da..455d4053dc 100644
--- a/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
+++ b/drivers/media/platform/samsung/exynos7870-csis/exynos7870-csis.c
@@ -132,23 +132,27 @@ struct csis_buffer {
 	struct list_head list;
 };
 
+#define CSIS_CHANNELS			2
+
+struct csis_dev;
+
+/* One receiver (CSIS0 or CSIS1) and its capture node. */
 struct csis {
+	struct csis_dev *parent;
+	unsigned int id;
+	bool present;
 	struct device *dev;
 	void __iomem *regs;
 	int irq;
-	struct clk_bulk_data clks[2];
 	struct phy *phy;
 	unsigned int lanes;
 
-	struct media_device mdev;
-	struct v4l2_device v4l2_dev;
 	struct video_device vdev;
 	struct media_pad vdev_pad;
 	struct media_pipeline pipe;
 	struct vb2_queue queue;
 	struct mutex lock;
 
-	struct v4l2_async_notifier notifier;
 	struct v4l2_subdev *sensor;
 	u32 sensor_pad;
 
@@ -262,8 +266,8 @@ static irqreturn_t csis_irq(int irq, void *data)
 	if ((src0 & CSIS_INT0_ERRORS) || (src1 & CSIS_INT1_DMA_ERROR)) {
 		csis->errors++;
 		dev_err_ratelimited(csis->dev,
-				    "errors: src0 %08x src1 %08x dma %08x\n",
-				    src0, src1,
+				    "csis%u errors: src0 %08x src1 %08x dma %08x\n",
+				    csis->id, src0, src1,
 				    csis_read(csis, CSIS_DMA_ERR_CODE));
 	}
 
@@ -276,8 +280,8 @@ static irqreturn_t csis_irq(int irq, void *data)
 		if (csis->reported < 3) {
 			csis->reported++;
 			dev_info(csis->dev,
-				 "frame %u: dma byte count %u, frame count %u\n",
-				 csis->sequence,
+				 "csis%u frame %u: dma byte count %u, frame count %u\n",
+				 csis->id, csis->sequence,
 				 csis_read(csis, CSIS_DMA0_BYTE_CNT),
 				 csis_read(csis, CSIS_FRM_CNT_CH0));
 		}
@@ -368,8 +372,8 @@ static int csis_hw_start(struct csis *csis)
 	csis_update(csis, CSIS_CMN_CTRL, CSIS_CMN_CTRL_CSI_EN,
 		    CSIS_CMN_CTRL_CSI_EN);
 
-	dev_dbg(csis->dev, "started: version %08x, %u lanes, settle %u\n",
-		csis_read(csis, CSIS_VERSION), csis->lanes, hs_settle);
+	dev_dbg(csis->dev, "csis%u started: version %08x, %u lanes, settle %u\n",
+		csis->id, csis_read(csis, CSIS_VERSION), csis->lanes, hs_settle);
 
 	return 0;
 }
@@ -546,8 +550,8 @@ static void csis_stop_streaming(struct vb2_queue *q)
 	video_device_pipeline_stop(&csis->vdev);
 
 	dev_info(csis->dev,
-		 "%u frames on the link, %u captured, %u broken, %u error interrupts\n",
-		 csis->sequence, csis->done, csis->dropped, csis->errors);
+		 "csis%u: %u frames on the link, %u captured, %u broken, %u error interrupts\n",
+		 csis->id, csis->sequence, csis->done, csis->dropped, csis->errors);
 
 	csis_return_all(csis, VB2_BUF_STATE_ERROR);
 }
@@ -589,7 +593,9 @@ static int csis_querycap(struct file *file, void *priv,
 			 struct v4l2_capability *cap)
 {
 	strscpy(cap->driver, CSIS_DRV_NAME, sizeof(cap->driver));
-	strscpy(cap->card, "Exynos7870 CSIS", sizeof(cap->card));
+	struct csis *csis = video_drvdata(file);
+
+	snprintf(cap->card, sizeof(cap->card), "Exynos7870 CSIS%u", csis->id);
 	return 0;
 }
 
@@ -679,13 +685,32 @@ static const struct v4l2_file_operations csis_fops = {
 	.poll = vb2_fop_poll,
 };
 
+/*
+ * The two receivers sit behind one SysMMU, and exynos-iommu keeps one
+ * master per SysMMU: they are one device, hence one IOMMU domain, with a
+ * channel per receiver, one media graph and one camera per sensor.
+ */
+struct csis_dev {
+	struct device *dev;
+	struct clk_bulk_data clks[2];
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct v4l2_async_notifier notifier;
+	struct csis chans[CSIS_CHANNELS];
+};
+
+struct csis_asc {
+	struct v4l2_async_connection asc;
+	struct csis *chan;
+};
+
 /* -------------------------------------------------------------- async */
 
 static int csis_notify_bound(struct v4l2_async_notifier *notifier,
 			     struct v4l2_subdev *sd,
 			     struct v4l2_async_connection *asc)
 {
-	struct csis *csis = container_of(notifier, struct csis, notifier);
+	struct csis *csis = container_of(asc, struct csis_asc, asc)->chan;
 	int pad;
 
 	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
@@ -703,14 +728,14 @@ static int csis_notify_bound(struct v4l2_async_notifier *notifier,
 
 static int csis_notify_complete(struct v4l2_async_notifier *notifier)
 {
-	struct csis *csis = container_of(notifier, struct csis, notifier);
+	struct csis_dev *cdev = container_of(notifier, struct csis_dev, notifier);
 	int ret;
 
-	ret = v4l2_device_register_subdev_nodes(&csis->v4l2_dev);
+	ret = v4l2_device_register_subdev_nodes(&cdev->v4l2_dev);
 	if (ret)
 		return ret;
 
-	return media_device_register(&csis->mdev);
+	return media_device_register(&cdev->mdev);
 }
 
 static const struct v4l2_async_notifier_operations csis_notify_ops = {
@@ -718,58 +743,81 @@ static const struct v4l2_async_notifier_operations csis_notify_ops = {
 	.complete = csis_notify_complete,
 };
 
-static int csis_parse_dt(struct csis *csis)
+/* The channel of port @id, if the device tree connects it to a sensor. */
+static int csis_parse_port(struct csis_dev *cdev, unsigned int id)
 {
 	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
-	struct v4l2_async_connection *asc;
+	struct platform_device *pdev = to_platform_device(cdev->dev);
+	struct csis *csis = &cdev->chans[id];
+	struct csis_asc *asc;
 	struct fwnode_handle *ep;
+	char name[8];
 	int ret;
 
-	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(csis->dev), 0, 0, 0);
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(cdev->dev), id, 0, 0);
 	if (!ep)
-		return dev_err_probe(csis->dev, -ENODEV, "no endpoint\n");
+		return 0;
 
 	ret = v4l2_fwnode_endpoint_parse(ep, &vep);
-	if (ret) {
-		fwnode_handle_put(ep);
-		return dev_err_probe(csis->dev, ret, "bad endpoint\n");
-	}
+	if (ret)
+		goto out;
 	csis->lanes = vep.bus.mipi_csi2.num_data_lanes;
 	if (csis->lanes < 1 || csis->lanes > 4) {
-		fwnode_handle_put(ep);
-		return dev_err_probe(csis->dev, -EINVAL, "%u lanes\n",
-				     csis->lanes);
+		ret = dev_err_probe(cdev->dev, -EINVAL, "port %u: %u lanes\n",
+				    id, csis->lanes);
+		goto out;
 	}
 
-	v4l2_async_nf_init(&csis->notifier, &csis->v4l2_dev);
-	csis->notifier.ops = &csis_notify_ops;
+	csis->regs = devm_platform_ioremap_resource(pdev, id);
+	if (IS_ERR(csis->regs)) {
+		ret = PTR_ERR(csis->regs);
+		goto out;
+	}
 
-	asc = v4l2_async_nf_add_fwnode_remote(&csis->notifier, ep,
-					      struct v4l2_async_connection);
-	fwnode_handle_put(ep);
-	if (IS_ERR(asc))
-		return PTR_ERR(asc);
+	csis->irq = platform_get_irq(pdev, id);
+	if (csis->irq < 0) {
+		ret = csis->irq;
+		goto out;
+	}
 
-	return 0;
+	snprintf(name, sizeof(name), "csis%u", id);
+	csis->phy = devm_phy_get(cdev->dev, name);
+	if (IS_ERR(csis->phy)) {
+		ret = dev_err_probe(cdev->dev, PTR_ERR(csis->phy),
+				    "failed to get PHY %s\n", name);
+		goto out;
+	}
+
+	ret = devm_request_irq(cdev->dev, csis->irq, csis_irq, 0,
+			       devm_kasprintf(cdev->dev, GFP_KERNEL, "%s:%s",
+					      dev_name(cdev->dev), name),
+			       csis);
+	if (ret)
+		goto out;
+
+	asc = v4l2_async_nf_add_fwnode_remote(&cdev->notifier, ep,
+					      struct csis_asc);
+	if (IS_ERR(asc)) {
+		ret = PTR_ERR(asc);
+		goto out;
+	}
+	asc->chan = csis;
+	csis->present = true;
+	ret = 0;
+
+out:
+	fwnode_handle_put(ep);
+	return ret;
 }
 
 /* -------------------------------------------------------------- probe */
 
-static int csis_register(struct csis *csis)
+static int csis_register_chan(struct csis *csis)
 {
 	struct video_device *vdev = &csis->vdev;
 	struct vb2_queue *q = &csis->queue;
 	int ret;
 
-	csis->mdev.dev = csis->dev;
-	strscpy(csis->mdev.model, "Exynos7870 CSIS", sizeof(csis->mdev.model));
-	media_device_init(&csis->mdev);
-
-	csis->v4l2_dev.mdev = &csis->mdev;
-	ret = v4l2_device_register(csis->dev, &csis->v4l2_dev);
-	if (ret)
-		goto err_mdev;
-
 	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
 	q->io_modes = VB2_MMAP | VB2_DMABUF;
 	q->drv_priv = csis;
@@ -788,13 +836,13 @@ static int csis_register(struct csis *csis)
 	q->dev = csis->dev;
 	ret = vb2_queue_init(q);
 	if (ret)
-		goto err_v4l2;
+		return ret;
 
-	strscpy(vdev->name, CSIS_DRV_NAME, sizeof(vdev->name));
+	snprintf(vdev->name, sizeof(vdev->name), CSIS_DRV_NAME "%u", csis->id);
 	vdev->fops = &csis_fops;
 	vdev->ioctl_ops = &csis_ioctl_ops;
 	vdev->release = video_device_release_empty;
-	vdev->v4l2_dev = &csis->v4l2_dev;
+	vdev->v4l2_dev = &csis->parent->v4l2_dev;
 	vdev->queue = q;
 	vdev->lock = &csis->lock;
 	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
@@ -805,122 +853,142 @@ static int csis_register(struct csis *csis)
 	csis->vdev_pad.flags = MEDIA_PAD_FL_SINK | MEDIA_PAD_FL_MUST_CONNECT;
 	ret = media_entity_pads_init(&vdev->entity, 1, &csis->vdev_pad);
 	if (ret)
-		goto err_v4l2;
+		return ret;
 
 	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
 	if (ret)
-		goto err_entity;
+		media_entity_cleanup(&vdev->entity);
 
-	ret = csis_parse_dt(csis);
-	if (ret)
-		goto err_vdev;
+	return ret;
+}
 
-	ret = v4l2_async_nf_register(&csis->notifier);
-	if (ret)
-		goto err_nf;
+static void csis_unregister_chans(struct csis_dev *cdev)
+{
+	unsigned int i;
 
-	return 0;
+	for (i = 0; i < CSIS_CHANNELS; i++) {
+		struct csis *csis = &cdev->chans[i];
 
-err_nf:
-	v4l2_async_nf_cleanup(&csis->notifier);
-err_vdev:
-	video_unregister_device(vdev);
-err_entity:
-	media_entity_cleanup(&vdev->entity);
-err_v4l2:
-	v4l2_device_unregister(&csis->v4l2_dev);
-err_mdev:
-	media_device_cleanup(&csis->mdev);
-	return ret;
+		if (!csis->present || !video_is_registered(&csis->vdev))
+			continue;
+		video_unregister_device(&csis->vdev);
+		media_entity_cleanup(&csis->vdev.entity);
+	}
 }
 
 static int csis_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
-	struct csis *csis;
+	struct csis_dev *cdev;
+	unsigned int i, present = 0;
 	int ret;
 
-	csis = devm_kzalloc(dev, sizeof(*csis), GFP_KERNEL);
-	if (!csis)
+	cdev = devm_kzalloc(dev, sizeof(*cdev), GFP_KERNEL);
+	if (!cdev)
 		return -ENOMEM;
 
-	csis->dev = dev;
-	mutex_init(&csis->lock);
-	spin_lock_init(&csis->slock);
-	INIT_LIST_HEAD(&csis->pending);
-	platform_set_drvdata(pdev, csis);
-
-	csis->regs = devm_platform_ioremap_resource(pdev, 0);
-	if (IS_ERR(csis->regs))
-		return PTR_ERR(csis->regs);
+	cdev->dev = dev;
+	platform_set_drvdata(pdev, cdev);
 
-	csis->irq = platform_get_irq(pdev, 0);
-	if (csis->irq < 0)
-		return csis->irq;
-
-	csis->clks[0].id = "aclk";
-	csis->clks[1].id = "pclk";
-	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(csis->clks), csis->clks);
+	cdev->clks[0].id = "aclk";
+	cdev->clks[1].id = "pclk";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(cdev->clks), cdev->clks);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to get clocks\n");
 
-	csis->phy = devm_phy_get(dev, "csis");
-	if (IS_ERR(csis->phy))
-		return dev_err_probe(dev, PTR_ERR(csis->phy),
-				     "failed to get the PHY\n");
-
 	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
 	if (ret)
 		return ret;
 
-	ret = devm_request_irq(dev, csis->irq, csis_irq, 0, dev_name(dev),
-			       csis);
+	cdev->mdev.dev = dev;
+	strscpy(cdev->mdev.model, "Exynos7870 CSIS", sizeof(cdev->mdev.model));
+	media_device_init(&cdev->mdev);
+
+	cdev->v4l2_dev.mdev = &cdev->mdev;
+	ret = v4l2_device_register(dev, &cdev->v4l2_dev);
 	if (ret)
-		return ret;
+		goto err_mdev;
 
-	csis->fmt.pixelformat = V4L2_PIX_FMT_SBGGR10;
-	csis->fmt.width = 1632;
-	csis->fmt.height = 1228;
-	csis_try_fmt(&csis->fmt, &csis->cfmt);
+	v4l2_async_nf_init(&cdev->notifier, &cdev->v4l2_dev);
+	cdev->notifier.ops = &csis_notify_ops;
+
+	for (i = 0; i < CSIS_CHANNELS; i++) {
+		struct csis *csis = &cdev->chans[i];
+
+		csis->parent = cdev;
+		csis->id = i;
+		csis->dev = dev;
+		mutex_init(&csis->lock);
+		spin_lock_init(&csis->slock);
+		INIT_LIST_HEAD(&csis->pending);
+		csis->fmt.pixelformat = V4L2_PIX_FMT_SBGGR10;
+		csis->fmt.width = 1632;
+		csis->fmt.height = 1228;
+		csis_try_fmt(&csis->fmt, &csis->cfmt);
+
+		ret = csis_parse_port(cdev, i);
+		if (ret)
+			goto err_nf;
+		present += csis->present;
+	}
+	if (!present) {
+		ret = dev_err_probe(dev, -ENODEV, "no port connected\n");
+		goto err_nf;
+	}
 
 	pm_runtime_enable(dev);
 
-	ret = csis_register(csis);
-	if (ret) {
-		pm_runtime_disable(dev);
-		return ret;
+	for (i = 0; i < CSIS_CHANNELS; i++) {
+		if (!cdev->chans[i].present)
+			continue;
+		ret = csis_register_chan(&cdev->chans[i]);
+		if (ret)
+			goto err_chans;
 	}
 
+	ret = v4l2_async_nf_register(&cdev->notifier);
+	if (ret)
+		goto err_chans;
+
 	return 0;
+
+err_chans:
+	csis_unregister_chans(cdev);
+	pm_runtime_disable(dev);
+err_nf:
+	v4l2_async_nf_cleanup(&cdev->notifier);
+	v4l2_device_unregister(&cdev->v4l2_dev);
+err_mdev:
+	media_device_cleanup(&cdev->mdev);
