diff --git a/drivers/mfd/sm5703.c b/drivers/mfd/sm5703.c
new file mode 100644
index 0000000000..be91b7e21a
--- /dev/null
+++ b/drivers/mfd/sm5703.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Silicon Mitus SM5703 PMIC core driver
+ *
+ * The SM5703 combines a charger, LDO and buck regulators, a flash LED
+ * driver, a MUIC USB switch and a fuel gauge.  The charger, the
+ * regulators and the LED driver share the I2C address this driver binds
+ * to; the MUIC and the fuel gauge have addresses of their own, often on
+ * a different bus, and are handled by separate drivers.
+ *
+ * Copyright (C) 2022 Markuss Broks <markuss.broks@gmail.com>
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/ioport.h>
+#include <linux/mfd/core.h>
+#include <linux/mfd/sm5703.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
+/*
+ * The charger watches the interrupts that tell it charging has started
+ * or finished.  mfd_add_devices() turns these into real interrupt
+ * numbers against the regmap-irq domain passed to it, so the values
+ * here are indices into sm5703_irqs below, not virqs.
+ */
+static const struct resource sm5703_charger_resources[] = {
+	DEFINE_RES_IRQ_NAMED(SM5703_IRQ_CHGON, "CHGON"),
+	DEFINE_RES_IRQ_NAMED(SM5703_IRQ_TOPOFF, "TOPOFF"),
+	DEFINE_RES_IRQ_NAMED(SM5703_IRQ_DONE, "DONE"),
+};
+
+static const struct mfd_cell sm5703_cells[] = {
+	MFD_CELL_OF("sm5703-charger", sm5703_charger_resources, NULL, 0, 0,
+		    "siliconmitus,sm5703-charger"),
+};
+
+static const struct regmap_irq sm5703_irqs[] = {
+	REGMAP_IRQ_REG(SM5703_IRQ_AICL, 0, BIT(0)),
+	REGMAP_IRQ_REG(SM5703_IRQ_BATOVP, 0, BIT(1)),
+	REGMAP_IRQ_REG(SM5703_IRQ_LOWBATT, 0, BIT(2)),
+	REGMAP_IRQ_REG(SM5703_IRQ_VBUSLIMIT, 0, BIT(3)),
+	REGMAP_IRQ_REG(SM5703_IRQ_DISLIMIT, 0, BIT(4)),
+	REGMAP_IRQ_REG(SM5703_IRQ_VSYSOLP, 0, BIT(5)),
+	REGMAP_IRQ_REG(SM5703_IRQ_OTGFAIL, 0, BIT(6)),
+
+	REGMAP_IRQ_REG(SM5703_IRQ_THEMREG, 1, BIT(0)),
+	REGMAP_IRQ_REG(SM5703_IRQ_THEMSHDN, 1, BIT(1)),
+	REGMAP_IRQ_REG(SM5703_IRQ_VSYSNG, 1, BIT(2)),
+	REGMAP_IRQ_REG(SM5703_IRQ_VSYSOK, 1, BIT(3)),
+	REGMAP_IRQ_REG(SM5703_IRQ_NOBAT, 1, BIT(4)),
+	REGMAP_IRQ_REG(SM5703_IRQ_PRETMROFF, 1, BIT(5)),
+	REGMAP_IRQ_REG(SM5703_IRQ_FASTTMROFF, 1, BIT(6)),
+
+	REGMAP_IRQ_REG(SM5703_IRQ_CHGON, 2, BIT(0)),
+	REGMAP_IRQ_REG(SM5703_IRQ_Q4FULLON, 2, BIT(1)),
+	REGMAP_IRQ_REG(SM5703_IRQ_TOPOFF, 2, BIT(2)),
+	REGMAP_IRQ_REG(SM5703_IRQ_DONE, 2, BIT(3)),
+	REGMAP_IRQ_REG(SM5703_IRQ_CHGRSTF, 2, BIT(4)),
+
+	REGMAP_IRQ_REG(SM5703_IRQ_FLEDSHORT, 3, BIT(0)),
+	REGMAP_IRQ_REG(SM5703_IRQ_FLEDOPEN, 3, BIT(1)),
+	REGMAP_IRQ_REG(SM5703_IRQ_BOOSTPOK_NG, 3, BIT(2)),
+	REGMAP_IRQ_REG(SM5703_IRQ_BOOSTPOK, 3, BIT(3)),
+	REGMAP_IRQ_REG(SM5703_IRQ_ABSTMRON, 3, BIT(4)),
+};
+
+static const struct regmap_irq_chip sm5703_irq_chip = {
+	.name		= "sm5703",
+	.status_base	= SM5703_REG_INT1,
+	.mask_base	= SM5703_REG_INTMSK1,
+	.num_regs	= 4,
+	.irqs		= sm5703_irqs,
+	.num_irqs	= ARRAY_SIZE(sm5703_irqs),
+};
+
+static const struct regmap_config sm5703_regmap_config = {
+	.reg_bits	= 8,
+	.val_bits	= 8,
+	.max_register	= SM5703_REG_MAX,
+};
+
+static int sm5703_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct regmap_irq_chip_data *irq_data;
+	struct gpio_desc *reset_gpio;
+	struct regmap *regmap;
+	unsigned int dev_id;
+	int ret;
+
+	regmap = devm_regmap_init_i2c(i2c, &sm5703_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "Failed to allocate the register map\n");
+
+	/*
+	 * The reset line is wired to the chip's MRSTB pin.  Deasserting it
+	 * is all that is needed here: the chip keeps its configuration
+	 * across a warm boot, and the charger driver reprograms what it
+	 * cares about anyway.
+	 */
+	reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(reset_gpio),
+				     "Cannot get reset GPIO\n");
+
+	if (reset_gpio)
+		msleep(20);
+
+	ret = regmap_read(regmap, SM5703_REG_DEVICE_ID, &dev_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "Device not found\n");
+
+	dev_dbg(dev, "SM5703 revision 0x%02x\n", dev_id);
+
+	ret = devm_regmap_add_irq_chip(dev, regmap, i2c->irq,
+				       IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+				       0, &sm5703_irq_chip, &irq_data);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to add IRQ chip\n");
+
+	ret = devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, sm5703_cells,
+				   ARRAY_SIZE(sm5703_cells), NULL, 0,
+				   regmap_irq_get_domain(irq_data));
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to add child devices\n");
+
+	return 0;
+}
+
+static const struct of_device_id sm5703_of_match[] = {
+	{ .compatible = "siliconmitus,sm5703" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sm5703_of_match);
+
+static struct i2c_driver sm5703_driver = {
+	.driver = {
+		.name		= "sm5703",
+		.of_match_table	= sm5703_of_match,
+	},
+	.probe = sm5703_i2c_probe,
+};
+module_i2c_driver(sm5703_driver);
+
+MODULE_DESCRIPTION("Silicon Mitus SM5703 PMIC core driver");
+MODULE_AUTHOR("Markuss Broks <markuss.broks@gmail.com>");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/mfd/sm5703.h b/include/linux/mfd/sm5703.h
new file mode 100644
index 0000000000..6472dc9c61
--- /dev/null
+++ b/include/linux/mfd/sm5703.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Silicon Mitus SM5703 PMIC register definitions
+ *
+ * Copyright (C) 2022 Markuss Broks <markuss.broks@gmail.com>
+ */
+
+#ifndef __MFD_SM5703_H__
+#define __MFD_SM5703_H__
+
+#include <linux/bits.h>
+
+/* Interrupt status, cleared on read */
+#define SM5703_REG_INT1			0x00
+#define SM5703_REG_INT2			0x01
+#define SM5703_REG_INT3			0x02
+#define SM5703_REG_INT4			0x03
+
+/* Interrupt masks, a set bit masks the interrupt off */
+#define SM5703_REG_INTMSK1		0x04
+#define SM5703_REG_INTMSK2		0x05
+#define SM5703_REG_INTMSK3		0x06
+#define SM5703_REG_INTMSK4		0x07
+
+#define SM5703_REG_STATUS1		0x08
+#define SM5703_REG_STATUS2		0x09
+#define SM5703_REG_STATUS3		0x0a
+#define SM5703_REG_STATUS4		0x0b
+
+#define SM5703_REG_CNTL			0x0c
+#define SM5703_REG_VBUSCNTL		0x0d
+#define SM5703_REG_CHGCNTL1		0x0e
+#define SM5703_REG_CHGCNTL2		0x0f
+#define SM5703_REG_CHGCNTL3		0x10
+#define SM5703_REG_CHGCNTL4		0x11
+#define SM5703_REG_CHGCNTL5		0x12
+#define SM5703_REG_CHGCNTL6		0x13
+
+#define SM5703_REG_FLEDCNTL1		0x14
+#define SM5703_REG_FLEDCNTL6		0x19
+
+#define SM5703_REG_LDO1			0x1a
+#define SM5703_REG_LDO2			0x1b
+#define SM5703_REG_LDO3			0x1c
+#define SM5703_REG_BUCK			0x1d
+#define SM5703_REG_DEVICE_ID		0x1e
+
+#define SM5703_REG_OTGCURRENTCNTL	0x60
+#define SM5703_REG_Q3LIMITCNTL		0x66
+#define SM5703_REG_STATUS5		0x6b
+
+#define SM5703_REG_MAX			0x6b
+
+/* SM5703_REG_CNTL */
+#define SM5703_CNTL_OPERATION_MODE_MASK		GENMASK(2, 0)
+#define SM5703_CNTL_OPERATION_MODE_SUSPEND	0x0
+#define SM5703_CNTL_OPERATION_MODE_CHARGING_OFF	0x4
+#define SM5703_CNTL_OPERATION_MODE_CHARGING_ON	0x5
+#define SM5703_CNTL_OPERATION_MODE_FLASH_BOOST	0x6
+#define SM5703_CNTL_OPERATION_MODE_USB_OTG	0x7
+#define SM5703_CNTL_AUTOSET			BIT(4)
+
+/* SM5703_REG_VBUSCNTL */
+#define SM5703_VBUSCNTL_VBUSLIMIT		GENMASK(5, 0)
+
+/* SM5703_REG_CHGCNTL2 */
+#define SM5703_CHGCNTL2_FASTCHG			GENMASK(5, 0)
+
+/* SM5703_REG_CHGCNTL3 */
+#define SM5703_CHGCNTL3_BATREG			GENMASK(4, 0)
+
+/* SM5703_REG_CHGCNTL4 */
+#define SM5703_CHGCNTL4_TOPOFF			GENMASK(6, 3)
+#define SM5703_CHGCNTL4_AUTOSTOP		BIT(7)
+
+/* SM5703_REG_CHGCNTL5 */
+#define SM5703_CHGCNTL5_AICLTH			GENMASK(2, 0)
+#define SM5703_CHGCNTL5_TOPOFF_TIMER		GENMASK(6, 5)
+#define SM5703_CHGCNTL5_AICLEN			BIT(7)
+
+/* SM5703_REG_CHGCNTL6 */
+#define SM5703_CHGCNTL6_FREQSEL			GENMASK(3, 2)
+#define SM5703_CHGCNTL6_FREQSEL_1P5MHZ		0x2
+
+/* SM5703_REG_STATUS1 */
+#define SM5703_STATUS1_AICL			BIT(0)
+#define SM5703_STATUS1_BATOVP			BIT(1)
+#define SM5703_STATUS1_OTGFAIL			BIT(6)
+
+/* SM5703_REG_STATUS2 */
+#define SM5703_STATUS2_THEMREG			BIT(0)
+#define SM5703_STATUS2_THEMSHDN			BIT(1)
+#define SM5703_STATUS2_NOBAT			BIT(4)
+
+/* SM5703_REG_STATUS3 */
+#define SM5703_STATUS3_CHGON			BIT(0)
+#define SM5703_STATUS3_Q4FULLON			BIT(1)
+#define SM5703_STATUS3_TOPOFF			BIT(2)
+#define SM5703_STATUS3_DONE			BIT(3)
+
+/* SM5703_REG_STATUS5 */
+#define SM5703_STATUS5_VBUSOK			BIT(5)
+#define SM5703_STATUS5_VBUSUVLO			BIT(6)
+#define SM5703_STATUS5_VBUSOVP			BIT(7)
+
+enum sm5703_irq {
+	SM5703_IRQ_AICL = 0,
+	SM5703_IRQ_BATOVP,
+	SM5703_IRQ_LOWBATT,
+	SM5703_IRQ_VBUSLIMIT,
+	SM5703_IRQ_DISLIMIT,
+	SM5703_IRQ_VSYSOLP,
+	SM5703_IRQ_OTGFAIL,
+
+	SM5703_IRQ_THEMREG,
+	SM5703_IRQ_THEMSHDN,
+	SM5703_IRQ_VSYSNG,
+	SM5703_IRQ_VSYSOK,
+	SM5703_IRQ_NOBAT,
+	SM5703_IRQ_PRETMROFF,
+	SM5703_IRQ_FASTTMROFF,
+
+	SM5703_IRQ_CHGON,
+	SM5703_IRQ_Q4FULLON,
+	SM5703_IRQ_TOPOFF,
+	SM5703_IRQ_DONE,
+	SM5703_IRQ_CHGRSTF,
+
+	SM5703_IRQ_FLEDSHORT,
+	SM5703_IRQ_FLEDOPEN,
+	SM5703_IRQ_BOOSTPOK_NG,
+	SM5703_IRQ_BOOSTPOK,
+	SM5703_IRQ_ABSTMRON,
+};
+
+#endif /* __MFD_SM5703_H__ */
-- 
