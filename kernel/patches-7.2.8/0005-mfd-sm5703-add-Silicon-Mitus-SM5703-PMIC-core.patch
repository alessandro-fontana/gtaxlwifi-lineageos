From e60a6bd8bcb8d70fe7dfb91e5314f3d3e9767b8f Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 11 Aug 2026 20:39:23 +0000
Subject: [PATCH] mfd: sm5703: add Silicon Mitus SM5703 PMIC core

The SM5703 combines a charger, LDO and buck regulators, a flash LED
driver, a MUIC and a fuel gauge.  Add a core driver for the I2C address
the charger, the regulators and the LED driver share, exposing the
shared register map and the four interrupt registers to child devices.

The fuel gauge is not a child of this driver: it has an address of its
own, usually on a different bus, and is handled by its own driver.

Based on a driver posted by Markuss Broks in 2022, extended with the
interrupt chip the charger needs.
---
 .../bindings/mfd/siliconmitus,sm5703.yaml     |  70 ++++++++
 drivers/mfd/Kconfig                           |  16 ++
 drivers/mfd/Makefile                          |   1 +
 drivers/mfd/sm5703.c                          | 152 ++++++++++++++++++
 include/linux/mfd/sm5703.h                    | 136 ++++++++++++++++
 5 files changed, 375 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
 create mode 100644 drivers/mfd/sm5703.c
 create mode 100644 include/linux/mfd/sm5703.h

diff --git a/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml b/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
new file mode 100644
index 0000000000..0920276f6d
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/siliconmitus,sm5703.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/siliconmitus,sm5703.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5703 PMIC
+
+maintainers:
+  - Markuss Broks <markuss.broks@gmail.com>
+
+description: |
+  The SM5703 combines a charger, LDO and buck regulators, a flash LED
+  driver, a MUIC USB switch and a fuel gauge.  The charger, the
+  regulators and the LED driver share the I2C address described by this
+  binding.  The fuel gauge has an address of its own, usually on a
+  different bus, and is described separately by
+  siliconmitus,sm5703-fuelgauge.yaml.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5703
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO connected to the MRSTB pin.
+
+  charger:
+    $ref: /schemas/power/supply/siliconmitus,sm5703-charger.yaml#
+    type: object
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@49 {
+            compatible = "siliconmitus,sm5703";
+            reg = <0x49>;
+
+            interrupt-parent = <&gpa2>;
+            interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+
+            reset-gpios = <&gpc7 4 GPIO_ACTIVE_LOW>;
+
+            charger {
+                compatible = "siliconmitus,sm5703-charger";
+                monitored-battery = <&battery>;
+                enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
+                input-current-limit-microamp = <1650000>;
+            };
+        };
+    };
diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 763ce6a347..c3331e3c62 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1497,6 +1497,22 @@ config MFD_SL28CPLD
 	  It can be found on the following boards:
 		* SMARC-sAL28
 
+config MFD_SM5703
+	tristate "Silicon Mitus SM5703 PMIC"
+	depends on I2C
+	select MFD_CORE
+	select REGMAP_I2C
+	select REGMAP_IRQ
+	help
+	  Say Y here to enable support for the Silicon Mitus SM5703 PMIC,
+	  found in several Samsung mobile phones and tablets.  It combines
+	  a charger, LDO and buck regulators, a flash LED driver, a MUIC
+	  and a fuel gauge.
+
+	  This driver provides common support for accessing the device;
+	  additional drivers must be enabled to use the functions of the
+	  device.
+
 config MFD_SM501
 	tristate "Silicon Motion SM501"
 	depends on HAS_DMA
diff --git a/drivers/mfd/Makefile b/drivers/mfd/Makefile
