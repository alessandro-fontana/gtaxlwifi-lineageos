From cbbec97f733b379d854e47dc8a278a843c2e0c3e Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 15:58:02 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: rear camera module EEPROM

The rear camera module carries an 8 KiB EEPROM at 0x58 on the lens
driver's bus, with the module calibration (lens positions for infinity
and macro among others). The bus only answers with the sensor's I/O
rail on, which carries the pull-ups: give it to at24 as vcc, so that a
read powers it. Enable at24 as a module.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts      | 15 ++++++++++++++-
 arch/arm64/configs/gtaxlwifi_defconfig            |  2 +-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 9dbe6ad7da..9da6427ca1 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -2620,7 +2620,8 @@ csis1_in: endpoint {
 /*
  * Autofocus posteriore: DW9807 su hsi2c_4 del downstream, che qui e'
  * hsi2c2 (pin gpf1-0/1), indirizzo 0x0c. Sullo stesso bus c'e' la EEPROM
- * di taratura del modulo a 0x58, non dichiarata.
+ * di taratura del modulo a 0x58 (8 KiB, mappa rear-4h5yc_v001 del
+ * downstream: posizioni AF di infinito e macro a 0x100 e 0x108).
  */
 &hsi2c2 {
 	clock-frequency = <400000>;
@@ -2640,6 +2641,18 @@ rear_vcm: lens@c {
 		dongwoon,vcm-prescale = <1>;
 		dongwoon,sac-timing = <0x36>;
 	};
+
+	/*
+	 * Il bus risponde solo con la I/O del sensore accesa (le pull-up):
+	 * at24 la accende per ogni lettura.
+	 */
+	eeprom@58 {
+		compatible = "atmel,24c64";
+		reg = <0x58>;
+		pagesize = <32>;
+		read-only;
+		vcc-supply = <&vdd_ldo34>;
+	};
 };
 
 /*
diff --git a/arch/arm64/configs/gtaxlwifi_defconfig b/arch/arm64/configs/gtaxlwifi_defconfig
index 18efeb70d1..0c3e5c670a 100644
--- a/arch/arm64/configs/gtaxlwifi_defconfig
+++ b/arch/arm64/configs/gtaxlwifi_defconfig
@@ -1757,7 +1757,7 @@ CONFIG_XEN_BLKDEV_FRONTEND=y
 #
 # EEPROM support
 #
-# CONFIG_EEPROM_AT24 is not set
+CONFIG_EEPROM_AT24=m
 # CONFIG_EEPROM_MAX6875 is not set
 CONFIG_EEPROM_93CX6=y
 # CONFIG_EEPROM_IDT_89HPESX is not set
-- 
2.47.3

