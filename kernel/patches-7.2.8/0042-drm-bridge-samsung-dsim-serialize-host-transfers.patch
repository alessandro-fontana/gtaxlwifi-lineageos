From 28a481c070e8fcd587f22258c7dcd6b74899adeb Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 17 Aug 2026 12:00:00 +0000
Subject: [PATCH] drm/bridge: samsung-dsim: serialize host transfers

The transfer machinery assumes one submitter at a time:
transfer_start() peeks the list head under transfer_lock but then
drops the lock and operates on the transfer, so two concurrent
submitters can pick the same entry, send it to the FIFO twice,
complete it twice and corrupt the list. After that the IRQ handler
grinds on the broken list forever in hardirq context: on arm64
without pseudo-NMI the backtrace IPI is an ordinary interrupt, so
the CPU stops answering it and the whole SoC degrades as every
cross-CPU call towards it times out.

The invariant held as long as every command came from the panel
prepare/enable/disable paths, which the atomic commit serializes.
The hx8279 DSI-controlled backlight broke it: brightness writes
arrive from sysfs at any time. The captured netconsole interleave
shows a teardown command (DCS short write, no exit trace) and a
backlight write in flight at the same time, immediately followed by
the wedge, reproducible by interrupting a DPMS wake or by a
brightness/DPMS stress loop (wedged within ~23 cycles).

Serialize the submitters with a mutex in host_transfer(), covering
the lazy init as well. The IRQ path never submits, it only advances
the current list, so with submitters serialized the list holds at
most one transfer and the design invariant is restored for every
future caller.
---
 drivers/gpu/drm/bridge/samsung-dsim.c | 18 ++++++++++++++++++
 include/drm/bridge/samsung-dsim.h     |  2 ++
 2 files changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 8304fe5ae4..06eebc8f3b 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -2128,6 +2128,23 @@ static ssize_t samsung_dsim_host_transfer(struct mipi_dsi_host *host,
 	struct samsung_dsim_transfer xfer;
 	int ret;
 
+	/*
+	 * The transfer machinery below assumes one submitter at a time:
+	 * transfer_start() peeks the list head under transfer_lock but
+	 * then drops the lock and operates on the transfer, so two
+	 * concurrent submitters can pick the same entry, send it to the
+	 * FIFO twice, complete it twice and corrupt the list - after
+	 * which the IRQ handler grinds on the broken list forever in
+	 * hardirq context and the CPU stops answering even backtrace
+	 * IPIs. That invariant held as long as every command came from
+	 * the panel prepare/enable paths, which the atomic commit
+	 * serializes; the sysfs backlight writer broke it, and the
+	 * captured interleave shows a teardown command and a backlight
+	 * write in flight at the same time right before the wedge.
+	 * Restore the invariant here, for every submitter.
+	 */
+	guard(mutex)(&dsi->xfer_mutex);
+
 	if (!(dsi->state & DSIM_STATE_ENABLED))
 		return -EINVAL;
 
@@ -2250,6 +2267,7 @@ int samsung_dsim_probe(struct platform_device *pdev)
 	init_completion(&dsi->completed);
 	spin_lock_init(&dsi->transfer_lock);
 	INIT_LIST_HEAD(&dsi->transfer_list);
+	mutex_init(&dsi->xfer_mutex);
 
 	dsi->dsi_host.ops = &samsung_dsim_ops;
 	dsi->dsi_host.dev = dev;
diff --git a/include/drm/bridge/samsung-dsim.h b/include/drm/bridge/samsung-dsim.h
index 583734104d..60ddeb00a6 100644
--- a/include/drm/bridge/samsung-dsim.h
+++ b/include/drm/bridge/samsung-dsim.h
@@ -8,6 +8,7 @@
 #define __SAMSUNG_DSIM__
 
 #include <linux/gpio/consumer.h>
+#include <linux/mutex.h>
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_atomic_helper.h>
@@ -130,6 +131,7 @@ struct samsung_dsim {
 
 	spinlock_t transfer_lock; /* protects transfer_list */
 	struct list_head transfer_list;
+	struct mutex xfer_mutex; /* serializes host transfers */
 
 	const struct samsung_dsim_driver_data *driver_data;
 	const struct samsung_dsim_plat_data *plat_data;
-- 
