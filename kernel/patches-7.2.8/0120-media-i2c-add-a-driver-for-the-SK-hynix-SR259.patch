From 8823e1528fb85a89ef8773273028a4e3bb5652af Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 13:32:36 +0200
Subject: [PATCH] media: i2c: add a driver for the SK hynix SR259

The front camera of the Galaxy Tab A 10.1 (2016): 2 MP raw Bayer,
one CSI-2 lane, 8-bit paged registers. One mode, 1632x1228 at 30 fps
from 26 MHz, with the register sequence of the vendor driver
(fimc-is-cis-sr259-setA.h), exposure, analogue gain (1x-8x) and
vertical blanking.

---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/sr259.c  | 1244 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1256 insertions(+)
 create mode 100644 drivers/media/i2c/sr259.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5d173e0ecf..c7acd4f634 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -793,6 +793,17 @@ config VIDEO_S5K6A3
 	  This is a V4L2 sensor driver for Samsung S5K6A3 raw
 	  camera sensor.
 
+config VIDEO_SR259
+	tristate "SK hynix SR259 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the SK hynix SR259
+	  2 MP raw Bayer camera, the front camera of the Samsung Galaxy
+	  Tab A 10.1 (2016).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sr259.
+
 config VIDEO_S5KJN1
 	tristate "Samsung S5KJN1 sensor support"
 	select V4L2_CCI_I2C
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index e45359efe0..987792c4d8 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -129,6 +129,7 @@ obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
+obj-$(CONFIG_VIDEO_SR259) += sr259.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
 obj-$(CONFIG_VIDEO_SAA6588) += saa6588.o
diff --git a/drivers/media/i2c/sr259.c b/drivers/media/i2c/sr259.c
new file mode 100644
index 0000000000..e4271026e6
--- /dev/null
+++ b/drivers/media/i2c/sr259.c
@@ -0,0 +1,1244 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SK hynix SR259 image sensor driver
+ *
+ * 2 MP raw Bayer sensor, 1616x1212 active plus 16 border pixels on each
+ * axis, one MIPI CSI-2 lane, 10-bit output, 8-bit register addresses
+ * organised in pages (register 0x03 selects the page).
+ *
+ * The register sequence comes from the vendor driver of the Galaxy Tab A
+ * 10.1 (2016), fimc-is-cis-sr259-setA.h: it is the only mode the vendor
+ * uses, 1632x1228 at 30 fps from a 26 MHz clock.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define SR259_MCLK			26000000
+#define SR259_LINK_FREQ			351000000ULL
+/* 26 MHz / 4 * 54 / 5: one lane, 10 bits, DDR */
+#define SR259_PIXEL_RATE		70200000
+#define SR259_DATA_LANES		1
+
+#define SR259_REG_PAGE			CCI_REG8(0x03)
+#define SR259_PAGE_0			0x00
+#define SR259_PAGE_20			0x20
+
+/* page 0 */
+#define SR259_REG_MODE			CCI_REG8(0x01)
+#define SR259_MODE_STREAMING		0x00
+#define SR259_MODE_SLEEP		0x20
+#define SR259_REG_ID			CCI_REG8(0x04)
+#define SR259_REG_REV			CCI_REG8(0x05)
+#define SR259_REG_HOLD			CCI_REG8(0x1f)
+#define SR259_REG_FLL_H			CCI_REG8(0x4e)
+#define SR259_REG_FLL_L			CCI_REG8(0x4f)
+
+/* page 0x20 */
+#define SR259_REG_EXPOSURE_H		CCI_REG8(0x22)
+#define SR259_REG_EXPOSURE_L		CCI_REG8(0x23)
+#define SR259_REG_AGAIN_MSB		CCI_REG8(0x60)
+#define SR259_REG_AGAIN_LSB		CCI_REG8(0x61)
+
+#define SR259_WIDTH			1632
+#define SR259_HEIGHT			1228
+#define SR259_LLP			1800
+#define SR259_FLL_DEF			1300
+#define SR259_FLL_MAX			0xffff
+#define SR259_EXPOSURE_MIN		1
+#define SR259_EXPOSURE_MARGIN		4
+
+/*
+ * Analogue gain in 1/16 steps. The sensor takes a 9-bit code c with
+ * gain = 256 / (c / 2 + 17): code 478 is 1x, and the vendor stops at code
+ * 30, which is 8x.
+ */
+#define SR259_AGAIN_MIN			16
+#define SR259_AGAIN_MAX			128
+#define SR259_AGAIN_DEF			16
+
+#define SR259_MBUS_CODE			MEDIA_BUS_FMT_SBGGR10_1X10
+
