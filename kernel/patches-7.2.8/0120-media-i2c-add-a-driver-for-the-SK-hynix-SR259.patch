+static const s64 sr259_link_freqs[] = { SR259_LINK_FREQ };
+
+static const char * const sr259_supply_names[] = {
+	"vddio",	/* 1.8 V interface */
+	"avdd",		/* 2.8 V analog */
+};
+
+struct sr259 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(sr259_supply_names)];
+	struct gpio_desc *reset;
+	struct gpio_desc *enable;
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+};
+
+static inline struct sr259 *to_sr259(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sr259, sd);
+}
+
+static int sr259_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sr259 *sensor = to_sr259(sd);
+	int ret;
+
+	/* The vendor order: supplies, clock, standby released, reset released. */
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret)
+		return ret;
+	usleep_range(10000, 11000);
+
+	ret = clk_prepare_enable(sensor->mclk);
+	if (ret)
+		goto err_supplies;
+	usleep_range(10000, 11000);
+
+	gpiod_set_value_cansleep(sensor->enable, 1);
+	msleep(30);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(1000, 1100);
+
+	return 0;
+
+err_supplies:
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return ret;
+}
+
+static int sr259_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sr259 *sensor = to_sr259(sd);
+
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(20, 30);
+	clk_disable_unprepare(sensor->mclk);
+	gpiod_set_value_cansleep(sensor->enable, 0);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+
+	return 0;
+}
+
+static int sr259_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sr259 *sensor = container_of(ctrl->handler, struct sr259, ctrls);
+	int ret = 0;
+	u32 code;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = SR259_HEIGHT + ctrl->val - SR259_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum, max,
+					       sensor->exposure->step,
+					       min_t(s64, sensor->exposure->default_value, max));
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_0, &ret);
+	cci_write(sensor->regmap, SR259_REG_HOLD, 1, &ret);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_20, &ret);
+		cci_write(sensor->regmap, SR259_REG_EXPOSURE_H, ctrl->val >> 8, &ret);
+		cci_write(sensor->regmap, SR259_REG_EXPOSURE_L, ctrl->val & 0xff, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		code = 8192 / ctrl->val - 34;
+		cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_20, &ret);
+		cci_write(sensor->regmap, SR259_REG_AGAIN_MSB, code >> 1, &ret);
+		cci_write(sensor->regmap, SR259_REG_AGAIN_LSB, code & 1, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, SR259_REG_FLL_H,
+			  (SR259_HEIGHT + ctrl->val) >> 8, &ret);
+		cci_write(sensor->regmap, SR259_REG_FLL_L,
+			  (SR259_HEIGHT + ctrl->val) & 0xff, &ret);
+		break;
+	default:
+		break;
+	}
+
+	cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_0, &ret);
+	cci_write(sensor->regmap, SR259_REG_HOLD, 0, &ret);
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sr259_ctrl_ops = {
+	.s_ctrl = sr259_set_ctrl,
+};
+
+static int sr259_init_controls(struct sr259 *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &sr259_ctrl_ops, V4L2_CID_LINK_FREQ,
+				      0, 0, sr259_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &sr259_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  SR259_PIXEL_RATE, SR259_PIXEL_RATE, 1,
+			  SR259_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, &sr259_ctrl_ops, V4L2_CID_HBLANK,
+				 SR259_LLP - SR259_WIDTH,
+				 SR259_LLP - SR259_WIDTH, 1,
+				 SR259_LLP - SR259_WIDTH);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &sr259_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   SR259_FLL_DEF - SR259_HEIGHT,
+					   SR259_FLL_MAX - SR259_HEIGHT, 1,
+					   SR259_FLL_DEF - SR259_HEIGHT);
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &sr259_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     SR259_EXPOSURE_MIN,
+					     SR259_FLL_DEF - SR259_EXPOSURE_MARGIN,
+					     1, 333);
+
+	v4l2_ctrl_new_std(hdl, &sr259_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  SR259_AGAIN_MIN, SR259_AGAIN_MAX, 1,
+			  SR259_AGAIN_DEF);
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+	v4l2_ctrl_new_fwnode_properties(hdl, &sr259_ctrl_ops, &props);
+
+	if (hdl->error)
+		return hdl->error;
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static void sr259_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = SR259_WIDTH;
+	fmt->height = SR259_HEIGHT;
+	fmt->code = SR259_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int sr259_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state, u32 pad,
+				u64 streams_mask)
+{
+	struct sr259 *sensor = to_sr259(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+
+	ret = regmap_multi_reg_write(sensor->regmap, sr259_init,
+				     ARRAY_SIZE(sr259_init));
+	if (ret)
+		goto err;
+
+	ret = __v4l2_ctrl_handler_setup(sd->ctrl_handler);
+	if (ret)
+		goto err;
+
+	cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_0, &ret);
+	cci_write(sensor->regmap, SR259_REG_MODE, SR259_MODE_STREAMING, &ret);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static int sr259_disable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sr259 *sensor = to_sr259(sd);
+	int ret = 0;
+
+	cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_0, &ret);
+	cci_write(sensor->regmap, SR259_REG_MODE, SR259_MODE_SLEEP, &ret);
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static int sr259_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = SR259_MBUS_CODE;
+	return 0;
+}
+
+static int sr259_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != SR259_MBUS_CODE)
+		return -EINVAL;
+	fse->min_width = fse->max_width = SR259_WIDTH;
+	fse->min_height = fse->max_height = SR259_HEIGHT;
+	return 0;
+}
+
+static int sr259_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *state,
+			 struct v4l2_subdev_format *fmt)
+{
+	/* One mode only: whatever is asked, this is what is set. */
+	sr259_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	return 0;
+}
+
+static int sr259_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SR259_WIDTH;
+		sel->r.height = SR259_HEIGHT;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int sr259_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state)
+{
+	sr259_fill_format(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops sr259_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sr259_pad_ops = {
+	.enum_mbus_code = sr259_enum_mbus_code,
+	.enum_frame_size = sr259_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sr259_set_fmt,
+	.get_selection = sr259_get_selection,
+	.enable_streams = sr259_enable_streams,
+	.disable_streams = sr259_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sr259_subdev_ops = {
+	.video = &sr259_video_ops,
+	.pad = &sr259_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sr259_internal_ops = {
+	.init_state = sr259_init_state,
+};
+
+static int sr259_identify(struct sr259 *sensor)
+{
+	u64 id = 0, rev = 0;
+	int ret = 0;
+
+	cci_write(sensor->regmap, SR259_REG_PAGE, SR259_PAGE_0, &ret);
+	cci_read(sensor->regmap, SR259_REG_ID, &id, &ret);
+	cci_read(sensor->regmap, SR259_REG_REV, &rev, &ret);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "sensor does not answer on the bus\n");
+
+	dev_info(sensor->dev, "SR259 id 0x%02llx rev 0x%02llx\n", id, rev);
+	return 0;
+}
+
+static int sr259_check_endpoint(struct sr259 *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(sensor->dev, -EINVAL, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != SR259_DATA_LANES) {
+		ret = dev_err_probe(sensor->dev, -EINVAL,
+				    "one data lane is supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       sr259_link_freqs,
+				       ARRAY_SIZE(sr259_link_freqs), &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int sr259_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sr259 *sensor;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = dev;
+
+	ret = sr259_check_endpoint(sensor);
+	if (ret)
+		return ret;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	sensor->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->mclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->mclk),
+				     "failed to get the clock\n");
+	if (clk_get_rate(sensor->mclk) != SR259_MCLK)
+		return dev_err_probe(dev, -EINVAL, "clock is %lu Hz, not %u\n",
+				     clk_get_rate(sensor->mclk), SR259_MCLK);
+
+	for (i = 0; i < ARRAY_SIZE(sr259_supply_names); i++)
+		sensor->supplies[i].supply = sr259_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset),
+				     "failed to get reset gpio\n");
+	sensor->enable = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(sensor->enable))
+		return dev_err_probe(dev, PTR_ERR(sensor->enable),
+				     "failed to get enable gpio\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &sr259_subdev_ops);
+	sensor->sd.internal_ops = &sr259_internal_ops;
+
+	ret = sr259_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = sr259_identify(sensor);
+	if (ret)
+		goto err_power;
+
+	ret = sr259_init_controls(sensor);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+err_power:
+	sr259_power_off(dev);
+	return ret;
+}
+
+static void sr259_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sr259 *sensor = to_sr259(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev)) {
+		sr259_power_off(sensor->dev);
+		pm_runtime_set_suspended(sensor->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(sr259_pm_ops, sr259_power_off,
+				 sr259_power_on, NULL);
+
+static const struct of_device_id sr259_of_match[] = {
+	{ .compatible = "hynix,sr259" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sr259_of_match);
+
+static struct i2c_driver sr259_driver = {
+	.driver = {
+		.name = "sr259",
+		.pm = pm_ptr(&sr259_pm_ops),
+		.of_match_table = sr259_of_match,
+	},
+	.probe = sr259_probe,
+	.remove = sr259_remove,
+};
+module_i2c_driver(sr259_driver);
+
+MODULE_DESCRIPTION("SK hynix SR259 image sensor driver");
+MODULE_LICENSE("GPL");
