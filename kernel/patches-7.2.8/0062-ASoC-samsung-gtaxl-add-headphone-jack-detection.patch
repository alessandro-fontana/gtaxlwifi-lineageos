From 5b85cc3a61c6e027ecb4e412934933278fe4ae7d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:54 +0000
Subject: [PATCH] ASoC: samsung: gtaxl: add headphone jack detection

The board routes headphone detection to gpa0-5, which reads high with
nothing plugged in and is pulled low on insertion.  Measured on the
device by sampling GPA0DAT across several insert/remove cycles.

This is the external detection path, independent of the codec's own
interrupt line: no RT5659 IRQ is needed, so the reasons that led to
removing it from the DT still hold and it stays removed.

Reporting SND_JACK_HEADPHONE at both the HP and the SPK pin, the
latter inverted, mutes the speaker on insertion without any userspace
configuration.  Distinguishing three- from four-pole headsets needs
the ADC zones the vendor sec_jack driver reads, and is left out: it
only matters for the headset microphone and its buttons.

Downstream reference: the earjack node of exynos7870-gtaxl_common.dtsi
(compatible "sec_jack", detect-gpio <&gpa0 5 0>, det-dbtime <50>).

A missing gpio is only a warning: jack detection is an accessory, the
sound card is not, and the card must come up either way.  The DT
change adding headset-det-gpios is a separate patch.
---
 sound/soc/samsung/gtaxl_rt5659.c | 62 ++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/sound/soc/samsung/gtaxl_rt5659.c b/sound/soc/samsung/gtaxl_rt5659.c
index da2c20f160..aa8640df2f 100644
--- a/sound/soc/samsung/gtaxl_rt5659.c
+++ b/sound/soc/samsung/gtaxl_rt5659.c
@@ -21,6 +21,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <sound/jack.h>
 #include <sound/pcm_params.h>
 #include <sound/soc.h>
 
@@ -130,6 +131,66 @@ static const struct snd_soc_dapm_widget gtaxl_dapm_widgets[] = {
 	SND_SOC_DAPM_MIC("Headset Mic", NULL),
 };
 
+static struct snd_soc_jack gtaxl_headset_jack;
+
+/*
+ * Headphone insertion drives gpa0-5 low; the polarity lives in the DT
+ * flag, so no software inversion here.  Debounce matches the vendor
+ * det-dbtime property.
+ */
+static struct snd_soc_jack_gpio gtaxl_jack_gpio = {
+	.name		= "headset-det",
+	.report		= SND_JACK_HEADPHONE,
+	.debounce_time	= 50,
+};
+
+/*
+ * Routing the same report at the speaker pin with invert set gives
+ * automatic speaker muting on insertion, without any userspace help.
+ */
+static struct snd_soc_jack_pin gtaxl_jack_pins[] = {
+	{
+		.pin	= "HP",
+		.mask	= SND_JACK_HEADPHONE,
+	}, {
+		.pin	= "SPK",
+		.mask	= SND_JACK_HEADPHONE,
+		.invert	= 1,
+	},
+};
+
+static int gtaxl_late_probe(struct snd_soc_card *card)
+{
+	int ret;
+
+	gtaxl_jack_gpio.gpiod_dev = card->dev;
+
+	ret = snd_soc_card_jack_new_pins(card, "Headphone Jack",
+					 SND_JACK_HEADPHONE,
+					 &gtaxl_headset_jack,
+					 gtaxl_jack_pins,
+					 ARRAY_SIZE(gtaxl_jack_pins));
+	if (ret)
+		return dev_err_probe(card->dev, ret,
+				     "failed to create the headphone jack\n");
+
+	ret = snd_soc_jack_add_gpios(&gtaxl_headset_jack, 1,
+				     &gtaxl_jack_gpio);
+	if (ret) {
+		/*
+		 * Detection is an accessory, the card is not.  Losing the
+		 * gpio must not cost the sound card: outputs then stay
+		 * under the pin switches.
+		 */
+		dev_warn(card->dev,
+			 "no jack detect gpio (%d), outputs stay manual\n",
+			 ret);
+		return 0;
+	}
+
+	return 0;
+}
+
 SND_SOC_DAILINK_DEFS(aif1,
 	DAILINK_COMP_ARRAY(COMP_EMPTY()),
 	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "AP0"),
@@ -156,6 +217,7 @@ static struct snd_soc_card gtaxl_card = {
 	.dapm_widgets		= gtaxl_dapm_widgets,
 	.num_dapm_widgets	= ARRAY_SIZE(gtaxl_dapm_widgets),
 	.fully_routed		= true,
+	.late_probe		= gtaxl_late_probe,
 };
 
 static int gtaxl_audio_probe(struct platform_device *pdev)
-- 
