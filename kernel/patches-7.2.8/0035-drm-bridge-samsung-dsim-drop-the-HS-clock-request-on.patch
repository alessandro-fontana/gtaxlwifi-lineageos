From ef75ea0c5ec165c806a080fb5fd0be7308886550 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 19:29:54 +0000
Subject: [PATCH] drm/bridge: samsung-dsim: drop the HS clock request on
 teardown

The HS clock request is the only CLKCTRL bit that survives a
teardown. Leaving it set on a dead link would make a later probe
believe the bootloader handed over a running display. Clear it both
in disable_clock and in atomic_post_disable, so every teardown path
leaves the sentinel honest.

(Squash of the two original patches covering the two paths.)
---
 drivers/gpu/drm/bridge/samsung-dsim.c | 30 ++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 9ee0515074..3fe1c3b4b8 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -1022,10 +1022,16 @@ static void samsung_dsim_disable_clock(struct samsung_dsim *dsi)
 	u32 reg;
 
 	reg = samsung_dsim_read(dsi, DSIM_CLKCTRL_REG);
+	/*
+	 * Also drop the HS clock request: it is the only bit that survives
+	 * a teardown, and leaving it set on a dead link would make a later
+	 * probe believe the bootloader handed over a running display.
+	 */
 	reg &= ~(BIT(driver_data->lane_esc_clk_bit)
 		| DSIM_LANE_ESC_CLK_EN_DATA_MASK(driver_data->lane_esc_data_offset)
 		| BIT(driver_data->esc_clken_bit)
-		| BIT(driver_data->byte_clken_bit));
+		| BIT(driver_data->byte_clken_bit)
+		| BIT(driver_data->tx_req_hsclk_bit));
 	samsung_dsim_write(dsi, DSIM_CLKCTRL_REG, reg);
 
 	reg = samsung_dsim_read(dsi, DSIM_PLLCTRL_REG);
@@ -1694,6 +1700,28 @@ static void samsung_dsim_atomic_post_disable(struct drm_bridge *bridge,
 					     struct drm_atomic_commit *state)
 {
 	struct samsung_dsim *dsi = bridge_to_dsi(bridge);
+	const struct samsung_dsim_driver_data *driver_data = dsi->driver_data;
+	u32 reg;
+
+	/*
+	 * Without this the runtime PM count goes negative when the bridge
+	 * is post-disabled twice, and the register access below would then
+	 * happen with the clocks already gone.
+	 */
+	if (!(dsi->state & DSIM_STATE_ENABLED))
+		return;
+
+	/*
+	 * Drop the HS clock request while the clocks are still running: the
+	 * panel has already been unprepared by this point, and the runtime
+	 * suspend that would otherwise clear it is not guaranteed to run.
+	 * The bit is the only piece of state that survives a probe, and
+	 * samsung_dsim_init() reads it to decide whether it inherited a live
+	 * link, so it has to stop being set once we stop driving one.
+	 */
+	reg = samsung_dsim_read(dsi, DSIM_CLKCTRL_REG);
+	reg &= ~BIT(driver_data->tx_req_hsclk_bit);
+	samsung_dsim_write(dsi, DSIM_CLKCTRL_REG, reg);
 
 	dsi->state &= ~DSIM_STATE_ENABLED;
 	pm_runtime_put_sync(dsi->dev);
-- 
