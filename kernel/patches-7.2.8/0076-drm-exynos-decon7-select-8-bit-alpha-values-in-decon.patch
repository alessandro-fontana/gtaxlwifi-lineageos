From 0d464662069b6d6de18eb6dae569cbdfc35f96ae Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 6 Sep 2026 16:00:00 +0200
Subject: [PATCH] drm/exynos: decon7: select 8-bit alpha values in decon_init()

The vendor driver programs BLENDCON with NEW_8BIT_ALPHA_VALUE
unconditionally, right after the reset, both in decon_reg_init() and in
decon_reg_init_probe(). The blending support ported from
exynos5433_drm_decon.c only sets it when a plane alpha other than opaque
is requested, which SurfaceFlinger never does, so on Android the block
stays in the legacy 4-bit alpha mode while every window carries an
8-bit per-pixel alpha.

Set the 8-bit mode at init, as the vendor driver does.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/exynos/exynos7_drm_decon.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/gpu/drm/exynos/exynos7_drm_decon.c b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
index 7e682340f1..0c5f866a61 100644
--- a/drivers/gpu/drm/exynos/exynos7_drm_decon.c
+++ b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
@@ -683,6 +683,17 @@ static void decon_init(struct decon_context *ctx)
 	if (!ctx->i80_if)
 		writel(VIDCON1_VCLK_HOLD, ctx->regs + VIDCON1(0));
 
+	/*
+	 * Use 8-bit alpha values throughout. The vendor driver programs this
+	 * unconditionally right after the reset (decon_reg_init() and
+	 * decon_reg_init_probe()); in the legacy 4-bit mode the per-pixel
+	 * alpha of an ARGB8888 window is not interpreted as 8-bit coverage.
+	 */
+	val = readl(ctx->regs + BLENDCON);
+	val &= ~BLENDCON_NEW_MASK;
+	val |= BLENDCON_NEW_8BIT_ALPHA_VALUE;
+	writel(val, ctx->regs + BLENDCON);
+
 	/*
 	 * Map every window to its own DMA channel. The Exynos7870 DECON has
 	 * three channels (0..2) and the vendor driver programs window N to
