From 534de3cabd8b4f48cf9f25620353645c585ba51f Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 16:55:57 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: rear camera, LDO30 at 1.2 V

S5K4H5YC on hsi2c1 and CSIS0, four lanes, MCLK0 at 26 MHz, analog rail
from the external LDO on gpd4-4. LDO30 is the sensor core supply
(VDD_CAM_CORE_1P2 in the vendor tree): 1.2 V and switched by the sensor
driver instead of 1.8 V always on as S-BOOT leaves it.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 93 ++++++++++++++++---
 1 file changed, 79 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index d9d6132763..a86d4d5a48 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -386,6 +386,19 @@ tsp_avdd: regulator-tsp-avdd {
 	 * compare anche come hrm_vdd_io_en: e' un avanzo di un altro
 	 * modello, il tablet non ha il sensore cardiaco (§57).
 	 */
+	/*
+	 * Fotocamera posteriore, rail analogico a 2,8 V: LDO esterno acceso
+	 * da gpd4-4 ("8MCAM_LDO_EN" nel downstream) (§57).
+	 */
+	cam_avdd: regulator-cam-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD_CAM_A2P8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpd4 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	vtcam_avdd: regulator-vtcam-avdd {
 		compatible = "regulator-fixed";
 		regulator-name = "VDD_VTCAM_A2P8";
@@ -1281,17 +1294,16 @@ vdd_ldo32: ldo32 {
 			};
 
 			/*
-			 * LDO30: rail da 1,8 V acceso da S-BOOT (0x4c = 0xe8),
-			 * destinazione non identificata. Dichiarato con nome
-			 * neutro perche' l'etichetta precedente era falsa e
-			 * ha depistato due sessioni di diagnosi. Non toccarlo
-			 * finche' non si sa cosa alimenta.
+			 * LDO30: core a 1,2 V del sensore posteriore
+			 * ("VDD_CAM_CORE_1P2" nel DTS downstream di questa
+			 * scheda, acceso dal modulo del 4H5YC). S-BOOT lo lascia
+			 * acceso a 1,8 V (0x4c = 0xe8): qui 1,2 V e lo accende
+			 * il driver del sensore (§57.4).
 			 */
 			vdd_ldo30: ldo30 {
-				regulator-name = "vdd_ldo30";
-				regulator-min-microvolt = <1800000>;
-				regulator-max-microvolt = <1800000>;
-				regulator-always-on;
+				regulator-name = "VDD_CAM_CORE_1P2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
 			};
 		};
 	};
@@ -2556,13 +2568,66 @@ sr259_out: endpoint {
 	};
 };
 
-&csis1 {
+&csis {
 	status = "okay";
+};
+
+&csis0_port {
+	csis0_in: endpoint {
+		data-lanes = <1 2 3 4>;
+		remote-endpoint = <&s5k4h5yc_out>;
+	};
+};
 
-	port {
-		csis1_in: endpoint {
-			data-lanes = <1>;
-			remote-endpoint = <&sr259_out>;
+&csis1_port {
+	csis1_in: endpoint {
+		data-lanes = <1>;
+		remote-endpoint = <&sr259_out>;
+	};
+};
+
+/*
+ * ======================================================================
+ * FOTOCAMERA POSTERIORE — Samsung S5K4H5YC su CSIS0 (§57)
+ * ======================================================================
+ * Dal downstream (sensor-module-4h5yc, fimc_is_module_4h5yc): hsi2c_3 a
+ * 0x138a0000, che qui e' hsi2c1, pin gpf0-0/1; indirizzo 0x37; MCLK0 su
+ * gpe0-0 a 26 MHz; reset gpf3-3; analogica da un LDO esterno acceso da
+ * gpd4-4 ("8MCAM_LDO_EN"); core 1,2 V da LDO30; I/O da LDO34; quattro
+ * corsie verso il CSIS0, che divide il PHY con il DSIM0 del pannello.
+ * Link: 26 / 6 * 159 = 689 Mbit/s per corsia, 344,5 MHz.
+ */
+&hsi2c1 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	camera@37 {
+		compatible = "samsung,s5k4h5yc";
+		reg = <0x37>;
+
+		clocks = <&cmu_mif CLK_GOUT_MIF_CMU_ISP_SENSOR0>;
+		assigned-clocks = <&cmu_mif CLK_MOUT_MIF_CMU_ISP_SENSOR0>,
+				  <&cmu_mif CLK_DOUT_MIF_CMU_ISP_SENSOR0>;
+		assigned-clock-parents = <&oscclk>, <0>;
+		assigned-clock-rates = <0>, <26000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fimc_is_mclk0_fn>;
+
+		avdd-supply = <&cam_avdd>;
+		dvdd-supply = <&vdd_ldo30>;
+		vddio-supply = <&vdd_ldo34>;
+		reset-gpios = <&gpf3 3 GPIO_ACTIVE_LOW>;
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			s5k4h5yc_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <344500000>;
+				remote-endpoint = <&csis0_in>;
+			};
 		};
 	};
 };
-- 
2.47.3

