From 24bb744ca25e89e44f16cdbafa472de1309d8ccb Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 20:55:33 +0200
Subject: [PATCH] media: s5p-mfc: support the Exynos7870 MFC

The Exynos7870 has an MFC v10 (version 0xa0b0) behind an IOMMU, driven
by the vendor v10.x firmware. That firmware addresses its buffers as
offsets from its base, so every buffer must lie above it, while the
IOMMU DMA allocator hands out addresses top down: allocate the firmware
low (under 16 MiB, above an IOVA reservation described in the device
tree) and keep the video buffers within 256 MiB. Without it the header
parse fails with error 0x37.

Also program the stream buffer with its real size and set the decoder
options the vendor driver uses on this firmware (special parsing,
conceal control), and print the firmware and hardware versions at
init.

---
 .../media/platform/samsung/s5p-mfc/s5p_mfc.c  | 28 +++++++++++++++++++
 .../platform/samsung/s5p-mfc/s5p_mfc_common.h |  5 ++++
 .../platform/samsung/s5p-mfc/s5p_mfc_ctrl.c   |  4 +++
 .../platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c | 19 +++++++++++++
 4 files changed, 56 insertions(+)

diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
index 32eb402d43..18b5c5f1e7 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
@@ -1230,8 +1230,21 @@ static int s5p_mfc_configure_common_memory(struct s5p_mfc_dev *mfc_dev)
 	if (!mfc_dev->mem_bitmap)
 		return -ENOMEM;
 
+	/*
+	 * The firmware addresses memory as offsets from its base: every
+	 * buffer must lie above it. The IOMMU DMA allocator hands out
+	 * addresses top down, so the firmware, allocated first, would end
+	 * up above everything else. Allocate it under 16 MiB, then keep the
+	 * video buffers within 256 MiB, above it.
+	 */
+	if (mfc_dev->variant->v10x_quirks && exynos_is_iommu_available(dev))
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(24));
+
 	mfc_dev->mem_virt = dma_alloc_coherent(dev, mem_size,
 					       &mfc_dev->mem_base, GFP_KERNEL);
+
+	if (mfc_dev->variant->v10x_quirks && exynos_is_iommu_available(dev))
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(28));
 	if (!mfc_dev->mem_virt) {
 		bitmap_free(mfc_dev->mem_bitmap);
 		dev_err(dev, "failed to preallocate %ld MiB for the firmware and context buffers\n",
@@ -1680,6 +1693,18 @@ static const struct s5p_mfc_variant mfc_drvdata_v10 = {
 	.fw_name[0]     = "s5p-mfc-v10.fw",
 };
 
+/* Exynos7870: MFC v10 (version 0xa0b0) with a single gate clock. */
+static const struct s5p_mfc_variant mfc_drvdata_v10_7870 = {
+	.version        = MFC_VERSION_V10,
+	.version_bit    = MFC_V10_BIT,
+	.port_num       = MFC_NUM_PORTS_V10,
+	.buf_size       = &buf_size_v10,
+	.fw_name[0]     = "s5p-mfc-v10.fw",
+	.clk_names	= {"mfc"},
+	.num_clocks	= 1,
+	.v10x_quirks	= true,
+};
+
 static struct s5p_mfc_buf_size_v6 mfc_buf_size_v12 = {
 	.dev_ctx        = MFC_CTX_BUF_SIZE_V12,
 	.h264_dec_ctx   = MFC_H264_DEC_CTX_BUF_SIZE_V12,
@@ -1727,6 +1752,9 @@ static const struct of_device_id exynos_mfc_match[] = {
 	}, {
 		.compatible = "samsung,mfc-v10",
 		.data = &mfc_drvdata_v10,
+	}, {
+		.compatible = "samsung,exynos7870-mfc",
+		.data = &mfc_drvdata_v10_7870,
 	}, {
 		.compatible = "tesla,fsd-mfc",
 		.data = &mfc_drvdata_v12,
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
index 58dc176808..e89ee06d38 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
@@ -234,6 +234,11 @@ struct s5p_mfc_variant {
 	const char	*clk_names[MFC_MAX_CLOCKS];
 	int		num_clocks;
 	bool		use_clock_gating;
+	/*
+	 * The "v10.x" firmware of the vendor driver (Exynos7870, 0xa0b0):
+	 * real CPB size, special parsing and conceal control at init.
+	 */
+	bool		v10x_quirks;
 };
 
 /**
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_ctrl.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_ctrl.c
index 625d77b2be..947d00c5c1 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_ctrl.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_ctrl.c
@@ -285,6 +285,10 @@ int s5p_mfc_init_hw(struct s5p_mfc_dev *dev)
 
 	mfc_debug(2, "MFC F/W version : %02xyy, %02xmm, %02xdd\n",
 		(ver >> 16) & 0xFF, (ver >> 8) & 0xFF, ver & 0xFF);
+	if (dev->variant->v10x_quirks)
+		dev_info(&dev->plat_dev->dev,
+			 "firmware %06x, MFC version %08x, base %pad\n",
+			 ver, mfc_read(dev, 0xf028), &dev->dma_base[BANK_L_CTX]);
 	s5p_mfc_clock_off(dev);
 	mfc_debug_leave();
 	return 0;
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
index 98f8292b31..c129174d58 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
@@ -594,6 +594,19 @@ static int s5p_mfc_set_dec_stream_buffer_v6(struct s5p_mfc_ctx *ctx,
 	mfc_debug(2, "inst_no: %d, buf_addr: 0x%08x,\n"
 		"buf_size: 0x%08x (%d)\n",
 		ctx->inst_no, buf_addr, strm_size, strm_size);
+	if (dev->variant->v10x_quirks) {
+		/* The real buffer size, with 512 bytes the firmware may read past the data. */
+		unsigned int cpb = ALIGN(ctx->dec_src_buf_size, 512);
+
+		strm_size = min(strm_size, cpb - 512);
+		writel(strm_size, mfc_regs->d_stream_data_size);
+		writel(buf_addr, mfc_regs->d_cpb_buffer_addr);
+		writel(cpb, mfc_regs->d_cpb_buffer_size);
+		writel(start_num_byte, mfc_regs->d_cpb_buffer_offset);
+		mfc_debug_leave();
+		return 0;
+	}
+
 	writel(strm_size, mfc_regs->d_stream_data_size);
 	writel(buf_addr, mfc_regs->d_cpb_buffer_addr);
 	writel(buf_size->cpb, mfc_regs->d_cpb_buffer_size);
@@ -1771,6 +1784,12 @@ static int s5p_mfc_init_decode_v6(struct s5p_mfc_ctx *ctx)
 		writel(ctx->display_delay, mfc_regs->d_display_delay);
 	}
 
+	if (dev->variant->v10x_quirks) {
+		/* Vendor driver: special parsing (PPS too), conceal control. */
+		reg |= BIT(15) | (0x4 << 8);
+		writel(0x8020000, dev->regs_base + 0xf0c8);
+	}
+
 	if (IS_MFCV7_PLUS(dev) || IS_MFCV6_V2(dev)) {
 		writel(reg, mfc_regs->d_dec_options);
 		reg = 0;
-- 
2.47.3

