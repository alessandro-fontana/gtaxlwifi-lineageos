From 41e6306f42fcbdac32f2dbac04a709338b1c09ef Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 17:53:27 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: rear focus motor in SAC3
 mode

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 30672365a8..2679386e33 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -2610,6 +2610,15 @@ rear_vcm: lens@c {
 		compatible = "dongwoon,dw9807-vcm";
 		reg = <0x0c>;
 		vdd-supply = <&vdd_ldo29>;
+		/*
+		 * Dal downstream (sensor_dw9807_init): SAC3, prescaler x1,
+		 * periodo 6,3 + 0x36 * 0,1 = 11,7 ms. Senza, in modo
+		 * diretto, la lente oscilla per sei o sette fotogrammi dopo
+		 * ogni passo (misurato, §57).
+		 */
+		dongwoon,sac-mode = <3>;
+		dongwoon,vcm-prescale = <1>;
+		dongwoon,sac-timing = <0x36>;
 	};
 };
 
-- 
2.47.3

