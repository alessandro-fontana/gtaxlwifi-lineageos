From 52f5cb3f0c24c80b60e7d6045cb42d3b8689cbf0 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 10 Sep 2026 12:59:38 +0000
Subject: [PATCH] drm/panel: himax-hx8279: configure the gtaxl panel with its
 display off

The vendor init sequence turns the display off and the backlight duty to
zero before it writes a single table - page 0 register B3 = 0x88, page 4
register B8 = 0x00 - writes everything with the panel not driving the
glass, and only then turns the display on again with B3 = 0x08, after the
controller has been started. It never sends DCS set_display_on or
set_display_off to this DriverIC, the same way it never sends
enter_sleep_mode, and DCS reads on this link time out, so the standard
command set cannot be assumed to be implemented at all.

Here the whole configuration, the gate driver registers included, is
written to a panel that is already displaying, and the display is
switched with DCS. A comparison of the full byte stream against the
vendor BOE2 table shows this is now the only remaining difference in
what the panel is told and when: pages 1, 2 and 5 are identical register
for register, page 6 differs only by the ENG lock at the end, and page 3
carries the deliberate changes of the two previous patches.

Follow the vendor: display and backlight off at the top of hx8279_on(),
B3 = 0x08 in enable(), B3 = 0x8c in disable() to match the exit sequence
already used in unprepare(). The page lock is taken in enable() and
disable() because a backlight update may otherwise switch pages between
the page select and the write.
---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 37 ++++++++++++++++++++--
 1 file changed, 35 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index 28b6431142..bd2d56ee5b 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -39,6 +39,8 @@
  #define HX8279_P0_SLEEP_IN		0x00
 #define HX8279_P0_DISPLAY_CTRL		0xb3
  #define HX8279_P0_DISPLAY_OFF_BL_OFF		0x8c
+ #define HX8279_P0_DISPLAY_OFF		0x88
+ #define HX8279_P0_DISPLAY_ON		0x08
 #define HX8279_P0_UNKNOWN_B6		0xb6
 #define HX8279_P0_UNKNOWN_BA		0xba
 #define HX8279_P0_VGHS			0xbf
@@ -927,9 +929,26 @@ static int hx8279_on(struct hx8279 *hx)
 {
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	const u8 cmd_display_off[] = { HX8279_P0_DISPLAY_CTRL,
+				       HX8279_P0_DISPLAY_OFF };
+	const u8 cmd_bl_off[] = { HX8279_P4_REG_BRIGHTNESS, 0x00 };
 
 	hx8279_read_ids(hx, &dsi_ctx);
 
+	/*
+	 * Page 0 and 4: the vendor turns the display and the backlight
+	 * off before writing any table, and only turns the display back
+	 * on once the controller is running. Every register below,
+	 * including the whole gate driver configuration, therefore
+	 * reaches a panel that is not driving the glass.
+	 */
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_off,
+				     ARRAY_SIZE(cmd_display_off));
+	hx8279_set_page(hx, &dsi_ctx, 4);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_bl_off,
+				     ARRAY_SIZE(cmd_bl_off));
+
 	/* Page 5 */
 	hx8279_set_mipi_cfg(hx, &dsi_ctx);
 
@@ -1005,7 +1024,14 @@ static int hx8279_disable(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	const u8 cmd_display_off[] = { HX8279_P0_DISPLAY_CTRL,
+				       HX8279_P0_DISPLAY_OFF_BL_OFF };
+
+	mutex_lock(&hx->page_lock);
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_off,
+				     ARRAY_SIZE(cmd_display_off));
+	mutex_unlock(&hx->page_lock);
 
 	dev_info(&dsi->dev, "disable: display off, err %d\n", dsi_ctx.accum_err);
 
@@ -1018,7 +1044,14 @@ static int hx8279_enable(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	const u8 cmd_display_on[] = { HX8279_P0_DISPLAY_CTRL,
+				      HX8279_P0_DISPLAY_ON };
+
+	mutex_lock(&hx->page_lock);
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_on,
+				     ARRAY_SIZE(cmd_display_on));
+	mutex_unlock(&hx->page_lock);
 
 	dev_info(&dsi->dev, "enable: display on, err %d\n", dsi_ctx.accum_err);
 
-- 
