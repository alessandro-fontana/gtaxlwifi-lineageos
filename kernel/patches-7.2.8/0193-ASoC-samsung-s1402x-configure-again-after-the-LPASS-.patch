From 27c6efd81f9cb485141b3cfaed1b31375e5f3893 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 3 Oct 2026 16:13:05 +0200
Subject: [PATCH] ASoC: samsung: s1402x: configure again after the LPASS
 wrapper resumes

The LPASS wrapper resets the mixer (DISPAUD_CFG bit 0) every time it
resumes from runtime suspend, but the mixer was configured only once, at
probe. When the wrapper suspended after the mixer probed and resumed for
the first stream, the mixer was back at its reset values: DOUTMX1 sent
the mixer's own output to the AP port and playback was silent. Whether
this happened depended on the order and timing of module loading at boot.

Take part in runtime PM as a child of the wrapper: active and configured
at probe, then idle; each stream startup resumes the mixer, which resumes
the wrapper first, and the mixer's runtime resume runs the full reset
and static configuration again. The wrapper can still suspend while no
stream is open.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 sound/soc/samsung/s1402x.c | 52 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 50 insertions(+), 2 deletions(-)

diff --git a/sound/soc/samsung/s1402x.c b/sound/soc/samsung/s1402x.c
index 56543ae2e7..e417011b13 100644
--- a/sound/soc/samsung/s1402x.c
+++ b/sound/soc/samsung/s1402x.c
@@ -18,8 +18,11 @@
  * data length, 48k/192k system clock and the data-path flush.
  *
  * The IP is reset by the LPASS wrapper (MFD_EXYNOS_LPASS, DISPAUD_CFG
- * bit 0) before this device is populated; probe order is guaranteed by
- * the device hierarchy.
+ * bit 0) before this device is populated, and again every time the
+ * wrapper resumes from runtime suspend: the configuration is lost then.
+ * The mixer therefore takes part in runtime PM as a child of the wrapper
+ * and configures itself again in its own runtime resume, which a stream
+ * startup triggers after the wrapper's.
  *
  * Copyright (C) 2026 The LineageOS Project
  */
@@ -313,9 +316,23 @@ static void s1402x_shutdown(struct snd_pcm_substream *substream,
 	struct s1402x_priv *priv = snd_soc_component_get_drvdata(dai->component);
 
 	s1402x_reset_data(priv);
+	pm_runtime_put(priv->dev);
+}
+
+/*
+ * Resuming the mixer resumes the LPASS wrapper first, whose resume resets
+ * the mixer; s1402x_runtime_resume() then configures it again.
+ */
+static int s1402x_startup(struct snd_pcm_substream *substream,
+			  struct snd_soc_dai *dai)
+{
+	struct s1402x_priv *priv = snd_soc_component_get_drvdata(dai->component);
+
+	return pm_runtime_resume_and_get(priv->dev);
 }
 
 static const struct snd_soc_dai_ops s1402x_dai_ops = {
+	.startup	= s1402x_startup,
 	.hw_params	= s1402x_hw_params,
 	.set_bclk_ratio	= s1402x_set_bclk_ratio,
 	.shutdown	= s1402x_shutdown,
@@ -419,12 +436,23 @@ static int s1402x_probe(struct platform_device *pdev)
 	s1402x_reset_sys(priv);
 	s1402x_init(priv);
 
+	/*
+	 * Configured and active now; idle from here on, so that the wrapper
+	 * can suspend while no stream is open.
+	 */
+	pm_runtime_set_active(dev);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		goto err_dout;
+
 	ret = devm_snd_soc_register_component(dev, &s1402x_component,
 					      s1402x_dais,
 					      ARRAY_SIZE(s1402x_dais));
 	if (ret)
 		goto err_dout;
 
+	pm_runtime_idle(dev);
+
 	return 0;
 
 err_dout:
@@ -442,6 +470,25 @@ static void s1402x_remove(struct platform_device *pdev)
 	clk_disable_unprepare(priv->clk_aclk);
 }
 
+static int s1402x_runtime_suspend(struct device *dev)
+{
+	return 0;
+}
+
+static int s1402x_runtime_resume(struct device *dev)
+{
+	struct s1402x_priv *priv = dev_get_drvdata(dev);
+
+	s1402x_reset_sys(priv);
+	s1402x_init(priv);
+
+	return 0;
+}
+
+static const struct dev_pm_ops s1402x_pm_ops = {
+	RUNTIME_PM_OPS(s1402x_runtime_suspend, s1402x_runtime_resume, NULL)
+};
+
 static const struct of_device_id s1402x_of_match[] = {
 	{ .compatible = "samsung,s1402x" },
 	{ },
@@ -452,6 +499,7 @@ static struct platform_driver s1402x_driver = {
 	.driver = {
 		.name = "s1402x",
 		.of_match_table = s1402x_of_match,
+		.pm = pm_ptr(&s1402x_pm_ops),
 	},
 	.probe = s1402x_probe,
 	.remove = s1402x_remove,
-- 
2.47.3

