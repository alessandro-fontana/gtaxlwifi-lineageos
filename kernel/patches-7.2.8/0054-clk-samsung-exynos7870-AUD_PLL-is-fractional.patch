From 3641af50574b6f9912f036c01733cce01d8e7979 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:53 +0000
Subject: [PATCH] clk: samsung: exynos7870: AUD_PLL is fractional

The DISPAUD AUD_PLL is a PLL1431x: fractional, with a signed 16-bit K
divider in CON1.  Registered as integer pll_1417x, Linux decodes only
M/P/S and misreports the rate: with the bootloader programming
M=30 P=1 S=3 K=16213 (read live from 0x148d01c0/0x148d01c4 on
gtaxlwifi), the reported 97.5 MHz is 0.8% away from the real
98.304 MHz, which is enough to derail the I2S prescaler arithmetic in
the audio path.

The pll_36xx type has the exact same register layout (M 25:16, P 13:8,
S 2:0, K in CON1 bits 15:0) and K offset (con_reg + 4), unlike
pll_0831x which reads K from con_reg + 8.  Switch the type and provide
the single vendor-equivalent rate; 98304019 Hz is the exact integer
the 36xx formula yields for this M/P/S/K.

Downstream reference: CLK_PLL(14310, AUD_PLL, ...) with pll1431x_ops
in drivers/soc/samsung/pwrcal/S5E7870/S5E7870-cmu.c (LineageOS 21).
---
 drivers/clk/samsung/clk-exynos7870.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/samsung/clk-exynos7870.c b/drivers/clk/samsung/clk-exynos7870.c
index a31d379735..4c5f0047c4 100644
--- a/drivers/clk/samsung/clk-exynos7870.c
+++ b/drivers/clk/samsung/clk-exynos7870.c
@@ -1233,10 +1233,22 @@ static const struct samsung_fixed_rate_clock dispaud_fixed_clks[] __initconst =
 	FRATE(0, "frat_dispaud_mipiphy_txbyteclkhs", NULL, 0, 188000000),
 };
 
+/*
+ * AUD_PLL is a fractional PLL1431x: M/P/S in CON0 and a 16-bit K in
+ * CON1, matching the pll_36xx register layout (K at con_reg + 4).
+ * The bootloader programs 26 MHz * (30 + 16213/65536) / 8, i.e.
+ * 98.304 MHz to within 0.2 ppm; the single rate below reproduces it.
+ * Registering it as integer pll_1417x made Linux misreport 97.5 MHz.
+ */
+static const struct samsung_pll_rate_table dispaud_aud_pll_rates[] __initconst = {
+	PLL_36XX_RATE(26000000U, 98304019U, 30, 1, 3, 16213),
+	{ /* sentinel */ }
+};
+
 static const struct samsung_pll_clock dispaud_pll_clks[] __initconst = {
-	PLL(pll_1417x, CLK_FOUT_DISPAUD_AUD_PLL, "fout_dispaud_aud_pll",
+	PLL(pll_36xx, CLK_FOUT_DISPAUD_AUD_PLL, "fout_dispaud_aud_pll",
 	    "oscclk", PLL_LOCKTIME_DISPAUD_AUD_PLL, PLL_CON0_DISPAUD_AUD_PLL,
-	    NULL),
+	    dispaud_aud_pll_rates),
 	PLL(pll_1417x, CLK_FOUT_DISPAUD_PLL, "fout_dispaud_pll", "oscclk",
 	    PLL_LOCKTIME_DISPAUD_PLL, PLL_CON0_DISPAUD_PLL, NULL),
 };
-- 
