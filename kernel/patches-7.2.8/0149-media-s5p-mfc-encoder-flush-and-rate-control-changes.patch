From c1356113b4c7e44f719370479bd74d0d8f92e4ea Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 15:28:44 +0200
Subject: [PATCH] media: s5p-mfc: encoder flush and rate control changes while
 encoding

Stopping the queues of an encoder in the middle of the stream, as
Android's MediaCodec.flush() does, left the instance FINISHED: nothing
was encoded again after the queues were started. Keep it RUNNING (or
HEAD_PRODUCED), and force an IDR for the first picture after the flush.
A stop after the drain still leaves it FINISHED.

Bit rate and frame rate set while encoding were stored but never
reached the hardware. Write them with the E_PARAM_CHANGE bits for the
next picture, as the vendor driver does. The Codec2 V4L2 encoder sets
the frame rate it measures from the timestamps: a camera at 18-21 fps
was rate controlled as 30 fps, with a bit rate well below the request.

---
 .../platform/samsung/s5p-mfc/s5p_mfc_common.h |  6 +++++
 .../platform/samsung/s5p-mfc/s5p_mfc_enc.c    | 22 ++++++++++++++++++-
 .../platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c | 11 ++++++++++
 3 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
index f01e61f44e..c8113ce659 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_common.h
@@ -737,6 +737,8 @@ struct s5p_mfc_ctx {
 	 */
 	bool enc_last_pending;
 	u64 enc_last_ts;
+	/* Rate control changes for the next picture: E_PARAM_CHANGE bits. */
+	unsigned long enc_param_change;
 
 	struct list_head ref_queue;
 	unsigned int ref_queue_cnt;
@@ -833,6 +835,10 @@ void s5p_mfc_cleanup_queue(struct list_head *lh, struct vb2_queue *vq);
 
 #define MFC_V10PLUS_BITS	(MFC_V10_BIT | MFC_V12_BIT)
 
+/* E_PARAM_CHANGE: the rate control values rewritten for the next picture. */
+#define S5P_MFC_ENC_CHANGE_FRAMERATE	1
+#define S5P_MFC_ENC_CHANGE_BITRATE	2
+
 /*
  * Encoder source planes: Android hands in one dmabuf for both NV12M planes,
  * with the chroma at data_offset of the second one.
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_enc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_enc.c
index 90630d5bfe..65baa4ad38 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_enc.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_enc.c
@@ -1901,6 +1901,9 @@ static int s5p_mfc_enc_s_ctrl(struct v4l2_ctrl *ctrl)
 		break;
 	case V4L2_CID_MPEG_VIDEO_BITRATE:
 		p->rc_bitrate = ctrl->val;
+		/* While encoding, applied from the next picture. */
+		if (ctx->state == MFCINST_RUNNING)
+			set_bit(S5P_MFC_ENC_CHANGE_BITRATE, &ctx->enc_param_change);
 		break;
 	case V4L2_CID_MPEG_MFC51_VIDEO_RC_REACTION_COEFF:
 		p->rc_reaction_coeff = ctrl->val;
@@ -2321,6 +2324,9 @@ static int vidioc_s_parm(struct file *file, void *priv,
 					a->parm.output.timeperframe.denominator;
 		ctx->enc_params.rc_framerate_denom =
 					a->parm.output.timeperframe.numerator;
+		if (ctx->state == MFCINST_RUNNING)
+			set_bit(S5P_MFC_ENC_CHANGE_FRAMERATE,
+				&ctx->enc_param_change);
 	} else {
 		mfc_err("Setting FPS is only possible for the output queue\n");
 		return -EINVAL;
@@ -2732,6 +2738,12 @@ static void s5p_mfc_stop_streaming(struct vb2_queue *q)
 	unsigned long flags;
 	struct s5p_mfc_ctx *ctx = vb2_get_drv_priv(q);
 	struct s5p_mfc_dev *dev = ctx->dev;
+	/*
+	 * A flush (MediaCodec.flush()): both queues stop and start again in
+	 * the middle of the stream. The instance stays usable; only a stop
+	 * after the drain leaves it finished.
+	 */
+	enum s5p_mfc_inst_state prev = ctx->state;
 
 	if ((ctx->state == MFCINST_FINISHING ||
 		ctx->state == MFCINST_RUNNING) &&
@@ -2740,7 +2752,15 @@ static void s5p_mfc_stop_streaming(struct vb2_queue *q)
 		s5p_mfc_wait_for_done_ctx(ctx, S5P_MFC_R2H_CMD_FRAME_DONE_RET,
 					  0);
 	}
-	ctx->state = MFCINST_FINISHED;
+	if (prev == MFCINST_RUNNING || prev == MFCINST_HEAD_PRODUCED) {
+		ctx->state = prev;
+		/* The references are gone with the buffers: restart on an IDR. */
+		if (prev == MFCINST_RUNNING)
+			ctx->force_frame_type =
+				V4L2_MPEG_MFC51_VIDEO_FORCE_FRAME_TYPE_I_FRAME;
+	} else {
+		ctx->state = MFCINST_FINISHED;
+	}
 	spin_lock_irqsave(&dev->irqlock, flags);
 	if (q->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
 		s5p_mfc_cleanup_queue(&ctx->dst_queue, &ctx->vq_dst);
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
index 8cc043531d..f5c5123671 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
@@ -2031,6 +2031,7 @@ static inline int s5p_mfc_run_dec_frame(struct s5p_mfc_ctx *ctx)
 
 static inline int s5p_mfc_run_enc_frame(struct s5p_mfc_ctx *ctx)
 {
+	unsigned long change;
 	struct s5p_mfc_dev *dev = ctx->dev;
 	struct s5p_mfc_buf *dst_mb;
 	struct s5p_mfc_buf *src_mb;
@@ -2086,6 +2087,16 @@ static inline int s5p_mfc_run_enc_frame(struct s5p_mfc_ctx *ctx)
 
 	s5p_mfc_set_enc_stream_buffer_v6(ctx, dst_addr, dst_size);
 
+	/* Bit rate and frame rate changed while encoding (downstream: SFR mode). */
+	change = xchg(&ctx->enc_param_change, 0);
+	if (change & BIT(S5P_MFC_ENC_CHANGE_FRAMERATE))
+		writel(((ctx->enc_params.rc_framerate_num & 0xFFFF) << 16) |
+		       (ctx->enc_params.rc_framerate_denom & 0xFFFF),
+		       dev->mfc_regs->e_rc_frame_rate);
+	if (change & BIT(S5P_MFC_ENC_CHANGE_BITRATE))
+		writel(ctx->enc_params.rc_bitrate, dev->mfc_regs->e_rc_bit_rate);
+	writel(change, dev->mfc_regs->e_param_change);
+
 	/* FORCE_KEY_FRAME and FORCE_FRAME_TYPE apply to this picture only. */
 	writel(ctx->force_frame_type & 0x3, dev->mfc_regs->e_frame_insertion);
 	ctx->force_frame_type = V4L2_MPEG_MFC51_VIDEO_FORCE_FRAME_TYPE_DISABLED;
-- 
2.47.3

