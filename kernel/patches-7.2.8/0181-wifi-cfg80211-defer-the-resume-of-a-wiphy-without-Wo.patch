From f4126b5455214f23082a2888cba63a62b12af9b7 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Wed, 30 Sep 2026 10:13:41 +0200
Subject: [PATCH] wifi: cfg80211: defer the resume of a wiphy without WoWLAN

Without WoWLAN the device is stopped at suspend and mac80211 starts it
again from wiphy_resume(): for a device whose driver boots firmware on
start, that is seconds spent in the resume path, and the whole system
waits for them before thawing user space. On an SM-T580 (QCA9377 over
SDIO, ath10k) wiphy_resume() took 1.25 s of a 1.67 s kernel resume, and
the screen came on almost two seconds after the power key.

Nothing needs the device back before user space runs. Do the resume
from a work item: wiphy_resume() returns at once when no WoWLAN is
configured, the work takes the RTNL and the wiphy lock and does what
wiphy_resume() did. Until it has run the wiphy stays suspended and
nl80211 commands for it get -EBUSY, so that nothing reaches a device
that is not started yet. The work is on an unbound, non-freezable
workqueue: wiphy_suspend() and wiphy_unregister() flush it, and a
suspend starting before a freezable work ran would wait forever.

Measured over ten suspend cycles: wiphy_resume() from 1250 ms to under
1 ms, kernel resume from 1666 ms to 402-441 ms, Wi-Fi back with traffic
after every cycle, no warnings.

---
 net/wireless/core.c    |  8 +++++++
 net/wireless/core.h    |  5 +++++
 net/wireless/nl80211.c |  6 ++++++
 net/wireless/sysfs.c   | 47 +++++++++++++++++++++++++++++++++++++-----
 4 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/net/wireless/core.c b/net/wireless/core.c
index bc7e2c50cc..34c1f7c960 100644
--- a/net/wireless/core.c
+++ b/net/wireless/core.c
@@ -677,6 +677,9 @@ struct wiphy *wiphy_new_nm(const struct cfg80211_ops *ops, int sizeof_priv,
 		  cfg80211_mgmt_registrations_update_wk);
 	spin_lock_init(&rdev->mgmt_registrations_lock);
 	INIT_WORK(&rdev->wiphy_work, cfg80211_wiphy_work);
+#ifdef CONFIG_PM
+	INIT_WORK(&rdev->resume_work, cfg80211_resume_work);
+#endif
 	INIT_LIST_HEAD(&rdev->wiphy_work_list);
 	spin_lock_init(&rdev->wiphy_work_lock);
 
@@ -1325,6 +1328,11 @@ void wiphy_unregister(struct wiphy *wiphy)
 	if (rdev->wiphy.rfkill)
 		rfkill_unregister(rdev->wiphy.rfkill);
 
+#ifdef CONFIG_PM
+	/* the deferred resume takes the RTNL: wait for it before taking it */
+	flush_work(&rdev->resume_work);
+#endif
+
 	rtnl_lock();
 	wiphy_lock(&rdev->wiphy);
 	nl80211_notify_wiphy(rdev, NL80211_CMD_DEL_WIPHY);
diff --git a/net/wireless/core.h b/net/wireless/core.h
index 81e595247b..ac45e4b47a 100644
--- a/net/wireless/core.h
+++ b/net/wireless/core.h
@@ -130,12 +130,17 @@ struct cfg80211_registered_device {
 	/* protects the list above */
 	spinlock_t wiphy_work_lock;
 	bool suspended;
+	struct work_struct resume_work;
 
 	/* must be last because of the way we do wiphy_priv(),
 	 * and it should at least be aligned to NETDEV_ALIGN */
 	struct wiphy wiphy __aligned(NETDEV_ALIGN);
 };
 
+#ifdef CONFIG_PM
+void cfg80211_resume_work(struct work_struct *work);
+#endif
+
 static inline
 struct cfg80211_registered_device *wiphy_to_rdev(struct wiphy *wiphy)
 {
diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
index 755f8fe711..5f0d253928 100644
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -19337,6 +19337,12 @@ static int nl80211_pre_doit(const struct genl_split_ops *ops,
 		info->user_ptr[0] = rdev;
 	}
 
+	/* the device is not back yet from a deferred resume (sysfs.c) */
+	if (rdev && rdev->suspended) {
+		err = -EBUSY;
+		goto out_unlock;
+	}
+
 	if (internal_flags & NL80211_FLAG_MLO_VALID_LINK_ID) {
 		struct nlattr *link_id = info->attrs[NL80211_ATTR_MLO_LINK_ID];
 
diff --git a/net/wireless/sysfs.c b/net/wireless/sysfs.c
index 3ec25d3f00..e6d9a45c59 100644
--- a/net/wireless/sysfs.c
+++ b/net/wireless/sysfs.c
@@ -96,6 +96,9 @@ static int wiphy_suspend(struct device *dev)
 	struct cfg80211_registered_device *rdev = dev_to_rdev(dev);
 	int ret = 0;
 
+	/* a resume deferred from the previous cycle must finish first */
+	flush_work(&rdev->resume_work);
+
 	rdev->suspend_at = ktime_get_boottime_seconds();
 
 	rtnl_lock();
@@ -130,14 +133,10 @@ static int wiphy_suspend(struct device *dev)
 	return ret;
 }
 
-static int wiphy_resume(struct device *dev)
+static int __wiphy_resume(struct cfg80211_registered_device *rdev)
 {
-	struct cfg80211_registered_device *rdev = dev_to_rdev(dev);
 	int ret = 0;
 
-	/* Age scan results with time spent in suspend */
-	cfg80211_bss_age(rdev, ktime_get_boottime_seconds() - rdev->suspend_at);
-
 	rtnl_lock();
 	wiphy_lock(&rdev->wiphy);
 	if (rdev->wiphy.registered && rdev->ops->resume)
@@ -154,6 +153,44 @@ static int wiphy_resume(struct device *dev)
 	return ret;
 }
 
+void cfg80211_resume_work(struct work_struct *work)
+{
+	struct cfg80211_registered_device *rdev =
+		container_of(work, struct cfg80211_registered_device,
+			     resume_work);
+
+	__wiphy_resume(rdev);
+}
+
+/*
+ * Without WoWLAN the device was stopped at suspend and the driver starts it
+ * again on resume, which for some devices means booting their firmware:
+ * seconds, during which the whole system waits before thawing user space
+ * (and turning the screen on). Nothing depends on the device being back at
+ * that point, so do it right after, from a work item. Until then the wiphy
+ * stays suspended and nl80211 answers -EBUSY.
+ */
+static int wiphy_resume(struct device *dev)
+{
+	struct cfg80211_registered_device *rdev = dev_to_rdev(dev);
+
+	/* Age scan results with time spent in suspend */
+	cfg80211_bss_age(rdev, ktime_get_boottime_seconds() - rdev->suspend_at);
+
+	/*
+	 * Not a freezable workqueue: wiphy_suspend() flushes this work, and a
+	 * suspend that starts before it ran would wait forever on a frozen
+	 * queue. Here the work starts at once, in parallel with the rest of
+	 * the resume, and holds the RTNL like the synchronous path.
+	 */
+	if (!rdev->wiphy.wowlan_config) {
+		queue_work(system_unbound_wq, &rdev->resume_work);
+		return 0;
+	}
+
+	return __wiphy_resume(rdev);
+}
+
 static SIMPLE_DEV_PM_OPS(wiphy_pm_ops, wiphy_suspend, wiphy_resume);
 #define WIPHY_PM_OPS (&wiphy_pm_ops)
 #else
-- 
2.47.3

