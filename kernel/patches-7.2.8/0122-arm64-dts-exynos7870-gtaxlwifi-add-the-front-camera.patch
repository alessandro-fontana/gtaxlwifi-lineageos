From 3c9ec60e8f984ebb7c11a7206d6b93a7c2483df1 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 13:32:36 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: add the front camera

SK hynix SR259 on hsi2c3 (0x30), one lane to CSIS1, MCLK1 at 26 MHz
from the oscillator, I/O on LDO34 and 2.8 V analog from an external
LDO enabled by gpd4-3, reset on gpf3-1 and standby on gpa1-5, as in
the vendor device tree.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts  | 90 ++++++++++++++++++-
 1 file changed, 89 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index c86155ca9c..006b8261ed 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -8,7 +8,8 @@
  * charger, MUIC) funzionano. Il display e' ancora il framebuffer lasciato
  * acceso da S-BOOT via simpledrm: niente DECON/DSI, niente backlight.
  * Entrambi i banchi di RAM sono dichiarati (vedi memory@ qui sotto).
- * Assenti: camera. Sensori: accelerometro LIS2HH12 su i2c7
+ * Fotocamera anteriore (SR259 su CSIS1) in fondo, la posteriore
+ * non ancora. Sensori: accelerometro LIS2HH12 su i2c7
  * dichiarato con mount-matrix misurata (senza IRQ), piu' il sensore
  * di luce CM3323 sullo stesso bus (vedi in fondo). Audio in lavorazione:
  * catena completa dichiarata (lpass, adma, i2s0, mixer s1402x,
@@ -378,6 +379,22 @@ tsp_avdd: regulator-tsp-avdd {
 		enable-active-high;
 	};
 
+	/*
+	 * Fotocamera anteriore, rail analogico a 2,8 V: un LDO esterno
+	 * acceso da gpd4-3 ("VTCAM_LDO_EN" nel downstream,
+	 * gpio_vt_cam_2p8_en). Nel DTS comune del downstream lo stesso pin
+	 * compare anche come hrm_vdd_io_en: e' un avanzo di un altro
+	 * modello, il tablet non ha il sensore cardiaco (§57).
+	 */
+	vtcam_avdd: regulator-vtcam-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD_VTCAM_A2P8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpd4 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	/*
 	 * ======================================================================
 	 * WI-FI — alimentazione e sequenza di accensione
@@ -1181,6 +1198,17 @@ vdd_ldo27: ldo27 {
 			 * il rail e il chip non risponde. Tensione fissa a 2,8 V,
 			 * identica al downstream.
 			 */
+			/*
+			 * I/O a 1,8 V delle due fotocamere ("VDDIO_1.8V_CAM" nel
+			 * downstream, stessa tensione). Lo accende il driver del
+			 * sensore: nessun boot-on, nessun always-on (§57).
+			 */
+			vdd_ldo34: ldo34 {
+				regulator-name = "VDDIO_1.8V_CAM";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
 			vdd_ldo33: ldo33 {
 				regulator-name = "vdd_ldo33";
 				regulator-min-microvolt = <2800000>;
@@ -2472,3 +2500,63 @@ light-sensor@10 {
  *     alimentazione: LDO35 "LCD_1P8" + buck_en, poi reset sequence
  * ----------------------------------------------------------------------
  */
+
+/*
+ * ======================================================================
+ * FOTOCAMERA ANTERIORE — SK hynix SR259 su CSIS1 (§57)
+ * ======================================================================
+ * Dal downstream (exynos7870-gtaxl_common.dtsi, fimc-is-sr259@30 e
+ * fimc_is_module_sr259): hsi2c_5 a 0x138c0000, che qui e' hsi2c3, stessi
+ * pin gpf0-2/3; indirizzo 0x30; MCLK1 su gpe0-1 a 26 MHz; reset gpf3-1
+ * (alto = in funzione); standby gpa1-5 (alto = in funzione); una
+ * corsia MIPI verso il CSIS1.
+ *
+ * La MCLK viene dall'oscillatore a 26 MHz, divisore 1: e' il valore che
+ * il downstream imposta (exynos7870_fimc_is_sensor_mclk_on).
+ * Il link a 351 MHz viene dal PLL del sensore: 26 / 4 * 54 = 351 MHz,
+ * cioe' 70,2 Mpixel/s a 10 bit su una corsia DDR.
+ */
+&hsi2c3 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	camera@30 {
+		compatible = "hynix,sr259";
+		reg = <0x30>;
+
+		clocks = <&cmu_mif CLK_GOUT_MIF_CMU_ISP_SENSOR1>;
+		assigned-clocks = <&cmu_mif CLK_MOUT_MIF_CMU_ISP_SENSOR1>,
+				  <&cmu_mif CLK_DOUT_MIF_CMU_ISP_SENSOR1>;
+		assigned-clock-parents = <&oscclk>, <0>;
+		assigned-clock-rates = <0>, <26000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fimc_is_mclk1_fn>;
+
+		vddio-supply = <&vdd_ldo34>;
+		avdd-supply = <&vtcam_avdd>;
+		reset-gpios = <&gpf3 1 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&gpa1 5 GPIO_ACTIVE_HIGH>;
+
+		orientation = <0>;
+
+		port {
+			sr259_out: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <351000000>;
+				remote-endpoint = <&csis1_in>;
+			};
+		};
+	};
+};
+
+&csis1 {
+	status = "okay";
+
+	port {
+		csis1_in: endpoint {
+			data-lanes = <1>;
+			remote-endpoint = <&sr259_out>;
+		};
+	};
+};
-- 
2.47.3

