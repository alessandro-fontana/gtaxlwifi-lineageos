From 8505042c0e6cf716d2dc7807dbd7711e6326a0cf Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 16:55:56 +0200
Subject: [PATCH] media: i2c: add Samsung S5K4H5YC sensor driver

8 MP raw Bayer sensor on four CSI-2 lanes, rear camera of the Galaxy
Tab A 10.1 (2016). Two modes from the vendor setB tables, 3280x2458 and
the 2x2 binned 1640x1228, both at 30 fps from a 26 MHz clock.

---
 drivers/media/i2c/Kconfig    |  11 +
 drivers/media/i2c/Makefile   |   1 +
 drivers/media/i2c/s5k4h5yc.c | 897 +++++++++++++++++++++++++++++++++++
 3 files changed, 909 insertions(+)
 create mode 100644 drivers/media/i2c/s5k4h5yc.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index c7acd4f634..1b622fe758 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -781,6 +781,17 @@ config VIDEO_S5K3M5
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5k3m5.
 
+config VIDEO_S5K4H5YC
+	tristate "Samsung S5K4H5YC sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Samsung S5K4H5YC
+	  8 MP raw Bayer camera, the rear camera of the Samsung Galaxy
+	  Tab A 10.1 (2016).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k4h5yc.
+
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 987792c4d8..2f3a771cbf 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -128,6 +128,7 @@ obj-$(CONFIG_VIDEO_RDACM21) += rdacm21.o
 obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
+obj-$(CONFIG_VIDEO_S5K4H5YC) += s5k4h5yc.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_SR259) += sr259.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
diff --git a/drivers/media/i2c/s5k4h5yc.c b/drivers/media/i2c/s5k4h5yc.c
new file mode 100644
