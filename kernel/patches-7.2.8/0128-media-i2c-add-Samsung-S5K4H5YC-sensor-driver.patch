+static const s64 s5k4h5yc_link_freqs[] = { S5K4H5YC_LINK_FREQ };
+
+static const char * const s5k4h5yc_supply_names[] = {
+	"avdd",		/* 2.8 V analog */
+	"dvdd",		/* 1.2 V core */
+	"vddio",	/* 1.8 V interface */
+};
+
+struct s5k4h5yc {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5k4h5yc_supply_names)];
+	struct gpio_desc *reset;
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *again;
+
+	const struct s5k4h5yc_mode *mode;
+};
+
+static inline struct s5k4h5yc *to_s5k4h5yc(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k4h5yc, sd);
+}
+
+static int s5k4h5yc_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+	int ret;
+
+	/*
+	 * The vendor order is analog, core, I/O, then the clock and the
+	 * reset; the bulk API enables them in the order of the array.
+	 */
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret)
+		return ret;
+	usleep_range(2000, 2500);
+
+	ret = clk_prepare_enable(sensor->mclk);
+	if (ret)
+		goto err_supplies;
+	usleep_range(100, 200);
+
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(1400, 1600);
+
+	return 0;
+
+err_supplies:
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return ret;
+}
+
+static int s5k4h5yc_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+
+	clk_disable_unprepare(sensor->mclk);
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+
+	return 0;
+}
+
+static int s5k4h5yc_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k4h5yc *sensor =
+		container_of(ctrl->handler, struct s5k4h5yc, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = sensor->mode->height + ctrl->val -
+			  S5K4H5YC_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum, max,
+					       sensor->exposure->step,
+					       min_t(s64, sensor->exposure->default_value, max));
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	cci_write(sensor->regmap, S5K4H5YC_REG_HOLD, 1, &ret);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, S5K4H5YC_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(sensor->regmap, S5K4H5YC_REG_AGAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, S5K4H5YC_REG_FLL,
+			  sensor->mode->height + ctrl->val, &ret);
+		break;
+	default:
+		break;
+	}
+
+	cci_write(sensor->regmap, S5K4H5YC_REG_HOLD, 0, &ret);
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k4h5yc_ctrl_ops = {
+	.s_ctrl = s5k4h5yc_set_ctrl,
+};
+
+static int s5k4h5yc_init_controls(struct s5k4h5yc *sensor, u32 again_min,
+				  u32 again_max)
+{
+	const struct s5k4h5yc_mode *mode = sensor->mode;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &s5k4h5yc_ctrl_ops,
+				      V4L2_CID_LINK_FREQ, 0, 0,
+				      s5k4h5yc_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &s5k4h5yc_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  S5K4H5YC_PIXEL_RATE, S5K4H5YC_PIXEL_RATE, 1,
+			  S5K4H5YC_PIXEL_RATE);
+
+	sensor->hblank = v4l2_ctrl_new_std(hdl, &s5k4h5yc_ctrl_ops,
+					   V4L2_CID_HBLANK,
+					   mode->llp - mode->width,
+					   mode->llp - mode->width, 1,
+					   mode->llp - mode->width);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &s5k4h5yc_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->fll - mode->height,
+					   S5K4H5YC_FLL_MAX - mode->height, 1,
+					   mode->fll - mode->height);
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &s5k4h5yc_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K4H5YC_EXPOSURE_MIN,
+					     mode->fll - S5K4H5YC_EXPOSURE_MARGIN,
+					     1, 0x04e2);
+
+	sensor->again = v4l2_ctrl_new_std(hdl, &s5k4h5yc_ctrl_ops,
+					  V4L2_CID_ANALOGUE_GAIN,
+					  again_min, again_max, 1, again_min);
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+	v4l2_ctrl_new_fwnode_properties(hdl, &s5k4h5yc_ctrl_ops, &props);
+
+	if (hdl->error)
+		return hdl->error;
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static void s5k4h5yc_fill_format(const struct s5k4h5yc_mode *mode,
+				 struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = S5K4H5YC_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k4h5yc_enable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+
+	ret = regmap_multi_reg_write(sensor->regmap, sensor->mode->regs,
+				     sensor->mode->num_regs);
+	if (ret)
+		goto err;
+
+	ret = __v4l2_ctrl_handler_setup(sd->ctrl_handler);
+	if (ret)
+		goto err;
+
+	ret = cci_write(sensor->regmap, S5K4H5YC_REG_MODE_SELECT,
+			S5K4H5YC_MODE_STREAMING, NULL);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static int s5k4h5yc_disable_streams(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state, u32 pad,
+				    u64 streams_mask)
+{
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, S5K4H5YC_REG_MODE_SELECT,
+			S5K4H5YC_MODE_STANDBY, NULL);
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static int s5k4h5yc_enum_mbus_code(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = S5K4H5YC_MBUS_CODE;
+	return 0;
+}
+
+static int s5k4h5yc_enum_frame_size(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state,
+				    struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(s5k4h5yc_modes) ||
+	    fse->code != S5K4H5YC_MBUS_CODE)
+		return -EINVAL;
+	fse->min_width = fse->max_width = s5k4h5yc_modes[fse->index].width;
+	fse->min_height = fse->max_height = s5k4h5yc_modes[fse->index].height;
+	return 0;
+}
+
+static int s5k4h5yc_set_fmt(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_format *fmt)
+{
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+	const struct s5k4h5yc_mode *mode;
+	int ret;
+
+	mode = v4l2_find_nearest_size(s5k4h5yc_modes,
+				      ARRAY_SIZE(s5k4h5yc_modes), width,
+				      height, fmt->format.width,
+				      fmt->format.height);
+	s5k4h5yc_fill_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	sensor->mode = mode;
+
+	ret = __v4l2_ctrl_modify_range(sensor->hblank,
+				       mode->llp - mode->width,
+				       mode->llp - mode->width, 1,
+				       mode->llp - mode->width);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(sensor->vblank,
+				       mode->fll - mode->height,
+				       S5K4H5YC_FLL_MAX - mode->height, 1,
+				       mode->fll - mode->height);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_s_ctrl(sensor->vblank, mode->fll - mode->height);
+}
+
+static int s5k4h5yc_get_selection(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 3280;
+		sel->r.height = 2458;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int s5k4h5yc_init_state(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state)
+{
+	s5k4h5yc_fill_format(&s5k4h5yc_modes[0],
+			     v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k4h5yc_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4h5yc_pad_ops = {
+	.enum_mbus_code = s5k4h5yc_enum_mbus_code,
+	.enum_frame_size = s5k4h5yc_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k4h5yc_set_fmt,
+	.get_selection = s5k4h5yc_get_selection,
+	.enable_streams = s5k4h5yc_enable_streams,
+	.disable_streams = s5k4h5yc_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k4h5yc_subdev_ops = {
+	.video = &s5k4h5yc_video_ops,
+	.pad = &s5k4h5yc_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k4h5yc_internal_ops = {
+	.init_state = s5k4h5yc_init_state,
+};
+
+static int s5k4h5yc_check_endpoint(struct s5k4h5yc *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(sensor->dev, -EINVAL, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != S5K4H5YC_DATA_LANES) {
+		ret = dev_err_probe(sensor->dev, -EINVAL,
+				    "four data lanes are supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       s5k4h5yc_link_freqs,
+				       ARRAY_SIZE(s5k4h5yc_link_freqs), &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int s5k4h5yc_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k4h5yc *sensor;
+	u64 id = 0, rev = 0, gmin = 0, gmax = 0;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = dev;
+	sensor->mode = &s5k4h5yc_modes[0];
+
+	ret = s5k4h5yc_check_endpoint(sensor);
+	if (ret)
+		return ret;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	sensor->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->mclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->mclk),
+				     "failed to get the clock\n");
+	if (clk_get_rate(sensor->mclk) != S5K4H5YC_MCLK)
+		return dev_err_probe(dev, -EINVAL, "clock is %lu Hz, not %u\n",
+				     clk_get_rate(sensor->mclk),
+				     S5K4H5YC_MCLK);
+
+	for (i = 0; i < ARRAY_SIZE(s5k4h5yc_supply_names); i++)
+		sensor->supplies[i].supply = s5k4h5yc_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset),
+				     "failed to get reset gpio\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &s5k4h5yc_subdev_ops);
+	sensor->sd.internal_ops = &s5k4h5yc_internal_ops;
+
+	ret = s5k4h5yc_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	cci_read(sensor->regmap, S5K4H5YC_REG_CHIP_ID, &id, &ret);
+	cci_read(sensor->regmap, S5K4H5YC_REG_REVISION, &rev, &ret);
+	cci_read(sensor->regmap, S5K4H5YC_REG_AGAIN_MIN, &gmin, &ret);
+	cci_read(sensor->regmap, S5K4H5YC_REG_AGAIN_MAX, &gmax, &ret);
+	if (ret) {
+		dev_err_probe(dev, ret, "sensor does not answer on the bus\n");
+		goto err_power;
+	}
+	dev_info(dev, "S5K4H5YC id 0x%04llx rev 0x%02llx gain %llu-%llu/32\n",
+		 id, rev, gmin, gmax);
+	if (id != S5K4H5YC_CHIP_ID)
+		dev_warn(dev, "chip id 0x%04llx, expected 0x%04x\n", id,
+			 S5K4H5YC_CHIP_ID);
+	if (!gmin || gmax <= gmin) {
+		gmin = S5K4H5YC_AGAIN_MIN;
+		gmax = S5K4H5YC_AGAIN_MAX;
+	}
+
+	ret = s5k4h5yc_init_controls(sensor, gmin, gmax);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+err_power:
+	s5k4h5yc_power_off(dev);
+	return ret;
+}
+
+static void s5k4h5yc_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev)) {
+		s5k4h5yc_power_off(sensor->dev);
+		pm_runtime_set_suspended(sensor->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k4h5yc_pm_ops, s5k4h5yc_power_off,
+				 s5k4h5yc_power_on, NULL);
+
+static const struct of_device_id s5k4h5yc_of_match[] = {
+	{ .compatible = "samsung,s5k4h5yc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h5yc_of_match);
+
+static struct i2c_driver s5k4h5yc_driver = {
+	.driver = {
+		.name = "s5k4h5yc",
+		.pm = pm_ptr(&s5k4h5yc_pm_ops),
+		.of_match_table = s5k4h5yc_of_match,
+	},
+	.probe = s5k4h5yc_probe,
+	.remove = s5k4h5yc_remove,
+};
+module_i2c_driver(s5k4h5yc_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4H5YC image sensor driver");
+MODULE_LICENSE("GPL");
