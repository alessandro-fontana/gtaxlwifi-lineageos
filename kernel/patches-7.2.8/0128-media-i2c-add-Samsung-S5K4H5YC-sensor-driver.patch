+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K4H5YC image sensor driver
+ *
+ * 8 MP raw Bayer sensor, 3264x2448 active plus a 16x10 border, four MIPI
+ * CSI-2 lanes, 10-bit output, SMIA-style 16-bit register map.
+ *
+ * The register sequences come from the vendor driver of the Galaxy Tab A
+ * 10.1 (2016), fimc-is-cis-4h5yc-setB.h: full resolution at 30 fps and the
+ * 2x2 binned 1640x1228 mode at 30 fps, both from a 26 MHz clock. The two
+ * modes share the PLL settings, hence one link frequency.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K4H5YC_MCLK			26000000
+/* 26 MHz / 6 * 159: 689 Mbps per lane, DDR */
+#define S5K4H5YC_LINK_FREQ		344500000ULL
+/* 26 MHz / 6 * 129 / 2 */
+#define S5K4H5YC_PIXEL_RATE		279500000
+#define S5K4H5YC_DATA_LANES		4
+
+#define S5K4H5YC_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5K4H5YC_CHIP_ID		0x485b
+#define S5K4H5YC_REG_REVISION		CCI_REG8(0x0002)
+#define S5K4H5YC_REG_AGAIN_MIN		CCI_REG16(0x0084)
+#define S5K4H5YC_REG_AGAIN_MAX		CCI_REG16(0x0086)
+#define S5K4H5YC_REG_MODE_SELECT	CCI_REG8(0x0100)
+#define S5K4H5YC_MODE_STREAMING		0x01
+#define S5K4H5YC_MODE_STANDBY		0x00
+#define S5K4H5YC_REG_ORIENTATION	CCI_REG8(0x0101)
+#define S5K4H5YC_REG_HOLD		CCI_REG8(0x0104)
+#define S5K4H5YC_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K4H5YC_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K4H5YC_REG_FLL		CCI_REG16(0x0340)
+
+#define S5K4H5YC_FLL_MAX		0xffff
+#define S5K4H5YC_EXPOSURE_MIN		1
+#define S5K4H5YC_EXPOSURE_MARGIN	4
+/* Analogue gain code in 1/32 steps (vendor: sensor_cis_calc_again_code) */
+#define S5K4H5YC_AGAIN_MIN		32
+#define S5K4H5YC_AGAIN_MAX		512
+
+#define S5K4H5YC_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
+
+struct s5k4h5yc_mode {
+	u32 width;
+	u32 height;
+	u32 llp;
+	u32 fll;
+	const struct reg_sequence *regs;
+	unsigned int num_regs;
+};
