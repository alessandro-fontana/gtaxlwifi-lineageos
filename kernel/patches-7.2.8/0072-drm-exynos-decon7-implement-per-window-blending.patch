From 300b974fa57bd13de6adc97a94c3905e83d04dec Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 4 Sep 2026 19:00:00 +0200
Subject: [PATCH] drm/exynos: decon7: implement per-window blending

The DECON block on Exynos7870 supports per-window plane and pixel
blending, and regs-decon7.h already describes the registers involved:
WINCONx_BLD_PIX, WINCONx_ALPHA_MUL, WINCONx_ALPHA_SEL, the VIDOSDxC
alpha fields, the per-window blending equation register BLENDE() and
BLENDCON. The vendor driver programs BLENDCON with an 8-bit alpha value
and writes BLENDE() starting from window 1, at the same offsets.

exynos7_drm_decon.c programs none of them. decon_win_set_pixfmt() only
touches the pixel format and the burst length, and decon_update_plane()
writes fixed values into VIDOSD_C and VIDOSD_D. The bind loop leaves
exynos_drm_plane_config.capabilities at zero, so exynos_plane_init()
creates neither the "alpha" nor the "pixel blend mode" plane property.

The visible consequence is that the blending registers keep whatever
value they were left with. On a Galaxy Tab A (2016) this shows up as
translucent surfaces compositing wrongly: the wallpaper bleeding through
an opening menu, and selection highlights turning bright pink. Both
disappear with this patch applied.

Implement decon_win_set_bldmod() and decon_win_set_bldeq() following
exynos5433_drm_decon.c, which drives the same register layout, and
declare EXYNOS_DRM_PLANE_CAP_WIN_BLEND and EXYNOS_DRM_PLANE_CAP_PIX_BLEND
on every window but window 0. Window 0 is the bottom-most layer and has
no blending equation register, matching what the vendor driver does.

The capabilities are set inside the bind loop rather than through a
static array indexed by WINDOWS_NR, so the patch stays correct with the
third hardware window exposed by an earlier local patch.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/exynos/exynos7_drm_decon.c | 83 ++++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/drivers/gpu/drm/exynos/exynos7_drm_decon.c b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
index be547a0e7c..c5ffba7e21 100644
--- a/drivers/gpu/drm/exynos/exynos7_drm_decon.c
+++ b/drivers/gpu/drm/exynos/exynos7_drm_decon.c
@@ -19,6 +19,7 @@
 #include <video/of_display_timing.h>
 #include <video/of_videomode.h>
 
+#include <drm/drm_blend.h>
 #include <drm/drm_fourcc.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_print.h>
@@ -309,6 +310,71 @@ static void decon_disable_vblank(struct exynos_drm_crtc *crtc)
 	}
 }
 
+static void decon_win_set_bldeq(struct decon_context *ctx, unsigned int win,
+				unsigned int alpha, unsigned int pixel_alpha)
+{
+	u32 val;
+
+	/* Window 0 is the bottom-most layer and has no blending equation. */
+	if (win == 0)
+		return;
+
+	switch (pixel_alpha) {
+	case DRM_MODE_BLEND_PIXEL_NONE:
+	case DRM_MODE_BLEND_COVERAGE:
+		val = BLENDE_A_FUNC(BLENDE_COEF_ALPHA_A) |
+		      BLENDE_B_FUNC(BLENDE_COEF_ONE_MINUS_ALPHA_A);
+		break;
+	case DRM_MODE_BLEND_PREMULTI:
+	default:
+		if (alpha != DRM_BLEND_ALPHA_OPAQUE)
+			val = BLENDE_A_FUNC(BLENDE_COEF_ALPHA0) |
+			      BLENDE_B_FUNC(BLENDE_COEF_ONE_MINUS_ALPHA_A);
+		else
+			val = BLENDE_A_FUNC(BLENDE_COEF_ONE) |
+			      BLENDE_B_FUNC(BLENDE_COEF_ONE_MINUS_ALPHA_A);
+		break;
+	}
+
+	writel(val, ctx->regs + BLENDE(win - 1));
+}
+
+static void decon_win_set_bldmod(struct decon_context *ctx, unsigned int win,
+				 unsigned int alpha, unsigned int pixel_alpha)
+{
+	u32 win_alpha = alpha >> 8;
+	u32 mask = WINCONx_BLD_PIX | WINCONx_ALPHA_MUL | WINCONx_ALPHA_SEL;
+	u32 val;
+
+	val = readl(ctx->regs + WINCON(win));
+	val &= ~mask;
+
+	switch (pixel_alpha) {
+	case DRM_MODE_BLEND_PIXEL_NONE:
+		val |= WINCONx_BLD_PLANE;
+		break;
+	case DRM_MODE_BLEND_COVERAGE:
+	case DRM_MODE_BLEND_PREMULTI:
+	default:
+		val |= WINCONx_BLD_PIX | WINCONx_ALPHA_MUL | WINCONx_ALPHA_SEL;
+		break;
+	}
+
+	writel(val, ctx->regs + WINCON(win));
+
+	if (alpha != DRM_BLEND_ALPHA_OPAQUE) {
+		val = VIDOSDxC_ALPHA0_R_F(win_alpha) |
+		      VIDOSDxC_ALPHA0_G_F(win_alpha) |
+		      VIDOSDxC_ALPHA0_B_F(win_alpha);
+		writel(val, ctx->regs + VIDOSD_C(win));
+
+		val = readl(ctx->regs + BLENDCON);
+		val &= ~BLENDCON_NEW_MASK;
+		val |= BLENDCON_NEW_8BIT_ALPHA_VALUE;
+		writel(val, ctx->regs + BLENDCON);
+	}
+}
+
 static void decon_win_set_pixfmt(struct decon_context *ctx, unsigned int win,
 				 struct drm_framebuffer *fb)
 {
@@ -419,6 +485,7 @@ static void decon_update_plane(struct exynos_drm_crtc *crtc,
 	unsigned int cpp = fb->format->cpp[0];
 	unsigned int pitch = fb->pitches[0];
 	unsigned int vidw_addr0_base = ctx->data->vidw_buf_start_base;
+	unsigned int pixel_alpha;
 
 	/*
 	 * SHADOWCON/PRTCON register is used for enabling timing.
@@ -480,6 +547,14 @@ static void decon_update_plane(struct exynos_drm_crtc *crtc,
 
 	writel(alpha, ctx->regs + VIDOSD_D(win));
 
+	if (fb->format->has_alpha)
+		pixel_alpha = state->base.pixel_blend_mode;
+	else
+		pixel_alpha = DRM_MODE_BLEND_PIXEL_NONE;
+
+	decon_win_set_bldmod(ctx, win, state->base.alpha, pixel_alpha);
+	decon_win_set_bldeq(ctx, win, state->base.alpha, pixel_alpha);
+
 	decon_win_set_pixfmt(ctx, win, fb);
 
 	/* hardware window 0 doesn't support color key. */
@@ -708,6 +783,14 @@ static int decon_bind(struct device *dev, struct device *master, void *data)
 		ctx->configs[i].num_pixel_formats = ARRAY_SIZE(decon_formats);
 		ctx->configs[i].zpos = i;
 		ctx->configs[i].type = decon_win_types[i];
+		/*
+		 * Window 0 is the bottom-most layer: it has no blending
+		 * equation register and is always opaque.
+		 */
+		if (i > 0)
+			ctx->configs[i].capabilities =
+				EXYNOS_DRM_PLANE_CAP_WIN_BLEND |
+				EXYNOS_DRM_PLANE_CAP_PIX_BLEND;
 
 		ret = exynos_plane_init(drm_dev, &ctx->planes[i], i,
 					&ctx->configs[i]);
-- 
2.47.3

