From 475d5723b9b0f277de9769e0f75cf35a167e973f Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 17:28:46 +0200
Subject: [PATCH] media: s5p-mfc: HEVC and VP8 decoding on Exynos7870

Checked against the vendor driver for the Exynos7870 MFC (0xa0b0) to
decode HEVC Main and VP8 through Android's Codec2 V4L2 decoder:

- VP8: decode the buffer the header was parsed from, the first key
  frame, instead of completing it unused and decoding the next frames
  against an empty reference.
- HEVC: no "packed PB" rerun on the same buffer. The client sends one
  access unit per buffer; the rerun passed the whole length again with
  the offset, so the firmware read past the data, and it looped if the
  firmware reported nothing consumed.
- HEVC: align the scratch buffer as for the other codecs, or the MV
  buffers after it eat the margin of bank1.
- Write the MV count for every codec: the register is shared by the
  instances.
- HEVC: report the conformance window through G_SELECTION, as for
  H.264.
- HEVC: size the DPB planes for whole 64x64 CTBs, in case the firmware
  writes them; a write past a buffer is a SysMMU fault here.
- DMABUF CAPTURE buffers: the DPB and four more, the extra the client
  adds to the driver's minimum. The DPB is set up once every buffer has
  been queued, so the client must hold them all at once; it asks for
  its whole pipeline (output delay + 9) while the surface grants output
  delay + 7. DPB + 8 left VP8 waiting for buffers that never came, and
  H.264 only fitted under the former cap of 20.
- Allocate bank1 of at least its alignment: the IOMMU aligns an
  allocation to its size, and the alignment is BUG_ON checked.

---
 .../media/platform/samsung/s5p-mfc/s5p_mfc.c  | 14 ++++++++++
 .../platform/samsung/s5p-mfc/s5p_mfc_dec.c    | 16 +++++++-----
 .../platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c | 26 +++++++++++++++----
 3 files changed, 44 insertions(+), 12 deletions(-)

diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
index bb342200c2..95547e66fe 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
@@ -454,8 +454,15 @@ static void s5p_mfc_handle_frame(struct s5p_mfc_ctx *ctx,
 								list);
 		ctx->consumed_stream += s5p_mfc_hw_call(dev->mfc_ops,
 						get_consumed_stream, dev);
+		/*
+		 * Not for HEVC: v4l2_codec2 sends one access unit per buffer,
+		 * and the rerun passes the whole length again with the offset,
+		 * so the firmware reads past the data, and loops if it reports
+		 * nothing consumed.
+		 */
 		if (ctx->codec_mode != S5P_MFC_CODEC_H264_DEC &&
 			ctx->codec_mode != S5P_MFC_CODEC_VP8_DEC &&
+			ctx->codec_mode != S5P_MFC_CODEC_HEVC_DEC &&
 			ctx->consumed_stream + STUFF_BYTE <
 			src_buf->b->vb2_buf.planes[0].bytesused) {
 			/* Run MFC again on the same buffer */
@@ -587,6 +594,13 @@ static void s5p_mfc_handle_seq_done(struct s5p_mfc_ctx *ctx,
 				ctx->head_processed = 0;
 			else
 				ctx->head_processed = 1;
+		} else if (ctx->codec_mode == S5P_MFC_CODEC_VP8_DEC) {
+			/*
+			 * The buffer that carried the header is the first key
+			 * frame: decode it, rather than completing it unused and
+			 * decoding the next frames against an empty reference.
+			 */
+			ctx->head_processed = 0;
 		} else {
 			ctx->head_processed = 1;
 		}
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
index 13ef289a2a..d58bd002d8 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
@@ -928,7 +928,8 @@ static int vidioc_g_selection(struct file *file, void *priv,
 		mfc_err("Can not get compose information\n");
 		return -EINVAL;
 	}
-	if (ctx->src_fmt->fourcc == V4L2_PIX_FMT_H264) {
+	if (ctx->src_fmt->fourcc == V4L2_PIX_FMT_H264 ||
+	    ctx->src_fmt->fourcc == V4L2_PIX_FMT_HEVC) {
 		left = s5p_mfc_hw_call(dev->mfc_ops, get_crop_info_h, ctx);
 		right = left >> S5P_FIMV_SHARED_CROP_RIGHT_SHIFT;
 		left = left & S5P_FIMV_SHARED_CROP_LEFT_MASK;
@@ -1130,13 +1131,14 @@ static int s5p_mfc_queue_setup(struct vb2_queue *vq,
 			/*
 			 * The DPB is given to the MFC once every buffer has
 			 * been queued (their addresses come with the dmabufs),
-			 * so the client must be able to hold all of them at
-			 * once: Android's BufferQueue grants about 23. Keep a
-			 * margin above the DPB for the frames being displayed.
+			 * so the client must hold all of them at once. Android's
+			 * client asks for its whole pipeline (output delay + 9)
+			 * while the surface grants output delay + 7: give the
+			 * DPB and the four the client adds to it, which fits.
+			 * Asking for more waited for buffers that never came.
 			 */
-			*buf_count = min_t(unsigned int, ctx->pb_count + 8, 20);
-			if (*buf_count < ctx->pb_count)
-				*buf_count = ctx->pb_count;
+			*buf_count = clamp_t(unsigned int, *buf_count,
+					     ctx->pb_count, ctx->pb_count + 4);
 		} else if (*buf_count > ctx->pb_count + MFC_MAX_EXTRA_DPB) {
 			*buf_count = ctx->pb_count + MFC_MAX_EXTRA_DPB;
 		}
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
index f5c5123671..b48b693c03 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_opr_v6.c
@@ -253,6 +253,9 @@ static int s5p_mfc_alloc_codec_buffers_v6(struct s5p_mfc_ctx *ctx)
 		break;
 	case S5P_MFC_CODEC_HEVC_DEC:
 		mfc_debug(2, "Use min scratch buffer size\n");
+		/* Aligned, or the MV buffers placed after it eat the margin */
+		ctx->scratch_buf_size = ALIGN(ctx->scratch_buf_size,
+				S5P_FIMV_SCRATCH_BUFFER_ALIGN_V6);
 		ctx->bank1.size =
 			ctx->scratch_buf_size +
 			(ctx->mv_count * ctx->mv_size);
@@ -363,6 +366,12 @@ static int s5p_mfc_alloc_codec_buffers_v6(struct s5p_mfc_ctx *ctx)
 
 	/* Allocate only if memory from bank 1 is necessary */
 	if (ctx->bank1.size > 0) {
+		/*
+		 * The IOMMU aligns an allocation to its size: at least the
+		 * bank alignment, checked below, even for a small VP8 stream.
+		 */
+		ctx->bank1.size = max_t(size_t, ctx->bank1.size,
+					1 << MFC_BANK1_ALIGN_ORDER);
 		ret = s5p_mfc_alloc_generic_buf(dev, BANK_L_CTX, &ctx->bank1);
 		if (ret) {
 			mfc_err("Failed to allocate Bank1 memory\n");
@@ -486,6 +495,13 @@ static int calc_plane(int width, int height)
 static void s5p_mfc_dec_calc_dpb_size_v6(struct s5p_mfc_ctx *ctx)
 {
 	struct s5p_mfc_dev *dev = ctx->dev;
+	/*
+	 * HEVC pictures are made of 64x64 CTBs: size the planes for whole
+	 * ones, in case the firmware writes them (720 lines are 11.25 CTBs),
+	 * since a write past a buffer is a SysMMU fault.
+	 */
+	unsigned int height = ctx->codec_mode == S5P_MFC_CODEC_HEVC_DEC ?
+			      ALIGN(ctx->img_height, 64) : ctx->img_height;
 	ctx->buf_width = ALIGN(ctx->img_width, S5P_FIMV_NV12MT_HALIGN_V6);
 	ctx->buf_height = ALIGN(ctx->img_height, S5P_FIMV_NV12MT_VALIGN_V6);
 	ctx->chroma_size_1 = 0;
@@ -501,8 +517,8 @@ static void s5p_mfc_dec_calc_dpb_size_v6(struct s5p_mfc_ctx *ctx)
 		if (ctx->dst_contig)
 			ctx->stride[0] = ALIGN(ctx->img_width, 32);
 		ctx->stride[1] = ctx->stride[0];
-		ctx->luma_size = calc_plane(ctx->stride[0], ctx->img_height);
-		ctx->chroma_size = calc_plane(ctx->stride[1], (ctx->img_height / 2));
+		ctx->luma_size = calc_plane(ctx->stride[0], height);
+		ctx->chroma_size = calc_plane(ctx->stride[1], (height / 2));
 		break;
 	case V4L2_PIX_FMT_YUV420M:
 	case V4L2_PIX_FMT_YVU420M:
@@ -676,10 +692,10 @@ static int s5p_mfc_set_dec_frame_buffer_v6(struct s5p_mfc_ctx *ctx)
 
 	if (ctx->codec_mode == S5P_FIMV_CODEC_H264_DEC ||
 			ctx->codec_mode == S5P_FIMV_CODEC_H264_MVC_DEC ||
-			ctx->codec_mode == S5P_FIMV_CODEC_HEVC_DEC) {
+			ctx->codec_mode == S5P_FIMV_CODEC_HEVC_DEC)
 		writel(ctx->mv_size, mfc_regs->d_mv_buffer_size);
-		writel(ctx->mv_count, mfc_regs->d_num_mv);
-	}
+	/* Shared by the instances: a VP8 one would inherit a stale count. */
+	writel(ctx->mv_count, mfc_regs->d_num_mv);
 
 	frame_size = ctx->luma_size;
 	frame_size_ch = ctx->chroma_size;
-- 
2.47.3

