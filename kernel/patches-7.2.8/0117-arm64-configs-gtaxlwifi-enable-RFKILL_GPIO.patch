From 67c5625d78f39f3ff3dedf01605f53818e686e20 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 08:57:42 +0200
Subject: [PATCH] arm64: configs: gtaxlwifi: enable RFKILL_GPIO

The BCM4752 GPS enable line is described as an rfkill-gpio switch.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 arch/arm64/configs/gtaxlwifi_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/configs/gtaxlwifi_defconfig b/arch/arm64/configs/gtaxlwifi_defconfig
index c2d31aeffa..a08060e475 100644
--- a/arch/arm64/configs/gtaxlwifi_defconfig
+++ b/arch/arm64/configs/gtaxlwifi_defconfig
@@ -1511,7 +1511,7 @@ CONFIG_MAC80211_STA_HASH_MAX_SIZE=0
 CONFIG_RFKILL=m
 CONFIG_RFKILL_LEDS=y
 CONFIG_RFKILL_INPUT=y
-# CONFIG_RFKILL_GPIO is not set
+CONFIG_RFKILL_GPIO=m
 CONFIG_NET_9P=y
 CONFIG_NET_9P_FD=y
 # CONFIG_NET_9P_XEN is not set
-- 
2.47.3

