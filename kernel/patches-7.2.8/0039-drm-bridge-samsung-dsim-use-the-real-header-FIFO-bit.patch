From d5f8de2b2dc46c99998de1283e2381cc79d8bfc1 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 16 Aug 2026 12:00:00 +0000
Subject: [PATCH] drm/bridge: samsung-dsim: use the real header FIFO bits on
 exynos7870

The FIFOCTRL layout on the Exynos 7870 DSIM is not the classic
Exynos4/5 one this driver knows. The vendor header (decon_7870
regs-dsim.h) places the packet-header FIFO status at:

  bit 11      FULL_PH_SFR
  bit 10      EMPTY_PH_SFR
  bits 16-21  NUMBER_OF_PH_SFR (pending header count, 6 bits)

Bits 22 (SFR_HEADER_EMPTY) and 23 (SFR_HEADER_FULL) used by this
driver are reserved on 7870 and always read 0, which was measured on
the silicon (FIFOCTRL = 0x00001547 at rest: bit 22 clear with the
FIFO demonstrably empty, EMPTY_PH_SFR at bit 10 set, header count 0).

Because of that, no variant of wait_for_hdr_fifo can gate on the real
FIFO state on this SoC: checking bit 22 never succeeds and checking
bit 23 always succeeds immediately. Short writes complete as soon as
the header is queued, so a long init sequence (the 257-entry BOE2
table of the hx8279d panel) fills the 32-deep header FIFO after ~33
packets; the overflowing PKTHDR write ends in an asynchronous SError
and the SoC resets, deterministically.

Add per-variant header FIFO status bit positions, defaulting to the
legacy bits, and set 10/11 for exynos7870 with wait_for_hdr_fifo
enabled. This mirrors the vendor flow control: dsim_drv.c waits for
PH-FIFO-empty after every single header, so the queue never holds
more than one packet. On a stalled link the failure mode becomes the
"waiting for header FIFO timed out" log line instead of a bus abort.
---
 drivers/gpu/drm/bridge/samsung-dsim.c | 15 +++++++++++----
 include/drm/bridge/samsung-dsim.h     |  2 ++
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 18767b9454..ccc6319b2e 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -627,7 +627,9 @@ static const struct samsung_dsim_driver_data exynos7870_dsi_driver_data = {
 	.clk_data = exynos7870_clk_bulk_data,
 	.num_clks = ARRAY_SIZE(exynos7870_clk_bulk_data),
 	.max_freq = 1500,
-	.wait_for_hdr_fifo = 0,
+	.wait_for_hdr_fifo = 1,
+	.hdr_fifo_empty_bit = 10,
+	.hdr_fifo_full_bit = 11,
 	.wait_for_reset = 1,
 	.num_bits_resol = 12,
 	.video_mode_bit = 18,
@@ -1264,16 +1266,21 @@ static void samsung_dsim_set_display_enable(struct samsung_dsim *dsi, bool enabl
 
 static int samsung_dsim_wait_for_hdr_fifo(struct samsung_dsim *dsi)
 {
+	const struct samsung_dsim_driver_data *driver_data = dsi->driver_data;
+	u32 empty = driver_data->hdr_fifo_empty_bit ?
+		BIT(driver_data->hdr_fifo_empty_bit) : DSIM_SFR_HEADER_EMPTY;
+	u32 full = driver_data->hdr_fifo_full_bit ?
+		BIT(driver_data->hdr_fifo_full_bit) : DSIM_SFR_HEADER_FULL;
 	int timeout = 2000;
 
 	do {
 		u32 reg = samsung_dsim_read(dsi, DSIM_FIFOCTRL_REG);
 
-		if (!dsi->driver_data->has_broken_fifoctrl_emptyhdr) {
-			if (reg & DSIM_SFR_HEADER_EMPTY)
+		if (!driver_data->has_broken_fifoctrl_emptyhdr) {
+			if (reg & empty)
 				return 0;
 		} else {
-			if (!(reg & DSIM_SFR_HEADER_FULL)) {
+			if (!(reg & full)) {
 				/*
 				 * Wait a little bit, so the pending data can
 				 * actually leave the FIFO to avoid overflow.
diff --git a/include/drm/bridge/samsung-dsim.h b/include/drm/bridge/samsung-dsim.h
index abea54c06d..583734104d 100644
--- a/include/drm/bridge/samsung-dsim.h
+++ b/include/drm/bridge/samsung-dsim.h
@@ -66,6 +66,8 @@ struct samsung_dsim_driver_data {
 	unsigned int min_freq;
 	unsigned int max_freq;
 	unsigned int wait_for_hdr_fifo;
+	unsigned int hdr_fifo_empty_bit;
+	unsigned int hdr_fifo_full_bit;
 	unsigned int wait_for_reset;
 	unsigned int num_bits_resol;
 	unsigned int video_mode_bit;
-- 
2.47.3

