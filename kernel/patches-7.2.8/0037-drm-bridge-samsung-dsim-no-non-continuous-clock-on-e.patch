From c446f3134e9039baa1d274fcbf5e9ab34005a726 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 19:50:12 +0000
Subject: [PATCH] drm/bridge: samsung-dsim: no non-continuous clock on
 exynos7870 video mode

---
 drivers/gpu/drm/bridge/samsung-dsim.c | 11 ++++++++++-
 include/drm/bridge/samsung-dsim.h     |  1 +
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index b1fc9f8b17..18767b9454 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -623,6 +623,7 @@ static const struct samsung_dsim_driver_data exynos7870_dsi_driver_data = {
 	.has_clklane_stop = 1,
 	.has_sfrctrl = 1,
 	.has_pixel_porch = 1,
+	.clklane_stop_only = 1,
 	.clk_data = exynos7870_clk_bulk_data,
 	.num_clks = ARRAY_SIZE(exynos7870_clk_bulk_data),
 	.max_freq = 1500,
@@ -1132,7 +1133,15 @@ static int samsung_dsim_init_link(struct samsung_dsim *dsi)
 	 */
 	if (driver_data->has_clklane_stop &&
 	    dsi->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS) {
-		if (!samsung_dsim_hw_is_exynos(dsi->plat_data->hw_type))
+		/*
+		 * samsung_dsim_hw_is_exynos() stops at EXYNOS5433 and so does
+		 * not cover exynos7870, which is an Exynos all the same. Its
+		 * vendor driver only ever enables the non continuous clock in
+		 * command mode; in video mode it asks for clock lane stop and
+		 * start alone, and that is what the bootloader leaves behind.
+		 */
+		if (!samsung_dsim_hw_is_exynos(dsi->plat_data->hw_type) &&
+		    !driver_data->clklane_stop_only)
 			reg |= DSIM_NON_CONTINUOUS_CLKLANE;
 
 		reg |= DSIM_CLKLANE_STOP;
diff --git a/include/drm/bridge/samsung-dsim.h b/include/drm/bridge/samsung-dsim.h
index 109cdb5d83..abea54c06d 100644
--- a/include/drm/bridge/samsung-dsim.h
+++ b/include/drm/bridge/samsung-dsim.h
@@ -60,6 +60,7 @@ struct samsung_dsim_driver_data {
 	unsigned int has_broken_fifoctrl_emptyhdr:1;
 	unsigned int has_sfrctrl:1;
 	unsigned int has_pixel_porch:1;
+	unsigned int clklane_stop_only:1;
 	struct clk_bulk_data *clk_data;
 	unsigned int num_clks;
 	unsigned int min_freq;
-- 
2.47.3

