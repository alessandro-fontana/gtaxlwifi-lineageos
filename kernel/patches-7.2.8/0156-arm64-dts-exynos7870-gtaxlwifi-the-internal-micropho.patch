From 2215a51c6a19fe5a8ddc3b66ca6f552c35bcbad9 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 21:37:15 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: the internal microphone is
 differential

The main microphone is wired to IN3P and IN3N of the RT5659, and the
vendor kernel runs IN3 and IN4 in differential mode (IN3_IN4 reads
0xb580 while capturing). The driver has always parsed the two
properties; they were left out only because the YAML binding does not
list them yet.

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 9da6427ca1..53ccbf3a52 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -1822,9 +1822,10 @@ i2s_extcodec_bus: i2s-extcodec-bus-pins {
  * PMIC. IRQ su gpd3-7; il trigger e' quello dell'esempio del binding,
  * da rivedere nella campagna jack detection.
  *
- * Omesse per ora realtek,in3/in4-differential del downstream: il
- * binding mainline non le conosce (unevaluatedProperties: false) —
- * riguardano la cattura, da riaffrontare col microfono.
+ * IN3 e IN4 differenziali come nel downstream (IN3_IN4 = 0xb580 in
+ * cattura sul kernel Samsung): il microfono interno arriva su IN3P e
+ * IN3N. Il driver le legge da sempre; lo schema YAML del binding non
+ * le elenca ancora, e dtbs_check se ne lamentera'.
  */
 &i2c5 {
 	status = "okay";
@@ -1867,6 +1868,9 @@ audio_codec: audio-codec@1b {
 
 		realtek,ldo1-en-gpios = <&gpd3 2 GPIO_ACTIVE_HIGH>;
 		realtek,reset-gpios = <&gpd3 3 GPIO_ACTIVE_HIGH>;
+
+		realtek,in3-differential;
+		realtek,in4-differential;
 	};
 };
 
