From 790f85790508a40b353f9bee1b64097d30b3d011 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Wed, 12 Aug 2026 19:12:02 +0000
Subject: [PATCH] power: supply: sm5703-charger: expose the USB port type

The driver already works out what kind of port is attached in order to
pick the input current, so report it as well: reading USB_DCP is clearer
than inferring it from the current limit.

Also compare against the register rather than against the last value the
driver wrote when reapplying the limit, so that a limit changed behind
the driver's back is corrected on the next cable event instead of
persisting.
---
 drivers/power/supply/sm5703-charger.c | 180 ++++++++++++++++----------
 1 file changed, 115 insertions(+), 65 deletions(-)

diff --git a/drivers/power/supply/sm5703-charger.c b/drivers/power/supply/sm5703-charger.c
index 2df531dd63..cc017b75b4 100644
--- a/drivers/power/supply/sm5703-charger.c
+++ b/drivers/power/supply/sm5703-charger.c
@@ -98,6 +98,100 @@ static int sm5703_charger_get_field(struct sm5703_charger *chg,
 	return 0;
 }
 
+/*
+ * What the attached port is good for.  A dedicated charger gets whatever
+ * the board allows; the various host ports get what they are allowed to
+ * promise.  Anything unrecognised, or nothing attached at all, falls
+ * back to the least a source can offer, because guessing high is how a
+ * hub gets shut down.
+ *
+ * Without a MUIC there is nothing to ask, so the board limit is all
+ * there is to go on.
+ */
+static enum power_supply_usb_type
+sm5703_charger_usb_type(struct sm5703_charger *chg)
+{
+	if (!chg->edev)
+		return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_DCP) > 0)
+		return POWER_SUPPLY_USB_TYPE_DCP;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_CDP) > 0)
+		return POWER_SUPPLY_USB_TYPE_CDP;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_ACA) > 0)
+		return POWER_SUPPLY_USB_TYPE_ACA;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_SDP) > 0)
+		return POWER_SUPPLY_USB_TYPE_SDP;
+
+	return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+}
+
+static unsigned int sm5703_charger_wanted_current(struct sm5703_charger *chg)
+{
+	unsigned int wanted;
+
+	if (!chg->edev)
+		return chg->input_current_max;
+
+	switch (sm5703_charger_usb_type(chg)) {
+	case POWER_SUPPLY_USB_TYPE_DCP:
+		wanted = chg->input_current_max;
+		break;
+	case POWER_SUPPLY_USB_TYPE_CDP:
+		wanted = SM5703_INPUT_CURRENT_CDP;
+		break;
+	case POWER_SUPPLY_USB_TYPE_ACA:
+		wanted = SM5703_INPUT_CURRENT_ACA;
+		break;
+	default:
+		wanted = SM5703_INPUT_CURRENT_SDP;
+		break;
+	}
+
+	return min(wanted, chg->input_current_max);
+}
+
+/*
+ * Bring the hardware in line with what the attached port allows.
+ *
+ * The comparison is against the register rather than against what this
+ * driver last wrote, so that anything which changed the limit behind our
+ * back -- userspace, or the chip resetting itself on a cable event -- is
+ * corrected on the next event instead of persisting.
+ */
+static int sm5703_charger_apply_input_current(struct sm5703_charger *chg)
+{
+	unsigned int wanted = sm5703_charger_wanted_current(chg);
+	int ret, now;
+
+	ret = sm5703_charger_get_field(chg, SM5703_REG_VBUSCNTL,
+				       SM5703_VBUSCNTL_VBUSLIMIT,
+				       SM5703_INPUT_CURRENT_MIN,
+				       SM5703_INPUT_CURRENT_STEP, &now);
+	if (ret)
+		return ret;
+
+	chg->input_current_limit = wanted;
+
+	if ((unsigned int)now == wanted)
+		return 0;
+
+	ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
+				       SM5703_VBUSCNTL_VBUSLIMIT, wanted,
+				       SM5703_INPUT_CURRENT_MIN,
+				       SM5703_INPUT_CURRENT_MAX,
+				       SM5703_INPUT_CURRENT_STEP);
+	if (ret)
+		return ret;
+
+	dev_dbg(chg->dev, "Input current limit now %u uA\n", wanted);
+
+	return 1;
+}
+
 /*
  * Push the whole charging configuration into the chip.  This runs at
  * probe and again whenever the charger reports that it has restarted,
@@ -108,14 +202,8 @@ static int sm5703_charger_configure(struct sm5703_charger *chg)
 {
 	int ret;
 
-	ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
-				       SM5703_VBUSCNTL_VBUSLIMIT,
-				       min(chg->input_current_limit,
-					   chg->input_current_max),
-				       SM5703_INPUT_CURRENT_MIN,
-				       SM5703_INPUT_CURRENT_MAX,
-				       SM5703_INPUT_CURRENT_STEP);
-	if (ret)
+	ret = sm5703_charger_apply_input_current(chg);
+	if (ret < 0)
 		return ret;
 
 	ret = sm5703_charger_set_field(chg, SM5703_REG_CHGCNTL2,
@@ -305,6 +393,9 @@ static int sm5703_charger_get_property(struct power_supply *psy,
 						SM5703_TERM_CURRENT_MIN,
 						SM5703_TERM_CURRENT_STEP,
 						&val->intval);
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		val->intval = sm5703_charger_usb_type(chg);
+		return 0;
 	case POWER_SUPPLY_PROP_MODEL_NAME:
 		val->strval = "sm5703";
 		return 0;
@@ -387,12 +478,18 @@ static enum power_supply_property sm5703_charger_props[] = {
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
 	POWER_SUPPLY_PROP_CHARGE_TERM_CURRENT,
+	POWER_SUPPLY_PROP_USB_TYPE,
 	POWER_SUPPLY_PROP_MODEL_NAME,
 };
 
 static const struct power_supply_desc sm5703_charger_desc = {
 	.name			= "sm5703-charger",
 	.type			= POWER_SUPPLY_TYPE_USB,
+	.usb_types		= BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
+				  BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+				  BIT(POWER_SUPPLY_USB_TYPE_CDP) |
+				  BIT(POWER_SUPPLY_USB_TYPE_DCP) |
+				  BIT(POWER_SUPPLY_USB_TYPE_ACA),
 	.properties		= sm5703_charger_props,
 	.num_properties		= ARRAY_SIZE(sm5703_charger_props),
 	.get_property		= sm5703_charger_get_property,
@@ -400,58 +497,21 @@ static const struct power_supply_desc sm5703_charger_desc = {
 	.property_is_writeable	= sm5703_charger_property_is_writeable,
 };
 
-/*
- * Pick how much may be drawn from what the MUIC says is attached.  A
- * dedicated charger gets whatever the board allows; the various host
- * ports get what the USB specification lets them promise.  Anything
- * unrecognised, or nothing attached at all, falls back to the least a
- * source can offer, because guessing high is how a hub gets shut down.
- */
-static unsigned int sm5703_charger_extcon_current(struct sm5703_charger *chg)
-{
-	struct extcon_dev *edev = chg->edev;
-
-	if (extcon_get_state(edev, EXTCON_CHG_USB_DCP) > 0)
-		return chg->input_current_max;
-
-	if (extcon_get_state(edev, EXTCON_CHG_USB_CDP) > 0)
-		return SM5703_INPUT_CURRENT_CDP;
-
-	if (extcon_get_state(edev, EXTCON_CHG_USB_ACA) > 0)
-		return SM5703_INPUT_CURRENT_ACA;
-
-	return SM5703_INPUT_CURRENT_SDP;
-}
-
 static void sm5703_charger_extcon_work(struct work_struct *work)
 {
 	struct sm5703_charger *chg = container_of(work, struct sm5703_charger,
 						  extcon_work);
-	unsigned int current_limit;
 	int ret;
 
-	current_limit = min(sm5703_charger_extcon_current(chg),
-			    chg->input_current_max);
-
-	if (current_limit == chg->input_current_limit)
-		return;
-
-	ret = sm5703_charger_set_field(chg, SM5703_REG_VBUSCNTL,
-				       SM5703_VBUSCNTL_VBUSLIMIT,
-				       current_limit,
-				       SM5703_INPUT_CURRENT_MIN,
-				       SM5703_INPUT_CURRENT_MAX,
-				       SM5703_INPUT_CURRENT_STEP);
-	if (ret) {
+	ret = sm5703_charger_apply_input_current(chg);
+	if (ret < 0) {
 		dev_err(chg->dev, "Failed to set input current limit: %d\n",
 			ret);
 		return;
 	}
 
-	chg->input_current_limit = current_limit;
-	dev_dbg(chg->dev, "Input current limit now %u uA\n", current_limit);
-
-	power_supply_changed(chg->psy);
+	if (ret)
+		power_supply_changed(chg->psy);
 }
 
 static int sm5703_charger_extcon_notify(struct notifier_block *nb,
@@ -558,28 +618,18 @@ static int sm5703_charger_probe(struct platform_device *pdev)
 					 SM5703_INPUT_CURRENT_MIN,
 					 SM5703_INPUT_CURRENT_MAX);
 
+	/*
+	 * With no MUIC there is no way to tell a wall adapter from a host
+	 * port, and the board limit is all there is to go on.  With one,
+	 * the limit follows what it reports, starting from the least a
+	 * source can offer until it says otherwise.
+	 */
 	chg->edev = extcon_get_edev_by_phandle(dev, 0);
 	if (IS_ERR(chg->edev)) {
 		if (PTR_ERR(chg->edev) == -EPROBE_DEFER)
 			return -EPROBE_DEFER;
 
-		/*
-		 * No cable detection on this board.  The device tree is
-		 * then the only thing that knows what is safe to draw, so
-		 * take it at its word.
-		 */
 		chg->edev = NULL;
-		chg->input_current_limit = chg->input_current_max;
-	} else {
-		/*
-		 * Start low and let the first cable event raise it.  At
-		 * this point nothing has said what is on the other end of
-		 * the cable, and assuming a wall charger is how a host
-		 * port gets overdrawn.
-		 */
-		chg->input_current_limit = min_t(unsigned int,
-						 chg->input_current_max,
-						 SM5703_INPUT_CURRENT_SDP);
 	}
 
 	cfg.drv_data = chg;
-- 
