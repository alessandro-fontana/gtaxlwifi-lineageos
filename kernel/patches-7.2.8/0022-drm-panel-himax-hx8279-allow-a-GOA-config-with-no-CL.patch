From b5723269d5995561792011f7254d04ddcd05641d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 14:38:09 +0000
Subject: [PATCH] drm/panel: himax-hx8279: allow a GOA config with no CLR
 programming

---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index a87c749355..1005138215 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -872,8 +872,12 @@ static int hx8279_check_goa_config(struct hx8279 *hx, struct device *dev)
 		else
 			num_clr++;
 	}
-	if (!num_clr)
-		return -EINVAL;
+
+	/*
+	 * Leaving all of the CLR registers at their reset value is a valid
+	 * configuration: some panels only program the GOA lead/dummy timings
+	 * and rely on the DriverIC defaults for the clear signals.
+	 */
 
 	for (i = 0; i < ARRAY_SIZE(desc->goa_clr_polarity); i++) {
 		if (num_clr < 0)
-- 
2.47.3

