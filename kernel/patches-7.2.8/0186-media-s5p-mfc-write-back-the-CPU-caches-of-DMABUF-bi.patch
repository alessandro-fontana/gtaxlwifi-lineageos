From dcb383496554a63bf9e389c4056a3dd11799e66b Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 2 Oct 2026 11:37:19 +0200
Subject: [PATCH 186/187] media: s5p-mfc: write back the CPU caches of DMABUF
 bitstream buffers

vb2 keeps an imported DMABUF mapped from one QBUF to the next, so the
cache maintenance of dma_buf_map_attachment() happens once, when the
buffer is first queued. A client that fills a bitstream buffer through a
cached mapping without DMA_BUF_IOCTL_SYNC, as Android's Codec2 does with
the linear blocks of the system heap, leaves the data in the CPU caches,
and the MFC reads whatever the memory held before: an earlier frame.

On Exynos7870 this corrupted most decodes of the same H.264 file with
B-frames, at a different frame each time, from there to the end since
the broken picture is a reference; an MPEG-4 picture was now and then
reported as consumed in part, and the rerun on the rest failed with
"header not found" (0x66). Slowing the client down hid it.

Write the CPU caches of an OUTPUT DMABUF back in buf_prepare, before
every decode. With it, 35 runs of H.264 (B-pyramid, three references),
MPEG-4 Simple and H.263 out of 35 decode identical to ffmpeg, frame by
frame, against 1 to 4 out of 5 corrupted before.

---
 .../media/platform/samsung/s5p-mfc/s5p_mfc.c  |  1 +
 .../platform/samsung/s5p-mfc/s5p_mfc_dec.c    | 20 +++++++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
index a9e48e559e..9f47ef9dd7 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
@@ -1875,6 +1875,7 @@ static struct platform_driver s5p_mfc_driver = {
 module_platform_driver(s5p_mfc_driver);
 
 MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("DMA_BUF");
 MODULE_AUTHOR("Kamil Debski <k.debski@samsung.com>");
 MODULE_DESCRIPTION("Samsung S5P Multi Format Codec V4L2 driver");
 
diff --git a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
index df071c5957..1ffe506752 100644
--- a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
+++ b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc_dec.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/dma-buf.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/module.h>
@@ -1382,6 +1383,24 @@ static void s5p_mfc_stop_streaming(struct vb2_queue *q)
 }
 
 
+/*
+ * vb2 keeps an imported DMABUF mapped from one QBUF to the next, so nothing
+ * writes back the CPU caches of a bitstream buffer that the client filled
+ * through a cached mapping without DMA_BUF_IOCTL_SYNC, as Codec2 does with
+ * its linear blocks. The MFC then reads stale bytes: corrupted references,
+ * or a picture consumed only in part. Write them back before every decode.
+ */
+static int s5p_mfc_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+
+	if (vq->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE &&
+	    vq->memory == VB2_MEMORY_DMABUF && vb->planes[0].dbuf)
+		return dma_buf_end_cpu_access(vb->planes[0].dbuf,
+					      DMA_TO_DEVICE);
+	return 0;
+}
+
 static void s5p_mfc_buf_queue(struct vb2_buffer *vb)
 {
 	struct vb2_queue *vq = vb->vb2_queue;
@@ -1429,6 +1448,7 @@ static void s5p_mfc_buf_queue(struct vb2_buffer *vb)
 static const struct vb2_ops s5p_mfc_dec_qops = {
 	.queue_setup		= s5p_mfc_queue_setup,
 	.buf_init		= s5p_mfc_buf_init,
+	.buf_prepare		= s5p_mfc_buf_prepare,
 	.start_streaming	= s5p_mfc_start_streaming,
 	.stop_streaming		= s5p_mfc_stop_streaming,
 	.buf_queue		= s5p_mfc_buf_queue,
-- 
