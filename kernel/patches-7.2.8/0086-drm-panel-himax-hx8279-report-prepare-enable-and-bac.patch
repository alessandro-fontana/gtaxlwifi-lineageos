From 846dbe7c8bb2845ee6c57980041389569f3b76c4 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 10 Sep 2026 07:04:17 +0000
Subject: [PATCH] drm/panel: himax-hx8279: report prepare, enable and backlight
 writes

Diagnostic prints for the gtaxlwifi wake-up campaign: on a few wake-ups
out of thirty the panel comes back dimmer than requested, once with
horizontal lines, and the current driver leaves no trace of either.

Say, in dmesg, what the panel actually received and in which order:
prepare() entry (cold start or bootloader handoff, backlight cache and
power state), the result and duration of the init table and exit-sleep,
display on/off with their accumulated error (enable() and disable()
currently ignore it), enter-sleep in unprepare(), and every backlight
update: requested and effective brightness, DriverIC duty, page switch,
write result and the task that issued it, so that the modeset
(backlight_enable from the DRM commit) and the Android lights HAL can be
told apart.

No functional change.
---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 36 +++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index 9b0f04bd87..0413745076 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -12,7 +12,9 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/ktime.h>
 #include <linux/mutex.h>
+#include <linux/sched.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -672,6 +674,7 @@ static int hx8279_bl_update_status(struct backlight_device *bl)
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = hx->dsi[0] };
 	u16 brightness = backlight_get_brightness(bl);
 	u8 cmd_set_bl[2] = { HX8279_P4_REG_BRIGHTNESS, 0 };
+	u8 last_page;
 
 	/*
 	 * The DriverIC duty is linear in the requested brightness, capped
@@ -683,12 +686,25 @@ static int hx8279_bl_update_status(struct backlight_device *bl)
 
 	guard(mutex)(&hx->page_lock);
 
-	if (!hx->prepared)
+	if (!hx->prepared) {
+		dev_info(&hx->dsi[0]->dev,
+			 "bl: skipped, not prepared: req %d eff %u duty %u power %d state %#x from %s[%d]\n",
+			 bl->props.brightness, brightness, cmd_set_bl[1],
+			 bl->props.power, bl->props.state,
+			 current->comm, task_pid_nr(current));
 		return 0;
+	}
 
+	last_page = hx->last_page;
 	hx8279_set_page(hx, &dsi_ctx, 4);
 	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_set_bl, ARRAY_SIZE(cmd_set_bl));
 
+	dev_info(&hx->dsi[0]->dev,
+		 "bl: req %d eff %u duty %u power %d state %#x page %u->%u err %d from %s[%d]\n",
+		 bl->props.brightness, brightness, cmd_set_bl[1],
+		 bl->props.power, bl->props.state, last_page, hx->last_page,
+		 dsi_ctx.accum_err, current->comm, task_pid_nr(current));
+
 	return dsi_ctx.accum_err;
 }
 
@@ -918,6 +934,8 @@ static int hx8279_disable(struct drm_panel *panel)
 
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 
+	dev_info(&dsi->dev, "disable: display off, err %d\n", dsi_ctx.accum_err);
+
 	return 0;
 }
 
@@ -929,6 +947,8 @@ static int hx8279_enable(struct drm_panel *panel)
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
+	dev_info(&dsi->dev, "enable: display on, err %d\n", dsi_ctx.accum_err);
+
 	return 0;
 }
 
@@ -939,6 +959,13 @@ static int hx8279_prepare(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 	int ret;
+	ktime_t t0 = ktime_get();
+
+	dev_info(&dsi->dev, "prepare: %s, bl cache %d power %d state %#x\n",
+		 hx->handoff ? "bootloader handoff" : "cold start",
+		 hx->panel.backlight ? hx->panel.backlight->props.brightness : -1,
+		 hx->panel.backlight ? hx->panel.backlight->props.power : -1,
+		 hx->panel.backlight ? hx->panel.backlight->props.state : 0);
 
 	if (hx->handoff) {
 		/*
@@ -1024,6 +1051,8 @@ static int hx8279_prepare(struct drm_panel *panel)
 	mutex_unlock(&hx->page_lock);
 
 	if (ret) {
+		dev_info(&dsi->dev, "prepare: init table failed %d after %lld ms\n",
+			 ret, ktime_ms_delta(ktime_get(), t0));
 		hx8279_power_off(hx);
 		return ret;
 	}
@@ -1031,6 +1060,9 @@ static int hx8279_prepare(struct drm_panel *panel)
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 130);
 
+	dev_info(&dsi->dev, "prepare: done, err %d, last_page %u, %lld ms\n",
+		 dsi_ctx.accum_err, hx->last_page, ktime_ms_delta(ktime_get(), t0));
+
 	return dsi_ctx.accum_err;
 }
 
@@ -1051,6 +1083,8 @@ static int hx8279_unprepare(struct drm_panel *panel)
 	if (hx->dsi[1])
 		hx->dsi[1]->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
+	dev_info(&dsi->dev, "unprepare: enter sleep, err %d\n", dsi_ctx.accum_err);
+
 	hx8279_power_off(hx);
 
 	return dsi_ctx.accum_err;
-- 
2.47.3

