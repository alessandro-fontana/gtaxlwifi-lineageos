From c420bb2da95149b4edf1fc7691561c8f0f81ff54 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 16:48:27 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: front camera rotation

Measured with the tablet upright in its natural (portrait) orientation:
in the raw frame the top of the scene is on the right, so the sensor is
mounted rotated by 90 degrees and Android has to rotate by 270.

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 006b8261ed..d9d6132763 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -2539,6 +2539,12 @@ camera@30 {
 		enable-gpios = <&gpa1 5 GPIO_ACTIVE_HIGH>;
 
 		orientation = <0>;
+		/*
+		 * Misurata (§57): col tablet in piedi nell'orientamento
+		 * naturale (verticale), nel fotogramma grezzo l'alto della
+		 * scena sta a destra; Android deve ruotarlo di 270 gradi.
+		 */
+		rotation = <90>;
 
 		port {
 			sr259_out: endpoint {
-- 
2.47.3

