From 841500c733107967dcb1ddd3c789560b010aea22 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 10:05:00 +0000
Subject: [PATCH] dt-bindings: iio: adc: samsung: add Exynos7870 ADC

The ADC block on Exynos7870 needs its own compatible: it is held in
reset unless the reset is explicitly released, and its conversion result
is not where the other variants keep it.

Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 .../devicetree/bindings/iio/adc/samsung,exynos-adc.yaml          | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml b/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
index def879f6ed..26a327a110 100644
--- a/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
+++ b/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
@@ -18,6 +18,7 @@ properties:
           - samsung,exynos3250-adc
           - samsung,exynos4212-adc                # Exynos4212 and Exynos4412
           - samsung,exynos7-adc
+          - samsung,exynos7870-adc
           - samsung,s3c6410-adc
           - samsung,s5pv210-adc
       - items:
-- 
2.47.3

