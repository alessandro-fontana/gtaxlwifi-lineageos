From c23819b73207f399b35ba02f2e4cfe5bc783e4ca Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 29 Sep 2026 21:07:45 +0200
Subject: [PATCH] arm64: dts: exynos7870: add the CPU cluster 0 watchdog

The same block and PMU wiring as Exynos7, at the address, interrupt and
clock of the vendor device tree (clock 160 there is wdt_cpucl0). A total
freeze stops the kernel's pings and the watchdog resets the SoC, where
otherwise only a power cycle helps.

---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index 764a8c62b2..f49592a5d0 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -314,6 +314,16 @@ tmu: thermal-sensor@10130000 {
 			#thermal-sensor-cells = <0>;
 		};
 
+		watchdog_cl0: watchdog@10170000 {
+			compatible = "samsung,exynos7-wdt";
+			reg = <0x10170000 0x100>;
+			interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_peri CLK_GOUT_PERI_WDT_CPUCL0_PCLK>;
+			clock-names = "watchdog";
+			samsung,syscon-phandle = <&pmu_system_controller>;
+			timeout-sec = <30>;
+		};
+
 		cmu_peri: clock-controller@101f0000 {
 			compatible = "samsung,exynos7870-cmu-peri";
 			reg = <0x101f0000 0x1000>;
-- 
2.47.3

