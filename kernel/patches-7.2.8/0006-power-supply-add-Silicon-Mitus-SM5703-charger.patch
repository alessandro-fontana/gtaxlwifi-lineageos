From a70aa48f937f6a615234831d4b75f3b6494ef5c5 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 11 Aug 2026 20:39:23 +0000
Subject: [PATCH] power: supply: add Silicon Mitus SM5703 charger

Add a driver for the charger block of the SM5703 PMIC.  It reports
whether a charger is connected and what the charging state is, and
programs the input current limit, the charging current, the battery
regulation voltage and the termination current.

The chip cannot identify the charging port on its own: that is the
MUIC's job, and without a driver for it the chip falls back to 450 mA,
which on a tablet is less than the system draws.  The input current
limit therefore comes from the device tree, and is reapplied whenever
the charger restarts, because plugging a cable in makes the hardware
revert to its own value.
---
 .../supply/siliconmitus,sm5703-charger.yaml   |  57 ++
 drivers/power/supply/Kconfig                  |  12 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/sm5703-charger.c         | 524 ++++++++++++++++++
 4 files changed, 594 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
 create mode 100644 drivers/power/supply/sm5703-charger.c

diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
new file mode 100644
index 0000000000..1e8cdd7c26
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5703-charger.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5703-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5703 charger
+
+maintainers:
+  - Linux battery maintainers <linux-pm@vger.kernel.org>
+
+description:
+  The charger block of the Silicon Mitus SM5703 PMIC.  It is a child of
+  the PMIC node described by siliconmitus,sm5703.yaml and shares that
+  node's I2C address.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5703-charger
+
+  monitored-battery: true
+
+  enable-gpios:
+    maxItems: 1
+    description:
+      GPIO connected to the nCHGEN pin, which gates the charging path.
+      The pin is active low in hardware, so this is normally declared
+      GPIO_ACTIVE_LOW.
+
+  input-current-limit-microamp:
+    description:
+      Maximum current drawn from the charging port.  The charger cannot
+      identify the port on its own, so this applies to every source and
+      must not exceed what the least capable one can supply.
+    default: 500000
+    minimum: 100000
+    maximum: 2100000
+
+required:
+  - compatible
+  - monitored-battery
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    charger {
+        compatible = "siliconmitus,sm5703-charger";
+        monitored-battery = <&battery>;
+        enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
+        input-current-limit-microamp = <1650000>;
+    };
