From b5fd753c519ac82cdc4a34ac520e4238aaf23dc3 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 21:37:23 +0200
Subject: [PATCH] ASoC: samsung: s1402x: send the codec data to the AP on
 capture

DOUTMX1 selects what the AP port of the mixer transmits to the CPU,
and its reset value is DMIX_OUT, the output of the mixer: the playback
stream looped back. Nothing wrote it, so capture always returned the
playback data, which is exact zeros when nothing plays. The vendor
selects AIF4IN, the data returning from the codec, for every AP route.

Tested on the Galaxy Tab A 10.1 (2016): exact zeros before, and the
internal microphone at the same level as the vendor kernel once
DOUTMX1 is written.

---
 sound/soc/samsung/s1402x.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/sound/soc/samsung/s1402x.c b/sound/soc/samsung/s1402x.c
index de6f661f5e..da87a25f0d 100644
--- a/sound/soc/samsung/s1402x.c
+++ b/sound/soc/samsung/s1402x.c
@@ -51,6 +51,7 @@
 #define S1402X_0F_DIG_EN		0x3c
 #define S1402X_10_DMIX1			0x40
 #define S1402X_11_DMIX2			0x44
+#define S1402X_16_DOUTMX1		0x58
 #define S1402X_18_INAMP_CTL		0x60
 #define S1402X_19_OUTAP1_CTL		0x64
 #define S1402X_1A_OUTCP1_CTL		0x68
@@ -109,6 +110,10 @@
 #define DMIX1_MIX_LVL1_SHIFT		0
 #define DMIX1_MIX_LVL1_MASK		0x7
 
+/* S1402X_16_DOUTMX1: what the AP port transmits to the CPU */
+#define DOUTMX1_SEL_DMIX_OUT		0
+#define DOUTMX1_SEL_AIF4IN		1
+
 /* S1402X_18_INAMP_CTL (return path codec -> mixer, 64fs 24bit) */
 #define INAMP_CTL_LRCLK_POL_SHIFT	7
 #define INAMP_CTL_BCK_POL_SHIFT		6
@@ -207,6 +212,14 @@ static void s1402x_init(struct s1402x_priv *priv)
 	 */
 	regmap_write(priv->regmap, S1402X_10_DMIX1, DMIX1_MIX_EN1);
 
+	/*
+	 * Capture: send the AP the data coming back from the codec.  The
+	 * reset value is the output of the mixer itself, i.e. the playback
+	 * stream, which is silence whenever nothing plays; the vendor
+	 * selects AIF4IN for every AP route.
+	 */
+	regmap_write(priv->regmap, S1402X_16_DOUTMX1, DOUTMX1_SEL_AIF4IN);
+
 	s1402x_reset_data(priv);
 }
 
