From 6639ca6ddf0203744ad1e660cdd56fed0f6291ad Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 17:15:54 +0200
Subject: [PATCH] arm64: dts: exynos7870-gtaxlwifi: rear camera rotation is 270

Measured with the preview: 90, taken from the front camera, shows the
scene upside down.

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index 54c0d73ef7..30672365a8 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -2648,11 +2648,13 @@ camera@37 {
 
 		orientation = <1>;
 		/*
-		 * Misurata (§57): come per l'anteriore, col tablet in piedi
-		 * nell'orientamento naturale l'alto della scena sta a destra
-		 * nel fotogramma grezzo; Android lo ruota di 270 gradi.
+		 * Misurata (§57): al contrario dell'anteriore, col tablet in
+		 * piedi nell'orientamento naturale l'alto della scena sta a
+		 * sinistra nel fotogramma grezzo; Android lo ruota di 90
+		 * gradi. Il primo valore (90, copiato dall'anteriore) dava
+		 * l'anteprima capovolta.
 		 */
-		rotation = <90>;
+		rotation = <270>;
 		lens-focus = <&rear_vcm>;
 
 		port {
-- 
2.47.3

