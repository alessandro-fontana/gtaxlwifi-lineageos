From dab0b808c7eb9c8c781225a0cd617aec20a7ca44 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 27 Sep 2026 12:36:29 +0200
Subject: [PATCH] arm64: dts: exynos7870: reserve 16 MiB of MFC IOVA below the
 pool

The MFC addresses its buffers as offsets from the firmware, which sits
at the start of the context pool, so nothing may be mapped below it.
The driver now allocates a 16 MiB pool under 32 MiB: reserve the bottom
16 MiB, so that the pool sits right on top of the reservation and no
video buffer can land below it.

---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index caa2a9e352..9c2debfc1f 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -243,9 +243,11 @@ reserved-memory {
 		 * buffers as offsets from its base, so nothing may be mapped
 		 * below it. Reserving the bottom of the MFC's IOVA space puts
 		 * the firmware right above it and every later buffer higher.
+		 * 16 MiB, so that the driver's 16 MiB pool, allocated under
+		 * 32 MiB, sits right on top of it.
 		 */
 		mfc_iova: mfc-iova {
-			iommu-addresses = <&mfc 0x0 0x800000>;
+			iommu-addresses = <&mfc 0x0 0x1000000>;
 		};
 	};
 
