From 76afb3da341a52dd127a2a3cd9cc9efdca97633b Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Mon, 28 Sep 2026 18:41:29 +0200
Subject: [PATCH] mmc: dw_mmc-exynos, arm64: dts: exynos7870-gtaxlwifi: run the
 eMMC in HS400

Take the vendor kernel's HS400 settings: hs400-timing <0 4> (its
ddr200-timing <1 0 4 0> in the four-cell format, same divider),
read-strobe-delay 0x75, and the write CRC status timer for DDR200
(fastlimit 0x34, initval 0x38), which the driver now accepts as two
optional properties; the bootloader leaves 0x13/0x15, set for the speeds
it runs at. HS400_DQS_EN and HS400_DLINE_CTRL end up as the vendor kernel
programs them. Enhanced Strobe, which the vendor used, is not supported
by dw_mmc: this is HS400 after HS200 tuning.

Sequential reads go from 58-158 MB/s (HS200) to 176-228 MB/s; two full
reads of super hash identically, 1 GiB written to /data reads back
identical, five boots in a row come up in HS400 with no bus errors.

---
 .../boot/dts/exynos/exynos7870-gtaxlwifi.dts   | 18 ++++++++++++++++++
 drivers/mmc/host/dw_mmc-exynos.c               | 18 ++++++++++++++++++
 drivers/mmc/host/dw_mmc-exynos.h               |  4 ++++
 3 files changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
index a367876f55..e410bb7127 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi.dts
@@ -1385,6 +1385,24 @@ &mmc0 {
 	cap-mmc-highspeed;
 	mmc-hs200-1_8v;
 
+	/*
+	 * HS400, with the vendor kernel's values. Its four-cell timings are
+	 * <ciu-div fine-drive drive sample>, mainline's two cells are
+	 * <sample drive> with HS400_FIXED_CIU_CLK_DIV (1) as divider:
+	 * ddr200-timing <1 0 4 0> is <0 4> here, with the same divider. The
+	 * CIU runs at 800 MHz as in HS200 (the driver asks twice the rate),
+	 * the card clock at 200 MHz on both edges. ddr200-delay-line 0x75 is
+	 * the same RD_DQS_DELAY field of HS400_DLINE_CTRL. The write CRC
+	 * status timer is the vendor's DDR200 value; the bootloader leaves
+	 * 0x13/0x15. The vendor also used Enhanced Strobe, which the mainline
+	 * dw_mmc lacks: this is plain HS400, entered after HS200 tuning.
+	 */
+	mmc-hs400-1_8v;
+	samsung,dw-mshc-hs400-timing = <0 4>;
+	samsung,read-strobe-delay = <0x75>;
+	samsung,dw-mshc-txdt-crc-timer-fastlimit = <0x34>;
+	samsung,dw-mshc-txdt-crc-timer-initval = <0x38>;
+
 	/*
 	 * Timing nel formato MAINLINE a due celle: dw_mci_exynos_parse_dt()
 	 * fa of_property_read_u32_array(..., timing, 2) e poi
diff --git a/drivers/mmc/host/dw_mmc-exynos.c b/drivers/mmc/host/dw_mmc-exynos.c
index 4b76b997dd..61e6b6c13a 100644
--- a/drivers/mmc/host/dw_mmc-exynos.c
+++ b/drivers/mmc/host/dw_mmc-exynos.c
@@ -44,6 +44,9 @@ struct dw_mci_exynos_priv_data {
 	u32				dqs_delay;
 	u32				saved_dqs_en;
 	u32				saved_strobe_ctrl;
+	/* write CRC status timer for HS400, 0 = keep what the bootloader set */
+	u32				txdt_crc_fastlimit;
+	u32				txdt_crc_initval;
 };
 
 static struct dw_mci_exynos_compatible {
@@ -287,6 +290,16 @@ static void dw_mci_exynos_config_hs400(struct dw_mci *host, u32 timing)
 	if (timing == MMC_TIMING_MMC_HS400) {
 		dqs |= DATA_STROBE_EN;
 		strobe = DQS_CTRL_RD_DELAY(strobe, priv->dqs_delay);
+		/*
+		 * The bootloader leaves the write CRC status timer tuned for
+		 * the speeds it runs at; the vendor kernel sets it for DDR200
+		 * together with the other HS400 settings.
+		 */
+		if (priv->txdt_crc_fastlimit || priv->txdt_crc_initval) {
+			dqs &= ~TXDT_CRC_TIMER_SET(0xff, 0xff);
+			dqs |= TXDT_CRC_TIMER_SET(priv->txdt_crc_fastlimit,
+						  priv->txdt_crc_initval);
+		}
 	} else if (timing == MMC_TIMING_UHS_SDR104) {
 		dqs &= 0xffffff00;
 	} else {
@@ -421,6 +434,11 @@ static int dw_mci_exynos_parse_dt(struct dw_mci *host)
 
 	priv->hs400_timing = SDMMC_CLKSEL_TIMING(timing[0], timing[1],
 						HS400_FIXED_CIU_CLK_DIV);
+
+	of_property_read_u32(np, "samsung,dw-mshc-txdt-crc-timer-fastlimit",
+			     &priv->txdt_crc_fastlimit);
+	of_property_read_u32(np, "samsung,dw-mshc-txdt-crc-timer-initval",
+			     &priv->txdt_crc_initval);
 	host->priv = priv;
 	return 0;
 }
diff --git a/drivers/mmc/host/dw_mmc-exynos.h b/drivers/mmc/host/dw_mmc-exynos.h
index 0280d394a3..1673942938 100644
--- a/drivers/mmc/host/dw_mmc-exynos.h
+++ b/drivers/mmc/host/dw_mmc-exynos.h
@@ -33,6 +33,10 @@
 /* RCLK_EN register defines */
 #define DATA_STROBE_EN			BIT(0)
 #define AXI_NON_BLOCKING_WR	BIT(7)
+#define TXDT_CRC_TIMER_FASTLIMIT(x)	(((x) & 0xFF) << 16)
+#define TXDT_CRC_TIMER_INITVAL(x)	(((x) & 0xFF) << 8)
+#define TXDT_CRC_TIMER_SET(x, y)	(TXDT_CRC_TIMER_FASTLIMIT(x) | \
+					 TXDT_CRC_TIMER_INITVAL(y))
 
 /* DLINE_CTRL register defines */
 #define DQS_CTRL_RD_DELAY(x, y)		(((x) & ~0x3FF) | ((y) & 0x3FF))
-- 
2.47.3

