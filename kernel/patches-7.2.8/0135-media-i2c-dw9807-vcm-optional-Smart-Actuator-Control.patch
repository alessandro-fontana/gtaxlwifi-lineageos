From dd5c2d0b4e1326befd34fc09c09c2fd09277b85a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 17:53:27 +0200
Subject: [PATCH] media: i2c: dw9807-vcm: optional Smart Actuator Control

In direct mode the lens rings after every step: on the Galaxy Tab A 10.1
(2016) the contrast takes six to seven frames to settle, which makes a
contrast autofocus sweep slow or wrong. Add optional device tree
properties for the ringing control, the SAC mode, its prescaler and
period, as the vendor driver programs them; without them the device
stays in direct mode as before.

---
 .../media/i2c/dongwoon,dw9807-vcm.yaml        | 19 +++++++++
 drivers/media/i2c/dw9807-vcm.c                | 42 +++++++++++++++++++
 2 files changed, 61 insertions(+)

diff --git a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9807-vcm.yaml b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9807-vcm.yaml
index 47aeeda685..3cde6ae4ec 100644
--- a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9807-vcm.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9807-vcm.yaml
@@ -24,6 +24,25 @@ properties:
   vdd-supply:
     description: Power supply of the device.
 
+  dongwoon,sac-mode:
+    description:
+      Enables the ringing control and selects the Smart Actuator Control
+      mode, MODE[7:5]; direct mode when absent.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+
+  dongwoon,vcm-prescale:
+    description: Prescaler of the SAC period, MODE[2:0].
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    default: 0
+
+  dongwoon,sac-timing:
+    description: SAC period, 6.3 ms + value * 0.1 ms.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 0x3f
+    default: 0x20
+
 required:
   - compatible
   - reg
diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 700f448e78..3166ff8395 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -7,6 +7,7 @@
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
@@ -39,6 +40,11 @@
 
 #define MAX_RETRY		10
 
+#define DW9807_CTL_RING_EN	BIT(1)
+#define DW9807_MODE_SAC_SHIFT	5
+#define DW9807_MODE_PRESC_MASK	0x07
+#define DW9807_SACT_MASK	0x3f
+
 /* From supply on to the first I2C command */
 #define DW9807_PWR_ON_DELAY_US	5000
 
@@ -47,6 +53,10 @@ struct dw9807_device {
 	struct v4l2_subdev sd;
 	struct regulator *vdd;
 	bool online;
+	/* Smart Actuator Control, from the device tree; direct mode if unset */
+	bool sac;
+	u8 mode;
+	u8 sact;
 	u16 current_val;
 };
 
@@ -189,6 +199,7 @@ static int dw9807_init_controls(struct dw9807_device *dev_vcm)
 static int dw9807_probe(struct i2c_client *client)
 {
 	struct dw9807_device *dw9807_dev;
+	u32 val;
 	int rval;
 
 	dw9807_dev = devm_kzalloc(&client->dev, sizeof(*dw9807_dev),
@@ -201,6 +212,24 @@ static int dw9807_probe(struct i2c_client *client)
 		return dev_err_probe(&client->dev, PTR_ERR(dw9807_dev->vdd),
 				     "failed to get vdd regulator\n");
 
+	/*
+	 * Optional Smart Actuator Control: the lens settles in one SAC period
+	 * instead of ringing for several frames. The values depend on the
+	 * resonance of the actuator, hence on the module.
+	 */
+	if (!device_property_read_u32(&client->dev, "dongwoon,sac-mode", &val)) {
+		u32 presc = 0, sact = 0x20;
+
+		device_property_read_u32(&client->dev, "dongwoon,vcm-prescale",
+					 &presc);
+		device_property_read_u32(&client->dev, "dongwoon,sac-timing",
+					 &sact);
+		dw9807_dev->sac = true;
+		dw9807_dev->mode = (val << DW9807_MODE_SAC_SHIFT) |
+				   (presc & DW9807_MODE_PRESC_MASK);
+		dw9807_dev->sact = sact & DW9807_SACT_MASK;
+	}
+
 	rval = regulator_enable(dw9807_dev->vdd);
 	if (rval)
 		return rval;
@@ -315,6 +344,19 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 		return 0;
 	}
 
+	if (dw9807_dev->sac) {
+		const char ring[2] = { DW9807_CTL_ADDR, DW9807_CTL_RING_EN };
+		const char mode[2] = { DW9807_MODE_ADDR, dw9807_dev->mode };
+		const char sact[2] = { DW9807_RESONANCE_ADDR, dw9807_dev->sact };
+
+		/* 100 us from power on to the mode registers */
+		usleep_range(100, 200);
+		if (i2c_master_send(client, ring, sizeof(ring)) < 0 ||
+		    i2c_master_send(client, mode, sizeof(mode)) < 0 ||
+		    i2c_master_send(client, sact, sizeof(sact)) < 0)
+			dev_err(&client->dev, "failed to set the SAC mode\n");
+	}
+
 	for (val = dw9807_dev->current_val % DW9807_CTRL_STEPS;
 	     val < dw9807_dev->current_val + DW9807_CTRL_STEPS - 1;
 	     val += DW9807_CTRL_STEPS) {
-- 
2.47.3

