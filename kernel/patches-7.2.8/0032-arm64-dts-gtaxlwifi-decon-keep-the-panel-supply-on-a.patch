From 5db0ada31145703e300f01048fdd16b86db1e117 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 15 Aug 2026 17:30:00 +0000
Subject: [PATCH] arm64: dts: gtaxlwifi-decon: keep the panel supply on at boot

---
 arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts
index f20ebb48de..c0bf32be83 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtaxlwifi-decon.dts
@@ -40,6 +40,7 @@ / {
 	lcd_buck: regulator-lcd-buck {
 		compatible = "regulator-fixed";
 		regulator-name = "vdd_lcd_buck";
+		regulator-boot-on;
 		regulator-min-microvolt = <5000000>;
 		regulator-max-microvolt = <5000000>;
 		gpio = <&gpd3 4 GPIO_ACTIVE_HIGH>;
-- 
2.47.3

