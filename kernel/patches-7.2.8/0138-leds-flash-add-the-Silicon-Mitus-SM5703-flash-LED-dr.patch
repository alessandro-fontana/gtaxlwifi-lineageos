From 739c341e167a19920f5ead489348412b8ed642ce Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 19:35:49 +0200
Subject: [PATCH] leds: flash: add the Silicon Mitus SM5703 flash LED driver

The SM5703 drives a flash LED from its boost converter: movie mode for
the torch, flash mode for the strobe, switched over I2C. The operation
mode, shared with the charger, goes to boost while the LED is on (unless
VBUS feeds the torch) and is restored afterwards. The chip's absolute
timer bounds the flash at 1.6 s; the strobe timeout is done in software.
Register it as a cell of the SM5703 MFD.

---
 drivers/leds/flash/Kconfig       |   7 +
 drivers/leds/flash/Makefile      |   1 +
 drivers/leds/flash/leds-sm5703.c | 373 +++++++++++++++++++++++++++++++
 drivers/mfd/sm5703.c             |   2 +
 4 files changed, 383 insertions(+)
 create mode 100644 drivers/leds/flash/leds-sm5703.c

diff --git a/drivers/leds/flash/Kconfig b/drivers/leds/flash/Kconfig
index 9b6dd3f1ff..5f47b2808d 100644
--- a/drivers/leds/flash/Kconfig
+++ b/drivers/leds/flash/Kconfig
@@ -103,6 +103,13 @@ config LEDS_RT4505
 	  And it's commonly used to compensate the illuminance for the camera
 	  inside the mobile product like as phones or tablets.
 
+config LEDS_SM5703
+	tristate "LED support for the Silicon Mitus SM5703 flash LED"
+	depends on MFD_SM5703
+	help
+	  This option enables support for the flash LED driver of the
+	  Silicon Mitus SM5703 charger and PMIC, torch and flash.
+
 config LEDS_RT8515
 	tristate "LED support for Richtek RT8515 flash/torch LED"
 	depends on GPIOLIB
