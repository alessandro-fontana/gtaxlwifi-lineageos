--- a/drivers/leds/flash/Makefile
+++ b/drivers/leds/flash/Makefile
@@ -9,6 +9,7 @@ obj-$(CONFIG_LEDS_LM3601X)	+= leds-lm3601x.o
 obj-$(CONFIG_LEDS_MAX77693)	+= leds-max77693.o
 obj-$(CONFIG_LEDS_QCOM_FLASH)	+= leds-qcom-flash.o
 obj-$(CONFIG_LEDS_RT4505)	+= leds-rt4505.o
+obj-$(CONFIG_LEDS_SM5703)	+= leds-sm5703.o
 obj-$(CONFIG_LEDS_RT8515)	+= leds-rt8515.o
 obj-$(CONFIG_LEDS_S2M_FLASH)	+= leds-s2m-flash.o
 obj-$(CONFIG_LEDS_SGM3140)	+= leds-sgm3140.o
diff --git a/drivers/leds/flash/leds-sm5703.c b/drivers/leds/flash/leds-sm5703.c
new file mode 100644
index 0000000000..3e1cd2c17f
--- /dev/null
+++ b/drivers/leds/flash/leds-sm5703.c
@@ -0,0 +1,373 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Flash LED driver for the Silicon Mitus SM5703 charger and PMIC
+ *
+ * The SM5703 drives one flash LED from the output of its boost converter,
+ * the same converter that powers USB OTG. Torch is the "movie" mode, flash
+ * the "flash" mode, both switched here over I2C. The chip has two enable
+ * inputs for a camera to fire the flash from pins; they are not used.
+ *
+ * The LED needs the boost: in flash mode always, in movie mode unless VBUS
+ * is present, as the vendor driver does. The operation mode of the chip is
+ * shared with the charger, so it is saved when the LED turns on and put
+ * back when it turns off.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/led-class-flash.h>
+#include <linux/mfd/sm5703.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define SM5703_REG_FLEDCNTL1		0x14
+#define SM5703_REG_FLEDCNTL2		0x15
+#define SM5703_REG_FLEDCNTL3		0x16
+#define SM5703_REG_FLEDCNTL4		0x17
+
+/* FLEDCNTL1 */
+#define SM5703_FLEDEN_MASK		GENMASK(1, 0)
+#define SM5703_FLEDEN_OFF		0
+#define SM5703_FLEDEN_MOVIE		1
+#define SM5703_FLEDEN_FLASH		2
+#define SM5703_ABSTMR_MASK		GENMASK(3, 2)
+#define SM5703_ABSTMR_1600MS		3
+#define SM5703_ENABSTMR			BIT(4)
+
+/* FLEDCNTL2: the vendor value, safety timer and one-shot timer disabled */
+#define SM5703_FLEDCNTL2_VALUE		0x94
+
+#define SM5703_IFLED_MASK		GENMASK(4, 0)
+#define SM5703_IMLED_MASK		GENMASK(4, 0)
+
+/* FLEDCNTL6: boost output voltage */
+#define SM5703_BSTOUT_MASK		GENMASK(3, 0)
+#define SM5703_BSTOUT_4P5V		0x05
+
+#define SM5703_TORCH_MIN_UA		10000
+#define SM5703_TORCH_STEP_UA		10000
+#define SM5703_TORCH_MAX_UA		320000
+#define SM5703_FLASH_MIN_UA		300000
+#define SM5703_FLASH_MAX_UA		1500000
+
+/* The absolute timer turns the flash off after 1.6 s whatever happens. */
+#define SM5703_FLASH_TIMEOUT_MIN_US	100000
+#define SM5703_FLASH_TIMEOUT_STEP_US	100000
+#define SM5703_FLASH_TIMEOUT_MAX_US	1600000
+
+struct sm5703_flash {
+	struct device *dev;
+	struct regmap *regmap;
+	struct mutex lock;
+	struct led_classdev_flash fled;
+	struct delayed_work timeout_work;
+
+	u32 flash_code;
+	u32 flash_timeout_us;
+	unsigned int fleden;
+	unsigned int saved_mode;
+};
+
+static struct sm5703_flash *to_sm5703_flash(struct led_classdev_flash *fled)
+{
+	return container_of(fled, struct sm5703_flash, fled);
+}
+
+/* The vendor encoding: 25 mA steps up to 700 mA, then 50 mA steps. */
+static u32 sm5703_flash_code(u32 ua)
+{
+	u32 ma = ua / 1000;
+
+	if (ma < 700)
+		return ((ma - 300) / 25) & SM5703_IFLED_MASK;
+
+	return (((ma - 700) / 50) + 0x0f) & SM5703_IFLED_MASK;
+}
+
+static bool sm5703_vbus_present(struct sm5703_flash *flash)
+{
+	unsigned int status;
+
+	if (regmap_read(flash->regmap, SM5703_REG_STATUS5, &status))
+		return false;
+
+	return status & SM5703_STATUS5_VBUSOK;
+}
+
+/* Switch the LED to @fleden, taking or giving back the operation mode. */
+static int sm5703_flash_set_mode(struct sm5703_flash *flash, unsigned int fleden)
+{
+	unsigned int mode;
+	int ret;
+
+	if (fleden == flash->fleden)
+		return 0;
+
+	if (fleden == SM5703_FLEDEN_OFF) {
+		ret = regmap_update_bits(flash->regmap, SM5703_REG_FLEDCNTL1,
+					 SM5703_FLEDEN_MASK, SM5703_FLEDEN_OFF);
+		if (ret)
+			return ret;
+
+		ret = regmap_update_bits(flash->regmap, SM5703_REG_CNTL,
+					 SM5703_CNTL_OPERATION_MODE_MASK,
+					 flash->saved_mode);
+		if (!ret)
+			flash->fleden = fleden;
+		return ret;
+	}
+
+	if (flash->fleden == SM5703_FLEDEN_OFF) {
+		ret = regmap_read(flash->regmap, SM5703_REG_CNTL, &mode);
+		if (ret)
+			return ret;
+		flash->saved_mode = mode & SM5703_CNTL_OPERATION_MODE_MASK;
+	}
+
+	ret = regmap_update_bits(flash->regmap, SM5703_REG_FLEDCNTL6,
+				 SM5703_BSTOUT_MASK, SM5703_BSTOUT_4P5V);
+	if (ret)
+		return ret;
+
+	if (fleden == SM5703_FLEDEN_MOVIE && sm5703_vbus_present(flash))
+		mode = SM5703_CNTL_OPERATION_MODE_CHARGING_ON;
+	else
+		mode = SM5703_CNTL_OPERATION_MODE_FLASH_BOOST;
+
+	ret = regmap_update_bits(flash->regmap, SM5703_REG_CNTL,
+				 SM5703_CNTL_OPERATION_MODE_MASK, mode);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(flash->regmap, SM5703_REG_FLEDCNTL1,
+				 SM5703_FLEDEN_MASK, fleden);
+	if (!ret)
+		flash->fleden = fleden;
+
+	return ret;
+}
+
+static int sm5703_torch_brightness_set(struct led_classdev *led_cdev,
+				       enum led_brightness brightness)
+{
+	struct led_classdev_flash *fled = lcdev_to_flcdev(led_cdev);
+	struct sm5703_flash *flash = to_sm5703_flash(fled);
+	int ret;
+
+	mutex_lock(&flash->lock);
+
+	if (brightness == LED_OFF) {
+		ret = flash->fleden == SM5703_FLEDEN_MOVIE ?
+		      sm5703_flash_set_mode(flash, SM5703_FLEDEN_OFF) : 0;
+		goto out;
+	}
+
+	/* Level n is n * 10 mA. */
+	ret = regmap_update_bits(flash->regmap, SM5703_REG_FLEDCNTL4,
+				 SM5703_IMLED_MASK, brightness - 1);
+	if (ret)
+		goto out;
+
+	ret = sm5703_flash_set_mode(flash, SM5703_FLEDEN_MOVIE);
+
+out:
+	mutex_unlock(&flash->lock);
+	return ret;
+}
+
+static int sm5703_flash_brightness_set(struct led_classdev_flash *fled,
+				       u32 brightness)
+{
+	struct sm5703_flash *flash = to_sm5703_flash(fled);
+
+	mutex_lock(&flash->lock);
+	flash->flash_code = sm5703_flash_code(brightness);
+	mutex_unlock(&flash->lock);
+
+	return 0;
+}
+
+static int sm5703_flash_timeout_set(struct led_classdev_flash *fled,
+				    u32 timeout)
+{
+	struct sm5703_flash *flash = to_sm5703_flash(fled);
+
+	mutex_lock(&flash->lock);
+	flash->flash_timeout_us = timeout;
+	mutex_unlock(&flash->lock);
+
+	return 0;
+}
+
+static int sm5703_flash_strobe_set(struct led_classdev_flash *fled, bool state)
+{
+	struct sm5703_flash *flash = to_sm5703_flash(fled);
+	int ret;
+
+	mutex_lock(&flash->lock);
+
+	if (!state) {
+		ret = flash->fleden == SM5703_FLEDEN_FLASH ?
+		      sm5703_flash_set_mode(flash, SM5703_FLEDEN_OFF) : 0;
+		mutex_unlock(&flash->lock);
+		cancel_delayed_work_sync(&flash->timeout_work);
+		return ret;
+	}
+
+	ret = regmap_update_bits(flash->regmap, SM5703_REG_FLEDCNTL3,
+				 SM5703_IFLED_MASK, flash->flash_code);
+	if (!ret)
+		ret = sm5703_flash_set_mode(flash, SM5703_FLEDEN_FLASH);
+	if (!ret)
+		mod_delayed_work(system_wq, &flash->timeout_work,
+				 usecs_to_jiffies(flash->flash_timeout_us));
+
+	mutex_unlock(&flash->lock);
+	return ret;
+}
+
+static int sm5703_flash_strobe_get(struct led_classdev_flash *fled, bool *state)
+{
+	struct sm5703_flash *flash = to_sm5703_flash(fled);
+
+	mutex_lock(&flash->lock);
+	*state = flash->fleden == SM5703_FLEDEN_FLASH;
+	mutex_unlock(&flash->lock);
+
+	return 0;
+}
+
+static void sm5703_flash_timeout_work(struct work_struct *work)
+{
+	struct sm5703_flash *flash =
+		container_of(work, struct sm5703_flash, timeout_work.work);
+
+	mutex_lock(&flash->lock);
+	if (flash->fleden == SM5703_FLEDEN_FLASH)
+		sm5703_flash_set_mode(flash, SM5703_FLEDEN_OFF);
+	mutex_unlock(&flash->lock);
+}
+
+static const struct led_flash_ops sm5703_flash_ops = {
+	.flash_brightness_set = sm5703_flash_brightness_set,
+	.strobe_set = sm5703_flash_strobe_set,
+	.strobe_get = sm5703_flash_strobe_get,
+	.timeout_set = sm5703_flash_timeout_set,
+};
+
+static int sm5703_flash_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct led_init_data init_data = {};
+	struct led_classdev *led_cdev;
+	struct led_flash_setting *s;
+	struct fwnode_handle *child;
+	struct sm5703_flash *flash;
+	u32 torch_ua, flash_ua, timeout_us;
+	int ret;
+
+	flash = devm_kzalloc(dev, sizeof(*flash), GFP_KERNEL);
+	if (!flash)
+		return -ENOMEM;
+
+	flash->dev = dev;
+	flash->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!flash->regmap)
+		return dev_err_probe(dev, -ENODEV, "no regmap\n");
+
+	child = device_get_next_child_node(dev, NULL);
+	if (!child)
+		return dev_err_probe(dev, -ENODEV, "no LED node\n");
+
+	torch_ua = 150000;
+	fwnode_property_read_u32(child, "led-max-microamp", &torch_ua);
+	torch_ua = clamp(torch_ua, SM5703_TORCH_MIN_UA, SM5703_TORCH_MAX_UA);
+
+	flash_ua = 1200000;
+	fwnode_property_read_u32(child, "flash-max-microamp", &flash_ua);
+	flash_ua = clamp(flash_ua, SM5703_FLASH_MIN_UA, SM5703_FLASH_MAX_UA);
+
+	timeout_us = SM5703_FLASH_TIMEOUT_MAX_US;
+	fwnode_property_read_u32(child, "flash-max-timeout-us", &timeout_us);
+	timeout_us = clamp(timeout_us, SM5703_FLASH_TIMEOUT_MIN_US,
+			   SM5703_FLASH_TIMEOUT_MAX_US);
+
+	mutex_init(&flash->lock);
+	INIT_DELAYED_WORK(&flash->timeout_work, sm5703_flash_timeout_work);
+	flash->flash_code = sm5703_flash_code(flash_ua);
+	flash->flash_timeout_us = timeout_us;
+	flash->fleden = SM5703_FLEDEN_OFF;
+
+	/* LED off, absolute timer on at 1.6 s, as the vendor driver. */
+	ret = regmap_write(flash->regmap, SM5703_REG_FLEDCNTL1,
+			   SM5703_ENABSTMR |
+			   FIELD_PREP(SM5703_ABSTMR_MASK, SM5703_ABSTMR_1600MS));
+	if (!ret)
+		ret = regmap_write(flash->regmap, SM5703_REG_FLEDCNTL2,
+				   SM5703_FLEDCNTL2_VALUE);
+	if (ret) {
+		fwnode_handle_put(child);
+		return dev_err_probe(dev, ret, "failed to set up the LED\n");
+	}
+
+	led_cdev = &flash->fled.led_cdev;
+	led_cdev->max_brightness = (torch_ua - SM5703_TORCH_MIN_UA) /
+				   SM5703_TORCH_STEP_UA + 1;
+	led_cdev->brightness_set_blocking = sm5703_torch_brightness_set;
+	led_cdev->flags |= LED_DEV_CAP_FLASH;
+
+	flash->fled.ops = &sm5703_flash_ops;
+
+	s = &flash->fled.brightness;
+	s->min = flash_ua;
+	s->max = flash_ua;
+	s->step = 1;
+	s->val = flash_ua;
+
+	s = &flash->fled.timeout;
+	s->min = SM5703_FLASH_TIMEOUT_MIN_US;
+	s->max = timeout_us;
+	s->step = SM5703_FLASH_TIMEOUT_STEP_US;
+	s->val = timeout_us;
+
+	init_data.fwnode = child;
+	ret = devm_led_classdev_flash_register_ext(dev, &flash->fled, &init_data);
+	fwnode_handle_put(child);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the LED\n");
+
+	platform_set_drvdata(pdev, flash);
+	return 0;
+}
+
+static void sm5703_flash_remove(struct platform_device *pdev)
+{
+	struct sm5703_flash *flash = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&flash->timeout_work);
+	mutex_lock(&flash->lock);
+	sm5703_flash_set_mode(flash, SM5703_FLEDEN_OFF);
+	mutex_unlock(&flash->lock);
+}
+
+static const struct of_device_id sm5703_flash_of_match[] = {
+	{ .compatible = "siliconmitus,sm5703-flash" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sm5703_flash_of_match);
+
+static struct platform_driver sm5703_flash_driver = {
+	.probe = sm5703_flash_probe,
+	.remove = sm5703_flash_remove,
+	.driver = {
+		.name = "sm5703-flash",
+		.of_match_table = sm5703_flash_of_match,
+	},
+};
+module_platform_driver(sm5703_flash_driver);
+
+MODULE_DESCRIPTION("Silicon Mitus SM5703 flash LED driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/mfd/sm5703.c b/drivers/mfd/sm5703.c
index be91b7e21a..4f26a3cbc7 100644
--- a/drivers/mfd/sm5703.c
+++ b/drivers/mfd/sm5703.c
@@ -36,6 +36,8 @@ static const struct resource sm5703_charger_resources[] = {
 static const struct mfd_cell sm5703_cells[] = {
 	MFD_CELL_OF("sm5703-charger", sm5703_charger_resources, NULL, 0, 0,
 		    "siliconmitus,sm5703-charger"),
+	MFD_CELL_OF("sm5703-flash", NULL, NULL, 0, 0,
+		    "siliconmitus,sm5703-flash"),
 };
 
 static const struct regmap_irq sm5703_irqs[] = {
-- 
