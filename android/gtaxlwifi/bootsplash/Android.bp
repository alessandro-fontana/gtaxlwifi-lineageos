// SPDX-License-Identifier: Apache-2.0
//
// The boot splash (§43). Two variants from the same source:
//
//  - "bootsplash" in the ramdisk, for first stage. It must be **static**:
//    it runs before any shared library exists, and before the ramdisk is
//    freed;
//  - "bootsplash_vendor" in /vendor/bin, which init restarts when leaving
//    charging mode (§43.11). There the system is up, so it can be a normal
//    binary; on the device it is still called "bootsplash".

cc_defaults {
    name: "bootsplash_defaults",

    srcs: [
        "bootsplash.c",
        "anim_blob.S",
    ],

    // Needed by the assembler to find anim.rle with .incbin.
    local_include_dirs: ["."],

    stl: "none",

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-O2",
    ],
}

cc_binary {
    name: "bootsplash",
    defaults: ["bootsplash_defaults"],

    // With a non-empty system_shared_libs Soong would install libc.so,
    // libm.so, libdl.so and ld-android.so in the ramdisk (1.6 MB) for a binary
    // that does not use them; static_libs: ["libc"] brings back the headers
    // that -nostdlibinc removes (libc_headers is not visible outside bionic).
    static_executable: true,
    system_shared_libs: [],
    static_libs: ["libc"],

    ramdisk: true,
}

cc_binary {
    name: "bootsplash_vendor",
    defaults: ["bootsplash_defaults"],
    stem: "bootsplash",
    vendor: true,
}
