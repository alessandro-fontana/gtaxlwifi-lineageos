<?xml version="1.0" encoding="utf-8"?>
<!--
  gpsd (Broadcom glgps) configuration for the gtaxlwifi BCM4752.

  Comes from the LineageOS 21 port (configs/gps/gps.xml), with three
  differences due to the mainline kernel and to Treble:
    PortName        /dev/ttySAC1 -> /dev/ttySAC0: mainline calls the UART at
                    0x13800000 serial0, downstream it was serial_1;
    GpioNStdbyPath  /sys/class/sec/gps/GPS_PWR_EN/value (Samsung driver) ->
                    a symlink to the GPS rfkill state, created at boot by
                    gtaxl-gps-rfkill.sh (the rfkillN index is not stable);
                    accepts "1" and "0" like the old file;
    directories     /data/system/gps/ -> /data/vendor/gps/, like the two
                    blobs after blob_fixup (extract-files.py).
-->
<glgps xmlns="http://www.glpals.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.glpals.com/glconfig.xsd" >
  <hal
       PortName="/dev/ttySAC0"
       BaudRate="921600"
       GpioNStdbyPath="/data/vendor/gps/nstdby"
       GpioDelayMs="250"
       NvStorageDir="/data/vendor/gps/"

       LogDirectory="/data/vendor/gps/log"

       LPmode="false"
       ReAidingOnHotStart="false"
       RILEnabled="false"
       SuplEnable="false"
       SuplUseApn="false"

       LbsEnable="true"
       LbsServer="BCMLS2.glpals.com"
       HttpSyncLto="true"
       LbsCellEnable="false"
       LtoDir="/data/vendor/gps/"
       LtoSyncThresholdDays="1"

       IgnoreJniTime="true"
       HulaEnable="false"
       AssertEnabled="false"
       DisablePglorNmeaCallback="true"
   />

  <gll
       LogPriMask="LOG_INFO"
       LogFacMask="LOG_GLLIO | LOG_RAWDATA | LOG_GLLAPI | LOG_NMEA"
       FrqPlan="FRQ_PLAN_26MHZ_2PPM"
       RfType="GL_RF_47520_BRCM_EXT_LNA"
       WarmStandbyTimeout1Seconds="10"
       WarmStandbyTimeout2Seconds="15"
  >
  </gll>

  <gll_features
       EnableLowPowerPmm="true"
  />

</glgps>
