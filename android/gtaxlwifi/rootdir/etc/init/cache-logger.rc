# SPDX-License-Identifier: Apache-2.0
#
# Diagnostic logcat recorder on CACHE (by-name/CACHE, p20).
#
# Enabled only with androidboot.cachelogging=1 on the cmdline: it is a tool
# for investigating boots that hang before becoming reachable, not something
# that should run in production.
#
# The "vendor." prefix in the service name is mandatory for services
# declared in /vendor/etc/init: without it, init rejects it and nothing
# starts.
#
# early-boot is the same point chosen by init.logcat-to-serial.rc in the
# mainline common tree, so logd is already running, and it is before
# "boot", where init does class_start hal and the composer starts: that is
# the failure to capture.
#
# The mount is done by the script, not by init: the "mount" builtin does not
# know the sync flag (it is not in mount_flags[] of
# system/core/init/builtins.cpp) and without MS_SYNCHRONOUS what was written
# is not on the eMMC when power is cut to get out of the hang.

service vendor.cache-logger /system/bin/sh /vendor/bin/cache-logger.sh
    # userdebug: su is permissive. A vendor domain would require rewriting
    # the script (system ip and logcat are forbidden to vendor), 04 §38.
    seclabel u:r:su:s0
    class core
    user root
    group root system log
    oneshot
    disabled

on early-boot && property:ro.boot.cachelogging=1
    start vendor.cache-logger
