#
# LineageOS Recovery only (§65.12). In Android sys.usb.controller comes from
# hardware_detect, which the recovery does not run; without it the adb and
# sideload configfs triggers write an empty UDC and USB stays off.
on init
    setprop sys.usb.controller 13600000.usb

# /tmp is half the RAM by default, 934 MiB here: MindTheGapps unpacks its
# whole package there (1.1 GB) and fails on the biggest app, and backuptool
# keeps the addons there during an update (§69). The recovery itself needs
# ~160 MiB.
on fs
    mount tmpfs tmpfs /tmp remount size=85%

# No misc on the factory partition table: one in RAM (gtaxl-misc.sh), before
# the recovery service starts at boot.
on post-fs
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/etc/gtaxl-misc.sh
