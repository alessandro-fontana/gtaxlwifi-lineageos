#
# The splash when leaving charging mode (§43.11).
#
# In charging mode the kernel has been up for a while: the first-stage
# splash has already finished, and when the key is held healthd sets
# sys.boot_from_charger_mode=1, init stops the charger class and triggers
# late-init. From then until SurfaceFlinger nobody draws anything and the
# screen stays black but on: this brings the animation back.
#
# No seclabel: the domain comes from the transition on
# gtaxl_bootsplash_exec (§39.4), so it also works in a user build.
#
# This file is NOT in /vendor/etc/init but in the system_ext overlay
# (§39.3): there it is read by init, here it would be read by vendor_init,
# which is not allowed to read sys.boot_from_charger_mode. The symptom is
# exactly that denial, and the service would never start. For the same
# reason the name has no "vendor." prefix, which is mandatory only for
# services declared under /vendor.
#
# The charger may hold DRM master for an instant after class_stop: the
# binary retries the modeset for three seconds (--modeset-wait-ms).

service gtaxl-bootsplash /vendor/bin/bootsplash --seconds=40
    class core
    user root
    group root graphics
    oneshot
    disabled

on property:sys.boot_from_charger_mode=1
    start gtaxl-bootsplash
