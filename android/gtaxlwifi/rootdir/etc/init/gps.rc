# SPDX-FileCopyrightText: 2026 The LineageOS Project
# SPDX-License-Identifier: Apache-2.0
#
# gtaxlwifi GPS: BCM4752 on ttySAC0, driven by gpsd (Broadcom glgps).
#
# Order matters. gpsd powers the chip by writing "1"/"0" to the
# GpioNStdbyPath file (gps.xml), which here is /data/vendor/gps/nstdby: a
# symlink to the GPS rfkill state, whose rfkillN index changes with the
# probe order (measured: Wi-Fi moved from rfkill1 to rfkill2 when the GPS
# arrived). gtaxl-gps-rfkill.sh creates it with exec_start, i.e.
# synchronously, in post-fs-data: before the hal class, hence before gpsd
# starts. The same script turns the chip back off, because init.generic.rc
# does "rfkill unblock all" in early-init and that turns it on.
#
# CAP_NET_ADMIN: the kernel accepts a write to an rfkill's "state" only from
# a holder of it (net/rfkill/core.c, state_store), and without it gpsd gets
# EPERM - no SELinux denial, because the capability is missing before the
# policy check is even reached. Measured: gpsd wrote "1" and the chip stayed
# off, "ASIC (47520) communication failure during stage HAL init" (§54.7).
# It is the only capability the two services get.
#
# The "vendor." prefix in the names is mandatory in /vendor/etc/init. No
# seclabel: the domains come from the transitions on the _exec types (§39.4).

on post-fs-data
    mkdir /data/vendor/gps 0771 system system
    exec_start vendor.gps-rfkill

service vendor.gps-rfkill /vendor/bin/gtaxl-gps-rfkill.sh
    user gps
    group system
    capabilities NET_ADMIN
    # /dev/kmsg is 0600 root: init opens it on the script's behalf (§10).
    stdio_to_kmsg
    oneshot
    disabled

service vendor.gpsd /vendor/bin/hw/gpsd -c /vendor/etc/gps.xml
    class hal
    user gps
    group system inet net_raw wakelock
    capabilities NET_ADMIN
    ioprio be 0
