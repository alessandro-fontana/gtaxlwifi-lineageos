// BLE scan test (§48.x): establishes whether android.hardware.bluetooth_le
// can be DECLARED, i.e. whether a scan really succeeds. The LE APIs are not
// gated by the feature (BluetoothAdapter.getLeAccess() only looks at the
// adapter state), so the measurement can be made **before** declaring it —
// which is the only honest order. Not part of any image: `m BleScan` and
// adb install.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "BleScan",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    optimize: { enabled: false },
    dex_preopt: { enabled: false },
}
