From 47d86a9a1c97126e310ed416aca1fcfcd64ce56a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 2 Oct 2026 12:18:27 +0200
Subject: [PATCH] components: take AIDL BufferPool blocks for byte buffer
 output

With a GRALLOC output pool, VideoFramePool takes the buffer id from the
block's BufferPool data, but only knew the HIDL BufferPool. Codec2 on
Android 14 and later hands out AIDL BufferPool (bufferpool2) blocks, so
every byte buffer decode failed at the first output buffer. A basic
block pool, which Codec2 picks when the pool mask leaves GRALLOC out,
gives blocks without pool data at all, and the null dereference killed
the service: SIGSEGV in VideoFramePoolF, then SIGSYS when the in-process
crash handler called uname() under the seccomp policy.

Take the id from AIDL BufferPool data too, and fail cleanly on a block
without pool data.

Tested on Exynos7870 with debug.stagefright.c2-poolmask 0xf70000
(GRALLOC added to the pooled allocators): H.264, HEVC, VP8, MPEG-4 and
H.263 decoded into byte buffers identical to ffmpeg, frame by frame.

Change-Id: Ia0ce09268027662d7ffbd08a31f11485d029b91f
---
 components/Android.bp         |  1 +
 components/VideoFramePool.cpp | 17 +++++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/components/Android.bp b/components/Android.bp
index ecb5fed..c32d59a 100644
--- a/components/Android.bp
+++ b/components/Android.bp
@@ -45,6 +45,7 @@ cc_library {
         "libstagefright_foundation",
         "libui",
         "libnativewindow",
+        "libstagefright_aidl_bufferpool2",
         "libv4l2_codec2_common",
     ],
 
diff --git a/components/VideoFramePool.cpp b/components/VideoFramePool.cpp
index 466d6b9..6a8ecfe 100644
--- a/components/VideoFramePool.cpp
+++ b/components/VideoFramePool.cpp
@@ -12,6 +12,7 @@
 
 #include <C2BlockInternal.h>
 #include <bufferpool/BufferPoolTypes.h>
+#include <bufferpool2/BufferPoolTypes.h>
 
 #include <android/hardware_buffer.h>
 #include <android/hardware/graphics/common/1.0/types.h>
@@ -26,6 +27,7 @@
 
 using android::hardware::graphics::common::V1_0::BufferUsage;
 using android::hardware::media::bufferpool::BufferPoolData;
+using AidlBufferPoolData = aidl::android::hardware::media::bufferpool2::BufferPoolData;
 
 namespace android {
 
@@ -74,6 +76,21 @@ std::optional<uint32_t> VideoFramePool::getBufferIdFromGraphicBlock(C2BlockPool&
     case V4L2AllocatorId::SECURE_LINEAR: {
         std::shared_ptr<_C2BlockPoolData> blockPoolData =
                 _C2BlockFactory::GetGraphicBlockPoolData(block);
+        // A basic block pool, as Codec2 picks when the pool mask leaves GRALLOC out, gives
+        // blocks without pool data.
+        if (!blockPoolData) {
+            ALOGE("Obtained C2GraphicBlock has no block pool data.");
+            return std::nullopt;
+        }
+        // HIDL BufferPool, or AIDL BufferPool (bufferpool2) since Android 14.
+        if (blockPoolData->getType() == _C2BlockPoolData::TYPE_BUFFERPOOL2) {
+            std::shared_ptr<AidlBufferPoolData> bpData;
+            if (!_C2BlockFactory::GetBufferPoolData(blockPoolData, &bpData) || !bpData) {
+                ALOGE("BufferPoolData unavailable in block.");
+                return std::nullopt;
+            }
+            return bpData->mId;
+        }
         if (blockPoolData->getType() != _C2BlockPoolData::TYPE_BUFFERPOOL) {
             ALOGE("Obtained C2GraphicBlock is not bufferpool-backed.");
             return std::nullopt;
-- 
2.47.3

