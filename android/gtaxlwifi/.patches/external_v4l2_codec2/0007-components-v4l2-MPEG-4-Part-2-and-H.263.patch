+
+bool V4L2Encoder::configureMPEG4(std::optional<const uint8_t> outputLevel) {
+    // Simple profile, the level the component asked for (5 as fallback).
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                              {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_MPEG4_PROFILE,
+                                           V4L2_MPEG_VIDEO_MPEG4_PROFILE_SIMPLE),
+                               V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_MPEG4_LEVEL,
+                                           outputLevel.value_or(
+                                                   V4L2_MPEG_VIDEO_MPEG4_LEVEL_5))})) {
+        ALOGE("Failed setting the MPEG-4 profile and level");
+        return false;
+    }
+
+    std::vector<V4L2ExtCtrl> mpeg4Ctrls;
+    // No B-frames: Simple profile has none.
+    mpeg4Ctrls.emplace_back(V4L2_CID_MPEG_VIDEO_B_FRAMES, 0);
+    // Quantization parameter maximum value (for variable bitrate control): 31 in MPEG-4.
+    mpeg4Ctrls.emplace_back(V4L2_CID_MPEG_VIDEO_MPEG4_MAX_QP, 31);
+    // VOS, VO and VOL headers in front of the first frame, not in a buffer of their own.
+    mpeg4Ctrls.emplace_back(V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+                            V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+    // Ignore return value as these controls are optional.
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG, std::move(mpeg4Ctrls));
 
     return true;
 }
