     case VideoCodec::AV1:
         // This is not easily checked and is not breaking to ignore
         break;
+    case VideoCodec::MPEG4:
+        // A Video Object Layer header (start codes 00 00 01 20 to 2f) or an intra VOP
+        // (00 00 01 b6, vop_coding_type 0 in the next two bits).
+        for (size_t i = 0; i + 4 < view.capacity(); i++) {
+            if (pos[i] || pos[i + 1] || pos[i + 2] != 1) continue;
+            if ((pos[i + 3] & 0xf0) == 0x20) return true;
+            if (pos[i + 3] == 0xb6) return (pos[i + 4] >> 6) == 0;
+        }
+        break;
+    case VideoCodec::H263:
+        // Picture start code (22 bits: 00 00 8x), then TR (8 bits) and PTYPE: source format in
+        // bits 6-8 and picture coding type (0 = intra) in bit 9. With source format 7 (PLUSPTYPE)
+        // the coding type is elsewhere: assume intra.
+        if (view.capacity() >= 5 && !pos[0] && !pos[1] && (pos[2] & 0xfc) == 0x80) {
+            if (((pos[4] >> 2) & 0x7) == 0x7) return true;
+            return ((pos[4] >> 1) & 0x1) == 0;
+        }
+        break;
     }
 
     return false;
