From ee956a525a282e42688ca0c24232ee8a49b6630a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 12:20:39 +0200
Subject: [PATCH] components: 3 MB input buffers for up to 1080p

Input buffers are imported whole into the decoder's IOVA space, one per
V4L2 OUTPUT buffer: sixteen 16 MB buffers exhausted the window the
Exynos7870 MFC firmware can address. 3 MB is the MFC's own stream buffer.

Change-Id: Ibfda7330ea519727e143b60f6dae70fac697c92b
---
 components/DecodeInterface.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index 558c0ea..f128dcc 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -26,7 +26,10 @@ constexpr size_t k4KArea = 3840 * 2160;
 // when using higher bitrates, like 1Mb/s on slower devices. Also, this brings up compability
 // with the Chrome browser as it is using 2MB buffer size for a 1080p stream, ref:
 // https://source.chromium.org/chromium/chromium/src/+/main:media/gpu/gpu_video_encode_accelerator_helpers.cc;l=25
-constexpr size_t kInputBufferSizeFor1080p = 16 * 1024 * 1024;  // 16MB
+// Input buffers are imported whole into the decoder's IOVA space, one per
+// V4L2 OUTPUT buffer: 16 x 16 MB exhausted the 256 MB window the Exynos7870
+// MFC firmware can address. 3 MB is the MFC's own stream buffer size.
+constexpr size_t kInputBufferSizeFor1080p = 3 * 1024 * 1024;  // 3MB
 // Input bitstream buffer size for up to 4k streams.
 constexpr size_t kInputBufferSizeFor4K = 4 * kInputBufferSizeFor1080p;
 
