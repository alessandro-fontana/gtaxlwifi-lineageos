From c4e659aab1867ed0b625453b9884d572ef0d2dca Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 26 Sep 2026 17:48:05 +0200
Subject: [PATCH] components: VP8 output delay of 8

The output delay also sets how many buffers the output surface grants.
A stateful V4L2 decoder may hold more frames than the three VP8
references: the Exynos MFC asks for a DPB of 8 (the client then needs
12), and with a delay of 3 the surface granted 10, so the decoder never
had its buffers and stalled. Use 8, as for VP9 and AV1.

Change-Id: I2f57a51fe64df1aaff5aea9eae9d7ee85bf2099b
---
 components/DecodeInterface.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index f128dcc..10951dc 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -468,7 +468,10 @@ uint32_t DecodeInterface::getOutputDelay(VideoCodec codec) {
         // if number of frames in components is less then the number of maximum reference frames
         // that could be held by decoder.
         // Reference: RFC 6386 Section 3. Compressed Frame Types
-        return 3;
+        // Stateful V4L2 decoders may hold more than the references: the
+        // Exynos MFC keeps a DPB of 8 frames for VP8. With a smaller delay
+        // the surface grants fewer buffers than the decoder needs to start.
+        return 8;
     case VideoCodec::VP9:
         // Reference: https://www.webmproject.org/vp9/levels/
         return 8;
-- 
