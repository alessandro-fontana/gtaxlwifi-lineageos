 #define PROPERTY_RENDERER "debug.hwui.renderer"
 
+/**
+ * Overrides how the overscroll stretch effect is rendered. By default the
+ * behavior is derived from ActivityManager.isHighEndGfx(): "shader_hwui" on
+ * high end devices, "uniform_scale" otherwise. Possible values:
+ *   "shader_hwui"   - stretch shader in HWUI, matrix scale in SurfaceFlinger
+ *   "shader"        - stretch shader in both HWUI and SurfaceFlinger
+ *   "uniform_scale" - a linear scale everywhere, no full-size shader pass
+ * Intended for devices whose GPU is fast enough to not be low-end but too slow
+ * to run a full-window runtime shader every frame. Read at process start.
+ */
+#define PROPERTY_STRETCH_EFFECT_BEHAVIOR "debug.hwui.stretch_effect_behavior"
+
+/**
+ * When the stretch effect behavior is UniformScale the stretch is a matrix
+ * concat applied while the node is drawn (RenderNodeDrawable::setViewProperties),
+ * yet StretchEffect::requiresLayer() still promotes the node to a full size
+ * RenderLayer that is re-rendered on every frame of the spring. Setting this
+ * property to true skips that layer, which is the point of the uniform scale
+ * behavior in the first place. Read at process start.
+ */
+#define PROPERTY_STRETCH_UNIFORM_SKIPS_LAYER "debug.hwui.stretch_uniform_skips_layer"
+
 /**
  * Allows to collect a recording of Skia drawing commands.
  */
@@ -354,6 +376,7 @@ public:
