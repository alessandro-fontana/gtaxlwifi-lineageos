@@ -117,6 +118,32 @@ StretchEffectBehavior Properties::stretchEffectBehavior = StretchEffectBehavior:
 
 DrawingEnabled Properties::drawingEnabled = DrawingEnabled::NotInitialized;
 
+static std::optional<StretchEffectBehavior> stretchEffectBehaviorOverride() {
+    std::string value = base::GetProperty(PROPERTY_STRETCH_EFFECT_BEHAVIOR, "");
+    if (value.empty()) {
+        return std::nullopt;
+    }
+    if (value == "uniform_scale") {
+        return StretchEffectBehavior::UniformScale;
+    }
+    if (value == "shader") {
+        return StretchEffectBehavior::Shader;
+    }
+    if (value == "shader_hwui") {
+        return StretchEffectBehavior::ShaderHWUI;
+    }
+    ALOGW("Unknown value '%s' for %s, ignoring", value.c_str(),
+          PROPERTY_STRETCH_EFFECT_BEHAVIOR);
+    return std::nullopt;
+}
+
+void Properties::setIsHighEndGfx(bool isHighEndGfx) {
+    Properties::isHighEndGfx = isHighEndGfx;
+    stretchEffectBehavior = stretchEffectBehaviorOverride().value_or(
+            isHighEndGfx ? StretchEffectBehavior::ShaderHWUI
+                         : StretchEffectBehavior::UniformScale);
+}
+
 bool Properties::load() {
     bool prevDebugLayersUpdates = debugLayersUpdates;
     bool prevDebugOverdraw = debugOverdraw;
@@ -185,11 +212,19 @@ bool Properties::load() {
     clipSurfaceViews =
             base::GetBoolProperty("debug.hwui.clip_surfaceviews", hwui_flags::clip_surfaceviews());
     hdr10bitPlus = hwui_flags::hdr_10bit_plus();
+    stretchUniformSkipsLayer =
+            base::GetBoolProperty(PROPERTY_STRETCH_UNIFORM_SKIPS_LAYER, false);
 
     timeoutMultiplier = android::base::GetIntProperty("ro.hw_timeout_multiplier", 1);
     skipTelemetry = base::GetBoolProperty(PROPERTY_SKIP_EGLMANAGER_TELEMETRY,
                                           hwui_flags::skip_eglmanager_telemetry());
 
+    // setIsHighEndGfx() may run before or after load(); apply the override
+    // from both places so that the property wins regardless of the order.
+    if (auto behavior = stretchEffectBehaviorOverride()) {
+        stretchEffectBehavior = *behavior;
+    }
+
     return (prevDebugLayersUpdates != debugLayersUpdates) || (prevDebugOverdraw != debugOverdraw);
 }
 
diff --git a/libs/hwui/Properties.h b/libs/hwui/Properties.h
