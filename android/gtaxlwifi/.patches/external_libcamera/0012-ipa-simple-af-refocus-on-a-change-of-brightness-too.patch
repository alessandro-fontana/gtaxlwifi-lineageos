From 9ea93fe29f99002a8dc596ac4e05970840babaee Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 18:40:40 +0200
Subject: [PATCH] ipa: simple: af: refocus on a change of brightness too

Pointing at another subject often leaves the contrast of the out of
focus image about the same, and the autofocus kept the old position
until the camera was restarted. Count a change of the brightness of the
focus window as a scene change as well, with lower thresholds (25% for
eight frames, then five steady frames).

---
 src/ipa/simple/algorithms/af.cpp | 41 ++++++++++++++++++++++++--------
 src/ipa/simple/algorithms/af.h   |  4 +++-
 2 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index d7dff47c..13fc651a 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -34,12 +34,17 @@ static constexpr int32_t kCoarseSteps = 11;
 static constexpr int32_t kFineSteps = 4;
 /* A sweep stops after two positions below this fraction of the best */
 static constexpr double kFallRatio = 0.7;
-/* A contrast change larger than this starts to count as a scene change */
-static constexpr double kChangeRatio = 0.35;
-static constexpr unsigned int kChangedFrames = 15;
-/* The scene is steady when the contrast varies less than this, frame to frame */
+/*
+ * A change of the contrast or of the brightness of the focus window larger
+ * than this, lasting kChangedFrames, is a scene change. The brightness
+ * catches the common case of pointing at another subject whose contrast,
+ * out of focus, is about the same.
+ */
+static constexpr double kChangeRatio = 0.25;
+static constexpr unsigned int kChangedFrames = 8;
+/* The scene is steady when both vary less than this, frame to frame */
 static constexpr double kSteadyRatio = 0.08;
-static constexpr unsigned int kSteadyFrames = 6;
+static constexpr unsigned int kSteadyFrames = 5;
 
 int Af::configure(IPAContext &context,
 		  [[maybe_unused]] const IPAConfigInfo &configInfo)
@@ -50,6 +55,8 @@ int Af::configure(IPAContext &context,
 	changed_ = 0;
 	steady_ = 0;
 	last_ = 0.0;
+	lastBrightness_ = 0.0;
+	referenceBrightness_ = 0.0;
 	reference_ = 0.0;
 
 	context.activeState.af.changed = false;
@@ -121,23 +128,30 @@ void Af::sweep(IPAContext &context, double sharpness)
 	state_ = State::Focused;
 	reference_ = best_;
 	last_ = best_;
+	/* Taken from the first frame at the final position, see watch(). */
+	referenceBrightness_ = 0.0;
 	changed_ = 0;
 	steady_ = 0;
 	moveTo(context, bestPosition_);
 }
 
-void Af::watch(IPAContext &context, double sharpness)
+void Af::watch(IPAContext &context, double sharpness, double brightness)
 {
-	if (std::abs(sharpness - reference_) > reference_ * kChangeRatio)
+	bool different = std::abs(sharpness - reference_) > reference_ * kChangeRatio ||
+			 std::abs(brightness - referenceBrightness_) >
+				 referenceBrightness_ * kChangeRatio;
+	if (different)
 		changed_++;
 	else if (changed_ < kChangedFrames)
 		changed_ = 0;
 
-	if (std::abs(sharpness - last_) < last_ * kSteadyRatio)
+	if (std::abs(sharpness - last_) < last_ * kSteadyRatio &&
+	    std::abs(brightness - lastBrightness_) < lastBrightness_ * kSteadyRatio)
 		steady_++;
 	else
 		steady_ = 0;
 	last_ = sharpness;
+	lastBrightness_ = brightness;
 
 	if (changed_ >= kChangedFrames && steady_ >= kSteadyFrames) {
 		const AfConfiguration &af = context.configuration.af;
@@ -151,8 +165,10 @@ void Af::watch(IPAContext &context, double sharpness)
 	}
 
 	/* Follow slow drifts (exposure, noise) of an unchanged scene. */
-	if (!changed_)
+	if (!changed_) {
 		reference_ = 0.9 * reference_ + 0.1 * sharpness;
+		referenceBrightness_ = 0.9 * referenceBrightness_ + 0.1 * brightness;
+	}
 }
 
 void Af::process(IPAContext &context,
@@ -183,6 +199,7 @@ void Af::process(IPAContext &context,
 	/* Contrast relative to the brightness, independent of the exposure */
 	double sharpness = static_cast<double>(stats->sharpness) /
 			   stats->sharpnessBase;
+	double brightness = static_cast<double>(stats->sharpnessBase);
 
 	switch (state_) {
 	case State::Waiting: {
@@ -196,7 +213,11 @@ void Af::process(IPAContext &context,
 		sweep(context, sharpness);
 		break;
 	case State::Focused:
-		watch(context, sharpness);
+		if (!referenceBrightness_) {
+			referenceBrightness_ = brightness;
+			lastBrightness_ = brightness;
+		}
+		watch(context, sharpness, brightness);
 		break;
 	}
 }
diff --git a/src/ipa/simple/algorithms/af.h b/src/ipa/simple/algorithms/af.h
index 7cf0b169..15c55e66 100644
--- a/src/ipa/simple/algorithms/af.h
+++ b/src/ipa/simple/algorithms/af.h
@@ -36,7 +36,7 @@ private:
 	void startSweep(IPAContext &context, State state, int32_t from,
 			int32_t to, int32_t step);
 	void sweep(IPAContext &context, double sharpness);
-	void watch(IPAContext &context, double sharpness);
+	void watch(IPAContext &context, double sharpness, double brightness);
 
 	State state_;
 	unsigned int settle_;
@@ -50,6 +50,8 @@ private:
 
 	double reference_;
 	double last_;
+	double referenceBrightness_;
+	double lastBrightness_;
 	unsigned int changed_;
 	unsigned int steady_;
 };
-- 
