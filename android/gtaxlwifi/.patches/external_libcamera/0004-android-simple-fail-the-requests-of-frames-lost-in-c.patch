From 026231803a7a0b11560850381a91c2095886a74d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 18:06:34 +0200
Subject: [PATCH] android, simple: fail the requests of frames lost in capture

A buffer the receiver marks as failed (a DMA error) completed its
request without a timestamp and with the output buffers never written.
The HAL handed it to the framework as a result with a zero shutter
timestamp, which the framework rejects: the request stayed in flight and
the next reconfiguration (screen rotation, camera switch) timed out
waiting for it and closed the camera.

Mark the output buffers cancelled in the simple pipeline, and in the HAL
report such requests as failed, returning the internal buffers.

---
 src/android/camera_device.cpp            | 28 ++++++++++++++++++++++--
 src/libcamera/pipeline/simple/simple.cpp |  6 ++++-
 2 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index 08dcb8b2..64b6e6f4 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -1240,12 +1240,36 @@ void CameraDevice::requestComplete(Request *request)
 	 * If the Request has failed, abort the request by notifying the error
 	 * and complete the request with all buffers in error state.
 	 */
-	if (request->status() != Request::RequestComplete) {
+	/*
+	 * A frame lost in capture (a DMA error on the receiver) completes the
+	 * request with its buffers cancelled and no timestamp. Handing it to
+	 * the framework as a result, with a zero shutter timestamp, leaves the
+	 * request in flight for ever and the next reconfiguration times out
+	 * waiting for it: report it as a failed request instead.
+	 */
+	bool frameLost = !request->metadata().get(controls::SensorTimestamp);
+	for (const auto &[stream, buffer] : request->buffers()) {
+		if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+			frameLost = true;
+	}
+
+	if (request->status() != Request::RequestComplete || frameLost) {
 		LOG(HAL, Error) << "Request " << request->cookie()
 				<< " not successfully completed: "
-				<< request->status();
+				<< request->status()
+				<< (frameLost ? " (frame lost)" : "");
 
 		abortRequest(descriptor);
+
+		/* Nothing will post-process them: give the internal buffers back. */
+		for (auto &buffer : descriptor->buffers_) {
+			if (buffer.internalBuffer) {
+				buffer.stream->putBuffer(buffer.internalBuffer);
+				buffer.internalBuffer = nullptr;
+			}
+		}
+		descriptor->pendingStreamsToProcess_.clear();
+
 		completeDescriptor(descriptor);
 
 		return;
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index fe756f06..d4dc9c87 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -35,6 +35,7 @@
 #include "libcamera/internal/converter.h"
 #include "libcamera/internal/delayed_controls.h"
 #include "libcamera/internal/device_enumerator.h"
+#include "libcamera/internal/framebuffer.h"
 #include "libcamera/internal/media_device.h"
 #include "libcamera/internal/pipeline_handler.h"
 #include "libcamera/internal/software_isp/software_isp.h"
@@ -881,8 +882,11 @@ void SimpleCameraData::imageBufferReady(FrameBuffer *buffer)
 			return;
 
 		const RequestOutputs &outputs = conversionQueue_.front();
-		for (auto &[stream, buf] : outputs.outputs)
+		for (auto &[stream, buf] : outputs.outputs) {
+			/* The output was never written: say so to the application. */
+			buf->_d()->cancel();
 			pipe->completeBuffer(outputs.request, buf);
+		}
 		SimpleFrameInfo *info = frameInfo_.find(outputs.request->sequence());
 		if (info)
 			info->metadataRequired = false;
-- 
