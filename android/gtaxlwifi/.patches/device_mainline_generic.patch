diff --git a/sepolicy/private/dontaudit.te b/sepolicy/private/dontaudit.te
new file mode 100644
index 0000000..85f02b9
--- /dev/null
+++ b/sepolicy/private/dontaudit.te
@@ -0,0 +1,15 @@
+# storaged has no sysfs access in AOSP: eMMC rev and stat fail on stock builds too.
+dontaudit storaged sysfs:file r_file_perms;
+# kdevtmpfs works on its own devtmpfs, not mounted here (/dev is a tmpfs).
+dontaudit kernel device:dir { write add_name remove_name };
+dontaudit kernel device:blk_file { create setattr unlink };
+# Properties never set and without a context (vendor.display.*, persist.vendor.audio.*):
+# the read returns empty, as it does today.
+dontaudit { surfaceflinger audioserver } vendor_default_prop:file { getattr open read map };
+
+# Isolated processes cannot reach content_capture by design.
+dontaudit isolated_app_all content_capture_service:service_manager find;
+
+# KSM: the mainline kernel exposes it, AOSP does not label it.
+type sysfs_ksm, fs_type, sysfs_type;
+r_dir_file(system_server, sysfs_ksm)
