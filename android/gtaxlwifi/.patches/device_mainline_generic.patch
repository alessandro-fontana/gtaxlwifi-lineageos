diff --git a/sepolicy/private/init_dev.te b/sepolicy/private/init_dev.te
new file mode 100644
index 0000000..db156d0
--- /dev/null
+++ b/sepolicy/private/init_dev.te
@@ -0,0 +1,31 @@
+# /dev directories created by generic_init before the policy (dev_restorecon.rc).
+allow init tmpfs:dir relabelfrom;
+allow init { gpu_device input_device audio_device dmabuf_heap_device }:dir relabelto;
+
+# Device nodes and block devices created by generic_init before the policy.
+allow init tmpfs:chr_file relabelfrom;
+allow init gpu_device:chr_file relabelto;
+allow init { loop_device swap_block_device }:blk_file relabelto;
+
+# Mainline kernel: tracepoints and debugfs differ from what init.rc expects.
+dontaudit init debugfs_bootreceiver_tracing:dir { write add_name };
+dontaudit init debugfs_mmc:file setattr;
+# init.rc writes discard_max_bytes: a neverallow forbids generic sysfs to init.
+dontaudit init sysfs:file { open write };
+
+# block devices labelled by number in the device tree; init's restorecon on the GPU nodes
+allow init { cache_block_device userdata_block_device metadata_block_device }:blk_file relabelto;
+allow init gpu_device:chr_file getattr;
+
+# ueventd relabels the nodes created by generic_init before the policy.
+allow ueventd tmpfs:{ chr_file lnk_file } { getattr relabelfrom };
+allow ueventd dev_type:{ chr_file lnk_file } relabelto;
+
+# usbd waits for the gadget HAL (an APEX chosen by hardware_detect, starts later):
+# without binder_use servicemanager cannot notify it and USB is never configured.
+binder_use(usbd)
+
+# copy-up in the /vendor overlay: the upper keeps vendor_configs_file and
+# overlay_remounter has full rights on vendor_file_type (AOSP). init's restorecon
+# to overlayfs_file is unnecessary, and a neverallow forbids it.
+dontaudit init vendor_configs_file:{ dir file } relabelfrom;
diff --git a/sepolicy/private/overlay_remounter.te b/sepolicy/private/overlay_remounter.te
new file mode 100644
index 0000000..50e21d3
--- /dev/null
+++ b/sepolicy/private/overlay_remounter.te
@@ -0,0 +1,10 @@
+# Read-write overlay of /vendor (addon fstab): upper and work on tmpfs under /mnt/scratch.
+# Overlayfs checks accesses with the credentials of the mounter,
+# that is overlay_remounter, even when another process reads or writes.
+userdebug_or_eng(`
+  allow overlay_remounter tmpfs:dir create_dir_perms;
+  allow overlay_remounter tmpfs:chr_file unlink;
+  allow overlay_remounter tmpfs:file create_file_perms;
+  allow overlay_remounter overlayfs_file:dir create_dir_perms;
+  allow overlay_remounter overlayfs_file:file create_file_perms;
+')
