+// Boot splash (§43).
+//
+// Between the DECON reset (1.17 s) and the SurfaceFlinger modeset (~21 s) the
+// panel is on and shows nothing. /system/bin/bootsplash, in the ramdisk,
+// draws the LineageOS animation on it.
+//
+// The timing is bounded at both ends. Not before /dev is mounted, and not
+// after SwitchRoot, which moves /dev under the new root and would leave the
+// child — still tied to the old one — without any /dev.
+//
+// In between, start as early as possible: the splash is launched BEFORE the
+// first ueventd and waits on its own for /dev/dri/card0 to appear, so it
+// draws as soon as the node exists rather than at the end of the scan.
+// generic_init only waits for it at the SwitchRoot boundary
+// (WaitForBootsplash), where it has normally finished long before: the 2 s
+// limit is there because a boot must not depend on a splash.
+int StartBootsplash(const std::string& cmdline) {
+    constexpr const char* program = "/system/bin/bootsplash";
+
+    if (access(program, X_OK) != 0) return -1;
+
+    int pipe_fds[2];
+    if (pipe2(pipe_fds, O_CLOEXEC) != 0) {
+        PLOG(WARNING) << "bootsplash: pipe2 failed";
+        return -1;
+    }
+
+    pid_t pid = fork();
+    if (pid < 0) {
+        PLOG(WARNING) << "bootsplash: fork failed";
+        close(pipe_fds[0]);
+        close(pipe_fds[1]);
+        return -1;
+    }
+
+    if (pid == 0) {
+        close(pipe_fds[0]);
+        fcntl(pipe_fds[1], F_SETFD, 0);  // must survive the execv
+        std::string arg = "--ready-fd=" + std::to_string(pipe_fds[1]);
+        const char* args[] = {program, arg.c_str(), nullptr};
+        execv(program, const_cast<char**>(args));
+        _exit(127);
+    }
+
+    close(pipe_fds[1]);
+    return pipe_fds[0];
+}
+
+void WaitForBootsplash(int fd) {
+    if (fd < 0) return;
+    struct pollfd p = {.fd = fd, .events = POLLIN, .revents = 0};
+    int n = TEMP_FAILURE_RETRY(poll(&p, 1, 2000));
+    if (n <= 0) {
+        LOG(WARNING) << "bootsplash: no signal within 2 s, going on";
+    }
+    close(fd);
+}
