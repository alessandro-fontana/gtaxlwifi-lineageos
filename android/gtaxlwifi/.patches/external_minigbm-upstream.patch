+/*
+ * Buffers that a GPU renders and the CPU reads back, such as the input
+ * surface of a software video encoder, are write-combined when the GPU
+ * allocates them on a non-coherent SoC (Panfrost on Mali Midgard): CPU reads
+ * crawl, and a 720p RGBA to YUV conversion took 76% of a core for 4 frames
+ * per second. Allocate them from the system dma-heap instead, which maps
+ * cached and does the cache maintenance on DMA_BUF_IOCTL_SYNC; the GPU
+ * imports them like any other dma-buf.
+ */
+static bool gbm_mesa_use_heap(uint32_t format, uint64_t use_flags)
+{
+	if (!(use_flags & BO_USE_SW_READ_OFTEN))
+		return false;
+	if (use_flags & (BO_USE_SCANOUT | BO_USE_CURSOR | BO_USE_PROTECTED | BO_USE_CAMERA_READ |
+			 BO_USE_CAMERA_WRITE | BO_USE_HW_VIDEO_DECODER))
+		return false;
+
+	switch (format) {
+	case DRM_FORMAT_ABGR8888:
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ARGB8888:
+	case DRM_FORMAT_XRGB8888:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int gbm_mesa_heap_alloc(size_t size)
+{
+	static int heap_fd = -1;
+	static std::once_flag once;
+
+	/* The heap nodes are 0444: DMA_HEAP_IOCTL_ALLOC needs no write access. */
+	std::call_once(once, [] { heap_fd = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC); });
+	if (heap_fd < 0)
+		return -ENODEV;
+
+	struct dma_heap_allocation_data args = {
+		.len = size,
+		.fd_flags = O_RDWR | O_CLOEXEC,
+	};
+	if (ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &args))
+		return -errno;
+
+	return args.fd;
+}
+
+/* A dma-buf exported by the system heap, as fdinfo names its exporter. */
+static bool gbm_mesa_is_heap_fd(int fd)
+{
+	char path[64], buf[512];
+
+	snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+	int info = open(path, O_RDONLY | O_CLOEXEC);
+	if (info < 0)
+		return false;
+	ssize_t n = read(info, buf, sizeof(buf) - 1);
+	close(info);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+
+	return strstr(buf, "exp_name:\tsystem\n") != nullptr;
+}
+
+static int gbm_mesa_heap_sync(int fd, uint64_t flags)
+{
+	struct dma_buf_sync sync = { .flags = flags | DMA_BUF_SYNC_RW };
+
+	return ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) ? -errno : 0;
+}
