<resources>
    <!-- No always-on display (§28.2). The generic device's
         AodDefaultOnOverlay turns it on, but the composer exposes only
         OFF/ON: the framework has no hardware doze state and keeps the panel
         really on, with the SoC awake. This overlay replaces that one
         (overrides in Android.bp) and restates the framework value, which
         no other overlay touches. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
</resources>
