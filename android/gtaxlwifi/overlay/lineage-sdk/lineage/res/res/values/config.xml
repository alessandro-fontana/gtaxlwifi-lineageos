<?xml version="1.0" encoding="utf-8"?>
<!--
     Resource overlay of org.lineageos.platform-res for gtaxlwifi.

     The path inside the overlay mirrors the module's path in the tree
     (lineage-sdk/lineage/res/res), and that is how Soong finds it:
     overlayResourceGlob in build/soong/java/android_resources.go.
     "product" overlays are added after "device" ones, so this one wins
     over overlays/overlay.
-->
<resources>
    <!-- The hardware keys this tablet actually has (§50).

         The lineage-sdk default is 64, i.e. "volume rocker only": with that
         value PhoneWindowManager offers no configurable action for home and
         recents, and Settings > Buttons stays almost empty. The tablet has
         four groups of them:

              1  home        gpio-keys gpa1.7, KEY_HOMEPAGE
              2  back        stmfts, right capacitive key
             16  recents     stmfts, left capacitive key
             64  volume      gpio-keys gpa2.0/1
             ===
             83

         No menu key, no assistant key, no camera key. -->
    <integer name="config_deviceHardwareKeys">83</integer>

    <!-- Which of those can wake the screen.

         Only the two on gpio-keys, which have wakeup-source in the device
         tree and stay powered on the "alive" controller. Not the two
         capacitive ones: they live inside the touchscreen controller, which
         is off in suspend and cannot wake anything.

              1  home
             64  volume
             ===
             65

         With bit 1 set, HOME_WAKE_SCREEN (default 1) takes effect and
         PhoneWindowManager treats home as a wake key:
         PhoneWindowManager.java, case KEYCODE_HOME in
         interceptKeyBeforeQueueing. Without this bit the key arrives but
         does not turn the screen on. -->
    <integer name="config_deviceHardwareWakeKeys">65</integer>
</resources>
