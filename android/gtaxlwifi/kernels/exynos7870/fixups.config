# Applied after the kernel/mainline/configs fragments, which turn these two
# options back on over the defconfig.
#
# u_audio.ko and usb_f_midi.ko end up in the ramdisk and need symbols from
# the ALSA core, which is a module here (CONFIG_SND=m) and is not in the
# ramdisk: depmod fails with "needs unknown symbol". They are the USB audio
# and MIDI gadget, i.e. the tablet presenting itself as a sound card to a
# PC. Not needed on this device.
# CONFIG_USB_CONFIGFS_F_UAC2 is not set
# CONFIG_USB_CONFIGFS_F_MIDI is not set

CONFIG_DRM_PANEL_HIMAX_HX8279=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DRM_EXYNOS=y

# Netfilter required by netd. Without the IPv6 filter table, netd exits
# with status 1 ("ip6tables-restore: unable to initialize table 'filter'",
# "Failed to initialize BandwidthController"), its onrestart restarts
# zygote and system_server dies: a crash loop every ~6 s that never
# completes boot. The options were already there as =m, but the modules
# were not loaded; here they become builtin.
#
# List taken from kernel/configs/b/android-6.12/android-base.config, which
# is the minimum contract AOSP imposes on the kernel, not from trial and
# error. Excluded: QUOTA2 and QUOTA2_LOG (out-of-tree patches of the Android
# common kernel, they do not exist in mainline) and NF_CT_PROTO_DCCP/UDPLITE
# (absorbed into NF_CONNTRACK in 7.1).
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y

# The rest of android-base.config (kernel/configs/b/android-6.12/), applied
# as a block instead of piecemeal: the file is the minimum contract AOSP
# imposes on the kernel, and every entry matches a userspace component that
# assumes it. Discovering them one at a time means a kernel rebuild for
# every service that dies. netd failed first on BandwidthController (IPv6
# filter table), then on RouteController: IP_MULTIPLE_TABLES,
# IP_ADVANCED_ROUTER, IPV6_MULTIPLE_TABLES and the XFRM_* cover the latter.
#
# Excluded because they do not exist in mainline 7.1 (Android common kernel
# or symbols removed upstream): ASHMEM, CPU_FREQ_TIMES, DM_DEFAULT_KEY,
# NETFILTER_XT_MATCH_QUOTA2(_LOG), NF_CT_PROTO_DCCP, NF_CT_PROTO_UDPLITE,
# SCHED_DEBUG, UID_SYS_STATS.
# Excluded by choice: USB_CONFIGFS_F_MIDI (conflicts with disabling it
# above), MODVERSIONS (a second module-rejection mechanism besides BTF),
# STATIC_USERMODEHELPER (path not defined), SND/SOUND builtin (a structural
# change to audio, to be evaluated separately).
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_XCBC=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DUMMY=y
CONFIG_EXPERT=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HID_GENERIC=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_SONY=y
CONFIG_IFB=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET_ESP=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_VTI=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPVTI=y
CONFIG_NET_KEY=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NO_HZ=y
CONFIG_PLAYSTATION_FF=y
CONFIG_PM_WAKELOCKS=y
CONFIG_SONY_FF=y
CONFIG_STAGING=y
CONFIG_TRACE_GPU_MEM=y
CONFIG_UHID=y
CONFIG_VETH=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y

# The RAID6 algorithm benchmark costs 612 ms on every boot (measured with
# initcall_debug, §43.7): it times eight variants one by one, on a tablet
# that has no RAID at all. RAID6_PQ is builtin only because btrfs selects it.
# With it off, the algorithm is picked by default instead of measured.
# CONFIG_RAID6_PQ_BENCHMARK is not set

# Android thermal HAL (linaro-libpm, §68): libthermal reads zones,
# temperatures and trip point events only through thermal netlink.
CONFIG_THERMAL_NETLINK=y

# Hangs (§68.29): a core lost in firmware, or stuck with interrupts
# disabled, must become a panic, i.e. a warm reboot with the log in pstore.
# A forced reboot with the keys cuts power to the RAM and the log is lost.
# The "buddy" detector has each core check another core's timer: no NMI
# needed. Panic on soft lockup is on the cmdline (softlockup_panic=1): here
# BOOTPARAM_SOFTLOCKUP_PANIC is an integer.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y

# Adopted storage (microSD as internal storage, §71): vold encrypts the
# volume with the Android kernels' "default-key" device-mapper target. Here
# it is mainline's dm-inlinecrypt, which has the same syntax, also
# registered under that name (patch 0184). Neither the eMMC nor the card
# encrypt in hardware: blk-crypto does it in software (fallback).
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_DM_INLINECRYPT=y
CONFIG_DM_INLINECRYPT_DEFAULT_KEY=y
# Adopted storage is F2FS with casefold (case-insensitive names, as Android
# wants it): without the Unicode tables the kernel rejects it (§71). As in
# GKI.
CONFIG_UNICODE=y
