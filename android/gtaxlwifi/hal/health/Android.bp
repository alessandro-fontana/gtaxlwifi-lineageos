//
// gtaxlwifi Health HAL (§55): the AOSP default one plus the filter for
// spurious cable unplugs in charging mode, which used to be a patch to
// system/core/healthd. It replaces the generic tree's one (different path,
// so `overrides` is enough); the recovery variant stays the generic one.

cc_binary {
    name: "android.hardware.health-service.gtaxlwifi",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.health-service.gtaxlwifi.rc"],
    vintf_fragments: ["android.hardware.health-service.gtaxlwifi.xml"],
    defaults: ["libhealth_aidl_impl_user"],
    static_libs: ["libhealth_aidl_impl"],
    srcs: [
        "GtaxlHealth.cpp",
        "service.cpp",
    ],
    overrides: [
        "android.hardware.health-service.generic",
        "charger",
    ],
}
