// AIDL thermal HAL (§68, §76): the hardware/linaro/libpm frontend
// (hal/thermal/src, d062161) with two fixes, on top of its unmodified
// libthermal. In Linaro's HAL thermal events never arrive: the library fixes
// which events to deliver at initialisation, when the callbacks are not set
// yet, and the looper that reads the netlink socket is never polled, because
// ABinderProcess_joinThreadPool() does not return.
// The same fixes are ready for Linaro (§12 of 05-aperto).
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.thermal-service.gtaxlwifi",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.thermal-service.gtaxlwifi.rc"],
    vintf_fragments: ["android.hardware.thermal-service.gtaxlwifi.xml"],

    srcs: [
        "Thermal.cpp",
        "Config.cpp",
        "LibThermal.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "libpm_libthermal",
        "libbase",
        "libhidlbase",
        "libutils",
        "libjsoncpp",
        "libbinder_ndk",
        "android.hardware.thermal-V1-ndk",
    ],

    header_libs: [
        "libpm_libthermal_headers",
    ],

    cflags: ["-fexceptions"],
}
