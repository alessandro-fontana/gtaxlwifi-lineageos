// AIDL IGnss on top of Broadcom's legacy HAL (gps.default.so, hardware/gps.h),
// which talks to gpsd. The two blobs come from vendor/samsung/gtaxlwifi,
// extracted by this device tree's extract-files.py.
cc_binary {
    name: "android.hardware.gnss-service.gtaxlwifi",
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss-service.gtaxlwifi.rc"],
    vintf_fragments: ["android.hardware.gnss-service.gtaxlwifi.xml"],
    vendor: true,

    srcs: [
        "Gnss.cpp",
        "service.cpp",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    shared_libs: [
        "android.hardware.gnss-V6-ndk",
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
