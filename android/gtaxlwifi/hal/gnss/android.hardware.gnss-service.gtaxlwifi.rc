#
# No seclabel: the hal_gnss_default domain comes from the transition on the
# _exec type (sepolicy/vendor/file_contexts), as for the project's other
# services (03-metodo-e-trappole.md §39.4). The gps group is needed for the
# pipes to gpsd in /data/vendor/gps.
service vendor.gnss-gtaxlwifi /vendor/bin/hw/android.hardware.gnss-service.gtaxlwifi
    class hal
    user system
    group system gps
