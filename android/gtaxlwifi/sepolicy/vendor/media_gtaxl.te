# Hardware codecs (MFC) via external/v4l2_codec2, mediacodec domain (§58).

# Codec2's BufferPool exchanges its queues (FMQ) as memfds created by the
# app: without this, the kernel rejects the descriptor in the binder reply
# ("translate fd failed") and the component goes C2_CORRUPTED on the first
# buffer. The same rule mediaswcodec has in system/sepolicy.
allow mediacodec appdomain:memfd_file { getattr read write map };

# The ro.vendor.v4l2_codec2.* properties (instances, enabled codecs).
# init sets them while reading /vendor/build.prop, with vendor_init's permissions.
vendor_internal_prop(vendor_v4l2_codec2_prop)
set_prop(vendor_init, vendor_v4l2_codec2_prop)
get_prop(mediacodec, vendor_v4l2_codec2_prop)

# With surface input (measured with screen recording, §61) the service
# loads Mesa, which looks up its override properties (mesa.*, no context,
# never set) and uses the default. As for the allocator and composer in
# device/mainline/generic: nothing to allow.
dontaudit mediacodec default_prop:file { getattr open read map };

# Same recording, two more fruitless readers, like the rules minigbm ships
# in cros_gralloc/sepolicy for cameraserver, mediaswcodec and
# system_server: MediaRecorder in mediaserver looks up vendor.minigbm.debug,
# and the software decoder that previews the saved video probes the GPU's
# sysfs node. Both carry on with the default.
dontaudit mediaserver vendor_minigbm_prop:file read;
dontaudit mediaswcodec sysfs_gpu:dir search;
