# Entropy seed kept across boots (§43.6).
#
# Written by /vendor/bin/gtaxl-entropy-seed.sh to the first sector of
# OTA (p11), which the loader reads back on the next boot (§73).
#
# The block device has its own type, not block_device: the generic one is
# forbidden to everyone except kernel, init and recovery
# (system/sepolicy/private/domain.te:746). The script opens it by name,
# /dev/block/by-name/OTA (§65.8): following the link is required.
type gtaxl_entropy_seed, domain;
type gtaxl_entropy_seed_exec, exec_type, vendor_file_type, file_type;
type gtaxl_entropy_seed_block_device, dev_type;

init_daemon_domain(gtaxl_entropy_seed)

# The script runs with the vendor shell and toybox: a vendor domain does
# not execute system binaries (§39.2).
allow gtaxl_entropy_seed vendor_shell_exec:file rx_file_perms;
allow gtaxl_entropy_seed vendor_toolbox_exec:file rx_file_perms;

# Diagnostics on /dev/kmsg, like the project's other components.
allow gtaxl_entropy_seed kmsg_device:chr_file w_file_perms;

# The seed sector. /dev/urandom need not be declared: domain.te:123
# already grants it to every domain.
allow gtaxl_entropy_seed block_device:dir search;
allow gtaxl_entropy_seed block_device:lnk_file read;
allow gtaxl_entropy_seed gtaxl_entropy_seed_block_device:blk_file rw_file_perms;

# The seed node is created by the FIRST STAGE, when the policy is not loaded
# yet: so it is born with the /dev tmpfs label. ueventd can relabel the
# nodes it finds (private/ueventd.te:26 grants it relabelto on dev_type) but
# cannot **start** from tmpfs, and without these three permissions the node
# stays tmpfs for the whole boot: two ueventd denials and the seed service
# writing into the void.
#
# Measured: deleting the node and regenerating the uevent by hand, ueventd
# recreates it with the right label and without a denial. The defect is the
# stale node, not the access rule.
#
# The alternative — a restorecon from init in early-init — does not work:
# init has no relabelto on vendor block types, and the denial says so
# (`avc: denied { relabelto } comm="init" tcontext=gtaxl_entropy_seed_block_device`).
allow ueventd tmpfs:blk_file { getattr setattr relabelfrom };

# init runs into the node too: its restorecon of /dev at boot goes over it
# (`init: Running restorecon...`, measured at 7.1 s). Without this line one
# denial per boot remains, and this project keeps denials at zero.
allow init gtaxl_entropy_seed_block_device:blk_file relabelto;
