# gtaxlwifi GPS: BCM4752 on ttySAC0 (§54).
#
#   gpsd                Broadcom's glgps, blob: talks to the chip and to the HAL
#   hal_gnss_default    android.hardware.gnss-service.gtaxlwifi, ours; the
#                       domain and its _exec are AOSP's (vendor/hal_gnss_default.te)
#   gtaxl_gps_rfkill    the script that links the power-on file (gps.rc)
#
# Rules from denials measured in permissive (§54.7), not copied from LOS 21:
# its /data/system/gps was core_data_file_type, here the blobs write to
# /data/vendor/gps (blob_fixup).

type gpsd, domain;
type gpsd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gpsd)

type gtaxl_gps_rfkill, domain;
type gtaxl_gps_rfkill_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gtaxl_gps_rfkill)

# /data/vendor/gps: receiver state, pipes between gpsd and the HAL, the
# link to the power-on file.
type gps_vendor_data_file, file_type, data_file_type;

# The GPS rfkill state, under /sys/devices/platform/gps/rfkill.
type sysfs_gps, fs_type, sysfs_type;

# ------------------------------------------------------------------ gpsd
allow gpsd gnss_device:chr_file rw_file_perms;

allow gpsd gps_vendor_data_file:dir create_dir_perms;
allow gpsd gps_vendor_data_file:{ file fifo_file } create_file_perms;
allow gpsd gps_vendor_data_file:lnk_file read;
allow gpsd sysfs_gps:dir search;
allow gpsd sysfs_gps:file rw_file_perms;

wakelock_use(gpsd)

# The rfkill state: the kernel reserves it to CAP_NET_ADMIN (gps.rc).
allow gpsd self:capability net_admin;

# Network: gpsd downloads the LTO assistance data by itself (HttpSyncLto in
# gps.xml), with DNS through netd.
net_domain(gpsd)
# ... and keeps a local TCP socket listening on port 6477 (measured:
# bind at the start of every session).
allow gpsd port:tcp_socket name_bind;
allow gpsd node:tcp_socket node_bind;

# Reads gpsd makes that are not needed on this device: the debug channel
# /cache/glgpsctrl (Broadcom), a directory under /data/data (the
# com.broadcom.test.yellowbird test app) and the modem properties, and there
# is no modem on a Wi-Fi-only tablet. Not granted.
dontaudit gpsd cache_file:lnk_file read;
dontaudit gpsd system_data_file:dir search;
dontaudit gpsd radio_prop:file { read open getattr map };

# ------------------------------------------------------ hal_gnss_default
allow hal_gnss_default gps_vendor_data_file:dir rw_dir_perms;
allow hal_gnss_default gps_vendor_data_file:{ file fifo_file } create_file_perms;

# ------------------------------------------------------ gtaxl_gps_rfkill
allow gtaxl_gps_rfkill vendor_shell_exec:file rx_file_perms;
allow gtaxl_gps_rfkill vendor_toolbox_exec:file rx_file_perms;
# The script's stdout goes to dmesg with stdio_to_kmsg (gps.rc), which init
# opens as /dev/kmsg_debug.
allow gtaxl_gps_rfkill kmsg_debug_device:chr_file { getattr ioctl write };

allow gtaxl_gps_rfkill sysfs_gps:dir r_dir_perms;
allow gtaxl_gps_rfkill sysfs_gps:file { getattr w_file_perms };
allow gtaxl_gps_rfkill self:capability net_admin;
allow gtaxl_gps_rfkill gps_vendor_data_file:dir rw_dir_perms;
# toybox's ln -sf creates the link under a temporary name and renames it.
allow gtaxl_gps_rfkill gps_vendor_data_file:{ file lnk_file } create_file_perms;
