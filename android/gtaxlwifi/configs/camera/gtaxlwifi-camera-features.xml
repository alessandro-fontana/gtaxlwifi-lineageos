<?xml version="1.0" encoding="utf-8"?>
<!--
    Camera (§57): device/mainline declares front, full and raw for every
    libcamera device. Here the rear camera (with autofocus and flash) comes
    from android.hardware.camera.flash-autofocus.xml; we remove the
    capabilities the HAL (software ISP, LIMITED level) lacks. SystemConfig
    applies the unavailable-feature entries after reading all the files.
-->
<permissions>
    <unavailable-feature name="android.hardware.camera.level.full" />
    <unavailable-feature name="android.hardware.camera.capability.raw" />
    <unavailable-feature name="android.hardware.camera.capability.manual_sensor" />
    <unavailable-feature name="android.hardware.camera.capability.manual_post_processing" />
</permissions>
