<?xml version="1.0" encoding="utf-8" ?>
<!--
    Hardware codecs of the Exynos7870 MFC (§58), through
    external/v4l2_codec2 and the s5p-mfc driver. Only what the MFC does and
    has been tested: up to 1080p (the encoder in portrait too, with the
    macroblock count of a 1080p), no secure variants.
-->
<MediaCodecs>
    <Encoders>
        <MediaCodec name="c2.v4l2.avc.encoder" type="video/avc">
            <Limit name="size" min="32x32" max="1920x1920" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="block-count" range="1-8160" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="30-30" />
        </MediaCodec>
        <!-- HEVC Main and VP8 (§58.11): same limits as AVC, portrait included -->
        <MediaCodec name="c2.v4l2.hevc.encoder" type="video/hevc">
            <Limit name="size" min="32x32" max="1920x1920" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="block-count" range="1-8160" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="30-30" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.vp8.encoder" type="video/x-vnd.on2.vp8">
            <Limit name="size" min="32x32" max="1920x1920" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="block-count" range="1-8160" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="30-30" />
        </MediaCodec>
        <!-- MPEG-4 Simple and H.263 Baseline (§75): limits from the vendor XML -->
        <MediaCodec name="c2.v4l2.mpeg4.encoder" type="video/mp4v-es">
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="4" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.h263.encoder" type="video/3gpp">
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="4x4" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="4" />
        </MediaCodec>
    </Encoders>

    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc">
            <Limit name="size" min="16x16" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="489600" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="60-60" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
        <!-- HEVC Main, 8 bit (no Main10) and VP8: limits from the vendor XML -->
        <MediaCodec name="c2.v4l2.hevc.decoder" type="video/hevc">
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="489600" />
            <Limit name="bitrate" range="1-50000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="60-60" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.vp8.decoder" type="video/x-vnd.on2.vp8">
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="489600" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="concurrent-instances" max="4" />
            <Limit name="performance-point-1920x1080" range="60-60" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
        <!-- MPEG-4 Part 2 (Simple and Advanced Simple) and H.263 Baseline (§75):
             limits from the vendor XML -->
        <MediaCodec name="c2.v4l2.mpeg4.decoder" type="video/mp4v-es">
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="489600" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="concurrent-instances" max="4" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.h263.decoder" type="video/3gpp">
            <Limit name="size" min="32x32" max="720x480" />
            <Limit name="alignment" value="4x4" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="48600" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="concurrent-instances" max="4" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
