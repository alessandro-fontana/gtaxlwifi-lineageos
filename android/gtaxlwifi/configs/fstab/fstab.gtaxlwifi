# Userdata
# Mounted by the second stage init, not by generic_init: fs_mgr_mount_all()
# skips any entry flagged first_stage_mount, and it is the only function that
# sets ro.crypto.state and ro.crypto.type, without which init refuses to apply
# any fscrypt policy. Requires androidboot.mount_userdata=disable on the
# kernel command line. Partitions are addressed by GPT name: the by-name
# links are created by Android's ueventd (androidboot.boot_devices), whose
# coldboot is over before init mounts anything. generic_init does not use
# this file.
#
# /metadata is NOT latemount: gtaxl-metadata.rc mounts it with
# "mount_all --early" on fs, before post-fs, where init.rc creates
# /metadata/{vold,apex,password_slots,...} and aconfigd sets up its flag
# storage. As latemount it only appeared at late-fs: a fresh install then
# looped in system_server on android.permission.RANGING (§65.6).
#
# /metadata is also first_stage_mount (§68.27): generic_init mounts it from
# its addon fstab, so libinit can see /metadata/.enable_insecure_debugging.
# fs_mgr_mount_all() skips a first_stage_mount entry that is mounted, and
# mounts it only if it is also formattable and was not (a wiped partition on
# a fresh install): the gtaxl-metadata.rc path above is then the fallback.
#
# formattable: fs_mgr formats a wiped partition on first mount. On a fresh
# install the OTA's table migration zeroes the head of metadata
# (ota/gtaxl-ota.sh, §72.1); a partition is "wiped" when its first 4096
# bytes are all zeros or all 0xff.
/dev/block/by-name/CACHE    /cache    ext4 nosuid,nodev,noatime wait,check,formattable
/dev/block/by-name/metadata /metadata ext4 nosuid,nodev,noatime,errors=panic wait,check,formattable,first_stage_mount
/dev/block/by-name/USERDATA /data     ext4 nosuid,nodev,noatime,errors=panic latemount,wait,check,formattable,quota,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts:v2,fsverity

# External
# microSD: mmc2 (13560000.mmc), card-detect on gpa0-1. vold matches the
# DEVPATH with fnmatch without FNM_PATHNAME, so `*` crosses `/`.
# encryptable=userdata makes it adoptable as internal storage.
/devices/platform/soc@0/13560000.mmc/mmc_host* auto auto nosuid,nodev,noatime voldmanaged=sdcard1:auto,encryptable=userdata
/devices/*/usb* auto auto defaults voldmanaged=usb:auto

# Misc
# The BCB (bootloader control block) init writes when asked to reboot into
# recovery: without this entry get_misc_blk_device() does not find it and
# HandlePowerctlMessage() gives up on the reboot, without rebooting at all.
/dev/block/by-name/misc /misc emmc defaults defaults

# ZRAM
/dev/block/zram0 none swap defaults zramsize=100%,max_comp_streams=-1
