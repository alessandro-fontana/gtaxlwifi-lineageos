#
# LineageOS Recovery (§65.12). Partitions by GPT name: the recovery's ueventd
# creates /dev/block/by-name from androidboot.boot_devices. The installer zip
# writes the eMMC at fixed offsets and needs none of these; they serve the
# recovery's own menus (wipe, mount, logs).
# /system must be listed: the recovery's dm_find_system() dereferences the
# fstab entry for GetSystemRoot() without a null check, and without an entry
# it SIGSEGVs right after the package signature check (§65.12). Logical, in
# super: with ro.boot.dynamic_partitions=true the recovery maps them before
# installing a package, writable (force_writable in userdebug), and addons
# (GApps) find them in /dev/block/mapper by the names below (§69).
system                      /system   ext4  ro                    wait,logical
product                     /product  ext4  ro                    wait,logical
system_ext                  /system_ext ext4 ro                   wait,logical
vendor                      /vendor   erofs ro                    wait,logical
/dev/block/by-name/metadata /metadata ext4 nosuid,nodev,noatime wait,check,formattable
/dev/block/by-name/USERDATA /data     ext4 nosuid,nodev,noatime wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2
/dev/block/by-name/CACHE    /cache    ext4 nosuid,nodev,noatime wait,check
/dev/block/by-name/misc     /misc     emmc defaults defaults
/dev/block/by-name/BOOT     /boot     emmc defaults defaults
/dev/block/by-name/RECOVERY /recovery emmc defaults defaults

# microSD, for "Apply from SD card"
/devices/platform/soc@0/13560000.mmc* auto auto defaults voldmanaged=sdcard1:auto
