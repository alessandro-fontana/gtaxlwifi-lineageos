From 8019a7a01ac6d6e142d74efc3371db5424d996f3 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:15:41 +0200
Subject: [PATCH 1/3] hwui: Allow overriding the stretch effect behavior

The stretch effect behavior is derived from isHighEndGfx only. Some GPUs
are not low-end but cannot afford a full-window runtime shader on every
frame. Add debug.hwui.stretch_effect_behavior to select "shader_hwui",
"shader" or "uniform_scale" explicitly.

Assisted-by: LLM
Change-Id: Ieea4d326b3b2dffbfffe632654c65bdf2e9fe405
---
 libs/hwui/Properties.cpp | 32 ++++++++++++++++++++++++++++++++
 libs/hwui/Properties.h   | 17 +++++++++++------
 2 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/libs/hwui/Properties.cpp b/libs/hwui/Properties.cpp
index 6d81a0fab..a0f25a8f2 100644
--- a/libs/hwui/Properties.cpp
+++ b/libs/hwui/Properties.cpp
@@ -117,6 +117,32 @@ StretchEffectBehavior Properties::stretchEffectBehavior = StretchEffectBehavior:
 
 DrawingEnabled Properties::drawingEnabled = DrawingEnabled::NotInitialized;
 
+static std::optional<StretchEffectBehavior> stretchEffectBehaviorOverride() {
+    std::string value = base::GetProperty(PROPERTY_STRETCH_EFFECT_BEHAVIOR, "");
+    if (value.empty()) {
+        return std::nullopt;
+    }
+    if (value == "uniform_scale") {
+        return StretchEffectBehavior::UniformScale;
+    }
+    if (value == "shader") {
+        return StretchEffectBehavior::Shader;
+    }
+    if (value == "shader_hwui") {
+        return StretchEffectBehavior::ShaderHWUI;
+    }
+    ALOGW("Unknown value '%s' for %s, ignoring", value.c_str(),
+          PROPERTY_STRETCH_EFFECT_BEHAVIOR);
+    return std::nullopt;
+}
+
+void Properties::setIsHighEndGfx(bool isHighEndGfx) {
+    Properties::isHighEndGfx = isHighEndGfx;
+    stretchEffectBehavior = stretchEffectBehaviorOverride().value_or(
+            isHighEndGfx ? StretchEffectBehavior::ShaderHWUI
+                         : StretchEffectBehavior::UniformScale);
+}
+
 bool Properties::load() {
     bool prevDebugLayersUpdates = debugLayersUpdates;
     bool prevDebugOverdraw = debugOverdraw;
@@ -190,6 +216,12 @@ bool Properties::load() {
     skipTelemetry = base::GetBoolProperty(PROPERTY_SKIP_EGLMANAGER_TELEMETRY,
                                           hwui_flags::skip_eglmanager_telemetry());
 
+    // setIsHighEndGfx() may run before or after load(); apply the override
+    // from both places so that the property wins regardless of the order.
+    if (auto behavior = stretchEffectBehaviorOverride()) {
+        stretchEffectBehavior = *behavior;
+    }
+
     return (prevDebugLayersUpdates != debugLayersUpdates) || (prevDebugOverdraw != debugOverdraw);
 }
 
diff --git a/libs/hwui/Properties.h b/libs/hwui/Properties.h
index 9b8465fee..854d7b385 100644
--- a/libs/hwui/Properties.h
+++ b/libs/hwui/Properties.h
@@ -137,6 +137,16 @@ enum DebugLevel {
  */
 #define PROPERTY_RENDERER "debug.hwui.renderer"
 
+/**
+ * Overrides how the overscroll stretch effect is rendered, which otherwise
+ * depends on isHighEndGfx. Possible values:
+ *   "shader_hwui"   - stretch shader in HWUI, matrix scale in SurfaceFlinger
+ *   "shader"        - stretch shader in both HWUI and SurfaceFlinger
+ *   "uniform_scale" - linear scale everywhere, no runtime shader pass
+ * Read at process start.
+ */
+#define PROPERTY_STRETCH_EFFECT_BEHAVIOR "debug.hwui.stretch_effect_behavior"
+
 /**
  * Allows to collect a recording of Skia drawing commands.
  */
@@ -363,12 +373,7 @@ public:
         return stretchEffectBehavior;
     }
 
-    static void setIsHighEndGfx(bool isHighEndGfx) {
-        Properties::isHighEndGfx = isHighEndGfx;
-        stretchEffectBehavior = isHighEndGfx ?
-            StretchEffectBehavior::ShaderHWUI :
-            StretchEffectBehavior::UniformScale;
-    }
+    static void setIsHighEndGfx(bool isHighEndGfx);
 
     static void setIsLowRam(bool isLowRam) { Properties::isLowRam = isLowRam; }
 
