From 5c1ca3da8b9431d19d5437154bffb88526c7adb4 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 27 Sep 2026 13:45:05 +0200
Subject: [PATCH 6/8] V4L2Decoder: Reallocate on output surface change

When a client moves the decoder to another surface (setOutputSurface),
the pictures queued to the old surface never return to the block pool,
and the new surface only hands out buffers VideoFramePool has never
seen. The pool dropped them all and the decoder starved.

After a flush, watch whether known buffers still come back. If only
unknown ones arrive for about half a second, report that the buffer set
changed, and set up the output queue again as for a resolution change.

Assisted-by: LLM
Change-Id: I4ab0b4ec4f1424c13dc36cdd69a396aab6397b8f
---
 components/VideoFramePool.cpp                 | 25 +++++++++++++++++++
 .../v4l2_codec2/components/VideoFramePool.h   | 12 +++++++++
 v4l2/V4L2Decoder.cpp                          | 10 ++++++++
 3 files changed, 47 insertions(+)

diff --git a/components/VideoFramePool.cpp b/components/VideoFramePool.cpp
index ae5cd34..466d6b9 100644
--- a/components/VideoFramePool.cpp
+++ b/components/VideoFramePool.cpp
@@ -175,6 +175,13 @@ bool VideoFramePool::shouldDropBuffer(uint32_t bufferId) {
     return true;
 }
 
+void VideoFramePool::watchBufferSet() {
+    ALOGV("%s()", __func__);
+    ALOG_ASSERT(mClientTaskRunner->RunsTasksInCurrentSequence());
+
+    mWatchBufferSet = true;
+}
+
 bool VideoFramePool::getVideoFrame(GetVideoFrameCB cb) {
     ALOGV("%s()", __func__);
     ALOG_ASSERT(mClientTaskRunner->RunsTasksInCurrentSequence());
@@ -252,11 +259,29 @@ void VideoFramePool::getVideoFrameTask() {
             ALOGV("%s(): Got buffer with id = %u", __func__, *bufferId);
 
             if (shouldDropBuffer(*bufferId)) {
+                // About half a second of retries, with the backoff below.
+                constexpr size_t kUnknownBuffersLimit = 30;
+
                 // We drop buffer, since we got more then needed.
                 ALOGV("%s(): Dropping allocated buffer with id = %u", __func__, *bufferId);
                 bufferId = std::nullopt;
                 block.reset();
                 err = C2_TIMED_OUT;
+
+                if (mWatchBufferSet && ++mUnknownInARow >= kUnknownBuffersLimit) {
+                    ALOGI("%s(): only unknown buffers since the flush, the buffer set changed",
+                          __func__);
+                    mWatchBufferSet = false;
+                    mUnknownInARow = 0;
+                    mBufferSetChanged = true;
+                    mClientTaskRunner->PostTask(
+                            FROM_HERE, ::base::BindOnce(&VideoFramePool::onVideoFrameReady,
+                                                        mClientWeakThis, std::nullopt));
+                    return;
+                }
+            } else {
+                mWatchBufferSet = false;
+                mUnknownInARow = 0;
             }
         }
     }
diff --git a/components/include/v4l2_codec2/components/VideoFramePool.h b/components/include/v4l2_codec2/components/VideoFramePool.h
index 6bebc37..0496c6b 100644
--- a/components/include/v4l2_codec2/components/VideoFramePool.h
+++ b/components/include/v4l2_codec2/components/VideoFramePool.h
@@ -42,6 +42,13 @@ public:
     // be dropped directly.
     bool getVideoFrame(GetVideoFrameCB cb);
 
+    // Watches for the client moving to another surface, whose buffers are all
+    // unknown to the pool. The watch ends at the first known buffer. If only
+    // unknown buffers arrive for a while, the getVideoFrame() callback gets
+    // nullopt and bufferSetChanged() returns true: a new pool is needed.
+    void watchBufferSet();
+    bool bufferSetChanged() const { return mBufferSetChanged; }
+
 private:
     // |blockPool| is the C2BlockPool that we fetch graphic blocks from.
     // |maxBufferCount| maximum number of buffer that should should provide to client
@@ -74,6 +81,11 @@ private:
     // Contains known buffer ids that are valid for the pool.
     std::set<uint32_t> mBuffers;
 
+    // See watchBufferSet(). |mUnknownInARow| is only used on the fetch thread.
+    std::atomic<bool> mWatchBufferSet{false};
+    std::atomic<bool> mBufferSetChanged{false};
+    size_t mUnknownInARow = 0;
+
     const ui::Size mSize;
     const HalPixelFormat mPixelFormat;
     const C2MemoryUsage mMemoryUsage;
diff --git a/v4l2/V4L2Decoder.cpp b/v4l2/V4L2Decoder.cpp
index 09799eb..5b7a780 100644
--- a/v4l2/V4L2Decoder.cpp
+++ b/v4l2/V4L2Decoder.cpp
@@ -586,6 +586,8 @@ void V4L2Decoder::flush() {
     // a buffer is DQBUF from output queue. Now all the buffers are dropped at mOutputQueue, we
     // have to trigger tryFetchVideoFrame() here.
     if (mVideoFramePool) {
+        // A flush is also where a client moves to another surface.
+        mVideoFramePool->watchBufferSet();
         tryFetchVideoFrame();
     }
 
@@ -847,6 +849,14 @@ void V4L2Decoder::onVideoFrameReady(
     ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
 
     if (!frameWithBlockId) {
+        if (mVideoFramePool && mVideoFramePool->bufferSetChanged()) {
+            // The client moved to another surface, see VideoFramePool::watchBufferSet().
+            ALOGI("%s(): the output buffer set changed, reallocating", __func__);
+            if (!changeResolution()) {
+                onError();
+            }
+            return;
+        }
         ALOGE("Got nullptr VideoFrame.");
         onError();
         return;
