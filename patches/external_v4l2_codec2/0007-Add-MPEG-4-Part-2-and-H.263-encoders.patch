+uint8_t c2MPEG4LevelToV4L2Level(C2Config::level_t level) {
+    switch (level) {
+    case C2Config::LEVEL_MP4V_0:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_0;
+    case C2Config::LEVEL_MP4V_0B:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_0B;
+    case C2Config::LEVEL_MP4V_1:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_1;
+    case C2Config::LEVEL_MP4V_2:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_2;
+    case C2Config::LEVEL_MP4V_3:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_3;
+    case C2Config::LEVEL_MP4V_3B:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_3B;
+    case C2Config::LEVEL_MP4V_4:
+    case C2Config::LEVEL_MP4V_4A:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_4;
+    case C2Config::LEVEL_MP4V_5:
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_5;
+    default:
+        ALOGE("Unrecognizable C2 MPEG-4 level (value = 0x%x), using 5", level);
+        return V4L2_MPEG_VIDEO_MPEG4_LEVEL_5;
+    }
+}
+
+bool extractMPEG4CSDInfo(std::unique_ptr<C2StreamInitDataInfo::output>* const csd,
+                         const uint8_t* data, size_t length) {
+    constexpr uint8_t kVOPStartCode = 0xb6;
+    csd->reset();
+
+    // Everything up to the first VOP start code (00 00 01 b6).
+    size_t end = 0;
+    for (size_t i = 0; i + 4 <= length; i++) {
+        if (!data[i] && !data[i + 1] && data[i + 2] == 1 && data[i + 3] == kVOPStartCode) {
+            end = i;
+            break;
+        }
+    }
+    if (end < 4) {
+        ALOGE("No MPEG-4 headers in front of the first VOP");
+        return false;
+    }
+
+    ALOGV("Extracted MPEG-4 codec config data: length=%zu", end);
+    *csd = C2StreamInitDataInfo::output::AllocUnique(end, 0u);
+    memcpy((*csd)->m.value, data, end);
+    return true;
+}
+
 bool extractSPSPPS(const uint8_t* data, size_t length, std::vector<uint8_t>* sps,
                    std::vector<uint8_t>* pps) {
     bool foundSPS = false;
