+// static
+C2R EncodeInterface::MPEG4ProfileLevelSetter(bool /*mayBlock*/,
+                                             C2P<C2StreamProfileLevelInfo::output>& info) {
+    if (!info.F(info.v.profile).supportsAtAll(info.v.profile)) {
+        ALOGV("Set profile to Simple instead of %u.", info.v.profile);
+        info.set().profile = C2Config::PROFILE_MP4V_SIMPLE;
+    }
+    if (!info.F(info.v.level).supportsAtAll(info.v.level)) {
+        ALOGV("Set level to 5 instead of %u.", info.v.level);
+        info.set().level = C2Config::LEVEL_MP4V_5;
+    }
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::H263ProfileLevelSetter(bool /*mayBlock*/,
+                                            C2P<C2StreamProfileLevelInfo::output>& info) {
+    if (!info.F(info.v.profile).supportsAtAll(info.v.profile)) {
+        ALOGV("Set profile to Baseline instead of %u.", info.v.profile);
+        info.set().profile = C2Config::PROFILE_H263_BASELINE;
+    }
+    if (!info.F(info.v.level).supportsAtAll(info.v.level)) {
+        ALOGV("Set level to 45 instead of %u.", info.v.level);
+        info.set().level = C2Config::LEVEL_H263_45;
+    }
+    return C2R::Ok();
+}
