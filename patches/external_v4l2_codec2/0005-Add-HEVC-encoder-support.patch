+
+bool V4L2Encoder::configureHEVC(std::optional<const uint8_t> outputLevel) {
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                              {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
+                                           V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN),
+                               V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_LEVEL,
+                                           outputLevel.value_or(
+                                                   V4L2_MPEG_VIDEO_HEVC_LEVEL_4_1))})) {
+        ALOGE("Failed setting the HEVC profile and level");
+        return false;
+    }
+
+    // Key frames as IDR pictures, the first one included: with the default refresh type (none)
+    // the Exynos MFC codes them as TRAIL_R slices, where no decoder can start or seek.
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                              {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_REFRESH_TYPE,
+                                           V4L2_MPEG_VIDEO_HEVC_REFRESH_IDR)})) {
+        ALOGW("Failed setting the HEVC refresh type to IDR");
+    }
+
+    std::vector<V4L2ExtCtrl> hevcCtrls;
+    // No B-frames, for lowest decoding latency.
+    hevcCtrls.emplace_back(V4L2_CID_MPEG_VIDEO_B_FRAMES, 0);
+    hevcCtrls.emplace_back(V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP, 51);
+    // extractHEVCCSDInfo() expects the parameter sets in front of the first slice.
+    hevcCtrls.emplace_back(V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+                           V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+    // Ignore return value as these controls are optional.
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG, std::move(hevcCtrls));
 
     return true;
 }
