+uint8_t c2HEVCLevelToV4L2Level(C2Config::level_t level) {
+    switch (level) {
+    case C2Config::LEVEL_HEVC_MAIN_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_1;
+    case C2Config::LEVEL_HEVC_MAIN_2:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_2;
+    case C2Config::LEVEL_HEVC_MAIN_2_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_2_1;
+    case C2Config::LEVEL_HEVC_MAIN_3:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_3;
+    case C2Config::LEVEL_HEVC_MAIN_3_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_3_1;
+    case C2Config::LEVEL_HEVC_MAIN_4:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_4;
+    case C2Config::LEVEL_HEVC_MAIN_4_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_4_1;
+    case C2Config::LEVEL_HEVC_MAIN_5:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_5;
+    case C2Config::LEVEL_HEVC_MAIN_5_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1;
+    default:
+        ALOGE("Unrecognizable C2 HEVC level (value = 0x%x), using 4.1", level);
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_4_1;
+    }
+}
+
+bool extractHEVCCSDInfo(std::unique_ptr<C2StreamInitDataInfo::output>* const csd,
+                        const uint8_t* data, size_t length) {
+    constexpr uint8_t kVPS = 32, kPPS = 34;
+    csd->reset();
+
+    // NAL units: the bytes between one start code (00 00 01, or 00 00 00 01) and the next.
+    std::vector<std::pair<size_t, size_t>> nals;
+    size_t start = 0;
+    bool inNal = false;
+    for (size_t i = 0; i + 3 <= length; i++) {
+        if (data[i] || data[i + 1] || data[i + 2] != 1) continue;
+        if (inNal) {
+            size_t end = (i > 0 && data[i - 1] == 0) ? i - 1 : i;
+            nals.emplace_back(start, end - start);
+        }
+        start = i + 3;
+        inNal = true;
+        i += 2;
+    }
+    if (inNal) nals.emplace_back(start, length - start);
+
+    std::vector<uint8_t> params;
+    bool found[3] = {};
+    for (const auto& [offset, size] : nals) {
+        if (size < 2) continue;
+        uint8_t type = (data[offset] >> 1) & 0x3f;
+        if (type < kVPS) break;  // the first slice
+        if (type > kPPS) continue;
+        found[type - kVPS] = true;
+        params.insert(params.end(), kH264StartCode, kH264StartCode + kH264StartCodeSize);
+        params.insert(params.end(), data + offset, data + offset + size);
+    }
+    if (!(found[0] && found[1] && found[2])) {
+        ALOGE("VPS, SPS or PPS missing in front of the first HEVC slice");
+        return false;
+    }
+
+    ALOGV("Extracted HEVC codec config data: length=%zu", params.size());
+    *csd = C2StreamInitDataInfo::output::AllocUnique(params.size(), 0u);
+    memcpy((*csd)->m.value, params.data(), params.size());
+    return true;
+}
