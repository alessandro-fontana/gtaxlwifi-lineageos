From 4934ef6512d0953b787fd8f8e5b0571297b4d291 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 16 Oct 2026 10:06:32 +0200
Subject: [PATCH] libhealthloop: Rearm the wake alarm after reading

On battery, every event rearmed the slow wake alarm before the events
were handled. Rearming a timerfd drops its expirations, so when the
event was the alarm itself, its handler read nothing ("read wakealarm
fd failed") and skipped the periodic chores: the battery was not read
again until another event, and its level stayed where it was through
the night.

Rearm the alarm once the events are handled.

Assisted-by: LLM
Change-Id: Ia7bc0a5495793918df2fe8677a3e703184662def
---
 health/utils/libhealthloop/HealthLoop.cpp | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/health/utils/libhealthloop/HealthLoop.cpp b/health/utils/libhealthloop/HealthLoop.cpp
index 8501f33..c96a142 100644
--- a/health/utils/libhealthloop/HealthLoop.cpp
+++ b/health/utils/libhealthloop/HealthLoop.cpp
@@ -267,21 +267,23 @@ void HealthLoop::MainLoop(void) {
             break;
         }
 
+        for (int n = 0; n < nevents; ++n) {
+            if (events[n].data.ptr) {
+                auto* event_handler = reinterpret_cast<EventHandler*>(events[n].data.ptr);
+                event_handler->func(event_handler->object, events[n].events);
+            }
+        }
+
         /*
          * Reset slow timer to avoid excessive wakeup on interrupt
-         * It's assumed periodic_chores_interval_slow means the device being in non-charging state
+         * It's assumed periodic_chores_interval_slow means the device being in non-charging state.
+         * Only after the events are handled: rearming the timer drops its expirations, and the
+         * wake alarm handler would no longer read the one that woke the loop.
          */
         if (nevents > 0 &&
             wakealarm_wake_interval_ == healthd_config_.periodic_chores_interval_slow) {
             WakeAlarmSetInterval(wakealarm_wake_interval_);
         }
-
-        for (int n = 0; n < nevents; ++n) {
-            if (events[n].data.ptr) {
-                auto* event_handler = reinterpret_cast<EventHandler*>(events[n].data.ptr);
-                event_handler->func(event_handler->object, events[n].events);
-            }
-        }
     }
 
     return;
