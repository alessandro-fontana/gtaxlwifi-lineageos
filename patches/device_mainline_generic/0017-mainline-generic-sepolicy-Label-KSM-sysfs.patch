From df53a5039cbb6d8599c0231f123211203a5b4491 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:16:24 +0200
Subject: [PATCH 17/33] mainline/generic: sepolicy: Label KSM sysfs

The mainline kernel exposes /sys/kernel/mm/ksm, which the platform does
not label. Add sysfs_ksm and let system_server read its statistics.

Assisted-by: LLM
Change-Id: I596381f53bf6b002600f86f7a73e5a6cf7073b81
---
 sepolicy/private/dontaudit.te   | 4 ++++
 sepolicy/private/genfs_contexts | 1 +
 2 files changed, 5 insertions(+)

diff --git a/sepolicy/private/dontaudit.te b/sepolicy/private/dontaudit.te
index 8924fdf..6fbdec6 100644
--- a/sepolicy/private/dontaudit.te
+++ b/sepolicy/private/dontaudit.te
@@ -8,3 +8,7 @@ dontaudit { surfaceflinger audioserver } vendor_default_prop:file { getattr open
 
 # Isolated processes cannot reach content_capture by design.
 dontaudit isolated_app_all content_capture_service:service_manager find;
+
+# KSM is exposed by the mainline kernel but not labelled by the platform.
+type sysfs_ksm, fs_type, sysfs_type;
+r_dir_file(system_server, sysfs_ksm)
diff --git a/sepolicy/private/genfs_contexts b/sepolicy/private/genfs_contexts
index 2b6c6c2..bc900ac 100644
--- a/sepolicy/private/genfs_contexts
+++ b/sepolicy/private/genfs_contexts
@@ -1,2 +1,3 @@
 genfscon efivarfs / u:object_r:efivarfs:s0
 genfscon virtiofs / u:object_r:virtiofs:s0
+genfscon sysfs /kernel/mm/ksm u:object_r:sysfs_ksm:s0
-- 
