From bc1af30786369b44e48c0a166480246ff8063d55 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:16:24 +0200
Subject: [PATCH 14/33] mainline/generic: Dontaudit mainline kernel noise

Dontaudit accesses that fail harmlessly with a mainline kernel:
- storaged reading sysfs, which it cannot do on stock builds either
- kdevtmpfs creating nodes in its own devtmpfs, while /dev is a tmpfs
- init writing debugfs tracing and mmc nodes, and discard_max_bytes,
  which is generic sysfs that a neverallow keeps from init

Assisted-by: LLM
Change-Id: I19711dc97cbc570ea1143f3edec36db98937f8d9
---
 sepolicy/private/dontaudit.te | 5 +++++
 sepolicy/private/init_dev.te  | 6 ++++++
 2 files changed, 11 insertions(+)
 create mode 100644 sepolicy/private/dontaudit.te

diff --git a/sepolicy/private/dontaudit.te b/sepolicy/private/dontaudit.te
new file mode 100644
index 0000000..a9d543a
--- /dev/null
+++ b/sepolicy/private/dontaudit.te
@@ -0,0 +1,5 @@
+# storaged has no sysfs access in AOSP; these reads fail on stock builds too.
+dontaudit storaged sysfs:file r_file_perms;
+# kdevtmpfs works on its own devtmpfs, which is not mounted: /dev is a tmpfs.
+dontaudit kernel device:dir { write add_name remove_name };
+dontaudit kernel device:blk_file { create setattr unlink };
diff --git a/sepolicy/private/init_dev.te b/sepolicy/private/init_dev.te
index 233a196..8e5d349 100644
--- a/sepolicy/private/init_dev.te
+++ b/sepolicy/private/init_dev.te
@@ -7,6 +7,12 @@ allow init tmpfs:chr_file relabelfrom;
 allow init gpu_device:chr_file relabelto;
 allow init { loop_device swap_block_device }:blk_file relabelto;
 
+# Mainline kernel tracepoints and debugfs differ from what init.rc expects.
+dontaudit init debugfs_bootreceiver_tracing:dir { write add_name };
+dontaudit init debugfs_mmc:file setattr;
+# discard_max_bytes is generic sysfs, which a neverallow keeps from init.
+dontaudit init sysfs:file { open write };
+
 # Needed by restorecon_recursive /dev/dri.
 allow init gpu_device:chr_file getattr;
 
