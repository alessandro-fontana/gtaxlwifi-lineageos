From b08074c394df47baa8332743a90e5d7a8f027486 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:16:24 +0200
Subject: [PATCH 18/33] mainline/generic: sepolicy: Label firmware_config

proc_firmware_config and the vendor_init rule writing it exist in the
platform policy, but /proc/sys/kernel/firmware_config has no genfscon.

Assisted-by: LLM
Change-Id: I78b832300a92d85ee8cced0495986e8b4b6b26dd
---
 sepolicy/private/genfs_contexts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sepolicy/private/genfs_contexts b/sepolicy/private/genfs_contexts
index bc900ac..ebb5cd4 100644
--- a/sepolicy/private/genfs_contexts
+++ b/sepolicy/private/genfs_contexts
@@ -1,3 +1,5 @@
 genfscon efivarfs / u:object_r:efivarfs:s0
 genfscon virtiofs / u:object_r:virtiofs:s0
+# Type and vendor_init access are already defined by the platform.
+genfscon proc /sys/kernel/firmware_config u:object_r:proc_firmware_config:s0
 genfscon sysfs /kernel/mm/ksm u:object_r:sysfs_ksm:s0
-- 
2.47.3

