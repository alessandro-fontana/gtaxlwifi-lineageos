From ac653782e4853057e369dec46f4d03c36c0c9d76 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:16:24 +0200
Subject: [PATCH 12/33] mainline/generic: sepolicy: Relabel early nodes

Device nodes and symlinks created by generic_init before the policy is
loaded are labelled tmpfs. Allow ueventd to relabel them, and init to
relabel the loop and swap block devices.

Assisted-by: LLM
Change-Id: I1ae6c5492f8510416a2365348ec331d21afb3a3c
---
 sepolicy/private/init_dev.te | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sepolicy/private/init_dev.te b/sepolicy/private/init_dev.te
index 9acf737..90fbfb5 100644
--- a/sepolicy/private/init_dev.te
+++ b/sepolicy/private/init_dev.te
@@ -1,3 +1,10 @@
 # /dev directories created by generic_init before the policy.
 allow init tmpfs:dir relabelfrom;
 allow init { gpu_device input_device audio_device dmabuf_heap_device }:dir relabelto;
+
+# Nodes created by generic_init before the policy.
+allow init { loop_device swap_block_device }:blk_file relabelto;
+
+# ueventd relabels the nodes created by generic_init before the policy.
+allow ueventd tmpfs:{ chr_file lnk_file } { getattr relabelfrom };
+allow ueventd dev_type:{ chr_file lnk_file } relabelto;
-- 
