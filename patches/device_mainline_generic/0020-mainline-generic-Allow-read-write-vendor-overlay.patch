From c59d98bd3a7184c1e23e915d06444d07856f916d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:16:24 +0200
Subject: [PATCH 20/33] mainline/generic: Allow read-write vendor overlay

Overlayfs checks access to the upper and work directories with the
credentials of the mounter, overlay_remounter. On userdebug and eng
builds, allow it to manage them on tmpfs. Dontaudit init relabeling
copied-up vendor_configs_file files, which a neverallow forbids.

Assisted-by: LLM
Change-Id: I9710d7728acf8375c6c430b20b728c9cbf75c29c
---
 sepolicy/private/init_dev.te          | 4 ++++
 sepolicy/private/overlay_remounter.te | 9 +++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 sepolicy/private/overlay_remounter.te

diff --git a/sepolicy/private/init_dev.te b/sepolicy/private/init_dev.te
index 3dacd1a..d498cf9 100644
--- a/sepolicy/private/init_dev.te
+++ b/sepolicy/private/init_dev.te
@@ -23,3 +23,7 @@ allow ueventd dev_type:{ chr_file lnk_file } relabelto;
 # usbd waits for the USB gadget HAL; without binder_use, servicemanager
 # cannot notify it and USB is never configured.
 binder_use(usbd)
+
+# Copy-up into the /vendor overlay keeps vendor_configs_file; relabeling to
+# overlayfs_file is not needed, and a neverallow forbids it.
+dontaudit init vendor_configs_file:{ dir file } relabelfrom;
diff --git a/sepolicy/private/overlay_remounter.te b/sepolicy/private/overlay_remounter.te
new file mode 100644
index 0000000..9efdfd9
--- /dev/null
+++ b/sepolicy/private/overlay_remounter.te
@@ -0,0 +1,9 @@
+# Read-write /vendor overlay with upper and work dirs on tmpfs. Overlayfs
+# checks access with the mounter's credentials, whoever accesses the files.
+userdebug_or_eng(`
+  allow overlay_remounter tmpfs:dir create_dir_perms;
+  allow overlay_remounter tmpfs:chr_file unlink;
+  allow overlay_remounter tmpfs:file create_file_perms;
+  allow overlay_remounter overlayfs_file:dir create_dir_perms;
+  allow overlay_remounter overlayfs_file:file create_file_perms;
+')
-- 
