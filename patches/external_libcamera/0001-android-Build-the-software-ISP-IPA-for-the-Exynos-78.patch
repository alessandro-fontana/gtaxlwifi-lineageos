diff --git a/src/ipa/simple/Android.bp b/src/ipa/simple/Android.bp
new file mode 100644
index 00000000..eea708f5
--- /dev/null
+++ b/src/ipa/simple/Android.bp
@@ -0,0 +1,44 @@
+//
+// The IPA module of the software ISP: without it IPAManager::createIPA()
+// fails and the software ISP cannot be used with raw Bayer sensors.
+//
+
+cc_library_shared {
+    name: "ipa_soft_simple",
+    vendor: true,
+    // IPA_MODULE_DIR: lib64/libcamera inside the provider APEX
+    relative_install_path: "libcamera",
+    defaults: [
+        "libcamera_default_flags",
+    ],
+    cppflags: [
+        "-Wno-shadow",
+    ],
+    srcs: [
+        "ipa_context.cpp",
+        "soft_simple.cpp",
+        "algorithms/*.cpp",
+        ":libcamera_libipa_srcs",
+    ],
+    include_dirs: [
+        "external/libcamera/src/ipa",
+        "external/libcamera/src/ipa/simple",
+        "external/libcamera/include/libcamera/ipa",
+        "external/libcamera/include/libcamera",
+    ],
+    header_libs: [
+        "libcamera_includes",
+    ],
+    shared_libs: [
+        "libcamera",
+    ],
+}
+
+prebuilt_etc {
+    name: "libcamera_ipa_simple_uncalibrated.yaml",
+    vendor: true,
+    src: "data/uncalibrated.yaml",
+    filename: "uncalibrated.yaml",
+    // IPA_CONFIG_DIR/<ipa name>/
+    relative_install_path: "libcamera/ipa/simple",
+}
diff --git a/src/libcamera/ipa_manager.cpp b/src/libcamera/ipa_manager.cpp
index 830750dc..2f6a3ba1 100644
--- a/src/libcamera/ipa_manager.cpp
+++ b/src/libcamera/ipa_manager.cpp
@@ -302,6 +302,15 @@ bool IPAManager::isSignatureValid([[maybe_unused]] IPAModule *ipa) const
 		<< (valid ? "valid" : "not valid");
 
 	return valid;
+#elif defined(__ANDROID__)
+	/*
+	 * Without a signing key every module would run isolated, in a proxy
+	 * worker that the Android build does not install. On Android the
+	 * modules come from the same build as libcamera and are installed in
+	 * a read-only, verified location: trust those in IPA_MODULE_DIR, and
+	 * only those.
+	 */
+	return ipa->path().rfind(IPA_MODULE_DIR "/", 0) == 0;
 #else
 	return false;
 #endif
