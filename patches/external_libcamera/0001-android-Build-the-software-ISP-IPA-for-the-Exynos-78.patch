index 77d44059..5c03cd47 100644
--- a/Android.bp
+++ b/Android.bp
@@ -18,7 +18,6 @@ cc_defaults {
         "-Werror",
         "-Wshadow",
         "-Wno-c99-designator",
-        "-D_FORTIFY_SOURCE=2",
     ],
     cpp_std: "c++17",
     cppflags: [
@@ -27,11 +26,12 @@ cc_defaults {
         "-DHAVE_LOCALE_T",
         "-Wshadow",
         "-Wno-c99-designator",
-        "-D_FORTIFY_SOURCE=2",
         "-Wextra-semi",
         "-Wno-implicit-fallthrough",
         /* Real path will be set via environment variables at runtime */
-        "-DIPA_MODULE_DIR=\"/vendor/lib64/libcamera\"",
+        // The IPA modules ship inside the provider APEX, next to the
+        // libcamera.so they link against.
+        "-DIPA_MODULE_DIR=\"/apex/com.android.hardware.camera.libcamera/lib64/libcamera\"",
         "-DIPA_CONFIG_DIR=\"/vendor/etc/libcamera/ipa/:/vendor/share/libcamera/ipa\"",
         "-DIPA_PROXY_DIR=\"/vendor/bin/libcamera\"",
         "-DLIBCAMERA_SYSCONF_DIR=\"/vendor/etc/libcamera/\"",
@@ -64,6 +64,43 @@ cc_library_shared {
     ],
     shared_libs: [
         "libdl",
-        "libyaml"
+    ],
+    // As in AOSP's external/libcamera: libyaml has no vendor shared variant.
+    static_libs: [
+        "libyaml",
+    ],
+}
+
