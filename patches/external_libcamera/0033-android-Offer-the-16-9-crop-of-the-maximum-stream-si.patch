From 38f8e147e5b8665de511999670091626b420ed43 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 10 Oct 2026 11:47:30 +0200
Subject: [PATCH 33/35] android: Offer the 16:9 crop of the maximum stream size

With the stream size capped to a 4:3 binned mode, the largest 16:9 size
offered for YUV and implementation-defined streams was 1280x720, and
applications taking 16:9 stills got a 4:3 preview. Add the 16:9 crop of
the maximum size to the candidate resolutions.

Assisted-by: LLM
---
 src/android/camera_capabilities.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/android/camera_capabilities.cpp b/src/android/camera_capabilities.cpp
index ab328e39..33675a59 100644
--- a/src/android/camera_capabilities.cpp
+++ b/src/android/camera_capabilities.cpp
@@ -564,6 +564,16 @@ int CameraCapabilities::initializeStreamConfigurations()
 
 		cameraResolutions.push_back(derivedSize);
 	}
+
+	/*
+	 * Add the 16:9 crop of the maximum resolution when the maximum is
+	 * taller, so that a 16:9 preview can match 16:9 stills at more than
+	 * 1280x720.
+	 */
+	const Size wideRes{ maxRes.width, (maxRes.width * 9 / 16) & ~1u };
+	if (wideRes.height < maxRes.height)
+		cameraResolutions.push_back(wideRes);
+
 	cameraResolutions.push_back(maxRes);
 
 	/* Remove duplicated entries from the list of supported resolutions. */
-- 
