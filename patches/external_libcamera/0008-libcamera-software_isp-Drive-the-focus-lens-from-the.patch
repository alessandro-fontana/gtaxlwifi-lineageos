 include/libcamera/ipa/soft.mojom              |  4 +-
 include/libcamera/ipa/soft_ipa_interface.h    |  8 +++-
 include/libcamera/ipa/soft_ipa_proxy.h        | 10 ++++
 src/libcamera/proxy/soft_ipa_proxy.cpp        | 46 +++++++++++++++++--
 src/libcamera/software_isp/software_isp.cpp   | 28 ++++++++++-
 6 files changed, 91 insertions(+), 9 deletions(-)

