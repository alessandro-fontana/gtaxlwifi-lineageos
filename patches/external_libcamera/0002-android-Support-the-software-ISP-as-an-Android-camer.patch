+	}
+	for (unsigned int i = 1; i < threads_; i++) {
+		unsigned int start = i * stripe;
+		unsigned int end = std::min(height, start + stripe);
+		if (start >= end)
+			break;
+		workers.emplace_back([this, src, dst, start, end] {
+			debayerStripe2(src, dst, start, end);
+		});
