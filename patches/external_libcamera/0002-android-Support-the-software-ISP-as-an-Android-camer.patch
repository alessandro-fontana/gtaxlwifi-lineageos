+		if (sw != dw || sh != dh) {
+			/*
+			 * A stream derived from a larger one: crop the centre to
+			 * the destination aspect ratio, then scale.
+			 */
+			unsigned int cw = sw, ch = sh;
+			if (static_cast<uint64_t>(sw) * dh > static_cast<uint64_t>(sh) * dw)
+				cw = (sh * dw / dh) & ~1u;
+			else
+				ch = (sw * dh / dw) & ~1u;
+
