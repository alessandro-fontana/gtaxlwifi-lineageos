From 463c1ea9a7afdc4ce0caed676e2a10591aeffe37 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 18:34:07 +0200
Subject: [PATCH 11/31] android: Encode JPEGs of other sizes from the largest
 stream

With a software ISP the camera has a single output. A JPEG stream whose
size matches no other stream, such as a 16:9 photo with a 4:3 preview,
made the HAL add an internal stream that the pipeline dropped, and the
configuration failed.

Map the JPEG stream on the largest stream instead, and let the JPEG
post-processor crop an XRGB8888 source to the JPEG aspect ratio and
scale it before encoding.

Assisted-by: LLM
---
 src/android/camera_device.cpp            | 24 ++++++++
 src/android/jpeg/post_processor_jpeg.cpp | 75 +++++++++++++++++++++++-
 src/android/jpeg/post_processor_jpeg.h   | 10 ++++
 3 files changed, 106 insertions(+), 3 deletions(-)

diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index 64b6e6f4..446b15f2 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -713,6 +713,30 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 			break;
 		}
 
+		/*
+		 * A software ISP has a single output (see above): a JPEG of
+		 * another size is encoded from the largest stream, cropped and
+		 * scaled by the JPEG post-processor, instead of asking the
+		 * pipeline for a second stream it would drop.
+		 */
+		if (index < 0 && !streamConfigs.empty() &&
+		    capabilities_.needConversion(HAL_PIXEL_FORMAT_YCbCr_420_888)) {
+			auto largest = std::max_element(
+				streamConfigs.begin(), streamConfigs.end(),
+				[](const Camera3StreamConfig &a, const Camera3StreamConfig &b) {
+					return a.config.size.width * a.config.size.height <
+					       b.config.size.width * b.config.size.height;
+				});
+			index = largest - streamConfigs.begin();
+			type = CameraStream::Type::Mapped;
+			largest->streams[0].stream->usage |= GRALLOC_USAGE_SW_READ_OFTEN;
+
+			LOG(HAL, Info)
+				<< "JPEG " << jpegStream->width << "x"
+				<< jpegStream->height << " derived from "
+				<< largest->config.size;
+		}
+
 		/*
 		 * Without a compatible match for JPEG encoding we must
 		 * introduce a new stream to satisfy the request requirements.
diff --git a/src/android/jpeg/post_processor_jpeg.cpp b/src/android/jpeg/post_processor_jpeg.cpp
index 89b8a401..8890157a 100644
--- a/src/android/jpeg/post_processor_jpeg.cpp
+++ b/src/android/jpeg/post_processor_jpeg.cpp
@@ -23,6 +23,10 @@
 
 #include <libcamera/formats.h>
 
+#include <libyuv/scale_argb.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+
 using namespace libcamera;
 using namespace std::chrono_literals;
 
@@ -36,10 +40,17 @@ PostProcessorJpeg::PostProcessorJpeg(CameraDevice *const device)
 int PostProcessorJpeg::configure(const StreamConfiguration &inCfg,
 				 const StreamConfiguration &outCfg)
 {
-	if (inCfg.size != outCfg.size) {
+	/*
+	 * An XRGB source (software ISP) of another size is cropped to the
+	 * JPEG aspect ratio and scaled, then encoded from a temporary buffer.
+	 */
+	scale_ = inCfg.size != outCfg.size;
+	if (scale_ && inCfg.pixelFormat != formats::XRGB8888) {
 		LOG(JPEG, Error) << "Mismatch of input and output stream sizes";
 		return -EINVAL;
 	}
+	sourceSize_ = inCfg.size;
+	sourceStride_ = inCfg.stride ? inCfg.stride : inCfg.size.width * 4;
 
 	if (outCfg.pixelFormat != formats::MJPEG) {
 		LOG(JPEG, Error) << "Output stream pixel format is not JPEG";
@@ -56,7 +67,19 @@ int PostProcessorJpeg::configure(const StreamConfiguration &inCfg,
 	encoder_ = std::make_unique<EncoderLibJpeg>();
 #endif
 
-	return encoder_->configure(inCfg);
+	if (!scale_)
+		return encoder_->configure(inCfg);
+
+#if defined(OS_CHROMEOS)
+	LOG(JPEG, Error) << "Scaling is not supported by the JEA encoder";
+	return -EINVAL;
+#else
+	StreamConfiguration encCfg = inCfg;
+	encCfg.size = outCfg.size;
+	encCfg.stride = outCfg.size.width * 4;
+	scaled_.resize(static_cast<size_t>(encCfg.stride) * outCfg.size.height);
+	return encoder_->configure(encCfg);
+#endif
 }
 
 void PostProcessorJpeg::generateThumbnail(const FrameBuffer &source,
@@ -106,6 +129,46 @@ void PostProcessorJpeg::generateThumbnail(const FrameBuffer &source,
 	}
 }
 
+#if !defined(OS_CHROMEOS)
+int PostProcessorJpeg::encodeScaled(Camera3RequestDescriptor::StreamBuffer *streamBuffer,
+				    Span<const uint8_t> exifData, unsigned int quality)
+{
+	MappedFrameBuffer frame(streamBuffer->srcBuffer,
+				MappedFrameBuffer::MapFlag::Read);
+	if (!frame.isValid()) {
+		LOG(JPEG, Error) << "Failed to map FrameBuffer : "
+				 << strerror(frame.error());
+		return frame.error();
+	}
+
+	const unsigned int sw = sourceSize_.width;
+	const unsigned int sh = sourceSize_.height;
+	const unsigned int dw = streamSize_.width;
+	const unsigned int dh = streamSize_.height;
+
+	/* Crop the centre to the JPEG aspect ratio. */
+	unsigned int cw = sw, ch = sh;
+	if (static_cast<uint64_t>(sw) * dh > static_cast<uint64_t>(sh) * dw)
+		cw = (sh * dw / dh) & ~1u;
+	else
+		ch = (sw * dh / dw) & ~1u;
+
+	const uint8_t *crop = frame.planes()[0].data() +
+			      ((sh - ch) / 2) * sourceStride_ + ((sw - cw) / 2) * 4;
+	int ret = libyuv::ARGBScale(crop, sourceStride_, cw, ch,
+				    scaled_.data(), dw * 4, dw, dh,
+				    libyuv::FilterMode::kFilterBilinear);
+	if (ret) {
+		LOG(JPEG, Error) << "Failed to scale the JPEG source: " << ret;
+		return -EINVAL;
+	}
+
+	std::vector<Span<uint8_t>> planes{ { scaled_.data(), scaled_.size() } };
+	return static_cast<EncoderLibJpeg *>(encoder_.get())
+		->encode(planes, streamBuffer->dstBuffer->plane(0), exifData, quality);
+}
+#endif
+
 void PostProcessorJpeg::process(Camera3RequestDescriptor::StreamBuffer *streamBuffer)
 {
 	ASSERT(encoder_);
@@ -202,7 +265,13 @@ void PostProcessorJpeg::process(Camera3RequestDescriptor::StreamBuffer *streamBu
 	const uint8_t quality = ret ? *entry.data.u8 : 95;
 	resultMetadata->addEntry(ANDROID_JPEG_QUALITY, quality);
 
-	int jpeg_size = encoder_->encode(streamBuffer, exif.data(), quality);
+	int jpeg_size;
+#if !defined(OS_CHROMEOS)
+	if (scale_) {
+		jpeg_size = encodeScaled(streamBuffer, exif.data(), quality);
+	} else
+#endif
+		jpeg_size = encoder_->encode(streamBuffer, exif.data(), quality);
 	if (jpeg_size < 0) {
 		LOG(JPEG, Error) << "Failed to encode stream image";
 		processComplete.emit(streamBuffer, PostProcessor::Status::Error);
diff --git a/src/android/jpeg/post_processor_jpeg.h b/src/android/jpeg/post_processor_jpeg.h
index 6fe21457..4e1b951f 100644
--- a/src/android/jpeg/post_processor_jpeg.h
+++ b/src/android/jpeg/post_processor_jpeg.h
@@ -11,6 +11,8 @@
 #include "encoder_libjpeg.h"
 #include "thumbnailer.h"
 
+#include <vector>
+
 #include <libcamera/geometry.h>
 
 class CameraDevice;
@@ -25,6 +27,9 @@ public:
 	void process(Camera3RequestDescriptor::StreamBuffer *streamBuffer) override;
 
 private:
+	int encodeScaled(Camera3RequestDescriptor::StreamBuffer *streamBuffer,
+			 libcamera::Span<const uint8_t> exifData,
+			 unsigned int quality);
 	void generateThumbnail(const libcamera::FrameBuffer &source,
 			       const libcamera::Size &targetSize,
 			       unsigned int quality,
@@ -33,6 +38,11 @@ private:
 	CameraDevice *const cameraDevice_;
 	std::unique_ptr<Encoder> encoder_;
 	libcamera::Size streamSize_;
+	/* An XRGB source of another size, cropped and scaled before encoding */
+	bool scale_ = false;
+	libcamera::Size sourceSize_;
+	unsigned int sourceStride_ = 0;
+	std::vector<uint8_t> scaled_;
 	EncoderLibJpeg thumbnailEncoder_;
 	Thumbnailer thumbnailer_;
 };
-- 
