From 04f30fdbc09a78e3d25d3a137da50e8ea26558bf Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 1 Oct 2026 13:02:45 +0200
Subject: [PATCH 31/31] android: Avoid fixed focus scene overrides with a
 focuser

The scene mode overrides asked for AF off, which the API1 shim of the
camera service reads as fixed focus. On a camera that reports a
minimum focus distance this requires an infinity focus calibration,
and without one the service refuses to open the device ("Scene mode
override lists asks for fixed focus on a device with focuser but not
calibrated for infinity focus"). Apps using the legacy camera API, such
as the Wi-Fi QR code scanner of Settings, saw no camera.

Ask for continuous-picture AF when the camera has a focuser.

Assisted-by: LLM
---
 src/android/camera_capabilities.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/android/camera_capabilities.cpp b/src/android/camera_capabilities.cpp
index 7a0faf26..ab328e39 100644
--- a/src/android/camera_capabilities.cpp
+++ b/src/android/camera_capabilities.cpp
@@ -1177,10 +1177,16 @@ int CameraCapabilities::initializeStaticMetadata()
 	staticMetadata_->addEntry(ANDROID_CONTROL_MAX_REGIONS,
 				  availableMaxRegions);
 
+	/*
+	 * AF off in a scene mode means fixed focus, which a camera with a
+	 * focuser can only honour at an infinity focus calibration it does not
+	 * have: the API1 shim of the camera service then refuses the device.
+	 */
 	std::vector<uint8_t> sceneModesOverride = {
 		ANDROID_CONTROL_AE_MODE_ON,
 		ANDROID_CONTROL_AWB_MODE_AUTO,
-		ANDROID_CONTROL_AF_MODE_OFF,
+		static_cast<uint8_t>(afAvailable_ ? ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE
+						  : ANDROID_CONTROL_AF_MODE_OFF),
 	};
 	staticMetadata_->addEntry(ANDROID_CONTROL_SCENE_MODE_OVERRIDES,
 				  sceneModesOverride);
