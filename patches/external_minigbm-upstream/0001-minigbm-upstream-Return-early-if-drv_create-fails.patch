From 193fd84dbd6021a1d70241bd25cabdcfae409b4b Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 9 Oct 2026 18:08:43 +0200
Subject: [PATCH 1/7] minigbm-upstream: Return early if drv_create fails

init_try_node_path() closed the fd on failure but went on to log the name
of the NULL driver.

Assisted-by: LLM
Change-Id: I6768791a89e87793eaa1c47a12c076ec6999e4de
---
 cros_gralloc/cros_gralloc_driver.cc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index 047a39b..ed9d249 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -104,8 +104,10 @@ static struct driver *init_try_node_path(char const *node)
 		return NULL;
 
 	drv = drv_create(fd, NULL);
-	if (!drv)
+	if (!drv) {
 		close(fd);
+		return NULL;
+	}
 
 	drv_logi("Loaded driver %s on path %s\n", drv_get_name(drv), node);
 	return drv;
-- 
