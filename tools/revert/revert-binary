#!/sbin/sh
#
# SPDX-FileCopyrightText: 2026 The LineageOS Project
# SPDX-License-Identifier: Apache-2.0
#
# Restores the factory partition table of the SM-T580, so that the stock
# firmware or LineageOS 21 can be installed again. Runs in LineageOS
# Recovery or TWRP (no awk in the former).
#
# Accepts only the migrated table: super (p19) becomes one SYSTEM again,
# boot, metadata and misc go away, and USERDATA is formatted. A factory
# table is left alone, an unknown one stops everything. Until stock or
# LineageOS 21 is installed, the tablet starts only the recovery and
# download mode.
#
# Recovery arguments: $1 API version, $2 fd for ui_print, $3 zip path.

OUTFD=$2
ZIP=$3
DISK=/dev/block/mmcblk0
T=/tmp/gtaxl
LOG=$T/revert.log

# /proc/self/fd, not >&"$OUTFD": the recovery's shell rejects fds over 9 there
ui() { printf 'ui_print %s\nui_print\n' "$*" >> /proc/self/fd/"$OUTFD"; echo "$*" >> "$LOG"; }
die() { ui "ERROR: $*"; ui "Log in $LOG"; exit 1; }
step() { ui "- $*"; }
first() { echo "$1"; }

rm -rf "$T"; mkdir -p "$T"; : > "$LOG"
ui "gtaxlwifi: back to the factory partition table"

[ "$(getprop ro.product.device)" = gtaxlwifi ] || [ "$(getprop ro.build.product)" = gtaxlwifi ] \
	|| die "this zip is for gtaxlwifi (SM-T580) only"
case "$(first $(df "$ZIP" 2>/dev/null | tail -1))" in
	/dev/block/mmcblk0*|*/by-name/*) die "the zip is on internal storage: use adb sideload or a microSD card" ;;
esac
for x in unzip dd mke2fs blockdev cmp; do
	command -v $x >/dev/null 2>&1 || die "$x missing in this recovery"
done

cd "$T" || die "cannot use $T"
unzip -o -q "$ZIP" gtaxl/gtaxl-gpt gtaxl/gtaxl-dm -d "$T" || die "incomplete zip"
chmod 755 "$T/gtaxl/gtaxl-gpt" "$T/gtaxl/gtaxl-dm"

for m in /system_root /system /vendor /data /sdcard /cache /metadata /persist; do
	umount "$m" 2>/dev/null
done
grep -q "^${DISK}p" /proc/mounts && die "partitions still mounted: $(grep -o "^${DISK}p[0-9]*" /proc/mounts | tr '\n' ' ')"

SECTORS=$(cat /sys/block/mmcblk0/size)
dd if=$DISK of=$T/gpt.bin bs=512 skip=1 count=33 2>>"$LOG" || die "reading the GPT"
STATUS=$("$T/gtaxl/gtaxl-gpt" status "$T/gpt.bin" "$SECTORS"); RC=$?
ui "Partition table: $STATUS"
case $RC in
0)	ui "Already the factory table: nothing to do."; exit 0 ;;
3|4)	;;
*)	die "partition table not recognised, nothing written" ;;
esac

# the table found goes to cache, as in update-binary
mkdir -p /tmp/gtaxl-cache
if mount -t ext4 ${DISK}p20 /tmp/gtaxl-cache 2>>"$LOG"; then
	C=/tmp/gtaxl-cache/gtaxl-first
	[ -e $C/gpt-lba1-33.bin ] && C=/tmp/gtaxl-cache/gtaxl-previous
	mkdir -p $C
	cp "$T/gpt.bin" $C/gpt-lba1-33.bin
	dd if=$DISK of=$C/gpt-backup.bin bs=512 skip=$((SECTORS - 33)) count=33 2>>"$LOG"
	sync; umount /tmp/gtaxl-cache
	step "table found saved in cache/${C##*/}"
fi

# Erase the install image markers first, so that an interrupted revert
# cannot leave a factory table that still looks installed: the liblp
# metadata at the start of SYSTEM and the start of "boot" in both layouts.
for lba in 507904 8003584 6912000; do
	dd if=/dev/zero of=$DISK bs=512 seek=$lba count=2048 2>>"$LOG" || die "erasing the install image at LBA $lba"
done
sync
step "install image markers erased"

step "computing the factory table"
"$T/gtaxl/gtaxl-gpt" revert "$T/gpt.bin" "$SECTORS" "$T/primary.bin" "$T/backup.bin" >>"$LOG" 2>&1 \
	|| die "computing the table"
step "writing the table (backup, then primary)"
dd if="$T/backup.bin" of=$DISK bs=512 seek=$((SECTORS - 33)) count=33 2>>"$LOG" || die "writing the backup table"
dd if="$T/primary.bin" of=$DISK bs=512 seek=1 count=33 2>>"$LOG" || die "writing the primary table"
sync
dd if=$DISK of=$T/readback.bin bs=512 skip=1 count=33 2>>"$LOG"
cmp -s "$T/readback.bin" "$T/primary.bin" || die "the table does not read back the same"
# the recovery keeps the logical partitions of super mapped (it maps them
# before every package): while they hold p19 open the kernel refuses to
# reread the table
printf '%s 0 0\n' system product system_ext vendor vendor_dlkm system_dlkm > $T/lp-names.txt
"$T/gtaxl/gtaxl-dm" --remove $T/lp-names.txt >>"$LOG" 2>&1
blockdev --rereadpt $DISK 2>>"$LOG" \
	|| die "the kernel did not reread the table. The factory table is written and the tablet is safe: reboot to the recovery; USERDATA is formatted by the next install"
sleep 2
[ ! -e /sys/class/block/mmcblk0p23 ] && [ "$(cat /sys/class/block/mmcblk0p22/start)" = 8003584 ] \
	|| die "the kernel still sees the old partitions: reboot to the recovery before installing anything"

step "USERDATA (p22): ext4, all data erased"
mke2fs -F -t ext4 ${DISK}p22 >>"$LOG" 2>&1 || die "mke2fs USERDATA"

sync
ui ""
ui "Done. Now install LineageOS 21 or flash the stock firmware:"
ui "until then the tablet boots only the recovery and download mode."
exit 0
